[Unit]
Description=Yishu APNs push provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yishu-push
Group=yishu-push
WorkingDirectory=/opt/yishu-push-provider
EnvironmentFile=/etc/yishu/push-provider.env
ExecStart=/opt/yishu-push-provider/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8752 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yishu-push

[Install]
WantedBy=multi-user.target
