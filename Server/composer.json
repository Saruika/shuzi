{
    "name": "shuzijun/app-content-api",
    "description": "Runtime dependencies for the Shuzijun App Content WordPress plugin.",
    "type": "wordpress-muplugin",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "7.2.0"
    },
    "config": {
        "allow-plugins": false,
        "audit": {
            "abandoned": "fail"
        },
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.6"
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
