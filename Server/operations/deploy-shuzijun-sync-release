def standby_receipt_bytes(
    bootstrap_state: BootstrapState,
    backup_manifest_sha256: str,
) -> bytes:
    active_release = json.loads(bootstrap_state.active_release_payload.decode("ascii"))
    return canonical_json({
        "activation_nonce": bootstrap_state.activation_nonce,
        "active_release": active_release,
        "active_release_sha256": sha256_bytes(
            bootstrap_state.active_release_payload
        ),
        "backup_manifest_sha256": backup_manifest_sha256,
        "full_verifier_sha256": FULL_VERIFY_SHA256,
        "fpm_guard_sha256": FPM_GUARD_SHA256,
        "generation": active_release["generation"],
        "protocol": EXPECTED_PROTOCOL,
        "receiver_sha256": RECEIVER_SHA256,
        "release": RELEASE_ID,
        "release_id": bootstrap_state.release_id,
        "role": "standby",
        "ssh_gate_sha256": SSH_GATE_SHA256,
        "status": "committed",
        "sudoers_sha256": SUDOERS_SHA256,
        "version": 3,
    })


def validate_standby_receipt(payload: bytes) -> dict[str, object]:
    if len(payload) > 4096:
        fail("standby-first receipt is oversized")
    try:
        document = json.loads(payload.decode("ascii"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise DeploymentError("standby-first receipt is invalid JSON") from error
    exact_keys = {
        "activation_nonce",
        "active_release",
        "active_release_sha256",
        "backup_manifest_sha256",
        "full_verifier_sha256",
        "fpm_guard_sha256",
        "generation",
        "protocol",
        "receiver_sha256",
        "release",
        "release_id",
        "role",
        "ssh_gate_sha256",
        "status",
        "sudoers_sha256",
        "version",
    }
    if (
        not isinstance(document, dict)
        or set(document) != exact_keys
        or canonical_json(document) != payload
    ):
        fail("standby-first receipt is not canonical")
    fixed = {
        "full_verifier_sha256": FULL_VERIFY_SHA256,
        "fpm_guard_sha256": FPM_GUARD_SHA256,
        "protocol": EXPECTED_PROTOCOL,
        "receiver_sha256": RECEIVER_SHA256,
        "release": RELEASE_ID,
        "role": "standby",
        "ssh_gate_sha256": SSH_GATE_SHA256,
        "status": "committed",
        "sudoers_sha256": SUDOERS_SHA256,
        "version": 3,
    }
    if any(document.get(key) != value for key, value in fixed.items()):
        fail("standby-first receipt fixed evidence mismatch")
    if type(document.get("version")) is not int:
        fail("standby-first receipt version type is invalid")
    generation = document.get("generation")
    if (isinstance(generation, bool) or not isinstance(generation, int)
            or not BOOTSTRAP_GENERATION <= generation < 2**63):
        fail("standby-first receipt generation is invalid")
    for key in (
        "activation_nonce",
        "active_release_sha256",
        "backup_manifest_sha256",
        "release_id",
    ):
        value = document.get(key)
        if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
            fail(f"standby-first receipt digest is invalid: {key}")
    active_release = document.get("active_release")
    if not isinstance(active_release, dict):
        fail("standby-first receipt lacks active release evidence")
    active_payload = canonical_json(active_release)
    if sha256_bytes(active_payload) != document["active_release_sha256"]:
        fail("standby-first active release digest mismatch")
    active_keys = {
        "evidence_sha256", "generation", "release_id",
        "uploads_dev", "uploads_ino", "version",
    }
    if set(active_release) != active_keys:
        fail("standby-first active release keys mismatch")
    for key in ("generation", "uploads_dev", "uploads_ino", "version"):
        value = active_release.get(key)
        if isinstance(value, bool) or not isinstance(value, int):
            fail(f"standby-first active release integer is invalid: {key}")
    evidence = active_release.get("evidence_sha256")
    release_id = active_release.get("release_id")
    uploads_dev = active_release["uploads_dev"]
    uploads_ino = active_release["uploads_ino"]
    if (
        active_release["version"] != 4
        or active_release["generation"] != generation
        or uploads_dev < 1
        or uploads_ino < 1
        or not isinstance(evidence, str)
        or re.fullmatch(r"[0-9a-f]{64}", evidence) is None
        or not isinstance(release_id, str)
        or release_id != document["release_id"]
        or release_id
        != active_release_identifier(
            generation, evidence, uploads_dev, uploads_ino
        )
    ):
        fail("standby-first active release relationship mismatch")
    return document


def validate_primary_standby_generation_binding() -> int:
    """Bind the authority anti-replay counter to this exact standby commit."""
    issued_generation = validate_primary_generation_state()
    receipt, _ = read_regular(
        STAGES["primary"] / "standby-first.receipt",
        0o600,
        device=validate_directory(STAGES["primary"], 0o700).st_dev,
    )
    document = validate_standby_receipt(receipt)
    if document["generation"] != issued_generation:
        fail("standby receipt generation does not match highest-issued-generation")
    return issued_generation


