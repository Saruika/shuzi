def sha256_bytes(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def canonical_json(document: object) -> bytes:
    return (json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True) + "\n").encode("ascii")


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def lstat_or_none(path: Path) -> os.stat_result | None:
    try:
        return path.lstat()
    except FileNotFoundError:
        return None


def validate_directory(path: Path, mode: int | None = None, *, exact_owner: bool = True) -> os.stat_result:
    metadata = path.lstat()
    if path.resolve(strict=True) != path or not stat.S_ISDIR(metadata.st_mode):
        fail(f"unsafe directory: {path}")
    if exact_owner and (metadata.st_uid, metadata.st_gid) != (ROOT_UID, ROOT_GID):
        fail(f"directory is not root-owned: {path}")
    actual_mode = stat.S_IMODE(metadata.st_mode)
    if mode is not None and actual_mode != mode:
        fail(f"directory mode mismatch: {path}")
    if mode is None and actual_mode & 0o022:
        fail(f"directory is writable by a non-root identity: {path}")
    return metadata


def validate_parent_paths(paths: Iterable[Path]) -> None:
    for path in paths:
        validate_directory(path)


