def atomic_restore_symlink(path: Path, target: str) -> None:
    validate_directory(path.parent)
    temporary = path.parent / f".sync-release-link.{os.getpid()}.{os.urandom(8).hex()}"
    try:
        os.symlink(target, temporary)
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def atomic_write_bytes(path: Path, payload: bytes, mode: int, *, replace: bool = True) -> None:
    validate_directory(path.parent)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".sync-release.", dir=path.parent)
    temporary = Path(temporary_name)
    published = False
    try:
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, ROOT_UID, ROOT_GID)
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                fail("short atomic write")
            view = view[written:]
        os.fsync(descriptor)
        current = os.fstat(descriptor)
        if (not stat.S_ISREG(current.st_mode)
                or (current.st_uid, current.st_gid) != (ROOT_UID, ROOT_GID)
                or stat.S_IMODE(current.st_mode) != mode
                or current.st_nlink != 1
                or current.st_size != len(payload)):
            fail(f"unsafe temporary file for {path}")
        os.close(descriptor)
        descriptor = -1
        if replace:
            os.replace(temporary, path)
        else:
            os.link(temporary, path, follow_symlinks=False)
            temporary.unlink()
        published = True
        fsync_directory(path.parent)
        read_regular(path, mode, sha256_bytes(payload))
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if not published:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass


def ensure_directory(path: Path, mode: int) -> bool:
    existing = lstat_or_none(path)
    if existing is not None:
        validate_directory(path, mode)
        return False
    validate_directory(path.parent)
    os.mkdir(path, mode)
    os.chown(path, ROOT_UID, ROOT_GID)
    os.chmod(path, mode)
    fsync_directory(path)
    fsync_directory(path.parent)
    validate_directory(path, mode)
    return True


def create_empty_regular_exclusive(path: Path, mode: int) -> None:
    parent_metadata = validate_directory(path.parent)
    parent_descriptor = os.open(
        path.parent,
        os.O_RDONLY
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    descriptor = -1
    try:
        opened_parent = os.fstat(parent_descriptor)
        named_parent = path.parent.lstat()
        if (
            (opened_parent.st_dev, opened_parent.st_ino)
            != (named_parent.st_dev, named_parent.st_ino)
            or opened_parent.st_dev != parent_metadata.st_dev
        ):
            fail(f"parent inode changed before exclusive create: {path.parent}")
        descriptor = os.open(
            path.name,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
            mode,
            dir_fd=parent_descriptor,
        )
        os.fchown(descriptor, ROOT_UID, ROOT_GID)
        os.fchmod(descriptor, mode)
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or (metadata.st_uid, metadata.st_gid) != (ROOT_UID, ROOT_GID)
            or stat.S_IMODE(metadata.st_mode) != mode
            or metadata.st_nlink != 1
            or metadata.st_size != 0
            or metadata.st_dev != opened_parent.st_dev
        ):
            fail(f"exclusive file has unsafe metadata: {path}")
        os.fsync(descriptor)
        os.fsync(parent_descriptor)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent_descriptor)


def validate_operation_lock_path() -> tuple[os.stat_result, os.stat_result]:
    root_metadata = validate_directory(SYNC_ROOT, 0o700)
    path_metadata = OPERATION_LOCK.lstat()
    if (
        not stat.S_ISREG(path_metadata.st_mode)
        or (path_metadata.st_uid, path_metadata.st_gid) != (ROOT_UID, ROOT_GID)
        or stat.S_IMODE(path_metadata.st_mode) != 0o600
        or path_metadata.st_nlink != 1
        or path_metadata.st_size != 0
        or path_metadata.st_dev != root_metadata.st_dev
        or OPERATION_LOCK.resolve(strict=True) != OPERATION_LOCK
    ):
        fail("site-operation lock path is unsafe")
    return root_metadata, path_metadata


def validate_operation_lock_file(
    descriptor: int | None = None,
) -> os.stat_result:
    root_metadata, path_metadata = validate_operation_lock_path()
    local_descriptor = descriptor
    close_local = False
    if local_descriptor is None:
        local_descriptor = os.open(
            OPERATION_LOCK,
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        close_local = True
    try:
        metadata = os.fstat(local_descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or (metadata.st_uid, metadata.st_gid) != (ROOT_UID, ROOT_GID)
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1
            or metadata.st_size != 0
            or metadata.st_dev != root_metadata.st_dev
            or (path_metadata.st_dev, path_metadata.st_ino)
            != (metadata.st_dev, metadata.st_ino)
        ):
            fail("site-operation lock file or opened inode is unsafe")
        return metadata
    finally:
        if close_local:
            os.close(local_descriptor)


