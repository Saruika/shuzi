def validate_primary_generation_state() -> int:
    root_metadata = validate_directory(SYNC_ROOT, 0o700)
    payload, _ = read_regular(
        HIGHEST_ISSUED_GENERATION, 0o600, device=root_metadata.st_dev
    )
    match = re.fullmatch(rb"([1-9][0-9]{0,18})\n", payload)
    if match is None:
        fail("highest-issued-generation is not canonical")
    generation = int(match.group(1))
    # The deployer never initializes or advances this anti-replay counter.  It
    # accepts the bootstrap generation and later monotonic values only when the
    # standby receipt independently binds that exact generation.
    if generation < BOOTSTRAP_GENERATION or generation >= 2**63:
        fail("highest-issued-generation is outside the deployed lineage")
    managed = re.compile(r"\.highest-issued\.[0-9a-f]{32}")
    for entry in SYNC_ROOT.iterdir():
        if not entry.name.startswith(".highest-issued."):
            continue
        if managed.fullmatch(entry.name) is None:
            fail(f"unknown highest-issued temporary: {entry.name}")
        temporary, _ = read_regular(entry, 0o600, device=root_metadata.st_dev)
        if re.fullmatch(rb"(?:[1-9][0-9]{0,18}\n?)?", temporary) is None:
            fail(f"unsafe highest-issued temporary: {entry.name}")
    return generation


def validate_primary_receipt_inventory(issued_generation: int) -> None:
    validate_absent(PENDING_RECEIPT_STATE)
    temporary = re.compile(
        r"\.(?:pending-receipt-v5|last-resolution-v5)\.[0-9a-f]{32}"
    )
    clearing = re.compile(r"\.clearing-pending-receipt-v5\.[0-9a-f]{32}")
    for entry in SYNC_ROOT.iterdir():
        if (entry.name.startswith(".pending-receipt-v5.")
                or entry.name.startswith(".last-resolution-v5.")):
            if temporary.fullmatch(entry.name) is None:
                fail(f"unknown receipt-state temporary: {entry.name}")
            # An interrupted receipt-state publication must be recovered by the
            # pinned sender before any sender release is replaced.
            read_regular(entry, 0o600, device=validate_directory(SYNC_ROOT, 0o700).st_dev)
            fail(f"unrecovered receipt-state temporary: {entry.name}")
        if entry.name.startswith(".clearing-pending-receipt-v5."):
            if clearing.fullmatch(entry.name) is None:
                fail(f"unknown receipt clearing tombstone: {entry.name}")
            read_regular(entry, 0o600, device=validate_directory(SYNC_ROOT, 0o700).st_dev)
            fail(f"unrecovered receipt clearing tombstone: {entry.name}")
    metadata = lstat_or_none(LAST_RECEIPT_RESOLUTION)
    if metadata is None:
        return
    payload, _ = read_regular(
        LAST_RECEIPT_RESOLUTION,
        0o600,
        device=validate_directory(SYNC_ROOT, 0o700).st_dev,
    )
    if len(payload) > 4096:
        fail("last receipt resolution is oversized")
    try:
        document = json.loads(payload.decode("ascii"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise DeploymentError("last receipt resolution is invalid JSON") from error
    exact_keys = {
        "accepted_generation", "active_evidence_sha256", "active_generation",
        "committed_generation", "generation", "ingest_receiver_sha256",
        "outcome", "protocol", "query_receiver_sha256", "reason",
        "release_id", "runtime", "version",
    }
    if (not isinstance(document, dict) or set(document) != exact_keys
            or canonical_json(document) != payload
            or type(document.get("version")) is not int
            or document.get("version") != 5
            or document.get("protocol") != EXPECTED_PROTOCOL
            or document.get("outcome") not in {"committed", "not-committed"}
            or document.get("runtime") not in {"healthy", "isolated"}
            or document.get("reason") not in {
                "inline-ack", "legacy-v4-stdout-contamination",
                "queried-after-ambiguous-ack", "startup-recovery",
            }):
        fail("last receipt resolution is not canonical")
    numbers = (
        document["accepted_generation"], document["active_generation"],
        document["committed_generation"], document["generation"],
    )
    if any(isinstance(value, bool) or not isinstance(value, int) for value in numbers):
        fail("last receipt resolution has invalid generations")
    accepted, active, committed, generation = numbers
    if (not BOOTSTRAP_GENERATION <= committed == active <= accepted
            <= generation <= issued_generation
            or generation >= 2**63):
        fail("last receipt resolution generation relationship mismatch")
    for key in (
        "active_evidence_sha256", "ingest_receiver_sha256",
        "query_receiver_sha256", "release_id",
    ):
        value = document.get(key)
        if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
            fail(f"last receipt resolution digest is invalid: {key}")
    if document["outcome"] == "committed":
        if accepted != generation or active != generation or document["runtime"] != "healthy":
            fail("last committed receipt resolution is contradictory")
    elif active >= generation:
        fail("last non-commit receipt resolution is contradictory")
    elif accepted == active:
        if document["runtime"] != "healthy":
            fail("last prior-base receipt resolution is contradictory")
    elif accepted == generation:
        if document["runtime"] != "isolated":
            fail("last rollback receipt resolution is contradictory")
    else:
        fail("last non-commit receipt resolution is ambiguous")


def validate_root_owned_tree(root: Path, *, device: int) -> None:
    metadata = validate_directory(root, 0o700)
    if metadata.st_dev != device:
        fail(f"managed tree crosses a filesystem boundary: {root}")
    for _directory, directory_names, file_names, directory_fd in os.fwalk(
        root, topdown=True, follow_symlinks=False
    ):
        current = os.fstat(directory_fd)
        if (
            not stat.S_ISDIR(current.st_mode)
            or (current.st_uid, current.st_gid) != (ROOT_UID, ROOT_GID)
            or stat.S_IMODE(current.st_mode) != 0o700
            or current.st_dev != device
        ):
            fail(f"unsafe managed directory below {root}")
        for name in directory_names:
            child = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            if (
                not stat.S_ISDIR(child.st_mode)
                or (child.st_uid, child.st_gid) != (ROOT_UID, ROOT_GID)
                or stat.S_IMODE(child.st_mode) != 0o700
                or child.st_dev != device
            ):
                fail(f"unsafe managed child directory below {root}")
        for name in file_names:
            child = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            if (
                not stat.S_ISREG(child.st_mode)
                or (child.st_uid, child.st_gid) != (ROOT_UID, ROOT_GID)
                or stat.S_IMODE(child.st_mode) != 0o600
                or child.st_nlink != 1
                or child.st_dev != device
            ):
                fail(f"unsafe managed child file below {root}")


def validate_sender_staging_inventory() -> None:
    root_metadata = validate_directory(SYNC_ROOT, 0o700)
    validate_sync_subdirectory(SENDER_STAGING_ROOT)
    patterns = {
        "batch": re.compile(r"batch\.([0-9a-f]{32})"),
        "allocating": re.compile(r"\.allocating\.([0-9a-f]{32})"),
        "retiring": re.compile(r"\.retiring\.([0-9a-f]{32})"),
    }
    seen_tokens: set[str] = set()
    owner_name = ".sender-staging-owner.json"
    for entry in SENDER_STAGING_ROOT.iterdir():
        kind = ""
        match: re.Match[str] | None = None
        for candidate_kind, pattern in patterns.items():
            candidate = pattern.fullmatch(entry.name)
            if candidate is not None:
                kind, match = candidate_kind, candidate
                break
        if match is None:
            fail(f"unknown sender staging entry: {entry.name}")
        token = match.group(1)
        if token in seen_tokens:
            fail(f"ambiguous sender staging token: {token}")
        seen_tokens.add(token)
        validate_root_owned_tree(entry, device=root_metadata.st_dev)
        entries = list(entry.iterdir())
        if kind == "allocating" and any(item.name != owner_name for item in entries):
            fail(f"unsafe allocating sender staging prefix: {entry.name}")
        owner = entry / owner_name
        owner_metadata = lstat_or_none(owner)
        if owner_metadata is None:
            if kind == "batch" or (kind == "allocating" and entries):
                fail(f"sender staging owner is missing: {entry.name}")
            continue
        if owner_metadata.st_size > 96:
            fail(f"sender staging owner is oversized: {entry.name}")
        owner_payload, _ = read_regular(
            owner, 0o600, device=root_metadata.st_dev
        )
        expected = canonical_json({"token": token, "version": 1})
        if (
            (kind == "batch" and owner_payload != expected)
            or (
                kind in {"allocating", "retiring"}
                and not expected.startswith(owner_payload)
            )
        ):
            fail(f"sender staging owner is invalid: {entry.name}")


def validate_incoming_inventory() -> None:
    root_metadata = validate_directory(SYNC_ROOT, 0o700)
    incoming_metadata = validate_sync_subdirectory(INCOMING_ROOT)
    for entry in INCOMING_ROOT.iterdir():
        if re.fullmatch(r"batch\.[A-Za-z0-9]+", entry.name) is None:
            fail(f"unknown incoming claim: {entry.name}")
        validate_root_owned_tree(entry, device=incoming_metadata.st_dev)
    if incoming_metadata.st_dev != root_metadata.st_dev:
        fail("incoming claims cross a filesystem boundary")


def read_generation_record(path: Path, *, device: int) -> int:
    payload, _ = read_regular(path, 0o600, device=device)
    match = re.fullmatch(rb"([1-9][0-9]{0,18})\n", payload)
    if match is None:
        fail(f"generation record is not canonical: {path}")
    generation = int(match.group(1))
    if not BOOTSTRAP_GENERATION <= generation < 2**63:
        fail(f"generation record is outside the deployed lineage: {path}")
    return generation


def validate_retained_media_tree(path: Path, *, device: int) -> None:
    metadata = path.lstat()
    if (
        path.resolve(strict=True) != path
        or not stat.S_ISDIR(metadata.st_mode)
        or (metadata.st_uid, metadata.st_gid) != (WEB_UID, WEB_GID)
        or stat.S_IMODE(metadata.st_mode) != 0o755
        or metadata.st_dev != device
    ):
        fail(f"unsafe retained media root: {path}")
    file_count = directory_count = total_bytes = 0
    for _directory, directory_names, file_names, directory_fd in os.fwalk(
        path, topdown=True, follow_symlinks=False
    ):
        current = os.fstat(directory_fd)
        if (
            not stat.S_ISDIR(current.st_mode)
            or (current.st_uid, current.st_gid) != (WEB_UID, WEB_GID)
            or stat.S_IMODE(current.st_mode) != 0o755
            or current.st_dev != device
        ):
            fail(f"unsafe retained media directory: {path}")
        directory_count += 1
        if directory_count > MAX_MEDIA_DIRECTORIES:
            fail("retained media directory limit exceeded")
        for name in directory_names:
            child = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            if (
                not stat.S_ISDIR(child.st_mode)
                or (child.st_uid, child.st_gid) != (WEB_UID, WEB_GID)
                or stat.S_IMODE(child.st_mode) != 0o755
                or child.st_dev != device
            ):
                fail(f"unsafe retained media child directory: {path}")
        for name in file_names:
            child = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            lowered = name.lower()
            if (
                not stat.S_ISREG(child.st_mode)
                or (child.st_uid, child.st_gid) != (WEB_UID, WEB_GID)
                or stat.S_IMODE(child.st_mode) != 0o644
                or child.st_nlink != 1
                or child.st_dev != device
                or child.st_size > MAX_MEDIA_FILE_BYTES
                or (child.st_size > 0 and child.st_blocks * 512 < child.st_size)
                or lowered in FORBIDDEN_MEDIA_NAMES
                or ".php" in lowered
                or ".phtml" in lowered
                or ".phar" in lowered
                or any(lowered.endswith(suffix) for suffix in FORBIDDEN_MEDIA_SUFFIXES)
            ):
                fail(f"unsafe retained media file: {path}")
            file_count += 1
            total_bytes += child.st_size
            if file_count > MAX_MEDIA_FILES or total_bytes > MAX_MEDIA_TREE_BYTES:
                fail("retained media tree limit exceeded")


def validate_stable_uploads_release_inventory(active_generation: int) -> None:
    release_metadata = validate_sync_subdirectory(UPLOADS_RELEASE_ROOT)
    entries = list(UPLOADS_RELEASE_ROOT.iterdir())
    if len(entries) > 1:
        fail("too many retained media trees")
    if not entries:
        return
    match = re.fullmatch(
        r"previous-generation-([1-9][0-9]{0,18})-for-([1-9][0-9]{0,18})",
        entries[0].name,
    )
    if match is None:
        fail("unexpected stable uploads release entry")
    previous = int(match.group(1))
    target = int(match.group(2))
    if not BOOTSTRAP_GENERATION <= previous < target == active_generation < 2**63:
        fail("retained media generation relationship mismatch")
    validate_retained_media_tree(entries[0], device=release_metadata.st_dev)


def validate_sync_root_inventory(node: str, *, complete: bool) -> None:
    root_metadata = lstat_or_none(SYNC_ROOT)
    if root_metadata is None:
        if node == "primary" or complete:
            fail(f"{node} sync root is missing")
        return
    checked_root = validate_directory(SYNC_ROOT, 0o700)
    names = {entry.name for entry in SYNC_ROOT.iterdir()}
    if node == "primary":
        fixed = {
            "site-operation.lock", "highest-issued-generation", "sender-staging",
            "pending-receipt-v5.json", "last-resolution-v5.json",
        }
        unknown = {
            name for name in names
            if name not in fixed
            and re.fullmatch(r"\.highest-issued\.[0-9a-f]{32}", name) is None
            and re.fullmatch(
                r"\.(?:pending-receipt-v5|last-resolution-v5)\.[0-9a-f]{32}",
                name,
            ) is None
            and re.fullmatch(
                r"\.clearing-pending-receipt-v5\.[0-9a-f]{32}", name
            ) is None
        }
        if unknown:
            fail("unknown primary sync-root inventory: " + ",".join(sorted(unknown)))
        issued_generation = validate_primary_generation_state()
        validate_primary_receipt_inventory(issued_generation)
        if "sender-staging" in names:
            validate_sender_staging_inventory()
        elif complete:
            fail("primary sender staging is missing")
    else:
        fixed = {"site-operation.lock", "incoming", "state", "uploads-releases"}
        unknown = names - fixed
        if unknown:
            fail("unknown standby sync-root inventory: " + ",".join(sorted(unknown)))
        if "incoming" in names:
            validate_incoming_inventory()
            if complete and any(INCOMING_ROOT.iterdir()):
                fail("standby incoming claims were not recovered")
        if "state" in names:
            validate_sync_subdirectory(STATE_ROOT)
            receiver_temporaries = validate_receiver_state_inventory()
            if complete and receiver_temporaries:
                fail("standby receiver temporaries were not recovered")
        if "uploads-releases" in names:
            validate_sync_subdirectory(UPLOADS_RELEASE_ROOT)
            if any(UPLOADS_RELEASE_ROOT.iterdir()):
                state_device = validate_sync_subdirectory(STATE_ROOT).st_dev
                active_generation = read_generation_record(
                    ACTIVE_UPLOADS_GENERATION, device=state_device
                )
                validate_stable_uploads_release_inventory(active_generation)
        if complete and not fixed.issubset(names):
            fail("standby sync-root inventory is incomplete")
    if "site-operation.lock" in names:
        validate_operation_lock_path()
    elif complete:
        fail(f"{node} site-operation lock is missing")
    if checked_root.st_dev < 1:
        fail("sync-root device identity is invalid")


def ensure_release_frozen() -> None:
    for label, digest in (
        ("receiver", RECEIVER_SHA256),
        ("sender", SENDER_SHA256),
        ("FPM guard", FPM_GUARD_SHA256),
        ("SSH forced-command gate", SSH_GATE_SHA256),
        ("sudoers transport", SUDOERS_SHA256),
        ("full verifier", FULL_VERIFY_SHA256),
        ("source verifier", SOURCE_VERIFY_SHA256),
        ("known-hosts", KNOWN_HOSTS_SHA256),
        ("preflight service", PREFLIGHT_SERVICE_SHA256),
        ("sync service", SYNC_SERVICE_SHA256),
        ("generation 7 reconciliation service", RECONCILE_SERVICE_SHA256),
        ("role verifier", ROLE_VERIFY_SHA256),
    ):
        if len(digest) != 64 or any(character not in "0123456789abcdef" for character in digest):
            raise ReleaseBlocked(f"BLOCKED: {label} SHA-256 is not frozen")
    if ACTIVE_RELEASE_CONTRACT != "shuzijun-active-release-v4-bootstrap-root-live-inode":
        raise ReleaseBlocked("BLOCKED: active-release-v4 contract is not frozen")


