def read_regular(path: Path, mode: int, expected_digest: str | None = None, *, device: int | None = None) -> tuple[bytes, os.stat_result]:
    before_path = path.lstat()
    # Reject FIFOs, devices, sockets and links before open(2).  O_NOFOLLOW only
    # protects the symlink case; opening an attacker-supplied FIFO read-only
    # could otherwise block the deployer before its bounded command runner is
    # involved.
    if (not stat.S_ISREG(before_path.st_mode)
            or (before_path.st_uid, before_path.st_gid) != (ROOT_UID, ROOT_GID)
            or stat.S_IMODE(before_path.st_mode) != mode
            or before_path.st_nlink != 1
            or (device is not None and before_path.st_dev != device)):
        fail(f"unsafe regular file metadata: {path}")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        before_fd = os.fstat(descriptor)
        if (not stat.S_ISREG(before_fd.st_mode)
                or (before_fd.st_uid, before_fd.st_gid) != (ROOT_UID, ROOT_GID)
                or stat.S_IMODE(before_fd.st_mode) != mode
                or before_fd.st_nlink != 1
                or (device is not None and before_fd.st_dev != device)
                or (before_path.st_dev, before_path.st_ino) != (before_fd.st_dev, before_fd.st_ino)):
            fail(f"unsafe regular file metadata: {path}")
        digest = hashlib.sha256()
        chunks: list[bytes] = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            chunks.append(chunk)
        after_fd = os.fstat(descriptor)
        after_path = path.lstat()
        identity_before = (before_fd.st_dev, before_fd.st_ino, before_fd.st_size, before_fd.st_mtime_ns, before_fd.st_ctime_ns)
        identity_after = (after_fd.st_dev, after_fd.st_ino, after_fd.st_size, after_fd.st_mtime_ns, after_fd.st_ctime_ns)
        if identity_before != identity_after or (after_path.st_dev, after_path.st_ino) != (after_fd.st_dev, after_fd.st_ino):
            fail(f"file changed while it was read: {path}")
        actual_digest = digest.hexdigest()
        if expected_digest is not None and actual_digest != expected_digest:
            fail(f"SHA-256 mismatch: {path}")
        return b"".join(chunks), after_fd
    finally:
        os.close(descriptor)


