write_backup_manifest() {
    local relative scan_complete=0
    BACKUP_MANIFEST="$BACKUP_DIR/$MANIFEST_NAME"
    (
        cd "$BACKUP_DIR"
        while IFS= read -r -d '' relative; do
            if [[ -z "$relative" ]]; then
                scan_complete=1
                continue
            fi
            sha256sum "$relative"
        done < <(find shuzijun-app-content.php composer.json composer.lock vendor \
            -xdev -type f -print0 | sort -z && printf '\0')
        [[ "$scan_complete" -eq 1 ]] || fail 'backup file scan did not complete'
    ) > "$BACKUP_MANIFEST"
    chmod 600 "$BACKUP_MANIFEST"
}

create_code_backup() {
    local stamp
    validate_current_release_unit
    [[ -d "$BACKUP_ROOT" && ! -L "$BACKUP_ROOT" \
        && "$(realpath -e -- "$BACKUP_ROOT")" == "$BACKUP_ROOT" \
        && "$(stat -c '%u' "$BACKUP_ROOT")" == 0 ]] \
        || fail 'backup root is unsafe'
    reject_find_match 'backup root is writable by a non-root identity' \
        "$BACKUP_ROOT" -maxdepth 0 -perm /022

    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    BACKUP_DIR="$BACKUP_ROOT/${stamp}-${EXPECTED_MANIFEST_SHA256:0:12}-$$"
    mkdir -m 0700 "$BACKUP_DIR"
    [[ "$(realpath -e -- "$BACKUP_DIR")" == "$BACKUP_DIR" \
        && "${BACKUP_DIR#$BACKUP_ROOT/}" != */* \
        && "$(stat -c '%u' "$BACKUP_DIR")" == 0 ]] \
        || fail 'new backup directory boundary is unsafe'
    cp -a -- "$TARGET_DIR/shuzijun-app-content.php" "$BACKUP_DIR/"
    cp -a -- "$TARGET_DIR/composer.json" "$BACKUP_DIR/"
    cp -a -- "$TARGET_DIR/composer.lock" "$BACKUP_DIR/"
    cp -a -- "$TARGET_DIR/vendor" "$BACKUP_DIR/"
    write_backup_manifest
    # The persistent FPM boot guard can intentionally leave the node offline
    # after power loss. Make the rollback unit durable before arming rollback
    # or performing the first live-code mutation.
    sync -f "$BACKUP_DIR"
    sync -f "$BACKUP_ROOT"
    (
        cd "$BACKUP_DIR"
        sha256sum --strict --quiet --check "$BACKUP_MANIFEST"
    ) >/dev/null
    ROLLBACK_READY=1
}

remove_live_vendor() {
