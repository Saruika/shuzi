    LC_ALL=C tail -c 1 -- "$LIVE_MANIFEST" | grep -qx '' \
        || { fail 'live release manifest must be nonempty and end with one newline'; return 1; }

    while IFS= read -r line; do
        [[ "$line" =~ ^([a-f0-9]{64})\ \ ([A-Za-z0-9._/-]+)$ ]] \
            || { fail 'live release manifest has an invalid record'; return 1; }
        digest=${BASH_REMATCH[1]}
        relative=${BASH_REMATCH[2]}
        validate_relative_path "$relative" || return 1
        [[ -z "$previous_relative" || "$relative" > "$previous_relative" ]] \
            || { fail 'live release manifest paths must be unique and bytewise sorted'; return 1; }
        [[ -z "${manifest_paths[$relative]+present}" ]] \
            || { fail 'live release manifest contains a duplicate path'; return 1; }
        manifest_paths["$relative"]=$digest
        previous_relative=$relative
    done < "$LIVE_MANIFEST"

    for relative in shuzijun-app-content.php composer.json composer.lock vendor/autoload.php; do
        [[ -n "${manifest_paths[$relative]+present}" ]] \
            || { fail 'live release manifest omits a required file'; return 1; }
    done
    while IFS= read -r -d '' file; do
        if [[ -z "$file" ]]; then
            scan_complete=1
            continue
        fi
        relative=${file#"$TARGET_DIR/"}
        actual_file_count=$((actual_file_count + 1))
        [[ -n "${manifest_paths[$relative]+present}" ]] \
            || { fail 'live release manifest does not allow every release file'; return 1; }
    done < <(find "${release_paths[@]}" -type f -print0 && printf '\0')
    [[ "$scan_complete" -eq 1 ]] \
        || { fail 'live release file scan did not complete'; return 1; }
    [[ "$actual_file_count" -eq "${#manifest_paths[@]}" ]] \
        || { fail 'live release manifest contains a missing or extra file'; return 1; }
    (
        cd "$TARGET_DIR"
        sha256sum --strict --quiet --check "$LIVE_MANIFEST"
    ) >/dev/null || { fail 'live release files do not match the reviewed manifest'; return 1; }
}

validate_unmanifested_legacy_bridge() {
    local actual_php_sha line relative file
    local support_manifest_count=0 actual_support_file_count=0 scan_complete=0
    local -a support_paths=(
        "$TARGET_DIR/composer.json"
        "$TARGET_DIR/composer.lock"
        "$TARGET_DIR/vendor"
    )

    [[ "$AUTHORITY_ROLE" == authority ]] \
        || { fail 'a missing live manifest is allowed only on the authority bootstrap transition'; return 1; }
    [[ "$EXPECTED_MANIFEST_SHA256" == "$LEGACY_BRIDGE_MANIFEST_SHA256" ]] \
        || { fail 'a missing live manifest is allowed only for the reviewed 1.5.8 transition'; return 1; }
    actual_php_sha=$(sha256sum -- "$TARGET_DIR/shuzijun-app-content.php")
    actual_php_sha=${actual_php_sha%% *}
    [[ "$actual_php_sha" == "$LEGACY_PRE_MANIFEST_PHP_SHA256" ]] \
        || { fail 'unmanifested live PHP is not the reviewed 1.5.7 transition'; return 1; }
    grep -qxF ' * Version: 1.5.7' "$TARGET_DIR/shuzijun-app-content.php" \
        || { fail 'unmanifested live PHP does not declare version 1.5.7'; return 1; }

    while IFS= read -r line; do
        relative=${line#*  }
        [[ "$relative" == shuzijun-app-content.php ]] && continue
        support_manifest_count=$((support_manifest_count + 1))
    done < "$MANIFEST"
    while IFS= read -r -d '' file; do
        if [[ -z "$file" ]]; then
            scan_complete=1
            continue
        fi
        actual_support_file_count=$((actual_support_file_count + 1))
    done < <(find "${support_paths[@]}" -type f -print0 && printf '\0')
    [[ "$scan_complete" -eq 1 ]] \
        || { fail 'unmanifested release support scan did not complete'; return 1; }
    [[ "$actual_support_file_count" -eq "$support_manifest_count" ]] \
        || { fail 'unmanifested release support differs from the reviewed 1.5.8 unit'; return 1; }
    (
        cd "$TARGET_DIR"
        while IFS= read -r line; do
            [[ "${line#*  }" == shuzijun-app-content.php ]] && continue
            printf '%s\n' "$line"
        done < "$MANIFEST" | sha256sum --strict --quiet --check -
    ) >/dev/null \
        || { fail 'unmanifested release support does not match the reviewed 1.5.8 manifest'; return 1; }
}

validate_current_release_unit() {
    local entry target_device scan_complete=0
    local -a release_paths=(
        "$TARGET_DIR/shuzijun-app-content.php"
        "$TARGET_DIR/composer.json"
        "$TARGET_DIR/composer.lock"
        "$TARGET_DIR/vendor"
    )

    validate_target_boundary || return 1
    reject_find_match 'a stale live manifest staging entry requires manual inspection' \
        "$TARGET_DIR" -mindepth 1 -maxdepth 1 \
        -name '.shuzijun-release-manifest-*' || return 1
    if ! [[ -f "${release_paths[0]}" && ! -L "${release_paths[0]}" \
        && -f "${release_paths[1]}" && ! -L "${release_paths[1]}" \
        && -f "${release_paths[2]}" && ! -L "${release_paths[2]}" \
        && -d "${release_paths[3]}" && ! -L "${release_paths[3]}" ]]; then
        fail 'current release unit is incomplete or unsafe'
        return 1
    fi
    reject_find_match 'current release unit contains a symbolic link' \
        "${release_paths[@]}" -type l || return 1
    reject_find_match 'current release unit contains a non-regular entry' \
        "${release_paths[@]}" ! -type d ! -type f || return 1
    reject_find_match 'current release unit contains a hard-linked file' \
        "${release_paths[@]}" -type f -links +1 || return 1
    reject_find_match 'current release unit has unsafe ownership or write access' \
        "${release_paths[@]}" \( ! -uid 0 -o -perm /022 \) || return 1

    target_device=$(stat -c '%d' "$TARGET_DIR")
    while IFS= read -r -d '' entry; do
        if [[ -z "$entry" ]]; then
            scan_complete=1
            continue
        fi
        if [[ "$(stat -c '%d' "$entry")" != "$target_device" ]]; then
            fail 'current release unit crosses a filesystem boundary'
            return 1
        fi
    done < <(find "${release_paths[@]}" -print0 && printf '\0')
    if [[ "$scan_complete" -ne 1 ]]; then
        fail 'current release unit scan did not complete'
        return 1
    fi
    if [[ -e "$LIVE_MANIFEST" || -L "$LIVE_MANIFEST" ]]; then
        validate_live_manifested_release || return 1
    else
        validate_unmanifested_legacy_bridge || return 1
    fi
    return 0
}

