probe_offline_wordpress_api() {
    local expected_role=$1
    [[ "$expected_role" == authority || "$expected_role" == standby ]] \
        || { fail 'offline WordPress probe received an invalid authority role'; return 1; }
    # FPM remains stopped and persistently guarded. Loading the actual
    # WordPress tree as www-data proves both marker readability and the newly
    # installed plugin's REST gate before any production worker can serve it.
    timeout --signal=KILL 45s runuser -u www-data -- env -i \
        PATH="$PATH" LC_ALL=C LANG=C HOME=/nonexistent \
        "$PHP_BIN" -d display_errors=0 -d log_errors=0 -r '
        $site = $argv[1];
        $role = $argv[2];
        $_SERVER["REQUEST_METHOD"] = "GET";
        $_SERVER["HTTP_HOST"] = "www.shuzijun.com.cn";
        $_SERVER["SERVER_NAME"] = "www.shuzijun.com.cn";
        $_SERVER["SERVER_PORT"] = "443";
        $_SERVER["HTTPS"] = "on";
        $_SERVER["REQUEST_URI"] = "/?rest_route=%2Fshuzijun%2Fv1%2Fapp-content";
        define("REST_REQUEST", true);
        define("WP_USE_THEMES", false);
        require $site . "/wp-load.php";
        $server = rest_get_server();
        if (!did_action("rest_api_init")) {
            do_action("rest_api_init", $server);
        }
        $request = new WP_REST_Request("GET", "/shuzijun/v1/app-content");
        $response = rest_do_request($request);
        if (is_wp_error($response)) {
            $response = rest_convert_error_to_response($response);
        }
        if (!$response instanceof WP_REST_Response) { exit(11); }
        $data = $response->get_data();
        $expected = $role === "authority"
            ? array(401, "fan_session_required")
            : array(503, "yishu_account_authority_unavailable");
        $actual = array(
            (int) $response->get_status(),
            is_array($data) ? (string) ($data["code"] ?? "") : "",
        );
        exit($actual === $expected ? 0 : 12);
    ' "$SITE" "$expected_role"
}

