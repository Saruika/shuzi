#!/bin/bash
set -Eeuo pipefail
umask 077

# A root deployment must not inherit command lookup, locale, proxy or Composer
# authentication settings from the invoking shell.  Individual networked
# commands below receive only the environment they actually need.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
IFS=$' \t\n'
LC_ALL=C
LANG=C
export PATH LC_ALL LANG
unset CDPATH ENV http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy \
    NO_PROXY no_proxy COMPOSER_AUTH GITHUB_TOKEN GITLAB_TOKEN || true

readonly SITE=/var/www/html/shuzijun.com.cn
readonly TARGET_DIR="$SITE/wp-content/mu-plugins"
readonly STAGING_ROOT=/var/lib/shuzijun-app-content/releases
readonly BACKUP_ROOT=/var/backups/shuzijun-app-content
# flock(2) works on the already-existing staging directory descriptor.  This
# coordinates apply and dry-run without creating or opening a lock file for
# writing, so dry-run has no persistent filesystem mutation.
readonly LOCK_PATH="$STAGING_ROOT"
readonly AUTHORITY_LOCK_PATH="$SITE"
readonly VERIFY=/usr/local/sbin/verify-shuzijun-webroot-security
readonly VERIFY_SHA256=5c2f109000ae721cae772416a4c5c58fa579078f229443e8691c7be6cb7576cd
readonly AUTHORITY_VERIFY=/usr/local/sbin/verify-shuzijun-account-authority-role
readonly AUTHORITY_VERIFY_SHA256=5fe67111642c53895e16afd0a9d6a341af881c3711736f9fe40a34b830e20a58
readonly FPM_SERVICE=php8.3-fpm
readonly HEALTH_HOST=www.shuzijun.com.cn
# The query-form REST route deliberately misses the backup node's pretty-URL
# proxy location and therefore exercises that node's local WordPress/plugin.
readonly HEALTH_URL="https://$HEALTH_HOST/?rest_route=%2Fshuzijun%2Fv1%2Fapp-content"
readonly HEALTH_INDEX_URL="https://$HEALTH_HOST/index.php?rest_route=%2Fshuzijun%2Fv1%2Fapp-content"
readonly DIRECT_PHP_URL="https://$HEALTH_HOST/wp-content/mu-plugins/shuzijun-app-content.php"
readonly DIRECT_VENDOR_PHP_URL="https://$HEALTH_HOST/wp-content/mu-plugins/vendor/autoload.php"
readonly MANIFEST_NAME=release.sha256
readonly JWT_README=vendor/firebase/php-jwt/README.md
readonly JWT_README_SHA256=8e2392c48204a21ad0d73068fb273b7ec1f79ccf13eab3fe6f256382f741dc39
readonly LEGACY_BRIDGE_PHP_SHA256=c109713a02e469bd716767dfd14894c055aeaa68faed473481c119251789d7c0
readonly TARGET_RELEASE_PHP_SHA256=90d50b197ad39e2efb45d2e394f6926c0c1f01d501ef95e4a21de18bd8581fa3
readonly COLLABORATION_FUSE_PROBE_SENTINEL=shuzijun-collaboration-fuse-probe-complete-v1

MODE=dry-run
BUNDLE_INPUT=
EXPECTED_MANIFEST_SHA256=
AUTHORITY_ROLE=
BUNDLE=
MANIFEST=
PHP_BIN=
COMPOSER_BIN=
BACKUP_DIR=
BACKUP_MANIFEST=
ROLLBACK_READY=0
CODE_MUTATED=0
FPM_WAS_ACTIVE=0
FPM_BOOT_GUARD_ACTIVE=0
MODE_SEEN=0
BUNDLE_SEEN=0
MANIFEST_SHA_SEEN=0
AUTHORITY_ROLE_SEEN=0

usage() {
    cat <<'EOF'
Usage:
  deploy-app-content-release --bundle ABSOLUTE_PATH \
      --manifest-sha256 SHA256 --authority-role authority|standby \
      [--dry-run|--apply]
  deploy-app-content-release --bundle ABSOLUTE_PATH \
      --manifest-sha256 SHA256 --bundle-preflight

The default mode is --dry-run. --bundle-preflight performs only the immutable
bundle, manifest, isolated collaboration-fuse, PHP, Composer and dependency
checks; it does not inspect the currently installed release unit, issue
production-origin health probes, create a backup, stop a service or write the
webroot. The candidate fuse probe runs before Composer security audit may use
its configured public advisory source. The bundle must be a canonical,
root-owned directory immediately below /var/lib/shuzijun-app-content/releases
and contain only these release entries plus release.sha256:
  shuzijun-app-content.php
  composer.json
  composer.lock
  vendor/
EOF
}

fail() {
    printf 'app-content-release: %s\n' "$1" >&2
    return 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command unavailable: $1"
}

# `find ... | grep` cannot distinguish "no match" from a failed filesystem
# scan.  The final empty NUL record is emitted only after a successful find,
# so every security rejection also fails closed on I/O/traversal errors.
reject_find_match() {
    local failure_message=$1
    local entry found=0 scan_complete=0
    shift

    while IFS= read -r -d '' entry; do
        if [[ -z "$entry" ]]; then
            scan_complete=1
        else
            found=1
        fi
    done < <(find "$@" -print0 -quit && printf '\0')

    if [[ "$scan_complete" -ne 1 ]]; then
        fail 'filesystem safety scan did not complete'
        return 1
    fi
    if [[ "$found" -ne 0 ]]; then
        fail "$failure_message"
        return 1
    fi
    return 0
}

is_outside_site() {
    local candidate=$1
    [[ "$candidate" != "$SITE" && "$candidate" != "$SITE/"* ]]
}

validate_staging_lock_path() {
    [[ "$(realpath -e -- "$STAGING_ROOT")" == "$STAGING_ROOT" \
        && -d "$STAGING_ROOT" && ! -L "$STAGING_ROOT" ]] \
        || fail 'staging root is not a canonical directory'
    [[ "$(stat -c '%u' "$STAGING_ROOT")" == 0 ]] \
        || fail 'staging root must be owned by root'
    reject_find_match 'staging root is writable by a non-root identity' \
        "$STAGING_ROOT" -maxdepth 0 -perm /022
}

validate_fixed_paths() {
    local site_real target_real staging_real backup_real
    site_real=$(realpath -e -- "$SITE")
    target_real=$(realpath -e -- "$TARGET_DIR")
    staging_real=$(realpath -e -- "$STAGING_ROOT")
    backup_real=$(realpath -e -- "$BACKUP_ROOT")

    [[ "$site_real" == "$SITE" ]] || fail 'site path is not canonical'
    [[ "$target_real" == "$TARGET_DIR" ]] || fail 'target path is not canonical'
    [[ "$staging_real" == "$STAGING_ROOT" ]] || fail 'staging root is not canonical'
    [[ "$backup_real" == "$BACKUP_ROOT" ]] || fail 'backup root is not canonical'
    [[ ! -L "$SITE" && ! -L "$TARGET_DIR" && ! -L "$STAGING_ROOT" \
        && -d "$BACKUP_ROOT" && ! -L "$BACKUP_ROOT" ]] \
        || fail 'fixed release path must not be a symbolic link'
    is_outside_site "$STAGING_ROOT" || fail 'staging root must be outside the webroot'
    is_outside_site "$BACKUP_ROOT" || fail 'backup root must be outside the webroot'
    [[ "$(stat -c '%u' "$SITE")" == 0 \
        && "$(stat -c '%u' "$TARGET_DIR")" == 0 \
        && "$(stat -c '%u' "$STAGING_ROOT")" == 0 \
        && "$(stat -c '%u' "$BACKUP_ROOT")" == 0 ]] \
        || fail 'fixed release paths must be owned by root'
    reject_find_match 'staging root is writable by a non-root identity' \
        "$STAGING_ROOT" -maxdepth 0 -perm /022
    reject_find_match 'backup root is writable by a non-root identity' \
        "$BACKUP_ROOT" -maxdepth 0 -perm /022
    [[ "$(realpath -e -- /var/backups)" == /var/backups && ! -L /var/backups ]] \
        || fail 'backup parent is unsafe'
    [[ "$(stat -c '%u' /var/backups)" == 0 ]] || fail 'backup parent must be owned by root'
    reject_find_match 'backup parent is writable by a non-root identity' \
        /var/backups -maxdepth 0 -perm /022
}

validate_authority_verifier() {
    local verifier_parent verifier_sha256 verifier_fd_path=/proc/self/fd/7
    [[ "$AUTHORITY_VERIFY" == /usr/local/sbin/verify-shuzijun-account-authority-role \
        && -f "$AUTHORITY_VERIFY" && -x "$AUTHORITY_VERIFY" \
        && ! -L "$AUTHORITY_VERIFY" \
        && "$(realpath -e -- "$AUTHORITY_VERIFY")" == "$AUTHORITY_VERIFY" \
        && "$(stat -c '%u' "$AUTHORITY_VERIFY")" == 0 \
        && "$(stat -c '%h' "$AUTHORITY_VERIFY")" == 1 ]] \
        || { fail 'account-authority verifier is missing or unsafe'; return 1; }
    for verifier_parent in /usr /usr/local /usr/local/sbin; do
        [[ "$(realpath -e -- "$verifier_parent")" == "$verifier_parent" \
            && -d "$verifier_parent" && ! -L "$verifier_parent" \
            && "$(stat -c '%u' "$verifier_parent")" == 0 ]] \
            || { fail 'account-authority verifier parent is unsafe'; return 1; }
        reject_find_match 'account-authority verifier parent is writable by a non-root identity' \
            "$verifier_parent" -maxdepth 0 -perm /022 || return 1
    done
    reject_find_match 'account-authority verifier is writable by a non-root identity' \
        "$AUTHORITY_VERIFY" -maxdepth 0 -perm /022 || return 1
    exec 7<"$AUTHORITY_VERIFY" \
        || { fail 'account-authority verifier cannot be opened'; return 1; }
    [[ -f "$verifier_fd_path" \
        && "$(stat -Lc '%u:%g:%h:%a' "$verifier_fd_path")" == '0:0:1:755' ]] \
        || { fail 'opened account-authority verifier metadata is unsafe'; exec 7<&-; return 1; }
    verifier_sha256=$(sha256sum "$verifier_fd_path" | awk '{ print $1 }') \
        || { exec 7<&-; return 1; }
    [[ "$verifier_sha256" == "$AUTHORITY_VERIFY_SHA256" ]] \
        || { fail 'account-authority verifier does not match the reviewed release'; exec 7<&-; return 1; }
}

validate_webroot_verifier() {
    local verifier_parent verifier_sha256 verifier_fd_path=/proc/self/fd/6
    [[ "$VERIFY" == /usr/local/sbin/verify-shuzijun-webroot-security \
        && -f "$VERIFY" && -x "$VERIFY" && ! -L "$VERIFY" \
        && "$(realpath -e -- "$VERIFY")" == "$VERIFY" \
        && "$(stat -c '%u:%g:%h:%a' "$VERIFY")" == '0:0:1:755' ]] \
        || { fail 'webroot verifier is missing or unsafe'; return 1; }
    for verifier_parent in /usr /usr/local /usr/local/sbin; do
        [[ -d "$verifier_parent" && ! -L "$verifier_parent" \
            && "$(realpath -e -- "$verifier_parent")" == "$verifier_parent" \
            && "$(stat -c '%u:%g' "$verifier_parent")" == '0:0' ]] \
            || { fail 'webroot verifier parent is unsafe'; return 1; }
        reject_find_match 'webroot verifier parent is writable by a non-root identity' \
            "$verifier_parent" -maxdepth 0 -perm /022 || return 1
    done
    reject_find_match 'webroot verifier is writable by a non-root identity' \
        "$VERIFY" -maxdepth 0 -perm /022 || return 1
    exec 6<"$VERIFY" || { fail 'webroot verifier cannot be opened'; return 1; }
    [[ -f "$verifier_fd_path" \
        && "$(stat -Lc '%u:%g:%h:%a' "$verifier_fd_path")" == '0:0:1:755' ]] \
        || { exec 6<&-; fail 'opened webroot verifier metadata is unsafe'; return 1; }
    verifier_sha256=$(sha256sum "$verifier_fd_path" | awk '{ print $1 }') \
        || { exec 6<&-; return 1; }
    [[ "$verifier_sha256" == "$VERIFY_SHA256" ]] \
        || { exec 6<&-; fail 'webroot verifier does not match the reviewed release'; return 1; }
}

run_webroot_verifier() {
    local verifier_status=0
    validate_webroot_verifier || return 1
    env -i PATH="$PATH" LC_ALL=C LANG=C \
        /bin/bash /proc/self/fd/6 "$SITE" || verifier_status=$?
    exec 6<&-
    return "$verifier_status"
}

validate_authority_lock_path() {
    [[ "$AUTHORITY_LOCK_PATH" == /var/www/html/shuzijun.com.cn \
        && -d "$AUTHORITY_LOCK_PATH" && ! -L "$AUTHORITY_LOCK_PATH" \
        && "$(realpath -e -- "$AUTHORITY_LOCK_PATH")" == "$AUTHORITY_LOCK_PATH" \
        && "$(stat -c '%u' "$AUTHORITY_LOCK_PATH")" == 0 ]] \
        || { fail 'account-authority lock path is unsafe'; return 1; }
    reject_find_match 'account-authority lock path is writable by a non-root identity' \
        "$AUTHORITY_LOCK_PATH" -maxdepth 0 -perm /022 || return 1
}

verify_authority_role() {
    local verifier_status=0
    validate_authority_verifier || return 1
    if ! env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/7 "$AUTHORITY_ROLE"; then
        verifier_status=1
    fi
    exec 7<&-
    return "$verifier_status"
}

validate_bundle_path() {
    [[ "$BUNDLE_INPUT" == /* ]] || fail 'bundle path must be absolute'
    [[ "$BUNDLE_INPUT" != *'//'*
        && "$BUNDLE_INPUT" != *'/./'*
        && "$BUNDLE_INPUT" != */.
        && "$BUNDLE_INPUT" != *'/../'*
        && "$BUNDLE_INPUT" != */.. ]] || fail 'bundle path is not canonical'

    BUNDLE=$(realpath -e -- "$BUNDLE_INPUT")
    [[ "$BUNDLE" == "$BUNDLE_INPUT" ]] || fail 'bundle path must not traverse or resolve links'
    [[ "$BUNDLE" == "$STAGING_ROOT/"* ]] || fail 'bundle is outside the fixed staging root'
    [[ "${BUNDLE#$STAGING_ROOT/}" != */* ]] \
        || fail 'bundle must be an immediate child of the staging root'
    [[ "${BUNDLE##*/}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] \
        || fail 'bundle directory name is unsafe'
    [[ -d "$BUNDLE" && ! -L "$BUNDLE" ]] || fail 'bundle is not a regular directory'
    [[ "$(stat -c '%u' "$BUNDLE")" == 0 ]] || fail 'bundle must be owned by root'

    MANIFEST="$BUNDLE/$MANIFEST_NAME"
    [[ -f "$MANIFEST" && ! -L "$MANIFEST" ]] || fail 'release manifest is missing or unsafe'
    reject_find_match 'bundle is writable by a non-root identity' \
        "$BUNDLE" \( ! -uid 0 -o -perm /022 \)
    reject_find_match 'bundle contains a symbolic link' "$BUNDLE" -type l
    reject_find_match 'bundle contains a non-regular entry' \
        "$BUNDLE" ! -type d ! -type f
    reject_find_match 'bundle contains a hard-linked file' \
        "$BUNDLE" -type f -links +1
}

validate_relative_path() {
    local relative=$1
    [[ "$relative" =~ ^[A-Za-z0-9._/-]+$ ]] || fail 'manifest contains an unsafe filename'
    [[ "$relative" != /*
        && "$relative" != ./*
        && "$relative" != *'//'*
        && "$relative" != *'/./'*
        && "$relative" != */.
        && "$relative" != ..
        && "$relative" != ../*
        && "$relative" != *'/../'*
        && "$relative" != */.. ]] || fail 'manifest contains path traversal'
    case "$relative" in
        shuzijun-app-content.php|composer.json|composer.lock|vendor/*) ;;
        *) fail 'manifest contains an entry outside the fixed release unit' ;;
    esac
}

validate_bundle_tree() {
    local entry relative bundle_device scan_complete=0
    bundle_device=$(stat -c '%d' "$BUNDLE")
    while IFS= read -r -d '' entry; do
        if [[ -z "$entry" ]]; then
            scan_complete=1
            continue
        fi
        relative=${entry#"$BUNDLE/"}
        [[ "$relative" =~ ^[A-Za-z0-9._/-]+$ ]] || fail 'bundle contains an unsafe filename'
        [[ "$(stat -c '%d' "$entry")" == "$bundle_device" ]] \
            || fail 'bundle crosses a filesystem boundary'
        case "$relative" in
            "$MANIFEST_NAME"|shuzijun-app-content.php|composer.json|composer.lock|vendor|vendor/*) ;;
            *) fail 'bundle contains an entry outside the fixed release unit' ;;
        esac
    done < <(find "$BUNDLE" -mindepth 1 -print0 && printf '\0')
    [[ "$scan_complete" -eq 1 ]] || fail 'bundle tree scan did not complete'

    for entry in shuzijun-app-content.php composer.json composer.lock vendor/autoload.php; do
        [[ -f "$BUNDLE/$entry" && ! -L "$BUNDLE/$entry" ]] \
            || fail 'bundle is missing a required release file'
    done

    reject_find_match 'bundle contains a forbidden secret or database filename' \
        "$BUNDLE" -type f \
        \( -iname '*.p8' -o -iname '*.pem' -o -iname '*.key' \
        -o -iname '*.p12' -o -iname '*.pfx' -o -iname '*.jks' \
        -o -iname '.env*' -o -iname 'auth.json' \
        -o -iname 'credentials*.json' -o -iname 'service-account*.json' \
        -o -iname '*.sql' -o -iname '*.sql.gz' -o -iname '*.dump' \)
    reject_find_match 'bundle contains a mixed-case PHP filename' \
        "$BUNDLE" -type f -iname '*.php' ! -name '*.php'
    reject_find_match 'bundle contains executable backup or editor residue' \
        "$BUNDLE" -type f \
        \( -name '*.php?*' -o -name '*.php.*' -o -name '*.php_*' \
        -o -name '*.php-*' -o -name '*.php~' -o -name '*.bak*' \
        -o -name '*.backup*' -o -name '*.old*' -o -name '*.orig*' \
        -o -name '*.save*' -o -name '*.swp*' -o -name '*.tmp*' \)
}

validate_manifest() {
    local actual_manifest_sha line digest relative previous_relative='' file
    local actual_file_count=0 scan_complete=0
    declare -A manifest_paths=()

    [[ "$EXPECTED_MANIFEST_SHA256" =~ ^[a-f0-9]{64}$ ]] \
        || fail 'expected manifest SHA256 must be 64 lowercase hexadecimal characters'
    LC_ALL=C tail -c 1 -- "$MANIFEST" | grep -qx '' \
        || fail 'release manifest must be nonempty and end with one newline'
    actual_manifest_sha=$(sha256sum -- "$MANIFEST")
    actual_manifest_sha=${actual_manifest_sha%% *}
    [[ "$actual_manifest_sha" == "$EXPECTED_MANIFEST_SHA256" ]] \
        || fail 'release manifest SHA256 does not match the trusted value'

    while IFS= read -r line; do
        [[ "$line" =~ ^([a-f0-9]{64})\ \ ([A-Za-z0-9._/-]+)$ ]] \
            || fail 'release manifest has an invalid record'
        digest=${BASH_REMATCH[1]}
        relative=${BASH_REMATCH[2]}
        validate_relative_path "$relative"
        [[ -z "$previous_relative" || "$relative" > "$previous_relative" ]] \
            || fail 'release manifest paths must be unique and bytewise sorted'
        [[ -z "${manifest_paths[$relative]+present}" ]] \
            || fail 'release manifest contains a duplicate path'
        manifest_paths["$relative"]=$digest
        previous_relative=$relative
    done < "$MANIFEST"

    for relative in shuzijun-app-content.php composer.json composer.lock vendor/autoload.php; do
        [[ -n "${manifest_paths[$relative]+present}" ]] \
            || fail 'release manifest omits a required file'
    done

    while IFS= read -r -d '' file; do
        if [[ -z "$file" ]]; then
            scan_complete=1
            continue
        fi
        relative=${file#"$BUNDLE/"}
        [[ "$relative" == "$MANIFEST_NAME" ]] && continue
        actual_file_count=$((actual_file_count + 1))
        [[ -n "${manifest_paths[$relative]+present}" ]] \
            || fail 'release manifest does not allow every bundle file'
    done < <(find "$BUNDLE" -type f -print0 && printf '\0')
    [[ "$scan_complete" -eq 1 ]] || fail 'bundle file scan did not complete'
    [[ "$actual_file_count" -eq "${#manifest_paths[@]}" ]] \
        || fail 'release manifest contains a missing or extra file'

    (
        cd "$BUNDLE"
        sha256sum --strict --quiet --check "$MANIFEST"
    ) >/dev/null
}

validate_secret_content() {
    local file relative actual_sha grep_status scan_complete=0
    local secret_pattern='AKID[A-Za-z0-9]{20,}|AKIA[A-Z0-9]{16}|-----BEGIN ([A-Z0-9 ]+)?PRIVATE KEY-----|Secret(Key|Id)[[:space:]]*[:=][[:space:]]*[A-Za-z0-9/+_.=-]{16,}'

    while IFS= read -r -d '' file; do
        if [[ -z "$file" ]]; then
            scan_complete=1
            continue
        fi
        relative=${file#"$BUNDLE/"}
        [[ "$relative" == "$MANIFEST_NAME" ]] && continue
        if [[ "$relative" == "$JWT_README" ]]; then
            actual_sha=$(sha256sum -- "$file")
            actual_sha=${actual_sha%% *}
            [[ "$actual_sha" == "$JWT_README_SHA256" ]] \
                || fail 'reviewed upstream JWT documentation hash changed'
            continue
        fi
        if [[ -s "$file" ]]; then
            grep_status=0
            LC_ALL=C grep -I -q '^' "$file" || grep_status=$?
            [[ "$grep_status" -eq 0 ]] \
                || fail 'bundle contains a binary or unreadable release file'
        fi
        grep_status=0
        LC_ALL=C grep -I -q -E "$secret_pattern" "$file" || grep_status=$?
        case "$grep_status" in
            0) fail 'bundle contains content resembling a long-lived credential' ;;
            1) ;;
            *) fail 'credential content scan did not complete' ;;
        esac
    done < <(find "$BUNDLE" -type f -print0 && printf '\0')
    [[ "$scan_complete" -eq 1 ]] || fail 'credential file scan did not complete'
}

resolve_runtime_tools() {
    local candidate candidate_parent binary_parent
    for candidate in /usr/bin/php8.3 /usr/local/bin/php8.3 /usr/bin/php /usr/local/bin/php; do
        if [[ -x "$candidate" ]]; then
            PHP_BIN=$candidate
            break
        fi
    done
    [[ -n "$PHP_BIN" ]] || fail 'PHP 8.3 is unavailable'
    candidate_parent=${PHP_BIN%/*}
    PHP_BIN=$(realpath -e -- "$PHP_BIN")
    binary_parent=${PHP_BIN%/*}
    [[ -f "$PHP_BIN" && ! -L "$PHP_BIN" ]] || fail 'PHP binary path is unsafe'
    for candidate in "$candidate_parent" "$binary_parent"; do
        [[ "$(realpath -e -- "$candidate")" == "$candidate" \
            && "$(stat -c '%u' "$candidate")" == 0 ]] \
            || fail 'PHP binary directory is unsafe'
        reject_find_match 'PHP binary directory is writable by a non-root identity' \
            "$candidate" -maxdepth 0 -perm /022
    done
    "$PHP_BIN" -n -r 'exit(PHP_MAJOR_VERSION === 8 && PHP_MINOR_VERSION === 3 ? 0 : 1);' \
        || fail 'PHP runtime must be version 8.3'

    for candidate in /usr/bin/composer /usr/local/bin/composer; do
        if [[ -x "$candidate" ]]; then
            COMPOSER_BIN=$candidate
            break
        fi
    done
    [[ -n "$COMPOSER_BIN" ]] || fail 'Composer is unavailable'
    candidate_parent=${COMPOSER_BIN%/*}
    COMPOSER_BIN=$(realpath -e -- "$COMPOSER_BIN")
    binary_parent=${COMPOSER_BIN%/*}
    [[ -f "$COMPOSER_BIN" && ! -L "$COMPOSER_BIN" ]] \
        || fail 'Composer binary path is unsafe'
    for candidate in "$candidate_parent" "$binary_parent"; do
        [[ "$(realpath -e -- "$candidate")" == "$candidate" \
            && "$(stat -c '%u' "$candidate")" == 0 ]] \
            || fail 'Composer binary directory is unsafe'
        reject_find_match 'Composer binary directory is writable by a non-root identity' \
            "$candidate" -maxdepth 0 -perm /022
    done
    [[ "$(stat -c '%u' "$PHP_BIN")" == 0 \
        && "$(stat -c '%u' "$COMPOSER_BIN")" == 0 ]] \
        || fail 'runtime tools must be owned by root'
    reject_find_match 'runtime tool is writable by a non-root identity' \
        "$PHP_BIN" "$COMPOSER_BIN" -maxdepth 0 -perm /022
}

run_composer() {
    env -i \
        PATH="$PATH" LC_ALL=C LANG=C HOME=/nonexistent \
        COMPOSER_HOME=/dev/null COMPOSER_CACHE_DIR=/dev/null \
        COMPOSER_ALLOW_SUPERUSER=1 COMPOSER_NO_INTERACTION=1 \
        "$PHP_BIN" "$COMPOSER_BIN" --no-interaction --no-ansi --no-cache \
        --no-plugins --no-scripts "$@"
}

probe_candidate_collaboration_release_fuse() {
    local pipeline_status=()

    # The staging root is intentionally root:root 0700, so the PHP worker must
    # not traverse it. Root streams the already manifest-verified candidate
    # through stdin while PHP remains www-data with common stream, socket and
    # DNS network entry points disabled and filesystem-confined. Exact source
    # hashes below are the primary execution allowlist. This preserves
    # the root-only release boundary instead of
    # weakening it merely to make the probe readable. Defining the future
    # external opt-in as strict true proves that a release carrying Phase 1
    # still has its internal fuse hard false. The pinned 1.5.8 bootstrap/seed
    # bundle predates every Phase 1 symbol, so an entirely absent gate is the
    # only backward-compatible pass.
    if cat -- "$BUNDLE/shuzijun-app-content.php" | \
        timeout --signal=KILL 20s runuser -u www-data -- env -i \
        PATH="$PATH" LC_ALL=C LANG=C HOME=/nonexistent \
        "$PHP_BIN" -n -d display_errors=0 -d log_errors=0 \
        -d allow_url_fopen=0 -d open_basedir=/nonexistent \
        -d 'disable_functions=exec,passthru,shell_exec,system,proc_open,popen,putenv,mail,pcntl_exec,dl,link,symlink,rename,unlink,rmdir,mkdir,chmod,chown,chgrp,touch,copy,file_put_contents,fsockopen,pfsockopen,stream_socket_client,stream_socket_server,stream_socket_sendto,stream_socket_recvfrom,stream_socket_accept,stream_socket_pair,stream_socket_shutdown,gethostbyname,gethostbynamel,gethostbyaddr,dns_check_record,checkdnsrr,dns_get_record,getmxrr,dns_get_mx,socket_create,socket_connect,socket_send,socket_sendto,socket_write,socket_create_listen,socket_create_pair,socket_import_stream,socket_addrinfo_lookup,socket_addrinfo_connect,socket_addrinfo_bind,curl_init,curl_exec,curl_multi_init,curl_multi_exec,curl_multi_add_handle,ftp_connect,ftp_ssl_connect' \
        -r '
        $source = stream_get_contents(STDIN);
        if (!is_string($source) || $source === "") { exit(18); }
        $sourceHash = hash("sha256", $source);
        $legacyHash = $argv[1];
        $targetHash = $argv[2];
        $sentinel = $argv[3];
        if (!hash_equals($legacyHash, $sourceHash)
            && !hash_equals($targetHash, $sourceHash)) {
            exit(25);
        }
        define("ABSPATH", "/nonexistent/");
        define("YISHU_ENABLE_COLLABORATION_PHASE1", true);
        function add_action(...$arguments): void {}
        function add_filter(...$arguments): void {}
        eval("?>" . $source);

        $class = "Shuzijun_App_Content_API";
        $gate = "collaboration_phase1_enabled";
        $fuse = $class . "::COLLABORATION_PHASE1_RELEASE_FUSE";
        if (!class_exists($class, false)) { exit(19); }
        $has_gate = method_exists($class, $gate);
        $has_fuse = defined($fuse);
        if (constant("YISHU_ENABLE_COLLABORATION_PHASE1") !== true) { exit(20); }
        if (!$has_gate && !$has_fuse) {
            if (!hash_equals($legacyHash, $sourceHash)) { exit(24); }
            fwrite(STDOUT, $sentinel . "\n");
            exit(0);
        }
        if (!$has_gate || !$has_fuse) { exit(21); }
        if (constant($fuse) !== false) { exit(22); }
        if ($class::$gate() !== false) { exit(23); }
        fwrite(STDOUT, $sentinel . "\n");
        exit(0);
    ' "$LEGACY_BRIDGE_PHP_SHA256" "$TARGET_RELEASE_PHP_SHA256" \
        "$COLLABORATION_FUSE_PROBE_SENTINEL" 8<&- 9<&- | \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        python3 -I -c '
import sys

expected = (sys.argv[1] + "\n").encode("ascii")
payload = sys.stdin.buffer.read(len(expected) + 1)
raise SystemExit(0 if payload == expected else 1)
' "$COLLABORATION_FUSE_PROBE_SENTINEL"
    then
        return 0
    fi

    pipeline_status=("${PIPESTATUS[@]}")
    if [[ "${pipeline_status[0]:-1}" -ne 0 ]]; then
        fail 'candidate plugin source could not be read from the reviewed bundle'
        return 1
    fi
    case "${pipeline_status[1]:-1}" in
        18) fail 'candidate plugin source was empty' ;;
        19) fail 'candidate plugin did not define the expected API class' ;;
        20) fail 'candidate plugin altered the external collaboration opt-in' ;;
        21) fail 'candidate collaboration gate and release fuse are incomplete' ;;
        22) fail 'candidate collaboration Phase 1 release fuse is not hard-disabled' ;;
        23) fail 'candidate collaboration gate became enabled' ;;
        24) fail 'gate-free collaboration candidate is not the reviewed 1.5.8 bridge' ;;
        25) fail 'candidate plugin PHP is not in the reviewed release allowlist' ;;
        124|137) fail 'candidate collaboration release fuse probe timed out' ;;
        0)
            if [[ "${pipeline_status[2]:-1}" -ne 0 ]]; then
                fail 'candidate plugin exited before the isolated fuse probe completed'
            else
                fail 'candidate plugin produced an invalid fuse probe result'
            fi
            ;;
        *) fail 'candidate plugin could not be evaluated by the isolated PHP probe' ;;
    esac
    return 1
}

preflight_release() {
    local file scan_complete=0
    while IFS= read -r -d '' file; do
        if [[ -z "$file" ]]; then
            scan_complete=1
            continue
        fi
        env -i PATH="$PATH" LC_ALL=C LANG=C HOME=/nonexistent \
            "$PHP_BIN" -n -l "$file" >/dev/null
    done < <(find "$BUNDLE" -type f -name '*.php' -print0 && printf '\0')
    [[ "$scan_complete" -eq 1 ]] || fail 'PHP source scan did not complete'

    probe_candidate_collaboration_release_fuse

    run_composer --working-dir="$BUNDLE" validate \
        --strict --no-check-publish >/dev/null
    run_composer --working-dir="$BUNDLE" audit \
        --locked --no-dev --format=summary >/dev/null
    run_composer --working-dir="$BUNDLE" check-platform-reqs \
        --no-dev >/dev/null
    env -i PATH="$PATH" LC_ALL=C LANG=C HOME=/nonexistent \
        "$PHP_BIN" -n -d allow_url_fopen=0 -d "open_basedir=$BUNDLE" -r '
        $root = $argv[1];
        $lock = json_decode(file_get_contents($root . "/composer.lock"), true, 512, JSON_THROW_ON_ERROR);
        $packages = $lock["packages"] ?? array();
        if (count($packages) !== 1
            || ($packages[0]["name"] ?? "") !== "firebase/php-jwt"
            || ($packages[0]["version"] ?? "") !== "v7.1.0"
            || !empty($lock["packages-dev"] ?? array())) { exit(2); }
        $psr4 = file_get_contents($root . "/vendor/composer/autoload_psr4.php");
        if (!is_string($psr4)
            || !str_contains($psr4, "Firebase\\\\JWT\\\\")
            || !is_file($root . "/vendor/firebase/php-jwt/src/JWT.php")
            || !is_file($root . "/vendor/firebase/php-jwt/src/JWK.php")) { exit(3); }
        exit(0);
    ' "$BUNDLE"

    # The release code above is deliberately constrained, but validating the
    # trusted manifest again also detects any package/tool mutation or TOCTOU
    # change before dry-run success or the first live write.
    validate_manifest
}

verify_installed_jwt_autoload() {
    # Only after installation, when files are root-owned 0644/0755, execute the
    # autoloader as the PHP worker rather than root.  FPM is still stopped and
    # any failure triggers the verified code-only rollback.
    timeout --signal=KILL 20s runuser -u www-data -- env -i \
