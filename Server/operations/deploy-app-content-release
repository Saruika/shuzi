        -r '
        $root = $argv[1];
        require $root . "/vendor/autoload.php";
        exit(class_exists("Firebase\\JWT\\JWT") && class_exists("Firebase\\JWT\\JWK") ? 0 : 3);
    ' "$TARGET_DIR"
