    CODE_MUTATED=1
    remove_live_vendor
    install -d -o root -g www-data -m 0755 "$TARGET_DIR/vendor"
    cp -R -- "$BUNDLE/vendor/." "$TARGET_DIR/vendor/"
    chown -R root:www-data "$TARGET_DIR/vendor"
    find "$TARGET_DIR/vendor" -xdev -type d -exec chmod 0755 {} +
    find "$TARGET_DIR/vendor" -xdev -type f -exec chmod 0644 {} +

