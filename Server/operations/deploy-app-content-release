        && "$(realpath -e -- "$LIVE_MANIFEST")" == "$LIVE_MANIFEST" \
        && "$(stat -c '%u:%g:%h:%a' "$LIVE_MANIFEST")" == "0:$worker_gid:1:644" \
        && "$(stat -c '%d' "$LIVE_MANIFEST")" == "$target_device" ]] \
        || { fail 'live release manifest metadata is unsafe'; return 1; }
