probe_candidate_collaboration_release_fuse() {
    local source_mode source_sizes_csv source_hashes_csv
    local index relative file pipeline_status=()
    local -a source_files=() source_sizes=() source_hashes=()

    case "$EXPECTED_MANIFEST_SHA256" in
        "$LEGACY_BRIDGE_MANIFEST_SHA256")
            source_mode=legacy
            source_files=("$BUNDLE/shuzijun-app-content.php")
            source_hashes=("$LEGACY_BRIDGE_PHP_SHA256")
            ;;
        "$TARGET_RELEASE_MANIFEST_SHA256")
            source_mode=modular
            [[ "${#PLUGIN_MODULE_RELATIVES[@]}" -eq "${#TARGET_RELEASE_MODULE_SHA256S[@]}" ]] \
                || { fail 'candidate API module allowlist is inconsistent'; return 1; }
            for index in "${!PLUGIN_MODULE_RELATIVES[@]}"; do
                relative=${PLUGIN_MODULE_RELATIVES[$index]}
                file="$BUNDLE/$relative"
                [[ -f "$file" && ! -L "$file" ]] \
                    || { fail 'candidate API module is missing or unsafe'; return 1; }
                source_files+=("$file")
                source_hashes+=("${TARGET_RELEASE_MODULE_SHA256S[$index]}")
            done
            source_files+=("$BUNDLE/shuzijun-app-content.php")
            source_hashes+=("$TARGET_RELEASE_PHP_SHA256")
            ;;
        *)
            fail 'candidate collaboration probe received an unreviewed manifest'
            return 1
            ;;
    esac

    for file in "${source_files[@]}"; do
        source_sizes+=("$(stat -c '%s' "$file")")
    done
    source_sizes_csv=$(IFS=,; printf '%s' "${source_sizes[*]}")
    source_hashes_csv=$(IFS=,; printf '%s' "${source_hashes[*]}")

    # The staging root is intentionally root:root 0700, so the PHP worker must
    # not traverse it. Root streams the already manifest-verified sources
    # through stdin while PHP remains www-data with common stream, socket and
    # DNS network entry points disabled and filesystem-confined. Exact
    # per-file hashes plus decimal byte framing prevent source-boundary
    # ambiguity. The modular target is evaluated as five traits, its class,
    # then the thin entrypoint. Reviewed require_once statements are removed
    # only inside this evaluator because the root-only bundle deliberately sits
    # outside the PHP worker's open_basedir. Runtime loading is unchanged.
    if cat -- "${source_files[@]}" | \
        timeout --signal=KILL 20s runuser -u www-data -- env -i \
        PATH="$PATH" LC_ALL=C LANG=C HOME=/nonexistent \
        "$PHP_BIN" -n -d display_errors=0 -d log_errors=0 \
        -d allow_url_fopen=0 -d open_basedir=/nonexistent \
        -d 'disable_functions=exec,passthru,shell_exec,system,proc_open,popen,putenv,mail,pcntl_exec,dl,link,symlink,rename,unlink,rmdir,mkdir,chmod,chown,chgrp,touch,copy,file_put_contents,fsockopen,pfsockopen,stream_socket_client,stream_socket_server,stream_socket_sendto,stream_socket_recvfrom,stream_socket_accept,stream_socket_pair,stream_socket_shutdown,gethostbyname,gethostbynamel,gethostbyaddr,dns_check_record,checkdnsrr,dns_get_record,getmxrr,dns_get_mx,socket_create,socket_connect,socket_send,socket_sendto,socket_write,socket_create_listen,socket_create_pair,socket_import_stream,socket_addrinfo_lookup,socket_addrinfo_connect,socket_addrinfo_bind,curl_init,curl_exec,curl_multi_init,curl_multi_exec,curl_multi_add_handle,ftp_connect,ftp_ssl_connect' \
        -r '
        $payload = stream_get_contents(STDIN);
        if (!is_string($payload) || $payload === "") { exit(18); }
        $sentinel = $argv[1];
        $sourceMode = $argv[2];
        $sizeValues = explode(",", $argv[3]);
        $sourceHashes = explode(",", $argv[4]);
        if (count($sizeValues) !== count($sourceHashes)
            || ($sourceMode === "legacy" && count($sizeValues) !== 1)
            || ($sourceMode === "modular" && count($sizeValues) !== 8)
            || ($sourceMode !== "legacy" && $sourceMode !== "modular")) {
            exit(26);
        }
        $sources = array();
        $offset = 0;
        foreach ($sizeValues as $index => $sizeValue) {
            if (!preg_match("/\\A[1-9][0-9]*\\z/D", $sizeValue)
                || !preg_match("/\\A[a-f0-9]{64}\\z/D", $sourceHashes[$index])) {
                exit(26);
            }
            $size = (int) $sizeValue;
            if ((string) $size !== $sizeValue || $size > strlen($payload) - $offset) {
                exit(26);
            }
            $source = substr($payload, $offset, $size);
            if (strlen($source) !== $size
                || !hash_equals($sourceHashes[$index], hash("sha256", $source))) {
                exit(25);
            }
            $sources[] = $source;
            $offset += $size;
        }
        if ($offset !== strlen($payload)) { exit(26); }

        if ($sourceMode === "legacy") {
            $traitSources = array();
            $classSource = "";
            $entrypoint = $sources[0];
        } else {
            $traitSources = array_slice($sources, 0, 6);
            $classSource = $sources[6];
            $entrypoint = $sources[7];
            $quote = chr(39);
            $entryLoader = "require_once __DIR__ . " . $quote
                . "/vendor/shuzijun/app-content/class-shuzijun-app-content-api.php"
                . $quote . ";";
            if (substr_count($entrypoint, $entryLoader) !== 1) { exit(27); }
            $entrypoint = str_replace($entryLoader, "", $entrypoint);
            $classLoaders = array(
                "require_once __DIR__ . " . $quote . "/class-shuzijun-collaboration-private-payload.php" . $quote . ";",
                "require_once __DIR__ . " . $quote . "/trait-shuzijun-app-collaboration.php" . $quote . ";",
                "require_once __DIR__ . " . $quote . "/trait-shuzijun-app-fan-endpoints.php" . $quote . ";",
                "require_once __DIR__ . " . $quote . "/trait-shuzijun-app-push-notifications.php" . $quote . ";",
                "require_once __DIR__ . " . $quote . "/trait-shuzijun-app-fan-identity.php" . $quote . ";",
                "require_once __DIR__ . " . $quote . "/trait-shuzijun-app-content-delivery.php" . $quote . ";",
            );
            foreach ($classLoaders as $classLoader) {
                if (substr_count($classSource, $classLoader) !== 1) { exit(27); }
                $classSource = str_replace($classLoader, "", $classSource);
            }
            if (strpos($classSource, "require_once __DIR__") !== false) { exit(27); }
        }
        if ($entrypoint === "") { exit(25); }

        define("ABSPATH", "/nonexistent/");
        define("YISHU_ENABLE_COLLABORATION_PHASE1", true);
        function add_action(...$arguments): void {}
        function add_filter(...$arguments): void {}
        foreach ($traitSources as $traitSource) { eval("?>" . $traitSource); }
        if ($classSource !== "") { eval("?>" . $classSource); }
        eval("?>" . $entrypoint);

        $class = "Shuzijun_App_Content_API";
        $gate = "collaboration_phase1_enabled";
        $fuse = $class . "::COLLABORATION_PHASE1_RELEASE_FUSE";
        if (!class_exists($class, false)) { exit(19); }
        $has_gate = method_exists($class, $gate);
        $has_fuse = defined($fuse);
        if (constant("YISHU_ENABLE_COLLABORATION_PHASE1") !== true) { exit(20); }
        if (!$has_gate && !$has_fuse) {
            if ($sourceMode !== "legacy") { exit(24); }
            fwrite(STDOUT, $sentinel . "\n");
            exit(0);
        }
        if (!$has_gate || !$has_fuse) { exit(21); }
        if (constant($fuse) !== false) { exit(22); }
        if ($class::$gate() !== false) { exit(23); }
        fwrite(STDOUT, $sentinel . "\n");
        exit(0);
    ' "$COLLABORATION_FUSE_PROBE_SENTINEL" "$source_mode" \
        "$source_sizes_csv" "$source_hashes_csv" 8<&- 9<&- | \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        python3 -I -c '
import sys

expected = (sys.argv[1] + "\n").encode("ascii")
payload = sys.stdin.buffer.read(len(expected) + 1)
raise SystemExit(0 if payload == expected else 1)
' "$COLLABORATION_FUSE_PROBE_SENTINEL"
    then
        return 0
    fi

    pipeline_status=("${PIPESTATUS[@]}")
    if [[ "${pipeline_status[0]:-1}" -ne 0 ]]; then
        fail 'candidate plugin sources could not be read from the reviewed bundle'
        return 1
    fi
    case "${pipeline_status[1]:-1}" in
        18) fail 'candidate plugin source was empty' ;;
        19) fail 'candidate plugin did not define the expected API class' ;;
        20) fail 'candidate plugin altered the external collaboration opt-in' ;;
        21) fail 'candidate collaboration gate and release fuse are incomplete' ;;
        22) fail 'candidate collaboration Phase 1 release fuse is not hard-disabled' ;;
        23) fail 'candidate collaboration gate became enabled' ;;
        24) fail 'gate-free collaboration candidate is not the reviewed 1.5.8 bridge' ;;
        25) fail 'candidate plugin PHP is not in the reviewed release allowlist' ;;
        26) fail 'candidate plugin source framing is invalid' ;;
        27) fail 'candidate plugin loader graph is not exact' ;;
        124|137) fail 'candidate collaboration release fuse probe timed out' ;;
        0)
            if [[ "${pipeline_status[2]:-1}" -ne 0 ]]; then
                fail 'candidate plugin exited before the isolated fuse probe completed'
            else
                fail 'candidate plugin produced an invalid fuse probe result'
            fi
            ;;
        *) fail 'candidate plugin could not be evaluated by the isolated PHP probe' ;;
    esac
    return 1
}

preflight_release() {
    local file scan_complete=0
    while IFS= read -r -d '' file; do
        if [[ -z "$file" ]]; then
            scan_complete=1
            continue
        fi
        env -i PATH="$PATH" LC_ALL=C LANG=C HOME=/nonexistent \
            "$PHP_BIN" -n -l "$file" >/dev/null
    done < <(find "$BUNDLE" -type f -name '*.php' -print0 && printf '\0')
    [[ "$scan_complete" -eq 1 ]] || fail 'PHP source scan did not complete'

    probe_candidate_collaboration_release_fuse

    # The release intentionally pins firebase/php-jwt exactly in composer.json
    # and composer.lock. Composer reports that policy as a publish-style
    # warning, so plain `validate --strict` would reject every reviewed bundle.
    # Composer's narrow --no-check-all switch suppresses only unbound/overly
    # strict constraint warnings; every other validation warning remains fatal.
    # Then independently enforce the one-package v7.1.0 lock and manifest below.
    run_composer --working-dir="$BUNDLE" validate \
        --strict --no-check-all --no-check-publish >/dev/null
    run_composer --working-dir="$BUNDLE" audit \
        --locked --no-dev --format=summary >/dev/null
    run_composer --working-dir="$BUNDLE" check-platform-reqs \
        --no-dev >/dev/null
    env -i PATH="$PATH" LC_ALL=C LANG=C HOME=/nonexistent \
        "$PHP_BIN" -n -d allow_url_fopen=0 -d "open_basedir=$BUNDLE" -r '
        $root = $argv[1];
        $lock = json_decode(file_get_contents($root . "/composer.lock"), true, 512, JSON_THROW_ON_ERROR);
        $packages = $lock["packages"] ?? array();
        if (count($packages) !== 1
            || ($packages[0]["name"] ?? "") !== "firebase/php-jwt"
            || ($packages[0]["version"] ?? "") !== "v7.1.0"
            || !empty($lock["packages-dev"] ?? array())) { exit(2); }
        $psr4 = file_get_contents($root . "/vendor/composer/autoload_psr4.php");
        if (!is_string($psr4)
            || !str_contains($psr4, "Firebase\\\\JWT\\\\")
            || !is_file($root . "/vendor/firebase/php-jwt/src/JWT.php")
            || !is_file($root . "/vendor/firebase/php-jwt/src/JWK.php")) { exit(3); }
        exit(0);
    ' "$BUNDLE"

    # The release code above is deliberately constrained, but validating the
    # trusted manifest again also detects any package/tool mutation or TOCTOU
    # change before dry-run success or the first live write.
    validate_manifest
}

verify_installed_jwt_autoload() {
    # Only after installation, when files are root-owned 0644/0755, execute the
