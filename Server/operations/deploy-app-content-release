validate_live_manifested_release() {
    local actual_manifest_sha line digest relative previous_relative='' file worker_gid
    local actual_file_count=0 scan_complete=0 target_device
    local -a release_paths=(
        "$TARGET_DIR/shuzijun-app-content.php"
