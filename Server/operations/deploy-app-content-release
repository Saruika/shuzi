write_backup_integrity_manifest() {
    local relative scan_complete=0
    local -a backup_paths=(
        shuzijun-app-content.php
        composer.json
        composer.lock
        vendor
        "$BACKUP_MANIFEST_STATE_NAME"
    )
    [[ "$BACKUP_LIVE_MANIFEST_STATE" == present ]] \
        && backup_paths+=("$MANIFEST_NAME")
    BACKUP_MANIFEST="$BACKUP_DIR/$BACKUP_INTEGRITY_NAME"
    (
        cd "$BACKUP_DIR"
        while IFS= read -r -d '' relative; do
            if [[ -z "$relative" ]]; then
                scan_complete=1
                continue
            fi
            sha256sum "$relative"
        done < <(find "${backup_paths[@]}" -xdev -type f -print0 | sort -z && printf '\0')
        [[ "$scan_complete" -eq 1 ]] || fail 'backup file scan did not complete'
    ) > "$BACKUP_MANIFEST"
    chmod 600 "$BACKUP_MANIFEST"
}

validate_code_backup() {
    local entry relative line digest previous_relative='' file state_size target_device
    local actual_file_count=0 manifest_file_count=0 scan_complete=0
    declare -A manifest_paths=()

    [[ "$BACKUP_DIR" == "$BACKUP_ROOT/"* \
        && "${BACKUP_DIR#$BACKUP_ROOT/}" != */* \
        && -d "$BACKUP_DIR" && ! -L "$BACKUP_DIR" \
        && "$(realpath -e -- "$BACKUP_DIR")" == "$BACKUP_DIR" \
        && "$(stat -c '%u:%a' "$BACKUP_DIR")" == '0:700' ]] \
        || { fail 'code backup boundary is unsafe'; return 1; }
    reject_find_match 'code backup contains a symbolic link' \
        "$BACKUP_DIR" -type l || return 1
    reject_find_match 'code backup contains a non-regular entry' \
        "$BACKUP_DIR" ! -type d ! -type f || return 1
    reject_find_match 'code backup contains a hard-linked file' \
        "$BACKUP_DIR" -type f -links +1 || return 1
    reject_find_match 'code backup has unsafe ownership or write access' \
        "$BACKUP_DIR" \( ! -uid 0 -o -perm /022 \) || return 1
    target_device=$(stat -c '%d' "$BACKUP_DIR")
    while IFS= read -r -d '' entry; do
        if [[ -z "$entry" ]]; then
            scan_complete=1
            continue
        fi
        [[ "$(stat -c '%d' "$entry")" == "$target_device" ]] \
            || { fail 'code backup crosses a filesystem boundary'; return 1; }
        relative=${entry#"$BACKUP_DIR/"}
        case "$relative" in
            shuzijun-app-content.php|composer.json|composer.lock|vendor|vendor/*|\
                "$MANIFEST_NAME"|"$BACKUP_MANIFEST_STATE_NAME"|"$BACKUP_INTEGRITY_NAME") ;;
            *) fail 'code backup contains an unknown entry'; return 1 ;;
        esac
    done < <(find "$BACKUP_DIR" -mindepth 1 -print0 && printf '\0')
    [[ "$scan_complete" -eq 1 ]] \
        || { fail 'code backup tree scan did not complete'; return 1; }

    [[ -f "$BACKUP_DIR/$BACKUP_MANIFEST_STATE_NAME" \
        && ! -L "$BACKUP_DIR/$BACKUP_MANIFEST_STATE_NAME" ]] \
        || { fail 'code backup manifest state is missing or unsafe'; return 1; }
    state_size=$(stat -c '%s' "$BACKUP_DIR/$BACKUP_MANIFEST_STATE_NAME")
    BACKUP_LIVE_MANIFEST_STATE=$(cat -- "$BACKUP_DIR/$BACKUP_MANIFEST_STATE_NAME")
    case "$BACKUP_LIVE_MANIFEST_STATE:$state_size" in
        present:8)
            [[ -f "$BACKUP_DIR/$MANIFEST_NAME" && ! -L "$BACKUP_DIR/$MANIFEST_NAME" ]] \
                || { fail 'code backup omitted the previous live manifest'; return 1; }
            ;;
        absent:7)
            [[ ! -e "$BACKUP_DIR/$MANIFEST_NAME" && ! -L "$BACKUP_DIR/$MANIFEST_NAME" ]] \
                || { fail 'code backup contains a manifest declared absent'; return 1; }
            ;;
        *) fail 'code backup manifest state is invalid'; return 1 ;;
    esac
    BACKUP_MANIFEST="$BACKUP_DIR/$BACKUP_INTEGRITY_NAME"
    [[ -f "$BACKUP_MANIFEST" && ! -L "$BACKUP_MANIFEST" \
        && "$(stat -c '%u:%h:%a' "$BACKUP_MANIFEST")" == '0:1:600' ]] \
        || { fail 'code backup integrity manifest is missing or unsafe'; return 1; }
    LC_ALL=C tail -c 1 -- "$BACKUP_MANIFEST" | grep -qx '' \
        || { fail 'code backup integrity manifest must end with one newline'; return 1; }

    while IFS= read -r line; do
        [[ "$line" =~ ^([a-f0-9]{64})\ \ ([A-Za-z0-9._/-]+)$ ]] \
            || { fail 'code backup integrity manifest has an invalid record'; return 1; }
        digest=${BASH_REMATCH[1]}
        relative=${BASH_REMATCH[2]}
        [[ "$relative" != /* && "$relative" != *'//'* \
            && "$relative" != *'/./'* && "$relative" != */. \
            && "$relative" != .. && "$relative" != ../* \
            && "$relative" != *'/../'* && "$relative" != */.. ]] \
            || { fail 'code backup integrity manifest contains path traversal'; return 1; }
        case "$relative" in
            shuzijun-app-content.php|composer.json|composer.lock|vendor/*|\
                "$BACKUP_MANIFEST_STATE_NAME") ;;
            "$MANIFEST_NAME")
                [[ "$BACKUP_LIVE_MANIFEST_STATE" == present ]] \
                    || { fail 'code backup integrity manifest contradicts absent state'; return 1; }
                ;;
            *) fail 'code backup integrity manifest contains an unknown path'; return 1 ;;
        esac
        [[ -z "$previous_relative" || "$relative" > "$previous_relative" ]] \
            || { fail 'code backup integrity manifest is not bytewise sorted and unique'; return 1; }
        [[ -z "${manifest_paths[$relative]+present}" ]] \
            || { fail 'code backup integrity manifest contains a duplicate path'; return 1; }
        manifest_paths["$relative"]=$digest
        previous_relative=$relative
        manifest_file_count=$((manifest_file_count + 1))
    done < "$BACKUP_MANIFEST"
    for relative in shuzijun-app-content.php composer.json composer.lock \
        vendor/autoload.php "$BACKUP_MANIFEST_STATE_NAME"; do
        [[ -n "${manifest_paths[$relative]+present}" ]] \
            || { fail 'code backup integrity manifest omits a required file'; return 1; }
    done
    if [[ "$BACKUP_LIVE_MANIFEST_STATE" == present ]]; then
        [[ -n "${manifest_paths[$MANIFEST_NAME]+present}" ]] \
            || { fail 'code backup integrity manifest omits the previous live manifest'; return 1; }
    fi
    scan_complete=0
    while IFS= read -r -d '' file; do
        if [[ -z "$file" ]]; then
            scan_complete=1
            continue
        fi
        [[ "$file" == "$BACKUP_MANIFEST" ]] && continue
        relative=${file#"$BACKUP_DIR/"}
        actual_file_count=$((actual_file_count + 1))
        [[ -n "${manifest_paths[$relative]+present}" ]] \
            || { fail 'code backup integrity manifest does not cover every backup file'; return 1; }
    done < <(find "$BACKUP_DIR" -type f -print0 && printf '\0')
    [[ "$scan_complete" -eq 1 && "$actual_file_count" -eq "$manifest_file_count" ]] \
        || { fail 'code backup integrity manifest has a missing or extra file'; return 1; }
    (
        cd "$BACKUP_DIR"
        sha256sum --strict --quiet --check "$BACKUP_MANIFEST"
    ) >/dev/null || { fail 'code backup integrity verification failed'; return 1; }
}

create_code_backup() {
    local stamp
    validate_current_release_unit
    [[ -d "$BACKUP_ROOT" && ! -L "$BACKUP_ROOT" \
        && "$(realpath -e -- "$BACKUP_ROOT")" == "$BACKUP_ROOT" \
        && "$(stat -c '%u' "$BACKUP_ROOT")" == 0 ]] \
        || fail 'backup root is unsafe'
    reject_find_match 'backup root is writable by a non-root identity' \
        "$BACKUP_ROOT" -maxdepth 0 -perm /022

    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    BACKUP_DIR="$BACKUP_ROOT/${stamp}-${EXPECTED_MANIFEST_SHA256:0:12}-$$"
    mkdir -m 0700 "$BACKUP_DIR"
    [[ "$(realpath -e -- "$BACKUP_DIR")" == "$BACKUP_DIR" \
        && "${BACKUP_DIR#$BACKUP_ROOT/}" != */* \
        && "$(stat -c '%u' "$BACKUP_DIR")" == 0 ]] \
        || fail 'new backup directory boundary is unsafe'
    cp -a -- "$TARGET_DIR/shuzijun-app-content.php" "$BACKUP_DIR/"
    cp -a -- "$TARGET_DIR/composer.json" "$BACKUP_DIR/"
    cp -a -- "$TARGET_DIR/composer.lock" "$BACKUP_DIR/"
    cp -a -- "$TARGET_DIR/vendor" "$BACKUP_DIR/"
    if [[ -e "$LIVE_MANIFEST" || -L "$LIVE_MANIFEST" ]]; then
        [[ -f "$LIVE_MANIFEST" && ! -L "$LIVE_MANIFEST" ]] \
            || fail 'previous live manifest became unsafe before backup'
        cp -a -- "$LIVE_MANIFEST" "$BACKUP_DIR/$MANIFEST_NAME"
        BACKUP_LIVE_MANIFEST_STATE=present
    else
        BACKUP_LIVE_MANIFEST_STATE=absent
    fi
    printf '%s\n' "$BACKUP_LIVE_MANIFEST_STATE" \
        > "$BACKUP_DIR/$BACKUP_MANIFEST_STATE_NAME"
    chmod 600 "$BACKUP_DIR/$BACKUP_MANIFEST_STATE_NAME"
    write_backup_integrity_manifest
    # The persistent FPM boot guard can intentionally leave the node offline
    # after power loss. Make the rollback unit durable before arming rollback
    # or performing the first live-code mutation.
    sync -f "$BACKUP_DIR"
    sync -f "$BACKUP_ROOT"
    validate_code_backup
    ROLLBACK_READY=1
}

