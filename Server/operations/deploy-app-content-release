validate_current_release_unit() {
    local entry target_device scan_complete=0
    local -a release_paths=(
        "$TARGET_DIR/shuzijun-app-content.php"
        "$TARGET_DIR/composer.json"
        "$TARGET_DIR/composer.lock"
        "$TARGET_DIR/vendor"
    )

    validate_target_boundary || return 1
    if ! [[ -f "${release_paths[0]}" && ! -L "${release_paths[0]}" \
        && -f "${release_paths[1]}" && ! -L "${release_paths[1]}" \
        && -f "${release_paths[2]}" && ! -L "${release_paths[2]}" \
        && -d "${release_paths[3]}" && ! -L "${release_paths[3]}" ]]; then
        fail 'current release unit is incomplete or unsafe'
        return 1
    fi
    reject_find_match 'current release unit contains a symbolic link' \
        "${release_paths[@]}" -type l || return 1
    reject_find_match 'current release unit contains a non-regular entry' \
        "${release_paths[@]}" ! -type d ! -type f || return 1
    reject_find_match 'current release unit contains a hard-linked file' \
        "${release_paths[@]}" -type f -links +1 || return 1
    reject_find_match 'current release unit has unsafe ownership or write access' \
        "${release_paths[@]}" \( ! -uid 0 -o -perm /022 \) || return 1

    target_device=$(stat -c '%d' "$TARGET_DIR")
    while IFS= read -r -d '' entry; do
        if [[ -z "$entry" ]]; then
            scan_complete=1
            continue
        fi
        if [[ "$(stat -c '%d' "$entry")" != "$target_device" ]]; then
            fail 'current release unit crosses a filesystem boundary'
            return 1
        fi
    done < <(find "${release_paths[@]}" -print0 && printf '\0')
    if [[ "$scan_complete" -ne 1 ]]; then
        fail 'current release unit scan did not complete'
        return 1
    fi
    return 0
}

