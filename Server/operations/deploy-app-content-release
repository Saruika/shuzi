    install -o root -g www-data -m 0644 "$BUNDLE/composer.lock" "$TARGET_DIR/composer.lock"

    # Install the entry point last, after its complete autoloader is in place.
    install -o root -g www-data -m 0644 \
        "$BUNDLE/shuzijun-app-content.php" "$TARGET_DIR/shuzijun-app-content.php"
}

require_fpm_enabled_policy() {
    local unit_state
    unit_state=$(systemctl is-enabled "$FPM_SERVICE" 2>/dev/null || true)
    [[ "$unit_state" == enabled ]] \
        || fail 'PHP-FPM must be enabled before deployment writes or service policy changes'
}

protect_fpm_from_incomplete_boot() {
    local unit_state
    require_fpm_enabled_policy

    if ! systemctl mask "$FPM_SERVICE" >/dev/null; then
        unit_state=$(systemctl is-enabled "$FPM_SERVICE" 2>/dev/null || true)
        [[ "$unit_state" == masked ]] && FPM_BOOT_GUARD_ACTIVE=1
        fail 'PHP-FPM persistent deployment boot guard could not be installed'
        return 1
    fi
    # Set the flag immediately after the write. A later verification failure
    # must still take the guarded rollback path rather than attempting an
    # ordinary start against a masked unit.
    FPM_BOOT_GUARD_ACTIVE=1
    unit_state=$(systemctl is-enabled "$FPM_SERVICE" 2>/dev/null || true)
    [[ "$unit_state" == masked ]] \
        || fail 'PHP-FPM persistent deployment boot guard was not installed'
}

release_fpm_boot_guard() {
    local unit_state
    [[ "$FPM_BOOT_GUARD_ACTIVE" -eq 1 ]] || return 0
    systemctl unmask "$FPM_SERVICE" >/dev/null
    unit_state=$(systemctl is-enabled "$FPM_SERVICE" 2>/dev/null || true)
    [[ "$unit_state" == enabled ]] \
        || fail 'PHP-FPM persistent deployment boot guard could not be removed'
    FPM_BOOT_GUARD_ACTIVE=0
}

is_fpm_persistently_masked() {
    local unit_state
    unit_state=$(systemctl is-enabled "$FPM_SERVICE" 2>/dev/null || true)
    if [[ "$unit_state" == masked ]]; then
        FPM_BOOT_GUARD_ACTIVE=1
        return 0
    fi
    return 1
}

restore_code_backup() {
    local restore_status=0
    [[ "$ROLLBACK_READY" -eq 1 && -n "$BACKUP_DIR" ]] || return 0

    [[ "$BACKUP_DIR" == "$BACKUP_ROOT/"* \
        && "${BACKUP_DIR#$BACKUP_ROOT/}" != */* \
        && -d "$BACKUP_DIR" && ! -L "$BACKUP_DIR" \
        && "$(realpath -e -- "$BACKUP_DIR")" == "$BACKUP_DIR" ]] || return 1
    (
        cd "$BACKUP_DIR"
        sha256sum --strict --quiet --check "$BACKUP_MANIFEST"
    ) >/dev/null 2>&1 || return 1

    if [[ "$CODE_MUTATED" -eq 1 ]]; then
        # The flag can lag behind systemd if unmask changed state immediately
        # before a status query failed. Reconcile the real state before any
        # rollback write and do not mutate the backup target without a mask.
        if ! is_fpm_persistently_masked; then
            protect_fpm_from_incomplete_boot >/dev/null 2>&1 || return 1
        fi
        systemctl stop "$FPM_SERVICE" >/dev/null 2>&1 || true
        if systemctl is-active --quiet "$FPM_SERVICE"; then
            return 1
        fi
        remove_live_vendor >/dev/null 2>&1 || restore_status=1
        remove_live_metadata >/dev/null 2>&1 || restore_status=1
        if [[ "$restore_status" -eq 0 ]]; then
            cp -a -- "$BACKUP_DIR/vendor" "$TARGET_DIR/vendor" || restore_status=1
            cp -a -- "$BACKUP_DIR/shuzijun-app-content.php" "$TARGET_DIR/" \
                || restore_status=1
            cp -a -- "$BACKUP_DIR/composer.json" "$TARGET_DIR/" || restore_status=1
            cp -a -- "$BACKUP_DIR/composer.lock" "$TARGET_DIR/" || restore_status=1
        fi
        if [[ "$restore_status" -eq 0 ]]; then
            validate_current_release_unit >/dev/null 2>&1 || restore_status=1
            (
                cd "$TARGET_DIR"
                sha256sum --strict --quiet --check "$BACKUP_MANIFEST"
            ) >/dev/null 2>&1 || restore_status=1
        fi
    fi

    # The restored plugin reads the fixed marker directly. Revalidate the
    # exact marker and the pinned verifier while FPM remains stopped; rollback
    # must never expose code under a stale or mismatched role contract.
    if [[ "$restore_status" -eq 0 && "$FPM_WAS_ACTIVE" -eq 1 ]]; then
        verify_authority_role >/dev/null 2>&1 || restore_status=1
    fi
    if [[ "$restore_status" -eq 0 && "$FPM_WAS_ACTIVE" -eq 1 ]]; then
        probe_offline_wordpress_api "$AUTHORITY_ROLE" >/dev/null 2>&1 || restore_status=1
    fi

    # Never restart PHP-FPM with a partial or unverified rollback.  Leaving it
    # stopped is the fail-closed state and prevents mismatched plugin/vendor
    # code from serving requests while an operator restores the known backup.
    if [[ "$restore_status" -eq 0 && "$FPM_WAS_ACTIVE" -eq 1 ]]; then
        release_fpm_boot_guard >/dev/null 2>&1 || restore_status=1
    fi
    if [[ "$restore_status" -eq 0 && "$FPM_WAS_ACTIVE" -eq 1 ]]; then
        systemctl start "$FPM_SERVICE" >/dev/null 2>&1 || restore_status=1
        systemctl is-active --quiet "$FPM_SERVICE" || restore_status=1
    fi
    # Keep a restored, running unit persistently masked until every online
    # rollback check in handle_failure has passed. Masking an active unit does
    # not stop it, but prevents a reboot or dependency start from reviving an
    # unverified rollback after this process is interrupted.
    if [[ "$restore_status" -eq 0 && "$FPM_WAS_ACTIVE" -eq 1 ]]; then
        protect_fpm_from_incomplete_boot >/dev/null 2>&1 || restore_status=1
    fi
    return "$restore_status"
}

isolate_failed_fpm() {
    local guard_status=0 stop_status=0

    # Reconcile against systemd's real state instead of trusting the in-memory
    # flag: a partially completed unmask can make those two states diverge.
    if ! is_fpm_persistently_masked; then
        protect_fpm_from_incomplete_boot >/dev/null 2>&1 || guard_status=1
    fi
    systemctl stop "$FPM_SERVICE" >/dev/null 2>&1 || stop_status=1
    systemctl is-active --quiet "$FPM_SERVICE" && stop_status=1
    is_fpm_persistently_masked || guard_status=1

    [[ "$guard_status" -eq 0 && "$stop_status" -eq 0 ]]
}

handle_failure() {
    local status=$1
    trap - ERR
    trap '' INT TERM HUP
    set +e
    [[ "$status" -ne 0 ]] || status=1
    if [[ "$ROLLBACK_READY" -eq 1 ]]; then
        printf 'app-content-release: failure detected; restoring previous code release\n' >&2
        if restore_code_backup \
            && run_webroot_verifier >/dev/null 2>&1 \
            && nginx -t >/dev/null 2>&1 \
            && systemctl is-active --quiet "$FPM_SERVICE" \
            && probe_direct_php_blocked \
            && probe_unauthorized_api "$AUTHORITY_ROLE" \
            && release_fpm_boot_guard; then
            printf 'app-content-release: previous code release restored; backup=%s\n' "$BACKUP_DIR" >&2
        else
            # A restored tree is not safe to serve until every post-rollback
            # check succeeds. The safe failure state requires both an inactive
            # service and an independently verified persistent systemd mask.
            if isolate_failed_fpm; then
                printf 'app-content-release: rollback was not fully verified; PHP-FPM left stopped and persistently masked; manual recovery required from %s\n' \
                    "$BACKUP_DIR" >&2
            else
                printf 'app-content-release: rollback was not fully verified and PHP-FPM isolation could not be confirmed; immediate manual isolation required; backup=%s\n' \
                    "$BACKUP_DIR" >&2
            fi
        fi
    elif [[ "$FPM_WAS_ACTIVE" -eq 1 ]]; then
        systemctl start "$FPM_SERVICE" >/dev/null 2>&1
    fi
    exit "$status"
}

trap 'handle_failure $?' ERR
trap 'handle_failure 130' INT TERM HUP

while [[ $# -gt 0 ]]; do
    case "$1" in
        --bundle)
            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
            [[ "$BUNDLE_SEEN" -eq 0 ]] || fail 'bundle option may be specified only once'
            BUNDLE_INPUT=$2
            BUNDLE_SEEN=1
            shift 2
            ;;
        --manifest-sha256)
            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
            [[ "$MANIFEST_SHA_SEEN" -eq 0 ]] \
                || fail 'manifest SHA256 option may be specified only once'
            EXPECTED_MANIFEST_SHA256=$2
            MANIFEST_SHA_SEEN=1
            shift 2
            ;;
        --authority-role)
            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
            [[ "$AUTHORITY_ROLE_SEEN" -eq 0 ]] \
                || fail 'authority role option may be specified only once'
            AUTHORITY_ROLE=$2
            AUTHORITY_ROLE_SEEN=1
            shift 2
            ;;
        --dry-run)
            [[ "$MODE_SEEN" -eq 0 ]] || fail 'release mode may be specified only once'
            MODE=dry-run
            MODE_SEEN=1
            shift
            ;;
        --bundle-preflight)
            [[ "$MODE_SEEN" -eq 0 ]] || fail 'release mode may be specified only once'
            MODE=bundle-preflight
            MODE_SEEN=1
            shift
            ;;
        --apply)
            [[ "$MODE_SEEN" -eq 0 ]] || fail 'release mode may be specified only once'
            MODE=apply
            MODE_SEEN=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

[[ "$EUID" -eq 0 ]] || fail 'must run as root'
[[ -n "$BUNDLE_INPUT" && -n "$EXPECTED_MANIFEST_SHA256" ]] \
    || { usage >&2; exit 2; }
if [[ "$MODE" == bundle-preflight ]]; then
    [[ "$AUTHORITY_ROLE_SEEN" -eq 0 ]] \
        || fail '--authority-role is not accepted with --bundle-preflight'
elif [[ "$AUTHORITY_ROLE" != authority && "$AUTHORITY_ROLE" != standby ]]; then
    fail '--authority-role authority|standby is mandatory outside bundle preflight'
fi

for command_name in realpath stat find grep awk sha256sum flock nginx systemctl curl cat \
    install cp rm sort date mkdir chmod chown sleep tail env timeout runuser mktemp \
    python3 sync; do
    require_command "$command_name"
done

if [[ "$MODE" != bundle-preflight ]]; then
    # This is the first production-state operation after argument/command
    # validation.  Reject a role mismatch before Composer, HTTP, backup,
    # service-policy or live-code work can have any persistent side effect.
    validate_authority_lock_path
    exec 8<"$AUTHORITY_LOCK_PATH"
    flock -n 8 || fail 'account-authority configuration change is in progress'
    verify_authority_role
fi

validate_staging_lock_path
exec 9<"$LOCK_PATH"
flock -n 9 || fail 'another App content release is in progress'

validate_fixed_paths
validate_bundle_path
validate_bundle_tree
validate_manifest
validate_secret_content
resolve_runtime_tools
preflight_release

if [[ "$MODE" == bundle-preflight ]]; then
    printf 'app-content-release: bundle preflight passed manifest=%s\n' \
        "$EXPECTED_MANIFEST_SHA256"
    exit 0
fi

verify_current_webroot
# Re-check after the potentially long immutable bundle/Web-root preflight so a
# dry-run cannot report success using an authority role that changed meanwhile.
verify_authority_role

if [[ "$MODE" == dry-run ]]; then
    printf 'app-content-release: dry-run passed manifest=%s authority-role=%s\n' \
        "$EXPECTED_MANIFEST_SHA256" "$AUTHORITY_ROLE"
    exit 0
fi

# HTTP itself can update access logs, caches, schedules or role metadata, so it
# is deliberately outside the no-persistent-write dry-run branch.  Apply checks
# the local route both before mutation and after FPM returns.
systemctl is-active --quiet "$FPM_SERVICE" || fail 'PHP-FPM must be active before deployment'
require_fpm_enabled_policy
FPM_WAS_ACTIVE=1
probe_direct_php_blocked
probe_unauthorized_api "$AUTHORITY_ROLE"
# Close the last validation-to-use gap before any live or backup write.
verify_authority_role
validate_bundle_path
validate_bundle_tree
validate_manifest
create_code_backup
protect_fpm_from_incomplete_boot
systemctl stop "$FPM_SERVICE"
if systemctl is-active --quiet "$FPM_SERVICE"; then
    fail 'PHP-FPM did not stop; live code was not modified'
fi
install_release_unit
verify_live_release_hashes
verify_installed_jwt_autoload
# The newly installed plugin consumes the same fixed marker verified here.
# Keep FPM stopped until that marker and the pinned verifier pass again.
verify_authority_role
probe_offline_wordpress_api "$AUTHORITY_ROLE"
release_fpm_boot_guard
systemctl start "$FPM_SERVICE"
systemctl is-active --quiet "$FPM_SERVICE"
# Keep the running unit persistently masked until all online validation passes.
# Masking an active unit does not stop it, so the local probes still execute.
protect_fpm_from_incomplete_boot

run_webroot_verifier
verify_authority_role
nginx -t >/dev/null
probe_direct_php_blocked
probe_unauthorized_api "$AUTHORITY_ROLE"
release_fpm_boot_guard

ROLLBACK_READY=0
trap - ERR INT TERM HUP
printf 'app-content-release: applied manifest=%s authority-role=%s backup=%s\n' \
    "$EXPECTED_MANIFEST_SHA256" "$AUTHORITY_ROLE" "$BACKUP_DIR"
