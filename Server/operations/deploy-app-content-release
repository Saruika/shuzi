        && -d "$TARGET_DIR" && ! -L "$TARGET_DIR" \
        && "$(realpath -e -- "$TARGET_DIR")" == "$TARGET_DIR" \
        && "$(stat -c '%u' "$TARGET_DIR")" == 0 ]]; then
        fail 'live release target boundary is unsafe'
        return 1
    fi
