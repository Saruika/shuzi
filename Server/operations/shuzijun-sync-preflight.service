[Unit]
Description=Validate Shuzijun Nginx before standby synchronization

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/sbin/nginx -t -q
TimeoutStartSec=2min
Restart=no

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
PrivateNetwork=true
ReadOnlyPaths=/etc/nginx /etc/letsencrypt /var/www/html/shuzijun.com.cn
ReadWritePaths=/var/log/nginx
InaccessiblePaths=-/root -/var/lib/shuzijun-sync -/var/backups
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE
AmbientCapabilities=
SystemCallArchitectures=native
