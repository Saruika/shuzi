                and read_marker(root_fd, main_claim.name, allow_missing=True) is None
                and read_marker(root_fd, watchdog_claim.name, allow_missing=True) is None):
            raise SystemExit(0)
    finally:
        os.close(root_fd)
    time.sleep(1)
