        # sender if its type changes between the no-follow stat and open.
        flags = (
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0)
        )
        descriptor = os.open(name, flags, dir_fd=directory_fd)
        try:
            initial = os.fstat(descriptor)
            if (not stat.S_ISREG(initial.st_mode) or initial.st_nlink != 1
                    or initial.st_dev != source_device
                    or initial.st_size < 0 or initial.st_size > MAX_FILE_BYTES
                    or identity(initial) != identity(entry)):
                raise SystemExit(1)
            file_count += 1
            upload_bytes += initial.st_size
            if file_count > MAX_FILES or upload_bytes > MAX_BATCH_BYTES:
                raise SystemExit(1)
            if mode == "preflight":
                continue
            if mode == "snapshot":
                final = os.fstat(descriptor)
                if identity(final) != identity(initial):
                    raise SystemExit(1)
                include_snapshot(b"F", relative, final)
                continue
            if total_size + initial.st_size + database_budget > MAX_BATCH_BYTES:
                raise SystemExit(1)
            filesystem = os.statvfs(root)
            if (filesystem.f_bavail * filesystem.f_frsize
                    < initial.st_size + database_budget + MIN_FREE_RESERVE):
                raise SystemExit(1)
            destination = destination_directory / name
            output = os.open(
                destination,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
            )
            try:
                remaining = initial.st_size
                while remaining:
                    chunk = os.read(descriptor, min(remaining, 1024 * 1024))
                    if not chunk:
                        raise SystemExit(1)
                    filesystem = os.statvfs(root)
                    if (filesystem.f_bavail * filesystem.f_frsize
                            < len(chunk) + database_budget + MIN_FREE_RESERVE):
                        raise SystemExit(1)
                    view = memoryview(chunk)
                    while view:
                        written = os.write(output, view)
                        if written <= 0:
                            raise SystemExit(1)
                        view = view[written:]
                    remaining -= len(chunk)
                if os.read(descriptor, 1):
                    raise SystemExit(1)
                os.fsync(output)
                completed = os.fstat(output)
                if (not stat.S_ISREG(completed.st_mode) or completed.st_uid != 0
                        or completed.st_gid != 0 or stat.S_IMODE(completed.st_mode) != 0o600
                        or completed.st_nlink != 1
                        or completed.st_size != initial.st_size):
                    raise SystemExit(1)
            finally:
                os.close(output)
            final = os.fstat(descriptor)
            if identity(final) != identity(initial):
                raise SystemExit(1)
            include_snapshot(b"F", relative, final)
            total_size += initial.st_size
        finally:
            os.close(descriptor)

filesystem = os.statvfs(root)
if mode == "preflight":
    if upload_bytes + database_budget > MAX_BATCH_BYTES:
        raise SystemExit(1)
    required_bytes = upload_bytes + database_budget + MIN_FREE_RESERVE
    required_inodes = file_count + directory_count + 1024
    if (filesystem.f_bavail * filesystem.f_frsize < required_bytes
            or filesystem.f_favail < required_inodes):
        raise SystemExit(1)
elif mode == "stage":
    if (filesystem.f_bavail * filesystem.f_frsize
            < database_budget + MIN_FREE_RESERVE
            or total_size + database_budget > MAX_BATCH_BYTES):
        raise SystemExit(1)
if mode in {"stage", "snapshot"}:
    print(f"{upload_bytes}:{file_count}:{directory_count}:{snapshot.hexdigest()}")
PY
}

bound_database_sql_stream() {
    env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 9<<'PY'
import os

MAX_DATABASE_SQL_BYTES = 4 * 1024 * 1024 * 1024
total = 0
while True:
    chunk = os.read(0, 1024 * 1024)
    if not chunk:
        break
    total += len(chunk)
    if total > MAX_DATABASE_SQL_BYTES:
        raise SystemExit(1)
    view = memoryview(chunk)
    while view:
        written = os.write(1, view)
        if written <= 0:
            raise SystemExit(1)
        view = view[written:]
if total == 0:
    raise SystemExit(1)
PY
}

store_staged_database() {
    local temporary_root=$1 staged_upload_bytes=$2
    env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 \
        "$temporary_root" "$staged_upload_bytes" 9<<'PY'
import ctypes
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

MAX_DATABASE_GZIP_BYTES = 8 * 1024 * 1024 * 1024
MAX_BATCH_BYTES = 64 * 1024 * 1024 * 1024
MIN_FREE_RESERVE = 1024 * 1024 * 1024
root = Path(sys.argv[1])
upload_text = sys.argv[2]
if not re.fullmatch(r"(?:0|[1-9][0-9]{0,18})", upload_text):
    raise SystemExit(1)
upload_bytes = int(upload_text)
if upload_bytes > MAX_BATCH_BYTES:
    raise SystemExit(1)
metadata = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700):
    raise SystemExit(1)
destination = root / "shuzijun-sync.sql.gz"
try:
    destination.lstat()
except FileNotFoundError:
    pass
else:
    raise SystemExit(1)
descriptor, temp_name = tempfile.mkstemp(prefix=".database-gzip.", dir=root)
temp_path = Path(temp_name)
total = 0
try:
    os.fchmod(descriptor, 0o600)
    while True:
        chunk = os.read(0, 1024 * 1024)
        if not chunk:
            break
        total += len(chunk)
        if (total > MAX_DATABASE_GZIP_BYTES
                or upload_bytes + total > MAX_BATCH_BYTES):
            raise SystemExit(1)
        filesystem = os.statvfs(root)
        if filesystem.f_bavail * filesystem.f_frsize < len(chunk) + MIN_FREE_RESERVE:
            raise SystemExit(1)
        view = memoryview(chunk)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise SystemExit(1)
            view = view[written:]
    if total == 0:
        raise SystemExit(1)
    os.fsync(descriptor)
    completed = os.fstat(descriptor)
    if (not stat.S_ISREG(completed.st_mode) or completed.st_uid != 0
            or completed.st_gid != 0 or stat.S_IMODE(completed.st_mode) != 0o600
            or completed.st_nlink != 1 or completed.st_size != total):
        raise SystemExit(1)
    os.close(descriptor)
    descriptor = -1
    named = temp_path.lstat()
    if (named.st_dev, named.st_ino) != (completed.st_dev, completed.st_ino):
        raise SystemExit(1)
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise SystemExit(1)
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    if renameat2(-100, os.fsencode(temp_path), -100, os.fsencode(destination), 1) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    directory = os.open(root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
finally:
    if descriptor >= 0:
        os.close(descriptor)
    try:
        temp_path.unlink()
    except FileNotFoundError:
        pass
PY
}

manage_sender_staging() {
    local action=$1 target=${2-} token=${3-}
    /usr/bin/timeout --signal=TERM --kill-after=10s 30m \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 \
        "$action" "$GENERATION_ROOT" "$SENDER_STAGING_ROOT" \
        "$target" "$token" 9<<'PY'
import json
import os
import re
import shutil
import stat
import sys
from pathlib import Path

action = sys.argv[1]
generation_root = Path(sys.argv[2])
staging_root = Path(sys.argv[3])
target_text = sys.argv[4]
token = sys.argv[5]
if (action not in {"clean-stale", "allocate", "remove"}
        or generation_root != Path("/var/lib/shuzijun-sync")
        or staging_root != generation_root / "sender-staging"):
    raise SystemExit(1)

generation_meta = generation_root.lstat()
staging_meta = staging_root.lstat()
if (generation_root.resolve(strict=True) != generation_root
        or not stat.S_ISDIR(generation_meta.st_mode)
        or generation_meta.st_uid != 0 or generation_meta.st_gid != 0
        or stat.S_IMODE(generation_meta.st_mode) != 0o700
        or staging_root.resolve(strict=True) != staging_root
        or not stat.S_ISDIR(staging_meta.st_mode)
        or staging_meta.st_uid != 0 or staging_meta.st_gid != 0
        or stat.S_IMODE(staging_meta.st_mode) != 0o700
        or staging_meta.st_dev != generation_meta.st_dev
        or not shutil.rmtree.avoids_symlink_attacks):
    raise SystemExit(1)

batch_pattern = re.compile(r"batch\.([0-9a-f]{32})")
allocating_pattern = re.compile(r"\.allocating\.([0-9a-f]{32})")
retiring_pattern = re.compile(r"\.retiring\.([0-9a-f]{32})")
owner_name = ".sender-staging-owner.json"

def identity(value):
    return value.st_dev, value.st_ino

def expected_owner(value):
    return (
        json.dumps(
            {"token": value, "version": 1},
            ensure_ascii=True,
            separators=(",", ":"),
            sort_keys=True,
        ) + "\n"
    ).encode("ascii")

def validate_tree(path, kind, value):
    metadata = path.lstat()
    if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0
            or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o700
            or metadata.st_dev != staging_meta.st_dev):
        raise RuntimeError("unsafe sender staging tree")
    entries = list(path.iterdir())
    if kind == "allocating" and any(entry.name != owner_name for entry in entries):
        raise RuntimeError("unsafe allocating tree")
    owner = path / owner_name
    try:
        owner_meta = owner.lstat()
    except FileNotFoundError:
        if kind == "batch" or (kind == "allocating" and entries):
            raise RuntimeError("missing sender staging owner")
    else:
        if (not stat.S_ISREG(owner_meta.st_mode) or owner_meta.st_uid != 0
                or owner_meta.st_gid != 0 or stat.S_IMODE(owner_meta.st_mode) != 0o600
                or owner_meta.st_nlink != 1 or owner_meta.st_dev != staging_meta.st_dev):
            raise RuntimeError("unsafe sender staging owner")
        payload = owner.read_bytes()
        expected = expected_owner(value)
        if (kind == "batch" and payload != expected) or (
                kind in {"allocating", "retiring"} and not expected.startswith(payload)):
            raise RuntimeError("invalid sender staging owner")
    for _directory, directory_names, file_names, directory_fd in os.fwalk(
        path, topdown=True, follow_symlinks=False
    ):
        current = os.fstat(directory_fd)
        if (not stat.S_ISDIR(current.st_mode) or current.st_uid != 0
                or current.st_gid != 0 or stat.S_IMODE(current.st_mode) != 0o700
                or current.st_dev != staging_meta.st_dev):
            raise RuntimeError("unsafe sender staging directory")
        for name in directory_names:
            child = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            if (not stat.S_ISDIR(child.st_mode) or child.st_uid != 0
                    or child.st_gid != 0 or stat.S_IMODE(child.st_mode) != 0o700
                    or child.st_dev != staging_meta.st_dev):
                raise RuntimeError("unsafe sender staging child directory")
        for name in file_names:
            child = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            if (not stat.S_ISREG(child.st_mode) or child.st_uid != 0
                    or child.st_gid != 0 or stat.S_IMODE(child.st_mode) != 0o600
                    or child.st_nlink != 1 or child.st_dev != staging_meta.st_dev):
                raise RuntimeError("unsafe sender staging child file")
    return identity(metadata)

def remove_tree(path, kind, value):
    expected_identity = validate_tree(path, kind, value)
    if identity(path.lstat()) != expected_identity:
        raise RuntimeError("sender staging identity changed")
    if kind != "retiring":
        retiring = staging_root / f".retiring.{value}"
        try:
            retiring.lstat()
        except FileNotFoundError:
            pass
        else:
            raise RuntimeError("sender retiring collision")
        os.rename(path, retiring)
        os.fsync(staging_fd)
        path = retiring
        kind = "retiring"
        validate_tree(path, kind, value)
    shutil.rmtree(path)
    os.fsync(staging_fd)

staging_fd = os.open(
    staging_root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
)
try:
    if action == "clean-stale":
        if target_text or token:
            raise SystemExit(1)
        stale = []
        for entry in staging_root.iterdir():
            match = batch_pattern.fullmatch(entry.name)
            kind = "batch"
            if match is None:
                match = allocating_pattern.fullmatch(entry.name)
                kind = "allocating"
            if match is None:
                match = retiring_pattern.fullmatch(entry.name)
                kind = "retiring"
            if match is None:
                raise RuntimeError("unknown sender staging entry")
            value = match.group(1)
            validate_tree(entry, kind, value)
            stale.append((entry, kind, value))
        for entry, kind, value in stale:
            remove_tree(entry, kind, value)
    elif action == "allocate":
        if (not re.fullmatch(r"[0-9a-f]{32}", token)
                or Path(target_text) != staging_root / f"batch.{token}"):
            raise SystemExit(1)
        target = Path(target_text)
        allocating = staging_root / f".allocating.{token}"
        for candidate in (target, allocating):
            try:
                candidate.lstat()
            except FileNotFoundError:
                pass
            else:
                raise RuntimeError("sender staging collision")
        os.mkdir(allocating, 0o700)
        os.chown(allocating, 0, 0)
        owner = allocating / owner_name
        descriptor = os.open(
            owner,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o600,
        )
        try:
            os.fchmod(descriptor, 0o600)
            payload = expected_owner(token)
            view = memoryview(payload)
            while view:
                written = os.write(descriptor, view)
                if written <= 0:
                    raise RuntimeError("short sender owner write")
                view = view[written:]
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        allocating_fd = os.open(
            allocating, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
        )
        try:
            os.fsync(allocating_fd)
        finally:
            os.close(allocating_fd)
        validate_tree(allocating, "allocating", token)
        os.rename(allocating, target)
        os.fsync(staging_fd)
        validate_tree(target, "batch", token)
    else:
        if not re.fullmatch(r"[0-9a-f]{32}", token):
            raise SystemExit(1)
        target = Path(target_text)
        if target == staging_root / f"batch.{token}":
            kind = "batch"
        elif target == staging_root / f".allocating.{token}":
            kind = "allocating"
        else:
            raise SystemExit(1)
        try:
            target.lstat()
        except FileNotFoundError:
            raise SystemExit(0)
        remove_tree(target, kind, token)
finally:
    os.close(staging_fd)
PY
}

read_database_logical_bytes() {
    local output
    # This query runs while the global site-operation lock is held, so it must
    # never inherit the outer eight-hour sync budget. Capture the status before
    # accepting stdout: a client that prints a plausible value and then hangs
    # or fails is not a successful size observation.
    output=$(
        /usr/bin/timeout --signal=TERM --kill-after=5s 30s \
            /usr/bin/env -i PATH="$PATH" LC_ALL=C LANG=C \
            /usr/bin/wp db query \
            'SELECT COALESCE(SUM(data_length + index_length), 0) FROM information_schema.tables WHERE table_schema = DATABASE();' \
            --skip-column-names --allow-root
    ) || return 1
    [[ "$output" =~ ^(0|[1-9][0-9]{0,18})$ ]] || return 1
    # A rollback SQL stream is capped at 4 GiB. Reject a database that cannot
    # be represented by that recovery bound before any media staging begins.
    if (( ${#output} > 10 )) \
        || { (( ${#output} == 10 )) && [[ "$output" > 4294967296 ]]; }; then
        return 1
    fi
    printf '%s\n' "$output"
}

FPM_FREEZE_TOKEN=
TMP=
TMP_ALLOCATION=
TMP_TOKEN=
cleanup_sender() {
    local status=$?
    trap - EXIT INT TERM HUP
    if [[ -n "$FPM_FREEZE_TOKEN" ]]; then
        if primary_fpm_freeze_state recover "$FPM_FREEZE_TOKEN"; then
            FPM_FREEZE_TOKEN=
        else
            printf 'sync sender: CRITICAL primary PHP-FPM recovery failed\n' >&2
            status=1
        fi
    fi
    if [[ -n "$TMP_TOKEN" ]]; then
        if [[ "$TMP_TOKEN" =~ ^[0-9a-f]{32}$ ]]; then
            manage_sender_staging remove "$TMP" "$TMP_TOKEN" || status=1
            manage_sender_staging remove "$TMP_ALLOCATION" "$TMP_TOKEN" || status=1
        else
            printf 'sync sender: refusing unsafe temporary path cleanup\n' >&2
            status=1
        fi
    fi
    exit "$status"
}

test -f "$KEY" && test ! -L "$KEY"
test "$(realpath -e -- "$KEY")" = "$KEY"
test "$(stat -c '%u:%h' "$KEY")" = '0:1'
key_mode=$(stat -c '%a' "$KEY")
(( (8#$key_mode & 8#077) == 0 ))
for known_hosts_parent in /etc /etc/shuzijun; do
    test -d "$known_hosts_parent" && test ! -L "$known_hosts_parent"
    test "$(realpath -e -- "$known_hosts_parent")" = "$known_hosts_parent"
    test "$(stat -c '%u:%g:%a' "$known_hosts_parent")" = '0:0:755'
done
test -f "$SYNC_KNOWN_HOSTS" && test ! -L "$SYNC_KNOWN_HOSTS"
test "$(realpath -e -- "$SYNC_KNOWN_HOSTS")" = "$SYNC_KNOWN_HOSTS"
test "$(stat -c '%u:%g:%h:%a' "$SYNC_KNOWN_HOSTS")" = '0:0:1:600'
test "$(sha256sum "$SYNC_KNOWN_HOSTS" | awk '{ print $1 }')" = "$SYNC_KNOWN_HOSTS_SHA256"
test "$(wc -l < "$SYNC_KNOWN_HOSTS")" -eq 1
grep -Fxq '129.226.202.207 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH/BHsxAKRunOi8GK2tlH20Th7mj9zyTxKUq1lLa5kw0' \
    "$SYNC_KNOWN_HOSTS"

# Prevent the sender from reading a release unit while any coordinated site
# operation is active. The lock lives under a root-only managed directory, so
# an unprivileged local identity cannot indefinitely deny synchronization.
validate_generation_state_root
enter_site_operation_lock_context "$@"
verify_authority_role authority
"$VERIFY" "$SITE"

SSH=(ssh -F /dev/null -i "$KEY" -o IdentitiesOnly=yes -o BatchMode=yes \
    -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$SYNC_KNOWN_HOSTS" \
    -o GlobalKnownHostsFile=/dev/null -o HostKeyAlgorithms=ssh-ed25519 \
    -o UpdateHostKeys=no -o ConnectTimeout=15 -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=2 -o TCPKeepAlive=yes "$TRANSPORT_USER"@"$HOST")

receiver_control_query() {
    local operation=$1
    [[ "$operation" == --attest || "$operation" == --protocol ]] || return 1
    /usr/bin/timeout --signal=TERM --kill-after=5s 45s \
        "${SSH[@]}" "sudo $REMOTE_RECEIVER $operation"
}

receiver_attestation=$(receiver_control_query --attest) || exit 1
test "$receiver_attestation" = "$REMOTE_RECEIVER_SHA256  $REMOTE_RECEIVER"
receiver_protocol=$(receiver_control_query --protocol) || exit 1
test "$receiver_protocol" = "$SYNC_PROTOCOL"

# Install cleanup before the first sender temporary-tree mutation. Signal exits
# therefore recover FPM and remove an already-recorded tree on every path.
trap cleanup_sender EXIT
trap 'exit 130' INT TERM HUP
# SIGKILL during a prior monotonic-state publication can leave only this exact
# root-owned tokenized temporary. Reclaim it before any new sender mutation;
# malformed final state and unknown same-prefix entries remain fail-closed.
clean_stale_generation_temporaries
# SIGKILL can land after the atomic freeze marker is published but before its
# token reaches this shell or a watchdog unit starts. Recover any exact durable
# marker/claim before allocating new staging; malformed state stays fail-closed.
primary_fpm_freeze_state recover
verify_primary_fpm_active
verify_primary_nginx_active
manage_sender_staging clean-stale
IFS= read -r TMP_TOKEN < /proc/sys/kernel/random/uuid
TMP_TOKEN=${TMP_TOKEN//-/}
[[ "$TMP_TOKEN" =~ ^[0-9a-f]{32}$ ]]
TMP_ALLOCATION="$SENDER_STAGING_ROOT/.allocating.$TMP_TOKEN"
TMP="$SENDER_STAGING_ROOT/batch.$TMP_TOKEN"
manage_sender_staging allocate "$TMP" "$TMP_TOKEN"
append_sync_authority_event start

cd "$SITE"
DATABASE_LOGICAL_BYTES=$(read_database_logical_bytes) || exit 1
audit_or_stage_uploads preflight "$TMP" "$DATABASE_LOGICAL_BYTES"

# Copy through fd-pinned, no-follow readers.  This pass enforces the limits on
# the bytes actually staged and rejects a source inode that changes while read,
# avoiding rsync's scan/copy aggregate-size race.
STAGED_UPLOAD_SNAPSHOT=$(
    audit_or_stage_uploads stage "$TMP" "$DATABASE_LOGICAL_BYTES"
)
if [[ ! "$STAGED_UPLOAD_SNAPSHOT" =~ ^(0|[1-9][0-9]{0,18}):(0|[1-9][0-9]{0,18}):(0|[1-9][0-9]{0,18}):[0-9a-f]{64}$ ]]; then
    exit 1
fi
STAGED_UPLOAD_BYTES=${BASH_REMATCH[1]}

# Freeze application writes only after every media byte is local.  Nginx stays
# active throughout.  PHP-FPM is restarted and accepted as active/running
# immediately after the bounded database stream, before hashing or transfer.
verify_primary_nginx_active
verify_primary_fpm_active
FPM_FREEZE_TOKEN=$(primary_fpm_freeze_state create '' "$$")
if [[ ! "$FPM_FREEZE_TOKEN" =~ ^[0-9a-f]{64}$ ]]; then
    exit 1
fi
FPM_WATCHDOG_UNIT="shuzijun-primary-fpm-recovery-${FPM_FREEZE_TOKEN:0:16}.service"
/usr/bin/timeout --signal=TERM --kill-after=2s 10s \
    /usr/bin/systemd-run --quiet --collect --unit="$FPM_WATCHDOG_UNIT" \
    --description='Recover Shuzijun primary PHP-FPM after bounded sync freeze' \
    --service-type=exec \
    --property=User=root --property=Group=root --property=UMask=0077 \
    --property=RuntimeMaxSec=7min --property=TimeoutStopSec=30s \
    --property=Restart=on-failure --property=RestartSec=1s \
    --property=StartLimitIntervalSec=10min --property=StartLimitBurst=5 \
    --property=KillMode=control-group --property=NoNewPrivileges=true \
    --property=PrivateTmp=true --property=PrivateDevices=true \
    --property=ProtectSystem=strict --property=ProtectHome=true \
    --property=ReadWritePaths=/run/shuzijun-sync \
    --property=ProtectHostname=true --property=ProtectClock=true \
    --property=ProtectKernelTunables=true --property=ProtectKernelModules=true \
    --property=ProtectKernelLogs=true --property=ProtectControlGroups=true \
    --property=RestrictSUIDSGID=true --property=LockPersonality=true \
    --property=RestrictRealtime=true --property=RestrictAddressFamilies=AF_UNIX \
    --property=CapabilityBoundingSet= --property=AmbientCapabilities= \
    --property=SystemCallArchitectures=native \
    /usr/local/sbin/sync-to-backup --watch-primary-fpm "$FPM_FREEZE_TOKEN"
verify_primary_fpm_watchdog_active "$FPM_WATCHDOG_UNIT"
/usr/bin/timeout --signal=TERM --kill-after=5s 15s \
    /usr/bin/systemctl stop "$FPM_SERVICE"
primary_fpm_freeze_state begin-frozen "$FPM_FREEZE_TOKEN"
verify_primary_fpm_inactive
verify_primary_nginx_active
FROZEN_UPLOAD_SNAPSHOT=$(
    /usr/bin/timeout --signal=TERM --kill-after=5s 20s \
        /usr/bin/env -i PATH="$PATH" LC_ALL=C LANG=C \
        /bin/bash --noprofile --norc -o pipefail -c \
        "$(declare -f audit_or_stage_uploads); \
SITE=\"\$1\"; audit_or_stage_uploads snapshot \"\$2\" \"\$3\"" \
        frozen-upload-snapshot "$SITE" "$TMP" "$DATABASE_LOGICAL_BYTES"
)
test "$FROZEN_UPLOAD_SNAPSHOT" = "$STAGED_UPLOAD_SNAPSHOT"

# No plaintext SQL file is created.  Any pipeline failure reaches the EXIT
# recovery trap; an independent transient systemd service is the SIGKILL-safe
# external watchdog. It owns a root-only marker with a monotonic hard deadline.
# The complete export/compress/store pipeline has its own short hard deadline,
# so the outer eight-hour transfer timeout can never become an eight-hour FPM
# outage. timeout's nonzero/TERM/KILL outcomes all return through cleanup_sender.
/usr/bin/timeout --signal=TERM --kill-after=10s 90s \
    /usr/bin/env -i PATH="$PATH" LC_ALL=C LANG=C \
    /bin/bash --noprofile --norc -o pipefail -c \
    "$(declare -f bound_database_sql_stream); \
$(declare -f store_staged_database); \
cd \"\$1\" || exit 1; wp db export - --add-drop-table --allow-root --quiet \
| bound_database_sql_stream | gzip -9 \
| store_staged_database \"\$2\" \"\$3\"" \
    frozen-database-export "$SITE" "$TMP" "$STAGED_UPLOAD_BYTES"

primary_fpm_freeze_state recover "$FPM_FREEZE_TOKEN"
FPM_FREEZE_TOKEN=

# Staging can take hours on a large site. Re-attest the exact receiver and
# protocol immediately before consuming the next monotonic generation.
receiver_attestation=$(receiver_control_query --attest) || exit 1
test "$receiver_attestation" = "$REMOTE_RECEIVER_SHA256  $REMOTE_RECEIVER"
receiver_protocol=$(receiver_control_query --protocol) || exit 1
test "$receiver_protocol" = "$SYNC_PROTOCOL"
GENERATION=$(issue_generation)
env -i PATH="$PATH" LC_ALL=C LANG=C /usr/bin/python3 -I - \
    "$TMP" "$GENERATION" <<'PY'
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve(strict=True)
generation = int(sys.argv[2])
token_match = re.fullmatch(r"batch\.([0-9a-f]{32})", root.name)
if (str(generation) != sys.argv[2] or generation < 1 or generation >= 2**63
        or token_match is None):
    raise SystemExit(1)
token = token_match.group(1)
max_files = 100_000
max_file_bytes = 8 * 1024 * 1024 * 1024
max_batch_bytes = 64 * 1024 * 1024 * 1024
files = []
total_size = 0
for directory, directory_names, file_names in os.walk(root, followlinks=False):
    base = Path(directory)
    for name in directory_names:
        metadata = (base / name).lstat()
        if not stat.S_ISDIR(metadata.st_mode):
            raise SystemExit(1)
    for name in file_names:
        path = base / name
        relative = path.relative_to(root).as_posix()
        metadata = path.lstat()
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
            raise SystemExit(1)
        if relative == ".sender-staging-owner.json":
            expected_owner = (
                json.dumps(
                    {"token": token, "version": 1},
                    ensure_ascii=True,
                    separators=(",", ":"),
                    sort_keys=True,
                ) + "\n"
            ).encode("ascii")
            if (metadata.st_uid != 0 or metadata.st_gid != 0
                    or stat.S_IMODE(metadata.st_mode) != 0o600
                    or path.read_bytes() != expected_owner):
                raise SystemExit(1)
            continue
        if relative != "shuzijun-sync.sql.gz" and not relative.startswith("wp-content/uploads/"):
            raise SystemExit(1)
        if relative.startswith("wp-content/uploads/"):
            lower_name = path.name.lower()
            forbidden_names = {".htaccess", ".user.ini"}
            forbidden_suffixes = {
                ".cgi", ".pl", ".py", ".rb", ".sh", ".bash", ".zsh", ".fish",
                ".exe", ".com", ".bat", ".cmd", ".ps1", ".jar", ".war",
            }
            if (lower_name in forbidden_names or ".php" in lower_name
                    or ".phtml" in lower_name or ".phar" in lower_name
                    or any(lower_name.endswith(suffix) for suffix in forbidden_suffixes)):
                raise SystemExit(1)
        if metadata.st_size < 0 or metadata.st_size > max_file_bytes:
            raise SystemExit(1)
        total_size += metadata.st_size
        if total_size > max_batch_bytes or len(files) >= max_files:
            raise SystemExit(1)
        digest = hashlib.sha256()
        with path.open("rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(chunk)
        files.append({"path": relative, "sha256": digest.hexdigest(), "size": metadata.st_size})
files.sort(key=lambda item: item["path"])
if not any(item["path"] == "shuzijun-sync.sql.gz" for item in files):
    raise SystemExit(1)
document = {"files": files, "generation": generation, "version": 2}
payload = (json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True) + "\n").encode()
manifest = root / "shuzijun-sync-manifest.json"
descriptor = os.open(manifest, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(descriptor, "wb", closefd=True) as stream:
    stream.write(payload)
    stream.flush()
    os.fsync(stream.fileno())
PY
ssh-keygen -Y sign -q -f "$KEY" -n shuzijun-sync \
    "$TMP/shuzijun-sync-manifest.json"

INGEST_RECEIPT=$(
    if ! env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I - "$TMP" <<'PY' \
        | "${SSH[@]}" "sudo $REMOTE_RECEIVER --ingest"; then
import hashlib
import json
import os
import stat
import struct
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve(strict=True)
manifest_path = root / "shuzijun-sync-manifest.json"
signature_path = root / "shuzijun-sync-manifest.json.sig"
manifest = manifest_path.read_bytes()
signature = signature_path.read_bytes()
if not manifest or len(manifest) > 32 * 1024 * 1024 or not signature or len(signature) > 64 * 1024:
    raise SystemExit(1)
document = json.loads(manifest.decode("utf-8"))
canonical = (json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True) + "\n").encode()
if canonical != manifest or set(document) != {"files", "generation", "version"}:
    raise SystemExit(1)

def write_all(payload):
    view = memoryview(payload)
    while view:
        written = os.write(1, view)
        if written <= 0:
            raise SystemExit(1)
        view = view[written:]

for control in (manifest, signature):
    write_all(struct.pack(">Q", len(control)))
    write_all(control)

for item in document["files"]:
    relative = item["path"]
    expected_size = item["size"]
    expected_digest = item["sha256"]
    path = root / relative
    resolved = path.resolve(strict=True)
    try:
        resolved.relative_to(root)
    except ValueError:
        raise SystemExit(1)
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    digest = hashlib.sha256()
    try:
        metadata = os.fstat(descriptor)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1
                or metadata.st_size != expected_size):
            raise SystemExit(1)
        remaining = expected_size
        while remaining:
            chunk = os.read(descriptor, min(remaining, 1024 * 1024))
            if not chunk:
                raise SystemExit(1)
            digest.update(chunk)
            write_all(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise SystemExit(1)
    finally:
        os.close(descriptor)
    if digest.hexdigest() != expected_digest:
        raise SystemExit(1)
PY
        exit 1
    fi
    # Command substitution removes trailing newlines.  A non-newline sentinel
    # preserves the receiver's exact stdout bytes for a fail-closed comparison.
    printf '\036'
)
printf -v EXPECTED_INGEST_RECEIPT \
    'sync-applied generation=%s receiver-sha256=%s protocol=%s cache=flushed signed=true uploads-only=true\n\036' \
    "$GENERATION" "$REMOTE_RECEIVER_SHA256" "$SYNC_PROTOCOL"
test "$INGEST_RECEIPT" = "$EXPECTED_INGEST_RECEIPT"

append_sync_authority_event completion "$GENERATION"
