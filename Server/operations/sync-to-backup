primary_fpm_freeze_state() {
    local mode=$1 expected_token=${2-} owner_pid=${3-}
    local -a runner=(
        /usr/bin/timeout --signal=TERM --kill-after=5s 55s
        /usr/bin/env -i
    )
    if [[ "$mode" == watch ]]; then
        # The independent watchdog intentionally lives for the full bounded
        # freeze deadline and is capped by its transient systemd RuntimeMax.
        runner=(/usr/bin/env -i)
    fi
    "${runner[@]}" PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 \
        "$mode" "$FPM_FREEZE_ROOT" "$FPM_FREEZE_MARKER" \
        "$FPM_SERVICE" "$expected_token" \
        "$owner_pid" "$FPM_FREEZE_ARM_LIMIT_SECONDS" \
        "$FPM_FREEZE_LIMIT_SECONDS" 9<<'PY'
import json
import os
import re
import secrets
import stat
import subprocess
import sys
import time
from pathlib import Path

mode = sys.argv[1]
root = Path(sys.argv[2])
marker = Path(sys.argv[3])
fpm_service = sys.argv[4]
expected_token = sys.argv[5]
owner_text = sys.argv[6]
arm_limit_text = sys.argv[7]
freeze_limit_text = sys.argv[8]
if (root != Path("/run/shuzijun-sync")
        or marker != root / "primary-fpm-freeze.json"
        or fpm_service != "php8.3-fpm.service"
        or mode not in {"create", "begin-frozen", "recover", "watch"}
        or not re.fullmatch(r"[1-9][0-9]{0,9}", arm_limit_text)
        or not re.fullmatch(r"[1-9][0-9]{0,9}", freeze_limit_text)):
    raise SystemExit(1)
arm_limit_seconds = int(arm_limit_text)
freeze_limit_seconds = int(freeze_limit_text)
if not 60 <= arm_limit_seconds <= 180 or not 90 <= freeze_limit_seconds <= 240:
    raise SystemExit(1)
main_claim = marker.with_name("primary-fpm-freeze.main-recovery.json")
watchdog_claim = marker.with_name("primary-fpm-freeze.watchdog-recovery.json")
allowed_names = {marker.name, main_claim.name, watchdog_claim.name}

def allowed_state_name(name: str) -> bool:
    return name in allowed_names or re.fullmatch(
        r"\.primary-fpm-freeze\.(?:refresh\.[0-9a-f]{24}|create\.[0-9a-f]{32})",
        name,
    ) is not None

def strict_root() -> int:
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    run_fd = os.open(root.parent, flags)
    try:
        metadata = os.fstat(run_fd)
        if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_gid != 0
                or stat.S_IMODE(metadata.st_mode) & 0o022):
            raise SystemExit(1)
        root_fd = os.open(root.name, flags, dir_fd=run_fd)
    finally:
        os.close(run_fd)
    metadata = os.fstat(root_fd)
    if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != 0
            or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o700):
        os.close(root_fd)
        raise SystemExit(1)
    return root_fd

def process_start_ticks(pid: int) -> int:
    payload = Path(f"/proc/{pid}/stat").read_text(encoding="ascii")
    fields = payload.rsplit(") ", 1)
    if len(fields) != 2:
        raise ValueError("invalid process stat")
    value = fields[1].split()[19]
    if not re.fullmatch(r"[1-9][0-9]*", value):
        raise ValueError("invalid process start time")
    return int(value)

def owner_is_alive(document: dict[str, object]) -> bool:
    try:
        return process_start_ticks(int(document["owner_pid"])) == int(
            document["owner_start_ticks"]
        )
    except (FileNotFoundError, IndexError, KeyError, PermissionError, ValueError):
        return False

def is_ancestor_process(pid: int) -> bool:
    current = os.getppid()
    for _ in range(16):
        if current == pid:
            return True
        try:
            payload = Path(f"/proc/{current}/stat").read_text(encoding="ascii")
            fields = payload.rsplit(") ", 1)
            if len(fields) != 2:
                return False
            parent = fields[1].split()[1]
            if not re.fullmatch(r"[0-9]+", parent):
                return False
            next_pid = int(parent)
        except (FileNotFoundError, IndexError, PermissionError, ValueError):
            return False
        if next_pid <= 0 or next_pid == current:
            return False
        current = next_pid
    return False

def read_marker(root_fd: int, name: str, *, allow_missing: bool = False):
    if not allowed_state_name(name):
        raise SystemExit(1)
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(name, flags, dir_fd=root_fd)
    except FileNotFoundError:
        if allow_missing:
            return None
        raise SystemExit(1)
    try:
        metadata = os.fstat(descriptor)
        named = os.stat(name, dir_fd=root_fd, follow_symlinks=False)
        payload = os.read(descriptor, 4097)
        if os.read(descriptor, 1):
            raise SystemExit(1)
    finally:
        os.close(descriptor)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
            or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1 or metadata.st_size != len(payload)
            or (metadata.st_dev, metadata.st_ino) != (named.st_dev, named.st_ino)
            or not payload.endswith(b"\n")):
        raise SystemExit(1)
    try:
        document = json.loads(payload.decode("ascii"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        raise SystemExit(1)
    canonical = (
        json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True)
        + "\n"
    ).encode("ascii")
    if canonical != payload or set(document) != {
        "created_monotonic_ns", "deadline_monotonic_ns", "owner_pid",
        "owner_start_ticks", "phase", "phase_started_monotonic_ns", "token",
        "version",
    }:
        raise SystemExit(1)
    if (document["version"] != 2
            or document["phase"] not in {"armed", "frozen"}
            or not isinstance(document["token"], str)
            or not re.fullmatch(r"[0-9a-f]{64}", document["token"])
            or type(document["owner_pid"]) is not int
            or not 1 < document["owner_pid"] < 2**31
            or type(document["owner_start_ticks"]) is not int
            or document["owner_start_ticks"] < 1
            or type(document["created_monotonic_ns"]) is not int
            or type(document["phase_started_monotonic_ns"]) is not int
            or type(document["deadline_monotonic_ns"]) is not int
            or document["created_monotonic_ns"] < 1
            or document["phase_started_monotonic_ns"] < document["created_monotonic_ns"]
            or document["deadline_monotonic_ns"]
                <= document["phase_started_monotonic_ns"]):
        raise SystemExit(1)
    expected_limit = (
        arm_limit_seconds if document["phase"] == "armed" else freeze_limit_seconds
    )
    if (document["deadline_monotonic_ns"] - document["phase_started_monotonic_ns"]
            != expected_limit * 1_000_000_000):
        raise SystemExit(1)
    return document

def encoded_document(document: dict[str, object]) -> bytes:
    return (
        json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True)
        + "\n"
    ).encode("ascii")

def write_new_marker(root_fd: int, name: str, document: dict[str, object]) -> None:
    if not allowed_state_name(name):
        raise SystemExit(1)
    payload = encoded_document(document)
    flags = (
        os.O_WRONLY | os.O_CREAT | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    )
    descriptor = os.open(name, flags, 0o600, dir_fd=root_fd)
    try:
        os.fchmod(descriptor, 0o600)
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise SystemExit(1)
            view = view[written:]
        os.fsync(descriptor)
        metadata = os.fstat(descriptor)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
                or metadata.st_nlink != 1 or metadata.st_size != len(payload)):
            raise SystemExit(1)
    finally:
        os.close(descriptor)
    os.fsync(root_fd)

def rename_noreplace(root_fd: int, source: str, destination: str) -> None:
    libc = __import__("ctypes").CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise SystemExit(1)
    renameat2.argtypes = [
        __import__("ctypes").c_int, __import__("ctypes").c_char_p,
        __import__("ctypes").c_int, __import__("ctypes").c_char_p,
        __import__("ctypes").c_uint,
    ]
    renameat2.restype = __import__("ctypes").c_int
    if renameat2(
        root_fd, os.fsencode(source), root_fd, os.fsencode(destination), 1
    ) != 0:
        error = __import__("ctypes").get_errno()
        raise OSError(error, os.strerror(error))

def cleanup_stale_temporaries(root_fd: int) -> None:
    # Called only by a new sender after all durable marker/claim names were
    # positively absent.  Exact root-owned temporary write prefixes can then
    # be reclaimed after SIGKILL; unknown entries remain fail-closed.
    root_meta = os.fstat(root_fd)
    temporary = re.compile(
        r"\.primary-fpm-freeze\.(?:refresh\.[0-9a-f]{24}|create\.[0-9a-f]{32})"
    )
    removed = False
    for name in os.listdir(root_fd):
        if name == "sync.lock":
            # flock(1) owns this inode for the full sender run. Validate its
            # fd/path identity but never lock, replace, truncate or unlink it.
            descriptor = os.open(
                name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
                dir_fd=root_fd,
            )
            try:
                opened = os.fstat(descriptor)
                named = os.stat(name, dir_fd=root_fd, follow_symlinks=False)
            finally:
                os.close(descriptor)
            if (not stat.S_ISREG(opened.st_mode) or opened.st_uid != 0
                    or opened.st_gid != 0 or stat.S_IMODE(opened.st_mode) != 0o600
                    or opened.st_nlink != 1 or opened.st_size != 0
                    or opened.st_dev != root_meta.st_dev
                    or (opened.st_dev, opened.st_ino) != (named.st_dev, named.st_ino)):
                raise RuntimeError("unsafe scheduler lock")
            continue
        if not name.startswith(".primary-fpm-freeze."):
            raise RuntimeError("unknown primary freeze root entry")
        if not temporary.fullmatch(name):
            raise RuntimeError("unknown primary freeze state entry")
        metadata = os.stat(name, dir_fd=root_fd, follow_symlinks=False)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
                or metadata.st_nlink != 1 or metadata.st_dev != root_meta.st_dev
                or metadata.st_size > 4096):
            raise RuntimeError("unsafe primary freeze temporary")
        os.unlink(name, dir_fd=root_fd)
        removed = True
    if removed:
        os.fsync(root_fd)

def publish_new_marker(
    root_fd: int, name: str, document: dict[str, object]
) -> None:
    if name != marker.name:
        raise SystemExit(1)
    temporary = f".primary-fpm-freeze.create.{secrets.token_hex(16)}"
    write_new_marker(root_fd, temporary, document)
    try:
        rename_noreplace(root_fd, temporary, name)
        os.fsync(root_fd)
        if read_marker(root_fd, name) != document:
            raise SystemExit(1)
    finally:
        try:
            os.unlink(temporary, dir_fd=root_fd)
            os.fsync(root_fd)
        except FileNotFoundError:
            pass

def service_snapshot(service: str) -> dict[str, str]:
    result = subprocess.run(
        [
            "/usr/bin/systemctl", "show",
            "--property=LoadState", "--property=ActiveState",
            "--property=SubState", "--property=Result", "--property=MainPID",
            "--property=Job",
            service,
        ],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        text=True, check=False, timeout=5,
    )
    if result.returncode != 0:
        raise SystemExit(1)
    values = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition("=")
        if not separator or key in values:
            raise SystemExit(1)
        values[key] = value
    if set(values) != {
        "LoadState", "ActiveState", "SubState", "Result", "MainPID", "Job"
    }:
        raise SystemExit(1)
    return values

def service_is_healthy(service: str) -> bool:
    values = service_snapshot(service)
    main_pid = values["MainPID"]
    return (
        values["LoadState"] == "loaded"
        and values["ActiveState"] == "active"
        and values["SubState"] == "running"
        and values["Result"] == "success"
        and values["Job"] == ""
        and re.fullmatch(r"[1-9][0-9]*", main_pid) is not None
        and int(main_pid) > 1
    )

def service_is_inactive(service: str) -> bool:
    values = service_snapshot(service)
    return (
        values["LoadState"] == "loaded"
        and values["ActiveState"] == "inactive"
        and values["SubState"] == "dead"
        and values["Result"] == "success"
        and values["MainPID"] == "0"
        and values["Job"] == ""
    )

def claim_for_recovery(root_fd: int, actor: str, *, immediate: bool = False):
    claim = main_claim if actor == "main" else watchdog_claim
    other = watchdog_claim if actor == "main" else main_claim
    existing_claim = read_marker(root_fd, claim.name, allow_missing=True)
    if existing_claim is not None:
        if actor != "watchdog" or (
            expected_token and existing_claim["token"] != expected_token
        ):
            raise SystemExit(1)
        return existing_claim
    document = read_marker(root_fd, marker.name, allow_missing=True)
    if document is not None:
        if expected_token and document["token"] != expected_token:
            raise SystemExit(1)
        if actor == "watchdog" and not immediate and owner_is_alive(document) \
                and time.monotonic_ns() < document["deadline_monotonic_ns"]:
            return None
        try:
            os.rename(marker.name, claim.name, src_dir_fd=root_fd, dst_dir_fd=root_fd)
        except FileNotFoundError:
            return None
        os.fsync(root_fd)
        claimed = read_marker(root_fd, claim.name)
        if claimed != document:
            raise SystemExit(1)
        return claimed
    if actor == "watchdog":
        document = read_marker(root_fd, other.name, allow_missing=True)
        if document is None:
            return None
        if expected_token and document["token"] != expected_token:
            raise SystemExit(1)
        if not immediate and owner_is_alive(document) \
                and time.monotonic_ns() < document["deadline_monotonic_ns"]:
            return None
        try:
            os.rename(other.name, claim.name, src_dir_fd=root_fd, dst_dir_fd=root_fd)
        except FileNotFoundError:
            return None
        os.fsync(root_fd)
        claimed = read_marker(root_fd, claim.name)
        if claimed != document:
            raise SystemExit(1)
        return claimed
    raise SystemExit(1)

def recover_claim(root_fd: int, claim: Path, document: dict[str, object]) -> None:
    if expected_token and document["token"] != expected_token:
        raise SystemExit(1)
    # Always enqueue start, even when the current snapshot still says active.
    # A timed-out `systemctl stop` client can leave a stop job running after the
    # shell has entered cleanup; this replacement start job guarantees the
    # final quiescent state is active rather than trusting that stale snapshot.
    result = subprocess.run(
        ["/usr/bin/systemctl", "start", "--no-block", fpm_service],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, check=False, timeout=5,
    )
    if result.returncode != 0:
        raise SystemExit(1)
    recovery_deadline = time.monotonic() + 35
    while not service_is_healthy(fpm_service):
        if time.monotonic() >= recovery_deadline:
            raise SystemExit(1)
        time.sleep(0.5)
    if not service_is_healthy("nginx.service"):
        raise SystemExit(1)
    current = read_marker(root_fd, claim.name, allow_missing=True)
    if current is None:
        raise SystemExit(1)
    if current != document:
        raise SystemExit(1)
    try:
        os.unlink(claim.name, dir_fd=root_fd)
    except FileNotFoundError:
        raise SystemExit(1)
    os.fsync(root_fd)

def replace_marker(root_fd: int, before: dict[str, object], after: dict[str, object]) -> None:
    temporary = f".primary-fpm-freeze.refresh.{secrets.token_hex(12)}"
    write_new_marker(root_fd, temporary, after)
    try:
        libc = __import__("ctypes").CDLL(None, use_errno=True)
        renameat2 = getattr(libc, "renameat2", None)
        if renameat2 is None:
            raise SystemExit(1)
        renameat2.argtypes = [
            __import__("ctypes").c_int, __import__("ctypes").c_char_p,
            __import__("ctypes").c_int, __import__("ctypes").c_char_p,
            __import__("ctypes").c_uint,
        ]
        renameat2.restype = __import__("ctypes").c_int
        if renameat2(root_fd, os.fsencode(temporary), root_fd, os.fsencode(marker.name), 2) != 0:
            raise SystemExit(1)
        os.fsync(root_fd)
        old = read_marker(root_fd, temporary)
        if old != before:
            raise SystemExit(1)
        os.unlink(temporary, dir_fd=root_fd)
        os.fsync(root_fd)
        if read_marker(root_fd, marker.name) != after:
            raise SystemExit(1)
    finally:
        try:
            os.unlink(temporary, dir_fd=root_fd)
            os.fsync(root_fd)
        except FileNotFoundError:
            pass

def marker_operation(current_mode: str) -> None:
    root_fd = strict_root()
    try:
        if current_mode == "create":
            if expected_token or not re.fullmatch(r"[1-9][0-9]*", owner_text):
                raise SystemExit(1)
            for path in (marker, main_claim, watchdog_claim):
                if read_marker(root_fd, path.name, allow_missing=True) is not None:
                    raise SystemExit(1)
            cleanup_stale_temporaries(root_fd)
            owner_pid = int(owner_text)
            if not is_ancestor_process(owner_pid):
                raise SystemExit(1)
            started = time.monotonic_ns()
            document = {
                "created_monotonic_ns": started,
                "deadline_monotonic_ns": started + arm_limit_seconds * 1_000_000_000,
                "owner_pid": owner_pid,
                "owner_start_ticks": process_start_ticks(owner_pid),
                "phase": "armed",
                "phase_started_monotonic_ns": started,
                "token": secrets.token_hex(32),
                "version": 2,
            }
            if not service_is_healthy(fpm_service) or not service_is_healthy("nginx.service"):
                raise SystemExit(1)
            publish_new_marker(root_fd, marker.name, document)
            print(document["token"])
            return
        if current_mode == "begin-frozen":
            if (not re.fullmatch(r"[0-9a-f]{64}", expected_token) or owner_text
                    or not service_is_inactive(fpm_service)
                    or not service_is_healthy("nginx.service")):
                raise SystemExit(1)
            document = read_marker(root_fd, marker.name)
            if document["token"] != expected_token or document["phase"] != "armed":
                raise SystemExit(1)
            started = time.monotonic_ns()
            updated = dict(document)
            updated["phase"] = "frozen"
            updated["phase_started_monotonic_ns"] = started
            updated["deadline_monotonic_ns"] = (
                started + freeze_limit_seconds * 1_000_000_000
            )
            replace_marker(root_fd, document, updated)
            return
        if current_mode == "recover":
            actor = "main" if expected_token else "watchdog"
            document = claim_for_recovery(
                root_fd, actor, immediate=not bool(expected_token)
            )
            if document is None:
                if expected_token:
                    raise SystemExit(1)
                return
            recover_claim(
                root_fd,
                main_claim if actor == "main" else watchdog_claim,
                document,
            )
            return
        raise SystemExit(1)
    finally:
        os.close(root_fd)

if mode != "watch":
    marker_operation(mode)
    raise SystemExit(0)
if not re.fullmatch(r"[0-9a-f]{64}", expected_token) or owner_text:
    raise SystemExit(1)
while True:
    root_fd = strict_root()
    try:
        document = claim_for_recovery(root_fd, "watchdog")
        if document is not None:
