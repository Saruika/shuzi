audit_or_stage_uploads() {
    local mode=$1 temporary_root=$2 database_logical_bytes=$3
    env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 \
        "$mode" "$temporary_root" "$SITE/wp-content/uploads" \
        "$database_logical_bytes" 9<<'PY'
import hashlib
import os
import re
import stat
import sys
from pathlib import Path

MAX_FILES = 100_000
MAX_DIRECTORIES = 100_000
MAX_FILE_BYTES = 8 * 1024 * 1024 * 1024
MAX_BATCH_BYTES = 64 * 1024 * 1024 * 1024
MAX_DATABASE_SQL_BYTES = 4 * 1024 * 1024 * 1024
MAX_DATABASE_GZIP_BYTES = 8 * 1024 * 1024 * 1024
MIN_DATABASE_BUDGET = 128 * 1024 * 1024
MIN_FREE_RESERVE = 1024 * 1024 * 1024
FORBIDDEN_UPLOAD_NAMES = {".htaccess", ".user.ini"}
FORBIDDEN_UPLOAD_SUFFIXES = {
    ".cgi", ".pl", ".py", ".rb", ".sh", ".bash", ".zsh", ".fish",
    ".exe", ".com", ".bat", ".cmd", ".ps1", ".jar", ".war",
}

mode = sys.argv[1]
root = Path(sys.argv[2])
source = Path(sys.argv[3])
logical_text = sys.argv[4]
if mode not in {"preflight", "stage", "snapshot"}:
    raise SystemExit(1)
root_metadata = root.lstat()
source_metadata = source.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(root_metadata.st_mode)
        or root_metadata.st_uid != 0 or root_metadata.st_gid != 0
        or stat.S_IMODE(root_metadata.st_mode) != 0o700
        or source.resolve(strict=True) != source
        or not stat.S_ISDIR(source_metadata.st_mode)):
    raise SystemExit(1)
if not re.fullmatch(r"(?:0|[1-9][0-9]{0,18})", logical_text):
    raise SystemExit(1)
logical_bytes = int(logical_text)
if logical_bytes > MAX_DATABASE_SQL_BYTES:
    raise SystemExit(1)

database_budget = max(
    MIN_DATABASE_BUDGET,
    logical_bytes * 2 + 64 * 1024 * 1024,
)
database_budget = min(database_budget, MAX_DATABASE_GZIP_BYTES)
file_count = 1
directory_count = 0
upload_bytes = 0
total_size = 0
target = root / "wp-content" / "uploads"
snapshot = hashlib.sha256()
if mode == "stage":
    try:
        target.lstat()
    except FileNotFoundError:
        pass
    else:
        raise SystemExit(1)
    target.mkdir(mode=0o700, parents=True)

source_device = source_metadata.st_dev
def identity(value):
    return (
        stat.S_IFMT(value.st_mode),
        value.st_dev,
        value.st_ino,
        value.st_nlink,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )

def snapshot_identity(value):
    return (
        value.st_mode,
        value.st_uid,
        value.st_gid,
        value.st_dev,
        value.st_ino,
        value.st_nlink,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )

def include_snapshot(kind, relative, value):
    encoded = relative.as_posix().encode("utf-8")
    if not encoded or len(encoded) > 4096:
        raise SystemExit(1)
    snapshot.update(kind)
    snapshot.update(len(encoded).to_bytes(8, "big"))
    snapshot.update(encoded)
    for field in snapshot_identity(value):
        encoded_field = str(field).encode("ascii")
        snapshot.update(len(encoded_field).to_bytes(8, "big"))
        snapshot.update(encoded_field)

for directory, directory_names, file_names, directory_fd in os.fwalk(
    source, topdown=True, follow_symlinks=False
):
    directory_names.sort()
    file_names.sort()
    current_directory = os.fstat(directory_fd)
    if (not stat.S_ISDIR(current_directory.st_mode)
            or current_directory.st_dev != source_device):
        raise SystemExit(1)
    relative_directory = Path(directory).relative_to(source)
    include_snapshot(b"D", relative_directory, current_directory)
    directory_count += 1
    if directory_count > MAX_DIRECTORIES:
        raise SystemExit(1)
    for child_name in directory_names:
        child = os.stat(child_name, dir_fd=directory_fd, follow_symlinks=False)
        if not stat.S_ISDIR(child.st_mode) or child.st_dev != source_device:
            raise SystemExit(1)
    if mode == "stage":
        destination_directory = target.joinpath(*relative_directory.parts)
        destination_directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        destination_metadata = destination_directory.lstat()
        if (not stat.S_ISDIR(destination_metadata.st_mode)
                or destination_metadata.st_uid != 0 or destination_metadata.st_gid != 0
                or stat.S_IMODE(destination_metadata.st_mode) != 0o700
                or destination_metadata.st_dev != root_metadata.st_dev):
            raise SystemExit(1)
    for name in file_names:
        relative = relative_directory / name
        encoded_relative = relative.as_posix().encode("utf-8")
        if not encoded_relative or len(encoded_relative) > 4096:
            raise SystemExit(1)
        lowered = name.lower()
        if (lowered in FORBIDDEN_UPLOAD_NAMES or ".php" in lowered
                or ".phtml" in lowered or ".phar" in lowered
                or any(lowered.endswith(suffix) for suffix in FORBIDDEN_UPLOAD_SUFFIXES)):
            raise SystemExit(1)
        entry = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if (not stat.S_ISREG(entry.st_mode) or entry.st_nlink != 1
                or entry.st_dev != source_device
                or entry.st_size < 0 or entry.st_size > MAX_FILE_BYTES):
            raise SystemExit(1)
        # O_NONBLOCK prevents an attacker-writable FIFO from hanging the
        # sender if its type changes between the no-follow stat and open.
        flags = (
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0)
        )
        descriptor = os.open(name, flags, dir_fd=directory_fd)
        try:
            initial = os.fstat(descriptor)
            if (not stat.S_ISREG(initial.st_mode) or initial.st_nlink != 1
                    or initial.st_dev != source_device
                    or initial.st_size < 0 or initial.st_size > MAX_FILE_BYTES
                    or identity(initial) != identity(entry)):
                raise SystemExit(1)
            file_count += 1
            upload_bytes += initial.st_size
            if file_count > MAX_FILES or upload_bytes > MAX_BATCH_BYTES:
                raise SystemExit(1)
            if mode == "preflight":
                continue
            if mode == "snapshot":
                final = os.fstat(descriptor)
                if identity(final) != identity(initial):
                    raise SystemExit(1)
                include_snapshot(b"F", relative, final)
                continue
            if total_size + initial.st_size + database_budget > MAX_BATCH_BYTES:
                raise SystemExit(1)
            filesystem = os.statvfs(root)
            if (filesystem.f_bavail * filesystem.f_frsize
                    < initial.st_size + database_budget + MIN_FREE_RESERVE):
                raise SystemExit(1)
            destination = destination_directory / name
            output = os.open(
                destination,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
            )
            try:
                remaining = initial.st_size
                while remaining:
                    chunk = os.read(descriptor, min(remaining, 1024 * 1024))
                    if not chunk:
                        raise SystemExit(1)
                    filesystem = os.statvfs(root)
                    if (filesystem.f_bavail * filesystem.f_frsize
                            < len(chunk) + database_budget + MIN_FREE_RESERVE):
                        raise SystemExit(1)
                    view = memoryview(chunk)
                    while view:
                        written = os.write(output, view)
                        if written <= 0:
                            raise SystemExit(1)
                        view = view[written:]
                    remaining -= len(chunk)
                if os.read(descriptor, 1):
                    raise SystemExit(1)
                os.fsync(output)
                completed = os.fstat(output)
                if (not stat.S_ISREG(completed.st_mode) or completed.st_uid != 0
                        or completed.st_gid != 0 or stat.S_IMODE(completed.st_mode) != 0o600
                        or completed.st_nlink != 1
                        or completed.st_size != initial.st_size):
                    raise SystemExit(1)
            finally:
                os.close(output)
            final = os.fstat(descriptor)
            if identity(final) != identity(initial):
                raise SystemExit(1)
            include_snapshot(b"F", relative, final)
            total_size += initial.st_size
        finally:
            os.close(descriptor)

filesystem = os.statvfs(root)
if mode == "preflight":
    if upload_bytes + database_budget > MAX_BATCH_BYTES:
        raise SystemExit(1)
    required_bytes = upload_bytes + database_budget + MIN_FREE_RESERVE
    required_inodes = file_count + directory_count + 1024
    if (filesystem.f_bavail * filesystem.f_frsize < required_bytes
            or filesystem.f_favail < required_inodes):
        raise SystemExit(1)
elif mode == "stage":
    if (filesystem.f_bavail * filesystem.f_frsize
            < database_budget + MIN_FREE_RESERVE
            or total_size + database_budget > MAX_BATCH_BYTES):
        raise SystemExit(1)
if mode in {"stage", "snapshot"}:
    print(f"{upload_bytes}:{file_count}:{directory_count}:{snapshot.hexdigest()}")
PY
}

