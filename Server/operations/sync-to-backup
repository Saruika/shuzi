service_property() {
    /usr/bin/timeout --signal=TERM --kill-after=2s 5s \
        /usr/bin/systemctl show --property="$2" --value "$1"
}

service_snapshot() {
    /usr/bin/timeout --signal=TERM --kill-after=2s 5s \
        /usr/bin/systemctl show \
        --property=LoadState --property=ActiveState --property=SubState \
        --property=Result --property=MainPID --property=Job "$1"
}

verify_primary_fpm_watchdog_active() {
    local unit=$1 active_state sub_state result
    [[ "$unit" =~ ^shuzijun-primary-fpm-recovery-[0-9a-f]{16}\.service$ ]] \
        || return 1
    active_state=$(service_property "$unit" ActiveState) || return 1
    sub_state=$(service_property "$unit" SubState) || return 1
    result=$(service_property "$unit" Result) || return 1
    test "$active_state" = active || return 1
    test "$sub_state" = running || return 1
    test "$result" = success || return 1
}

verify_primary_fpm_active() {
    local snapshot main_pid
    snapshot=$(service_snapshot "$FPM_SERVICE") || return 1
    test "$(grep -Fxc 'LoadState=loaded' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'ActiveState=active' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'SubState=running' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'Result=success' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'Job=' <<<"$snapshot")" -eq 1 || return 1
    main_pid=$(sed -n 's/^MainPID=//p' <<<"$snapshot") || return 1
    [[ "$main_pid" =~ ^[1-9][0-9]*$ && "$main_pid" -gt 1 ]] || return 1
    /usr/bin/timeout --signal=TERM --kill-after=2s 5s \
        /usr/bin/systemctl is-active --quiet "$FPM_SERVICE" || return 1
}

verify_primary_fpm_inactive() {
    local snapshot is_active_status
    snapshot=$(service_snapshot "$FPM_SERVICE") || return 1
    test "$(grep -Fxc 'LoadState=loaded' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'ActiveState=inactive' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'SubState=dead' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'Result=success' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'MainPID=0' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'Job=' <<<"$snapshot")" -eq 1 || return 1
    if /usr/bin/timeout --signal=TERM --kill-after=2s 5s \
        /usr/bin/systemctl is-active --quiet "$FPM_SERVICE"; then
        return 1
    else
        is_active_status=$?
    fi
    [[ "$is_active_status" -eq 3 ]] || return 1
    # Close the snapshot/is-active race with a second exact state read. A
    # timeout, unknown unit, failed unit or a late restart must not masquerade
    # as the expected quiescent state.
    snapshot=$(service_snapshot "$FPM_SERVICE") || return 1
    test "$(grep -Fxc 'LoadState=loaded' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'ActiveState=inactive' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'SubState=dead' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'Result=success' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'MainPID=0' <<<"$snapshot")" -eq 1 || return 1
    test "$(grep -Fxc 'Job=' <<<"$snapshot")" -eq 1 || return 1
}

verify_primary_nginx_active() {
