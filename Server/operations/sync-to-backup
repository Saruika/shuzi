    test "$(grep -Fxc 'Job=' <<<"$snapshot")" -eq 1 || return 1
    main_pid=$(sed -n 's/^MainPID=//p' <<<"$snapshot") || return 1
    [[ "$main_pid" =~ ^[1-9][0-9]*$ && "$main_pid" -gt 1 ]] || return 1
    /usr/bin/timeout --signal=TERM --kill-after=2s 5s \
