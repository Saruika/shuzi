        if (not stat.S_ISDIR(destination_metadata.st_mode)
                or destination_metadata.st_uid != 0 or destination_metadata.st_gid != 0
                or stat.S_IMODE(destination_metadata.st_mode) != 0o700
                or destination_metadata.st_dev != root_metadata.st_dev):
            raise SystemExit(1)
