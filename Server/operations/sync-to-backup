import ctypes
import json
import os
import re
import secrets
import stat
import sys
from pathlib import Path

action = sys.argv[1]
root = Path(sys.argv[2])
issued_path = Path(sys.argv[3])
pending_path = Path(sys.argv[4])
resolution_path = Path(sys.argv[5])
arguments = sys.argv[6:]
protocol_value = "shuzijun-sync-receiver-v4-transactional-uploads"
if (root != Path("/var/lib/shuzijun-sync")
        or issued_path != root / "highest-issued-generation"
        or pending_path != root / "pending-receipt-v5.json"
        or resolution_path != root / "last-resolution-v5.json"):
    raise SystemExit(1)
root_meta = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(root_meta.st_mode)
        or root_meta.st_uid != 0 or root_meta.st_gid != 0
        or stat.S_IMODE(root_meta.st_mode) != 0o700):
    raise SystemExit(1)
directory = os.open(
    root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
)

def read_payload(path, *, allow_missing=False, limit=4096):
    if path.parent != root:
        raise RuntimeError("unsafe receipt state path")
    try:
        descriptor = os.open(
            path.name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=directory,
        )
    except FileNotFoundError:
        if allow_missing:
            return None
        raise
    try:
        metadata = os.fstat(descriptor)
        payload = os.read(descriptor, limit + 1)
        if os.read(descriptor, 1):
            raise RuntimeError("oversize receipt state")
        named = os.stat(path.name, dir_fd=directory, follow_symlinks=False)
    finally:
        os.close(descriptor)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
            or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1 or metadata.st_dev != root_meta.st_dev
            or (metadata.st_dev, metadata.st_ino) != (named.st_dev, named.st_ino)
            or metadata.st_size != len(payload) or len(payload) > limit
            or not payload.endswith(b"\n")):
        raise RuntimeError("unsafe receipt state")
    return payload

def canonical(document):
    return (
        json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True)
        + "\n"
    ).encode("ascii")

def read_json(path, *, allow_missing=False):
    payload = read_payload(path, allow_missing=allow_missing)
    if payload is None:
        return None
    try:
        document = json.loads(payload.decode("ascii"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        raise RuntimeError("invalid receipt JSON") from None
    if canonical(document) != payload:
        raise RuntimeError("non-canonical receipt JSON")
    return document

def validate_generation(value):
    if (isinstance(value, bool) or not isinstance(value, int)
            or not 1 <= value < 2**63):
        raise RuntimeError("invalid receipt generation")
    return value

def validate_hash(value, *, allow_empty=False):
    if allow_empty and value == "":
        return value
    if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
        raise RuntimeError("invalid receipt hash")
    return value

def validate_pending(document):
    if not isinstance(document, dict) or set(document) != {
        "evidence_sha256", "expected_release_id", "generation",
        "ingest_receiver_sha256", "protocol", "version",
    }:
        raise RuntimeError("invalid pending receipt keys")
    if (type(document["version"]) is not int or document["version"] != 5
            or document["protocol"] != protocol_value):
        raise RuntimeError("invalid pending receipt version")
    validate_generation(document["generation"])
    validate_hash(document["evidence_sha256"])
    validate_hash(document["expected_release_id"], allow_empty=True)
    validate_hash(document["ingest_receiver_sha256"])
    return document

def validate_resolution(document):
    if not isinstance(document, dict) or set(document) != {
        "accepted_generation", "active_evidence_sha256", "active_generation",
        "committed_generation", "generation", "ingest_receiver_sha256",
        "outcome", "protocol", "query_receiver_sha256", "reason",
        "release_id", "runtime", "version",
    }:
        raise RuntimeError("invalid resolution keys")
    if (type(document["version"]) is not int or document["version"] != 5
            or document["protocol"] != protocol_value
            or document["outcome"] not in {"committed", "not-committed"}
            or document["reason"] not in {
                "inline-ack", "legacy-v4-stdout-contamination",
                "queried-after-ambiguous-ack", "startup-recovery",
            }
            or document["runtime"] not in {"healthy", "isolated"}):
        raise RuntimeError("invalid resolution values")
    for key in (
        "accepted_generation", "active_generation", "committed_generation", "generation"
    ):
        validate_generation(document[key])
    for key in (
        "active_evidence_sha256", "ingest_receiver_sha256",
        "query_receiver_sha256", "release_id",
    ):
        validate_hash(document[key])
    generation = document["generation"]
    accepted = document["accepted_generation"]
    active = document["active_generation"]
    committed = document["committed_generation"]
    if committed != active or active > accepted or accepted > generation:
        raise RuntimeError("invalid resolution generation ordering")
    if document["outcome"] == "committed":
        if (accepted != generation or active != generation
                or document["runtime"] != "healthy"):
            raise RuntimeError("invalid committed resolution")
    elif active >= generation:
        raise RuntimeError("invalid non-commit resolution")
    elif accepted == active:
        if document["runtime"] != "healthy":
            raise RuntimeError("invalid healthy-base resolution")
    elif accepted == generation:
        if document["runtime"] != "isolated":
            raise RuntimeError("invalid rolled-back resolution")
    else:
        raise RuntimeError("ambiguous non-commit resolution")
    return document

def authorize_pending_removal(pending, resolution, expected_query_receiver=None):
    if resolution is None:
        raise RuntimeError("pending receipt lacks durable resolution")
    if expected_query_receiver is not None:
        validate_hash(expected_query_receiver)
    if (resolution["generation"] != pending["generation"]
            or resolution["ingest_receiver_sha256"]
                != pending["ingest_receiver_sha256"]
            or resolution["protocol"] != pending["protocol"]
            or (expected_query_receiver is not None
                and resolution["query_receiver_sha256"]
                    != expected_query_receiver)):
        raise RuntimeError("resolution does not authorize pending removal")
    if resolution["outcome"] == "committed":
        if (resolution["active_evidence_sha256"]
                != pending["evidence_sha256"]
                or (pending["expected_release_id"]
                    and resolution["release_id"]
                        != pending["expected_release_id"])):
            raise RuntimeError("resolution lost committed evidence")
    elif pending["expected_release_id"]:
        raise RuntimeError("legacy expected release was not committed")

def read_issued():
    payload = read_payload(issued_path, limit=31)
    if re.fullmatch(rb"(?:0|[1-9][0-9]{0,18})\n", payload) is None:
        raise RuntimeError("invalid issued generation")
    value = int(payload)
    if value >= 2**63:
        raise RuntimeError("issued generation overflow")
    return value

def temporary_name(kind):
    if kind not in {"pending-receipt-v5", "last-resolution-v5"}:
        raise RuntimeError("invalid receipt temporary kind")
    return f".{kind}.{secrets.token_hex(16)}"

def rename_noreplace(source_name, destination_name):
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise RuntimeError("renameat2 unavailable")
    renameat2.argtypes = [
        ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint,
    ]
    renameat2.restype = ctypes.c_int
    if renameat2(
        directory, os.fsencode(source_name), directory,
        os.fsencode(destination_name), 1,
    ) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))

def atomic_write(path, document, *, replace):
    payload = canonical(document)
    kind = path.name.removesuffix(".json")
    temporary = temporary_name(kind)
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
        dir_fd=directory,
    )
    try:
        os.fchmod(descriptor, 0o600)
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise RuntimeError("short receipt state write")
            view = view[written:]
        os.fsync(descriptor)
        metadata = os.fstat(descriptor)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
                or metadata.st_nlink != 1 or metadata.st_dev != root_meta.st_dev
                or metadata.st_size != len(payload)):
            raise RuntimeError("unsafe receipt temporary")
    finally:
        os.close(descriptor)
    try:
        if replace:
            os.replace(temporary, path.name, src_dir_fd=directory, dst_dir_fd=directory)
        else:
            rename_noreplace(temporary, path.name)
        os.fsync(directory)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory)
            os.fsync(directory)
        except FileNotFoundError:
            pass

def promote_existing(path, expected):
    # A prior process may have died after rename but before the parent fsync.
    # Re-fsync and reopen before treating an identical visible record as durable.
    os.fsync(directory)
    repeated = read_json(path)
    if repeated != expected:
        raise RuntimeError("receipt state changed during durability promotion")

receipt_temporary_pattern = re.compile(
    r"\.(?:pending-receipt-v5|last-resolution-v5)\.[0-9a-f]{32}"
)
clearing_tombstone_pattern = re.compile(
    r"\.clearing-pending-receipt-v5\.[0-9a-f]{32}"
)

def receipt_inventory():
    temporaries = []
    tombstones = []
    for name in os.listdir(directory):
        if (name.startswith(".pending-receipt-v5.")
                or name.startswith(".last-resolution-v5.")):
            if receipt_temporary_pattern.fullmatch(name) is None:
                raise RuntimeError("unknown receipt state temporary")
            temporaries.append(name)
        elif name.startswith(".clearing-pending-receipt-v5."):
            if clearing_tombstone_pattern.fullmatch(name) is None:
                raise RuntimeError("unknown receipt clearing tombstone")
            tombstones.append(name)
    if len(tombstones) > 1:
        raise RuntimeError("multiple receipt clearing tombstones")
    return temporaries, tombstones

def validate_temporary_metadata(name):
    metadata = os.stat(name, dir_fd=directory, follow_symlinks=False)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
            or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1 or metadata.st_dev != root_meta.st_dev
            or metadata.st_size > 4096):
        raise RuntimeError("unsafe receipt state temporary")

def clean_stale_temporaries():
    temporaries, tombstones = receipt_inventory()
    for name in temporaries:
        validate_temporary_metadata(name)

    pending = read_json(pending_path, allow_missing=True)
    if pending is not None:
        validate_pending(pending)
    resolution = read_json(resolution_path, allow_missing=True)
    if resolution is not None:
        validate_resolution(resolution)
    issued = read_issued()
    if pending is not None and pending["generation"] != issued:
        raise RuntimeError("pending receipt is not highest issued generation")
    if resolution is not None and resolution["generation"] > issued:
        raise RuntimeError("resolution exceeds highest issued generation")

    if tombstones:
        tombstone_name = tombstones[0]
        tombstone = read_json(root / tombstone_name)
        validate_pending(tombstone)
        if tombstone["generation"] != issued:
            raise RuntimeError("clearing tombstone is not highest issued generation")
        authorize_pending_removal(tombstone, resolution)
        if pending is not None and pending != tombstone:
            raise RuntimeError("pending receipt conflicts with clearing tombstone")
        # With a visible pending record this completes a failed compensation;
        # without one it completes an already-authorized interrupted removal.
        os.unlink(tombstone_name, dir_fd=directory)
        os.fsync(directory)

    if temporaries:
        for name in temporaries:
            os.unlink(name, dir_fd=directory)
        os.fsync(directory)

def restore_pending_best_effort(expected):
    try:
        visible = read_json(pending_path, allow_missing=True)
        if visible is None:
            atomic_write(pending_path, expected, replace=False)
        elif visible == expected:
            promote_existing(pending_path, expected)
    except BaseException:
        # The caller still reports the original durability failure.  A visible
        # clearing tombstone and/or the durable resolution lets startup finish
        # recovery even when this compensation cannot itself be acknowledged.
        pass

def clear_pending_durably(expected):
    _temporaries, tombstones = receipt_inventory()
    if tombstones:
        raise RuntimeError("receipt clearing recovery is required")
    tombstone_name = (
        ".clearing-pending-receipt-v5." + secrets.token_hex(16)
    )
    os.rename(
        pending_path.name, tombstone_name,
        src_dir_fd=directory, dst_dir_fd=directory,
    )
    try:
        os.fsync(directory)
    except BaseException:
        # The rename was not acknowledged as durable.  Best effort restores
        # the user-visible pending record so a retry cannot silently advance.
        try:
            rename_noreplace(tombstone_name, pending_path.name)
            os.fsync(directory)
        except BaseException:
            pass
        raise
    try:
        os.unlink(tombstone_name, dir_fd=directory)
        os.fsync(directory)
    except BaseException:
        restore_pending_best_effort(expected)
        raise

try:
    if action == "clean-stale":
        if arguments:
            raise RuntimeError("unexpected clean-stale arguments")
        clean_stale_temporaries()
        raise SystemExit(0)

    pending = read_json(pending_path, allow_missing=True)
    if pending is not None:
        validate_pending(pending)
    resolution = read_json(resolution_path, allow_missing=True)
    if resolution is not None:
        validate_resolution(resolution)
    issued = read_issued()
    if pending is not None and pending["generation"] != issued:
        raise RuntimeError("pending receipt is not highest issued generation")
    if resolution is not None and resolution["generation"] > issued:
        raise RuntimeError("resolution exceeds highest issued generation")
    if action == "pending":
        if arguments:
            raise RuntimeError("unexpected pending arguments")
        if pending is None:
            print("none")
        else:
            sys.stdout.buffer.write(canonical(pending))
        raise SystemExit(0)

    if action == "create":
        if len(arguments) != 5:
            raise RuntimeError("invalid create arguments")
        generation_text, evidence, expected_release, ingest_receiver, protocol = arguments
        if re.fullmatch(r"[1-9][0-9]{0,18}", generation_text) is None:
            raise RuntimeError("invalid create generation")
        generation = validate_generation(int(generation_text))
        document = validate_pending({
            "evidence_sha256": validate_hash(evidence),
            "expected_release_id": validate_hash(expected_release, allow_empty=True),
            "generation": generation,
            "ingest_receiver_sha256": validate_hash(ingest_receiver),
            "protocol": protocol,
            "version": 5,
        })
        if issued != generation:
            raise RuntimeError("pending generation is not highest issued")
        if pending is None:
            atomic_write(pending_path, document, replace=False)
        elif pending != document:
            raise RuntimeError("different pending receipt already exists")
        else:
            promote_existing(pending_path, document)
        raise SystemExit(0)

    if action == "resolve-hex":
        if len(arguments) != 3 or pending is None:
            raise RuntimeError("invalid resolve arguments")
        encoded_line, reason, expected_query_receiver = arguments
        if reason not in {
            "inline-ack", "legacy-v4-stdout-contamination",
            "queried-after-ambiguous-ack", "startup-recovery",
        }:
            raise RuntimeError("invalid resolution reason")
        validate_hash(expected_query_receiver)
        if (not isinstance(encoded_line, str)
                or len(encoded_line) > 131_072
                or len(encoded_line) % 2
                or re.fullmatch(r"[0-9a-f]*", encoded_line) is None):
            raise RuntimeError("invalid reconciliation receipt encoding")
        try:
            line = bytes.fromhex(encoded_line).decode("ascii")
        except (ValueError, UnicodeDecodeError):
            raise RuntimeError("invalid reconciliation receipt encoding") from None
        match = re.fullmatch(
            r"sync-reconcile-v5 accepted=([1-9][0-9]{0,18}) "
            r"active=([1-9][0-9]{0,18}) committed=([1-9][0-9]{0,18}) "
            r"evidence-sha256=([0-9a-f]{64}) release-id=([0-9a-f]{64}) "
            r"receiver-sha256=([0-9a-f]{64}) "
            r"protocol=(shuzijun-sync-receiver-v4-transactional-uploads) "
            r"transaction=none runtime=(healthy|isolated)\n",
            line,
        )
        if match is None:
            raise RuntimeError("non-canonical reconciliation receipt")
        accepted = validate_generation(int(match.group(1)))
        active = validate_generation(int(match.group(2)))
        committed = validate_generation(int(match.group(3)))
        evidence = match.group(4)
        release_id = match.group(5)
        query_receiver = match.group(6)
        protocol = match.group(7)
        runtime = match.group(8)
        generation = pending["generation"]
        if (query_receiver != expected_query_receiver
                or protocol != pending["protocol"] or committed != active
                or active > accepted or accepted > generation):
            raise RuntimeError("reconciliation receipt conflicts with pending state")
        if active == generation:
            if (accepted != generation or evidence != pending["evidence_sha256"]
                    or runtime != "healthy"
                    or (pending["expected_release_id"]
                        and release_id != pending["expected_release_id"])):
                raise RuntimeError("committed receipt evidence mismatch")
            outcome = "committed"
        elif active < generation:
            if accepted == active:
                if runtime != "healthy":
                    raise RuntimeError("stable prior generation is not healthy")
            elif accepted == generation:
                if runtime != "isolated":
                    raise RuntimeError("rolled-back generation is not isolated")
            else:
                raise RuntimeError("ambiguous accepted generation")
            if pending["expected_release_id"]:
                raise RuntimeError("expected legacy release was not committed")
            outcome = "not-committed"
        else:
            raise RuntimeError("remote generation exceeds pending generation")
        document = validate_resolution({
            "accepted_generation": accepted,
            "active_evidence_sha256": evidence,
            "active_generation": active,
            "committed_generation": committed,
            "generation": generation,
            "ingest_receiver_sha256": pending["ingest_receiver_sha256"],
            "outcome": outcome,
            "protocol": protocol,
            "query_receiver_sha256": query_receiver,
            "reason": reason,
            "release_id": release_id,
            "runtime": runtime,
            "version": 5,
        })
        if resolution is not None and resolution["generation"] == generation:
            comparable = dict(resolution)
            comparable["reason"] = reason
            if comparable != document:
                raise RuntimeError("same-generation resolution changed")
            document = resolution
            promote_existing(resolution_path, document)
        elif resolution is not None and resolution["generation"] > generation:
            raise RuntimeError("future resolution cannot be replaced")
        else:
            atomic_write(resolution_path, document, replace=True)
        print(f"{document['outcome']} {document['reason']} {generation}")
        raise SystemExit(0)

    if action == "clear":
        if len(arguments) != 1 or pending is None:
            raise RuntimeError("invalid clear operation")
        expected_query_receiver = validate_hash(arguments[0])
        authorize_pending_removal(pending, resolution, expected_query_receiver)
        clear_pending_durably(pending)
        raise SystemExit(0)

    raise RuntimeError("unknown receipt state action")
finally:
    os.close(directory)
PY
}

verify_authority_role() {
    local expected_role=$1 verifier_fd_path=/proc/self/fd/7 verifier_sha256
    local authority_verify_parent authority_verify_parent_mode verifier_status=0
    test -f "$AUTHORITY_VERIFY" && test -x "$AUTHORITY_VERIFY" \
        && test ! -L "$AUTHORITY_VERIFY" || return 1
    test "$(realpath -e -- "$AUTHORITY_VERIFY")" = "$AUTHORITY_VERIFY" || return 1
    for authority_verify_parent in /usr /usr/local /usr/local/sbin; do
        test "$(realpath -e -- "$authority_verify_parent")" = "$authority_verify_parent" \
            || return 1
        test -d "$authority_verify_parent" && test ! -L "$authority_verify_parent" \
            || return 1
        test "$(stat -c '%u' "$authority_verify_parent")" = 0 || return 1
        authority_verify_parent_mode=$(stat -c '%a' "$authority_verify_parent") || return 1
        (( (8#$authority_verify_parent_mode & 8#022) == 0 )) || return 1
    done
    exec 7<"$AUTHORITY_VERIFY" || return 1
    test "$(stat -Lc '%u:%g:%h:%a' "$verifier_fd_path")" = '0:0:1:755' \
        || { exec 7<&-; return 1; }
    verifier_sha256=$(sha256sum "$verifier_fd_path" | awk '{ print $1 }') \
        || { exec 7<&-; return 1; }
    test "$verifier_sha256" = "$AUTHORITY_VERIFY_SHA256" \
        || { exec 7<&-; return 1; }
    if ! env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I "$verifier_fd_path" "$expected_role" >/dev/null; then
        verifier_status=1
    fi
    exec 7<&- || return 1
    return "$verifier_status"
}

