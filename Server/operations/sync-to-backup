        if (lowered in FORBIDDEN_UPLOAD_NAMES or ".php" in lowered
                or ".phtml" in lowered or ".phar" in lowered
                or any(lowered.endswith(suffix) for suffix in FORBIDDEN_UPLOAD_SUFFIXES)):
            raise SystemExit(1)
        entry = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if (not stat.S_ISREG(entry.st_mode) or entry.st_nlink != 1
                or entry.st_dev != source_device
                or entry.st_size < 0 or entry.st_size > MAX_FILE_BYTES):
