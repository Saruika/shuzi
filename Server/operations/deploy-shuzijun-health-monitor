    sync_path "$(dirname -- "$BACKUP_ROOT")" || return 1
}

backup_one() {
    local source=$1 name=$2 expected_sha=$3 mode=$4 copy
    copy=$BACKUP_DIR/$name
    cp -a --reflink=never -- "$source" "$copy" || return 1
    require_file "$copy" "$mode" "$expected_sha" || return 1
    require_file "$source" "$mode" "$expected_sha" || return 1
}

atomic_install() {
    local source=$1 target=$2 mode=$3 expected_sha=$4 parent base tmp
    parent=$(dirname -- "$target") || return 1
    base=$(basename -- "$target") || return 1
    tmp=$parent/.$base.build42.1.$$
    [[ ! -e "$tmp" ]] || return 1
    install -o root -g root -m "$mode" -- "$source" "$tmp" || return 1
    require_file "$tmp" "$mode" "$expected_sha" || return 1
    sync_path "$tmp" || return 1
    mv -T -- "$tmp" "$target" || return 1
    sync_path "$parent" || return 1
    require_file "$target" "$mode" "$expected_sha" || return 1
}

atomic_restore() {
    local source=$1 target=$2 expected_sha=$3 mode=$4 parent base tmp
    parent=$(dirname -- "$target") || return 1
    base=$(basename -- "$target") || return 1
    tmp=$parent/.$base.rollback.$$
    [[ ! -e "$tmp" ]] || return 1
    cp -a --reflink=never -- "$source" "$tmp" || return 1
    require_file "$tmp" "$mode" "$expected_sha" || return 1
    sync_path "$tmp" || return 1
    mv -T -- "$tmp" "$target" || return 1
    sync_path "$parent" || return 1
    require_file "$target" "$mode" "$expected_sha" || return 1
}

require_private_log_file() {
