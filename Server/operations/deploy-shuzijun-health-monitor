write_marker() {
    local name=$1 content=$2 tmp
    case "$name" in
        PREPARED|COMMITTED|STATUS_MAY_CHANGE|ACCEPTED) ;;
        *) return 1 ;;
    esac
    tmp=$BACKUP_DIR/.$name.$$
    [[ ! -e "$tmp" && ! -L "$tmp" ]] || return 1
