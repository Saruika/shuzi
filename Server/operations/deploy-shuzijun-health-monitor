require_stage() {
    require_dir "$STAGE" 700 || return 1
    local listing expected
    listing=$(find "$STAGE" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort) || return 1
    expected=$'shuzijun-internal-health\nshuzijun-internal-health.service\nshuzijun-internal-health.timer\nshuzijun-private-logs.conf\ntencent-daily-snapshot.cron'
    [[ "$listing" == "$expected" ]] || { printf 'stage contains unexpected entries\n' >&2; return 1; }
    require_file "$STAGE/shuzijun-internal-health" 700 "$NEW_SCRIPT_SHA" || return 1
    require_file "$STAGE/shuzijun-internal-health.service" 644 "$NEW_SERVICE_SHA" || return 1
    require_file "$STAGE/shuzijun-internal-health.timer" 644 "$NEW_TIMER_SHA" || return 1
    require_file "$STAGE/shuzijun-private-logs.conf" 644 "$NEW_PRIVATE_LOG_CONFIG_SHA" || return 1
    require_file "$STAGE/tencent-daily-snapshot.cron" 644 "$NEW_SNAPSHOT_CRON_SHA" || return 1
    /usr/bin/python3 -I -c 'import pathlib,sys; compile(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"), sys.argv[1], "exec")' "$STAGE/shuzijun-internal-health" || return 1
    systemd-analyze verify "$STAGE/shuzijun-internal-health.service" "$STAGE/shuzijun-internal-health.timer" || return 1
}

sync_path() {
