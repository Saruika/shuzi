wait_health_idle() {
    local attempt state job state_again job_again
    for attempt in $(seq 1 1000); do
        state=$(unit_value shuzijun-internal-health.service ActiveState) || return 1
        job=$(unit_value shuzijun-internal-health.service Job) || return 1
        case "$state" in
            active|activating|deactivating) sleep 0.25 ;;
            *)
                if [[ -n "$job" ]]; then
                    sleep 0.25
                    continue
                fi
                sleep 0.25
                state_again=$(unit_value shuzijun-internal-health.service ActiveState) || return 1
                job_again=$(unit_value shuzijun-internal-health.service Job) || return 1
                case "$state_again" in
                    active|activating|deactivating) continue ;;
                esac
                [[ -z "$job_again" ]] && return 0
                ;;
        esac
    done
    printf 'health service did not become idle\n' >&2
    return 1
}

normalize_stopped_health_service() {
    local sample load_state state substate job
    if systemctl reset-failed shuzijun-internal-health.service; then
        :
    fi
    for sample in 1 2; do
        load_state=$(unit_value shuzijun-internal-health.service LoadState) || return 1
        state=$(unit_value shuzijun-internal-health.service ActiveState) || return 1
        substate=$(unit_value shuzijun-internal-health.service SubState) || return 1
        job=$(unit_value shuzijun-internal-health.service Job) || return 1
        [[ "$load_state" == loaded && "$state" == inactive && "$substate" == dead && -z "$job" ]] || return 1
        (( sample == 2 )) || sleep 0.25
    done
}

require_old_state_stable() {
    local attempt
    for attempt in $(seq 1 40); do
        wait_health_idle || return 1
        if require_old_state; then
            sleep 0.25
            if require_old_state; then
                return 0
            fi
        fi
        sleep 0.25
    done
    printf 'old health runtime did not reach a stable deployable state\n' >&2
    return 1
}

validate_timer_quiescent() {
    local expected_invocation=$1 expected_trigger=$2 minimum_future_usec=$3 maximum_future_usec=$4 attempt state job invocation trigger next_elapse now_ns now_mono now_usec
    for attempt in 1 2; do
        state=$(unit_value shuzijun-internal-health.service ActiveState) || return 1
        job=$(unit_value shuzijun-internal-health.service Job) || return 1
        invocation=$(unit_value shuzijun-internal-health.service InvocationID) || return 1
        trigger=$(timer_usec LastTriggerUSecMonotonic) || return 1
        next_elapse=$(timer_usec NextElapseUSecMonotonic) || return 1
        case "$state" in
            inactive|failed) ;;
            *) return 1 ;;
        esac
        [[ -z "$job" && "$invocation" == "$expected_invocation" && "$trigger" == "$expected_trigger" ]] || return 1
        IFS=$'\t' read -r now_ns now_mono < <(clock_pair) || return 1
        [[ "$now_ns" =~ ^[0-9]+$ && "$now_mono" =~ ^[0-9]+$ ]] || return 1
        now_usec=$((now_mono / 1000))
        (( next_elapse > now_usec + minimum_future_usec )) || return 1
        (( next_elapse <= now_usec + maximum_future_usec )) || return 1
        (( attempt == 2 )) || sleep 0.25
    done
}

settle_timer_schedule() {
    local attempt invocation trigger
    for attempt in $(seq 1 1400); do
        wait_health_idle || return 1
        invocation=$(unit_value shuzijun-internal-health.service InvocationID) || return 1
        trigger=$(timer_usec LastTriggerUSecMonotonic) || return 1
        if validate_timer_quiescent "$invocation" "$trigger" 60000000 360000000; then
            SETTLED_INVOCATION=$invocation
            SETTLED_TIMER_TRIGGER=$trigger
            return 0
        fi
        sleep 0.25
    done
    printf 'timer did not reach a quiescent bounded future schedule\n' >&2
    return 1
}

clock_pair() {
    /usr/bin/python3 -I -c 'import time; print(f"{time.time_ns()}\t{time.monotonic_ns()}")'
}

start_disabled_timer_and_settle() {
    [[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == disabled ]] || return 1
    systemctl start shuzijun-internal-health.timer || return 1
    [[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == disabled ]] || return 1
    [[ "$(systemctl is-active shuzijun-internal-health.timer)" == active ]] || return 1
    require_timer_disabled_link || return 1
    settle_timer_schedule || return 1
}

classify_timer_activation_evidence() {
    local before_sha=$1 before_inode=$2 after_sha=$3 after_inode=$4
    TIMER_ACTIVATION_EVIDENCE=
    if [[ "$after_sha" == "$before_sha" && "$after_inode" == "$before_inode" ]]; then
        TIMER_ACTIVATION_EVIDENCE=unchanged
        return 0
    fi
    if [[ "$after_sha" != "$before_sha" && "$after_inode" != "$before_inode" ]]; then
        TIMER_ACTIVATION_EVIDENCE=invoked
        return 0
    fi
    printf 'timer activation produced inconsistent invocation evidence\n' >&2
    return 1
}

validate_status() {
    local previous_inode=$1 previous_sha=$2 start_ns=$3 end_ns=$4 expected_exit=$5
    /usr/bin/python3 -I - "$STATUS_FILE" "$ROLE" "$previous_inode" "$previous_sha" "$start_ns" "$end_ns" "$expected_exit" "$APP_MANIFEST_SHA" "$APP_PLUGIN_SHA" <<'PY'
import datetime
import hashlib
import json
import os
import pathlib
import stat
import sys

path = pathlib.Path(sys.argv[1])
role = sys.argv[2]
old_inode = int(sys.argv[3])
old_sha = sys.argv[4]
start_ns = int(sys.argv[5])
end_ns = int(sys.argv[6])
expected_exit = int(sys.argv[7])
manifest_sha = sys.argv[8]
plugin_sha = sys.argv[9]

flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
fd = os.open(path, flags)
try:
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode):
        raise SystemExit("status is not a regular file")
    if (metadata.st_uid, metadata.st_gid, stat.S_IMODE(metadata.st_mode), metadata.st_nlink) != (0, 0, 0o600, 1):
        raise SystemExit("status metadata mismatch")
    if metadata.st_ino == old_inode:
        raise SystemExit("status inode did not change")
    chunks = []
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        chunks.append(chunk)
    data = b"".join(chunks)
    after = os.fstat(fd)
finally:
    os.close(fd)
path_metadata = path.lstat()
if (metadata.st_dev, metadata.st_ino, metadata.st_size, metadata.st_mtime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
    raise SystemExit("status changed while being read")
if (path_metadata.st_dev, path_metadata.st_ino) != (metadata.st_dev, metadata.st_ino) or not stat.S_ISREG(path_metadata.st_mode):
    raise SystemExit("status path changed while being read")
digest = hashlib.sha256(data).hexdigest()
if digest == old_sha:
    raise SystemExit("status hash did not change")
if not start_ns <= metadata.st_mtime_ns <= end_ns:
    raise SystemExit("status mtime outside invocation window")
payload = json.loads(data.decode("utf-8"))
checked = datetime.datetime.fromisoformat(payload["checked_at"])
if checked.tzinfo is None:
    raise SystemExit("checked_at lacks timezone")
checked_ns = int(checked.timestamp()) * 1_000_000_000
if not (checked_ns < end_ns and checked_ns + 1_000_000_000 > start_ns):
    raise SystemExit("checked_at outside invocation window")
common_reasons = {
    "snapshot_last_success_untrusted_or_stale",
    "sync_last_success_untrusted_or_stale",
    "sync_log_generation_missing_or_invalid",
}
allowed_reasons = {
    "authority": common_reasons
    | {
        "authority_sync_generation_missing_or_invalid",
        "authority_sync_generation_behind_completed_log",
        "authority_forbidden_failover_timer_active",
        "sync_timer_missing_or_disabled",
        "sync_service_result_not_success",
    },
    "standby": common_reasons
    | {
        "standby_failover_timer_disabled",
        "standby_failover_service_result_not_success",
        "standby_forbidden_sync_timer_active",
        "standby_forbidden_cdn_timer_active",
        "standby_failover_mode_not_primary",
        "standby_failover_state_unhealthy_or_stale",
        "standby_sync_generation_missing_or_invalid",
        "standby_sync_commit_generation_missing_or_invalid",
        "standby_sync_generation_mismatch_applied_log",
        "standby_sync_generation_mismatch_commit",
    },
}
legacy_role = {"authority": "primary", "standby": "backup"}[role]
if payload.get("schema") != 3 or payload.get("role_verified") is not True:
    raise SystemExit("status schema or role verification mismatch")
if payload.get("account_authority_role") != role or payload.get("role") != legacy_role:
    raise SystemExit("status role mismatch")
if payload.get("critical_reasons") != []:
    raise SystemExit("status classification mismatch")
reasons = payload.get("operation_reasons")
if not isinstance(reasons, list) or reasons != sorted(set(reasons)):
    raise SystemExit("status reasons are not canonical")
if not set(reasons) <= allowed_reasons[role]:
    raise SystemExit("status contains an unknown operation reason")
expected_status = "degraded" if reasons else "healthy"
if payload.get("status") != expected_status:
    raise SystemExit("status/reason classification mismatch")
expected_status_exit = 2 if reasons else 0
if expected_exit != expected_status_exit:
    raise SystemExit("process exit/status classification mismatch")
operations = payload.get("operations")
if not isinstance(operations, dict):
    raise SystemExit("operations payload missing")
expected_sync_log = {
    "authority": "/var/lib/shuzijun-logs/sync-authority.log",
    "standby": "/var/lib/shuzijun-logs/sync-standby.log",
}[role]
for summary, expected_path in (
    (operations.get("snapshot_log"), "/var/lib/shuzijun-logs/snapshot.log"),
    (operations.get("sync_log"), expected_sync_log),
):
    if not isinstance(summary, dict):
        raise SystemExit("private log summary missing")
    if summary.get("path") != expected_path:
        raise SystemExit("private log path mismatch")
    if summary.get("present") is not True or summary.get("trusted") is not True:
        raise SystemExit("private log is not trusted")
    if summary.get("parent_trusted") is not True:
        raise SystemExit("private log parent is not trusted")
if role == "standby":
    accepted = operations.get("accepted_generation")
    committed = operations.get("committed_generation")
    if not isinstance(accepted, dict) or not isinstance(committed, dict):
        raise SystemExit("standby generation state missing")
    accepted_valid = accepted.get("valid") is True
    committed_valid = committed.get("valid") is True
    if accepted_valid and (
        accepted.get("trusted") is not True
        or isinstance(accepted.get("value"), bool)
        or not isinstance(accepted.get("value"), int)
        or not 0 <= accepted.get("value") < 2**63
    ):
        raise SystemExit("accepted generation is not a trusted integer")
    if committed_valid and (
        committed.get("trusted") is not True
        or isinstance(committed.get("value"), bool)
        or not isinstance(committed.get("value"), int)
        or not 0 <= committed.get("value") < 2**63
    ):
        raise SystemExit("committed generation is not a trusted integer")
    expected_generation_reasons = set()
    if not accepted_valid:
        expected_generation_reasons.add("standby_sync_generation_missing_or_invalid")
    if not committed_valid:
        expected_generation_reasons.add("standby_sync_commit_generation_missing_or_invalid")
    if accepted_valid and committed_valid and accepted.get("value") != committed.get("value"):
        expected_generation_reasons.add("standby_sync_generation_mismatch_commit")
    actual_generation_reasons = set(reasons) & {
        "standby_sync_generation_missing_or_invalid",
        "standby_sync_commit_generation_missing_or_invalid",
        "standby_sync_generation_mismatch_commit",
    }
    if actual_generation_reasons != expected_generation_reasons:
        raise SystemExit("standby accepted/committed reason mismatch")
if payload.get("hashes", {}).get("app_content_manifest") != manifest_sha:
    raise SystemExit("app manifest hash mismatch")
if payload.get("hashes", {}).get("app_content_plugin") != plugin_sha:
    raise SystemExit("app plugin hash mismatch")
if not all(value == "active" for value in payload.get("services", {}).values()):
    raise SystemExit("required service is not active")
if not payload.get("routes") or not all(value.get("ok") is True for value in payload["routes"].values()):
    raise SystemExit("required route failed")
print(f"status_sha={digest} status_inode={metadata.st_ino}")
PY
}

validate_last_invocation() {
    local previous_inode=$1 previous_sha=$2 previous_invocation=$3 start_ns=$4 end_ns=$5 outer_start_mono=$6 outer_end_mono=$7
    local start_wall exit_wall start_mono exit_mono invocation invocation_after result main_status active sub
    invocation=$(unit_value shuzijun-internal-health.service InvocationID) || return 1
    [[ -n "$invocation" && "$invocation" != "$previous_invocation" ]] || return 1
    result=$(unit_value shuzijun-internal-health.service Result) || return 1
    main_status=$(unit_value shuzijun-internal-health.service ExecMainStatus) || return 1
    active=$(unit_value shuzijun-internal-health.service ActiveState) || return 1
    sub=$(unit_value shuzijun-internal-health.service SubState) || return 1
    [[ "$result" == success && ( "$main_status" == 0 || "$main_status" == 2 ) && "$active" == inactive && "$sub" == dead ]] || return 1
    start_wall=$(service_usec ExecMainStartTimestamp) || return 1
    exit_wall=$(service_usec ExecMainExitTimestamp) || return 1
    start_mono=$(service_usec ExecMainStartTimestampMonotonic) || return 1
    exit_mono=$(service_usec ExecMainExitTimestampMonotonic) || return 1
    invocation_after=$(unit_value shuzijun-internal-health.service InvocationID) || return 1
    [[ "$invocation_after" == "$invocation" ]] || return 1
    [[ "$start_wall" =~ ^[0-9]+$ && "$exit_wall" =~ ^[0-9]+$ && "$start_wall" -gt 0 && "$exit_wall" -ge "$start_wall" ]] || return 1
    [[ "$start_mono" =~ ^[0-9]+$ && "$exit_mono" =~ ^[0-9]+$ && "$start_mono" -gt 0 && "$exit_mono" -ge "$start_mono" ]] || return 1
    [[ "$start_ns" =~ ^[0-9]+$ && "$end_ns" =~ ^[0-9]+$ && "$end_ns" -ge "$start_ns" ]] || return 1
    [[ "$outer_start_mono" =~ ^[0-9]+$ && "$outer_end_mono" =~ ^[0-9]+$ && "$outer_end_mono" -ge "$outer_start_mono" ]] || return 1
    (( start_wall * 1000 >= start_ns && exit_wall * 1000 <= end_ns )) || return 1
    (( start_mono * 1000 >= outer_start_mono && exit_mono * 1000 <= outer_end_mono )) || return 1
    validate_status "$previous_inode" "$previous_sha" "$((start_wall * 1000))" "$((exit_wall * 1000))" "$main_status" >/dev/null || return 1
    VALIDATED_INVOCATION=$invocation
    VALIDATED_EXIT_STATUS=$main_status
}

