require_snapshot_execution_lock_file() {
    local metadata mode
    [[ ! -L "$SNAPSHOT_EXECUTION_LOCK" && -f "$SNAPSHOT_EXECUTION_LOCK" ]] || {
        printf 'unsafe snapshot execution lock\n' >&2
        return 1
    }
    [[ "$(realpath -e -- "$SNAPSHOT_EXECUTION_LOCK")" == "$SNAPSHOT_EXECUTION_LOCK" ]] || return 1
    metadata=$(stat -c '%F:%u:%g:%a:%h' -- "$SNAPSHOT_EXECUTION_LOCK") || return 1
    [[ "${metadata%%:*}" == 'regular file' ]] || return 1
    [[ "$metadata" == regular\ file:0:0:*:1 ]] || return 1
    mode=${metadata%:*}
    mode=${mode##*:}
    [[ "$mode" == 600 || "$mode" == 644 ]] || {
        printf 'snapshot execution lock metadata mismatch: %s\n' "$metadata" >&2
        return 1
    }
}

acquire_snapshot_execution_lock() {
    local existed=0 path_identity descriptor_identity
    if [[ -e "$SNAPSHOT_EXECUTION_LOCK" || -L "$SNAPSHOT_EXECUTION_LOCK" ]]; then
        require_snapshot_execution_lock_file || return 1
        existed=1
    fi
    exec 8>>"$SNAPSHOT_EXECUTION_LOCK"
    if ! /usr/bin/flock -n 8; then
        printf 'snapshot execution lock busy\n' >&2
        return 1
    fi
    if (( existed == 0 )); then
        chown root:root "$SNAPSHOT_EXECUTION_LOCK" || return 1
        chmod 600 "$SNAPSHOT_EXECUTION_LOCK" || return 1
        sync -f "$SNAPSHOT_EXECUTION_LOCK" || return 1
        sync -f /run || return 1
    fi
    require_snapshot_execution_lock_file || return 1
    path_identity=$(stat -c '%d:%i' -- "$SNAPSHOT_EXECUTION_LOCK") || return 1
    descriptor_identity=$(stat -Lc '%d:%i' -- "/proc/$ROOT_BASHPID/fd/8") || return 1
    [[ "$path_identity" == "$descriptor_identity" ]] || {
        printf 'snapshot execution lock path changed\n' >&2
        return 1
    }
}

# Hold the same lock used by both the legacy and migrated cron commands for the
# full transaction. A busy snapshot therefore rejects the deployment before
# any service, crontab, private-log or backup-journal mutation.
acquire_snapshot_execution_lock

