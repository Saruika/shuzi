OLD_STATUS_INODE=$(stat -c '%i' -- "$STATUS_FILE")
backup_one "$SCRIPT_TARGET" script.old "$OLD_SCRIPT_SHA" 700
backup_one "$SERVICE_TARGET" service.old "$OLD_SERVICE_SHA" 644
backup_one "$TIMER_TARGET" timer.old "$OLD_TIMER_SHA" 644
backup_one "$STATUS_FILE" status.old "$OLD_STATUS_SHA" 600
capture_root_crontab "$BACKUP_DIR/root-crontab.old"
ROOT_CRONTAB_STATE=$CAPTURED_CRONTAB_STATE
ROOT_CRONTAB_SHA=$CAPTURED_CRONTAB_SHA
OLD_STARGATE_SHA=$(stargate_digest "$BACKUP_DIR/root-crontab.old")
require_snapshot_producer_count "$BACKUP_DIR/root-crontab.old" 1
transform_root_crontab "$BACKUP_DIR/root-crontab.old" "$BACKUP_DIR/root-crontab.migrated"
[[ "$REMOVED_SNAPSHOT_LINES" == 1 ]]
record_optional_asset "$PRIVATE_LOG_CONFIG_TARGET" private-logs-conf.old OLD_PRIVATE_LOG_CONFIG_STATE OLD_PRIVATE_LOG_CONFIG_SHA
record_optional_asset "$SNAPSHOT_CRON_TARGET" snapshot-cron.old OLD_SNAPSHOT_CRON_STATE OLD_SNAPSHOT_CRON_SHA
record_private_log_state
require_frozen_files
require_file "$STATUS_FILE" 600 "$OLD_STATUS_SHA"
[[ "$(stat -c '%i' -- "$STATUS_FILE")" == "$OLD_STATUS_INODE" ]]
require_optional_asset_state "$PRIVATE_LOG_CONFIG_TARGET" "$OLD_PRIVATE_LOG_CONFIG_STATE" "$OLD_PRIVATE_LOG_CONFIG_SHA"
require_optional_asset_state "$SNAPSHOT_CRON_TARGET" "$OLD_SNAPSHOT_CRON_STATE" "$OLD_SNAPSHOT_CRON_SHA"
[[ "$(stargate_digest "$BACKUP_DIR/root-crontab.old")" == "$OLD_STARGATE_SHA" ]]
{
    printf 'script\t%s\t%s\n' "$OLD_SCRIPT_SHA" "$(stat -c '%u:%g:%a:%h' "$SCRIPT_TARGET")"
    printf 'service\t%s\t%s\n' "$OLD_SERVICE_SHA" "$(stat -c '%u:%g:%a:%h' "$SERVICE_TARGET")"
    printf 'timer\t%s\t%s\n' "$OLD_TIMER_SHA" "$(stat -c '%u:%g:%a:%h' "$TIMER_TARGET")"
    printf 'status\t%s\t%s\tinode=%s\n' "$OLD_STATUS_SHA" "$(stat -c '%u:%g:%a:%h' "$STATUS_FILE")" "$OLD_STATUS_INODE"
    printf 'root-crontab\t%s\tstate=%s\tstargate_sha=%s\n' "$ROOT_CRONTAB_SHA" "$ROOT_CRONTAB_STATE" "$OLD_STARGATE_SHA"
    printf 'private-log-config\t%s\tstate=%s\n' "$OLD_PRIVATE_LOG_CONFIG_SHA" "$OLD_PRIVATE_LOG_CONFIG_STATE"
    printf 'snapshot-cron\t%s\tstate=%s\n' "$OLD_SNAPSHOT_CRON_SHA" "$OLD_SNAPSHOT_CRON_STATE"
    printf 'private-log-directory\tstate=%s\n' "$OLD_PRIVATE_LOG_STATE"
} > "$BACKUP_DIR/manifest.tsv"
chmod 600 "$BACKUP_DIR/manifest.tsv"
INTEGRITY_FILES=(
    "$BACKUP_DIR/manifest.tsv"
    "$BACKUP_DIR/script.old"
    "$BACKUP_DIR/service.old"
    "$BACKUP_DIR/timer.old"
    "$BACKUP_DIR/status.old"
    "$BACKUP_DIR/root-crontab.old"
    "$BACKUP_DIR/root-crontab.migrated"
)
if [[ "$OLD_PRIVATE_LOG_CONFIG_STATE" == present ]]; then
    INTEGRITY_FILES+=("$BACKUP_DIR/private-logs-conf.old")
fi
if [[ "$OLD_SNAPSHOT_CRON_STATE" == present ]]; then
    INTEGRITY_FILES+=("$BACKUP_DIR/snapshot-cron.old")
fi
sha256sum "${INTEGRITY_FILES[@]}" > "$BACKUP_DIR/integrity.sha256"
chmod 600 "$BACKUP_DIR/integrity.sha256"
sync_path "$BACKUP_DIR/manifest.tsv"
sync_path "$BACKUP_DIR/integrity.sha256"
sync_path "$BACKUP_DIR"
sync_path "$BACKUP_ROOT"
(cd "$BACKUP_DIR" && sha256sum -c integrity.sha256)
write_marker COMMITTED "old_status_sha=$OLD_STATUS_SHA old_status_inode=$OLD_STATUS_INODE"
PHASE=COMMITTED

atomic_install "$STAGE/shuzijun-internal-health" "$SCRIPT_TARGET" 700 "$NEW_SCRIPT_SHA"
atomic_install "$STAGE/shuzijun-internal-health.service" "$SERVICE_TARGET" 644 "$NEW_SERVICE_SHA"
atomic_install "$STAGE/shuzijun-internal-health.timer" "$TIMER_TARGET" 644 "$NEW_TIMER_SHA"
atomic_install "$STAGE/shuzijun-private-logs.conf" "$PRIVATE_LOG_CONFIG_TARGET" 644 "$NEW_PRIVATE_LOG_CONFIG_SHA"
create_private_logs
capture_root_crontab "$BACKUP_DIR/root-crontab.before-mutation"
[[ "$CAPTURED_CRONTAB_STATE" == "$ROOT_CRONTAB_STATE" ]]
[[ "$CAPTURED_CRONTAB_SHA" == "$ROOT_CRONTAB_SHA" ]]
[[ "$(stargate_digest "$BACKUP_DIR/root-crontab.before-mutation")" == "$OLD_STARGATE_SHA" ]]
require_snapshot_producer_count "$BACKUP_DIR/root-crontab.before-mutation" 1
atomic_install "$STAGE/tencent-daily-snapshot.cron" "$SNAPSHOT_CRON_TARGET" 644 "$NEW_SNAPSHOT_CRON_SHA"
install_migrated_root_crontab "$BACKUP_DIR/root-crontab.migrated"
require_new_support_assets
systemctl daemon-reload
require_new_units
[[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == disabled ]]
[[ "$(systemctl is-active shuzijun-internal-health.timer)" == inactive ]]
require_timer_disabled_link

write_marker STATUS_MAY_CHANGE "old_status_sha=$OLD_STATUS_SHA old_status_inode=$OLD_STATUS_INODE"
PHASE=STATUS_MAY_CHANGE
[[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == disabled ]]
IFS=$'\t' read -r TIMER_START_NS TIMER_START_MONO < <(clock_pair)
start_disabled_timer_and_settle
IFS=$'\t' read -r TIMER_END_NS TIMER_END_MONO < <(clock_pair)
PINNED_INVOCATION=$SETTLED_INVOCATION
PINNED_TIMER_TRIGGER=$SETTLED_TIMER_TRIGGER
require_status
PINNED_STATUS_SHA=$(sha "$STATUS_FILE")
PINNED_STATUS_INODE=$(stat -c '%i' -- "$STATUS_FILE")
classify_timer_activation_evidence "$OLD_STATUS_SHA" "$OLD_STATUS_INODE" "$PINNED_STATUS_SHA" "$PINNED_STATUS_INODE"
if [[ "$TIMER_ACTIVATION_EVIDENCE" == unchanged ]]; then
    PREVIOUS_INVOCATION=$PINNED_INVOCATION
    systemctl reset-failed shuzijun-internal-health.service
    IFS=$'\t' read -r FIRST_START_NS FIRST_START_MONO < <(clock_pair)
    systemctl start shuzijun-internal-health.service
    wait_health_idle
    IFS=$'\t' read -r FIRST_END_NS FIRST_END_MONO < <(clock_pair)
    validate_last_invocation "$OLD_STATUS_INODE" "$OLD_STATUS_SHA" "$PREVIOUS_INVOCATION" "$FIRST_START_NS" "$FIRST_END_NS" "$FIRST_START_MONO" "$FIRST_END_MONO"
    FIRST_INVOCATION=$VALIDATED_INVOCATION
    FIRST_STATUS_SHA=$(sha "$STATUS_FILE")
    FIRST_STATUS_INODE=$(stat -c '%i' -- "$STATUS_FILE")
else
    [[ "$TIMER_ACTIVATION_EVIDENCE" == invoked ]]
    validate_last_invocation "$OLD_STATUS_INODE" "$OLD_STATUS_SHA" "" "$TIMER_START_NS" "$TIMER_END_NS" "$TIMER_START_MONO" "$TIMER_END_MONO"
    [[ "$VALIDATED_INVOCATION" == "$PINNED_INVOCATION" ]]
    FIRST_INVOCATION=$PINNED_INVOCATION
    FIRST_STATUS_SHA=$PINNED_STATUS_SHA
    FIRST_STATUS_INODE=$PINNED_STATUS_INODE
fi
IFS=$'\t' read -r SETTLE_START_NS SETTLE_START_MONO < <(clock_pair)
settle_timer_schedule
IFS=$'\t' read -r SETTLE_END_NS SETTLE_END_MONO < <(clock_pair)
AFTER_INVOCATION=$SETTLED_INVOCATION
AFTER_TIMER_TRIGGER=$SETTLED_TIMER_TRIGGER
require_status
AFTER_STATUS_SHA=$(sha "$STATUS_FILE")
AFTER_STATUS_INODE=$(stat -c '%i' -- "$STATUS_FILE")
if [[ "$AFTER_INVOCATION" != "$FIRST_INVOCATION" || "$AFTER_STATUS_SHA" != "$FIRST_STATUS_SHA" || "$AFTER_STATUS_INODE" != "$FIRST_STATUS_INODE" ]]; then
    [[ "$AFTER_INVOCATION" != "$FIRST_INVOCATION" && "$AFTER_TIMER_TRIGGER" != "$PINNED_TIMER_TRIGGER" ]]
    validate_last_invocation "$FIRST_STATUS_INODE" "$FIRST_STATUS_SHA" "$FIRST_INVOCATION" "$SETTLE_START_NS" "$SETTLE_END_NS" "$SETTLE_START_MONO" "$SETTLE_END_MONO"
    [[ "$VALIDATED_INVOCATION" == "$AFTER_INVOCATION" ]]
fi
validate_timer_quiescent "$AFTER_INVOCATION" "$AFTER_TIMER_TRIGGER" 60000000 360000000
persist_status_snapshot "$AFTER_STATUS_SHA" "$AFTER_STATUS_INODE"

write_marker ACCEPTED "invocation=$AFTER_INVOCATION status_sha=$AFTER_STATUS_SHA status_inode=$AFTER_STATUS_INODE"
PHASE=ACCEPTED
IFS=$'\t' read -r ENABLE_START_NS ENABLE_START_MONO < <(clock_pair)
systemctl enable shuzijun-internal-health.timer
require_timer_enabled_link
sync_timer_enable_state
require_timer_enabled_link
[[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == enabled ]]
[[ "$(systemctl is-active shuzijun-internal-health.timer)" == active ]]
wait_health_idle
IFS=$'\t' read -r ENABLE_END_NS ENABLE_END_MONO < <(clock_pair)
FINAL_INVOCATION=$(unit_value shuzijun-internal-health.service InvocationID)
FINAL_STATUS_SHA=$(sha "$STATUS_FILE")
FINAL_STATUS_INODE=$(stat -c '%i' -- "$STATUS_FILE")
FINAL_TIMER_TRIGGER=$(timer_usec LastTriggerUSecMonotonic)
if [[ "$FINAL_INVOCATION" != "$AFTER_INVOCATION" || "$FINAL_STATUS_SHA" != "$AFTER_STATUS_SHA" || "$FINAL_STATUS_INODE" != "$AFTER_STATUS_INODE" || "$FINAL_TIMER_TRIGGER" != "$AFTER_TIMER_TRIGGER" ]]; then
    validate_last_invocation "$AFTER_STATUS_INODE" "$AFTER_STATUS_SHA" "$AFTER_INVOCATION" "$ENABLE_START_NS" "$ENABLE_END_NS" "$ENABLE_START_MONO" "$ENABLE_END_MONO"
    [[ "$VALIDATED_INVOCATION" == "$FINAL_INVOCATION" && "$FINAL_TIMER_TRIGGER" != "$AFTER_TIMER_TRIGGER" ]]
    persist_status_snapshot "$FINAL_STATUS_SHA" "$FINAL_STATUS_INODE"
    write_marker ACCEPTED "invocation=$FINAL_INVOCATION status_sha=$FINAL_STATUS_SHA status_inode=$FINAL_STATUS_INODE"
fi
validate_timer_quiescent "$FINAL_INVOCATION" "$FINAL_TIMER_TRIGGER" 60000000 360000000
sync_timer_enable_state
require_timer_enabled_link
[[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == enabled ]]
[[ "$(systemctl is-active shuzijun-internal-health.timer)" == active ]]
persist_status_snapshot "$FINAL_STATUS_SHA" "$FINAL_STATUS_INODE"
[[ "$VALIDATED_INVOCATION" == "$FINAL_INVOCATION" ]]
FINAL_EXIT_STATUS=$VALIDATED_EXIT_STATUS
case "$FINAL_EXIT_STATUS" in
    0) FINAL_HEALTH_STATUS=healthy ;;
    2) FINAL_HEALTH_STATUS=degraded ;;
    *) exit 1 ;;
esac
DONE_CONTENT="invocation=$FINAL_INVOCATION status_sha=$FINAL_STATUS_SHA status_inode=$FINAL_STATUS_INODE"
prepare_terminal_marker DONE "$DONE_CONTENT"
require_new_units
sync_timer_enable_state
require_timer_enabled_link
[[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == enabled ]]
[[ "$(systemctl is-active shuzijun-internal-health.timer)" == active ]]
persist_status_snapshot "$FINAL_STATUS_SHA" "$FINAL_STATUS_INODE"
validate_timer_quiescent "$FINAL_INVOCATION" "$FINAL_TIMER_TRIGGER" 60000000 360000000
commit_terminal_marker DONE
PHASE=DONE
trap - ERR INT TERM HUP

printf 'health-monitor-deploy release=%s node=%s status=%s exit=%s backup=%s invocation=%s\n' "$RELEASE_ID" "$NODE" "$FINAL_HEALTH_STATUS" "$FINAL_EXIT_STATUS" "$BACKUP_DIR" "$FINAL_INVOCATION"
