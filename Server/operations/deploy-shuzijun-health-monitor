import hashlib
import os
import stat
import sys

path = sys.argv[1]
directory, name = os.path.split(path)
dir_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_CLOEXEC", 0)
dir_fd = os.open(directory, dir_flags)
try:
    before_path = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(name, flags, dir_fd=dir_fd)
    try:
        before_fd = os.fstat(fd)
        if not stat.S_ISREG(before_fd.st_mode):
            raise SystemExit("deployer is not a regular file")
        if (
            before_fd.st_uid,
            before_fd.st_gid,
            stat.S_IMODE(before_fd.st_mode),
            before_fd.st_nlink,
        ) != (0, 0, 0o700, 1):
            raise SystemExit("deployer metadata mismatch")
        if (before_path.st_dev, before_path.st_ino) != (before_fd.st_dev, before_fd.st_ino):
            raise SystemExit("deployer path changed before hashing")
        digest = hashlib.sha256()
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            digest.update(chunk)
        after_fd = os.fstat(fd)
        after_path = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        if (
            before_fd.st_dev,
            before_fd.st_ino,
            before_fd.st_size,
            before_fd.st_mtime_ns,
        ) != (
            after_fd.st_dev,
            after_fd.st_ino,
            after_fd.st_size,
            after_fd.st_mtime_ns,
        ):
