    metadata=$(stat -c '%F:%u:%g:%a:%h' -- "$path") || return 1
    [[ "$metadata" == 'regular file:0:0:600:1' ]] || { printf 'private log metadata mismatch: %s %s\n' "$path" "$metadata" >&2; return 1; }
}

