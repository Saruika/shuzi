#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
export PATH LC_ALL LANG
unset CDPATH ENV BASH_ENV PYTHONPATH PYTHONHOME || true

SCRIPT_TARGET=/usr/local/sbin/shuzijun-internal-health
SERVICE_TARGET=/etc/systemd/system/shuzijun-internal-health.service
TIMER_TARGET=/etc/systemd/system/shuzijun-internal-health.timer
WANTS_DIR=/etc/systemd/system/timers.target.wants
WANTS_LINK=$WANTS_DIR/shuzijun-internal-health.timer
SERVICE_OBJECT_PATH=/org/freedesktop/systemd1/unit/shuzijun_2dinternal_2dhealth_2eservice
TIMER_OBJECT_PATH=/org/freedesktop/systemd1/unit/shuzijun_2dinternal_2dhealth_2etimer
STATUS_DIR=/var/lib/shuzijun-health
STATUS_FILE=$STATUS_DIR/status.json
BACKUP_ROOT=/var/backups/shuzijun-health-monitor
LOCK_DIR=/run/shuzijun-health-monitor-install
LOCK_FILE=$LOCK_DIR/deploy.lock
ROLE_VERIFY=/usr/local/sbin/verify-shuzijun-account-authority-role
ROLE_VERIFY_SHA=5fe67111642c53895e16afd0a9d6a341af881c3711736f9fe40a34b830e20a58

NEW_SCRIPT_SHA=e5f89d04ad4498396a8abdc32eaad645587c6ec6b7da7fe70c56498286fbd129
NEW_SERVICE_SHA=0dd8ab87398735292e9edd64a9fc57d8edf5097d499c4ba5680d7a2d4c2c80dc
NEW_TIMER_SHA=c7e1137ffd0df3fb8a37df08bfe4876b33ec4d92078e9ea4b94ec646a4a9ce3e
OLD_SCRIPT_SHA=71698f025ff467f837e8b7430b4188d05576d2010f9c4f181eea1e56625ca390
OLD_SERVICE_SHA=db95b5410561ce9e0cca235b7faf09e16d4a954c3c593565681cca49221c9537
OLD_TIMER_SHA=ed73e59758978970bf83269dd97e57763e7e1e62c06a26628105066f21f143b6
APP_MANIFEST_SHA=76f1591503d2bb11005d50f0429171b638caac40246be10ab260c500a63cabe9
APP_PLUGIN_SHA=90d50b197ad39e2efb45d2e394f6926c0c1f01d501ef95e4a21de18bd8581fa3
RELEASE_ID=build41.11
DEPLOYER_PATH=/run/deploy-shuzijun-health-build41.11

[[ $# -eq 2 ]] || { printf 'usage: %s <primary|backup> <authority|standby>\n' "$DEPLOYER_PATH" >&2; exit 2; }
NODE=${1:-}
ROLE=${2:-}
case "$NODE:$ROLE" in
    primary:authority|backup:standby) ;;
    *) printf 'invalid node/role\n' >&2; exit 2 ;;
esac
STAGE=/run/shuzijun-health-build41.11-$NODE

[[ $EUID -eq 0 ]] || { printf 'root required\n' >&2; exit 1; }
[[ "$0" == "$DEPLOYER_PATH" ]] || { printf 'fixed deployer path required\n' >&2; exit 1; }
ROOT_BASHPID=$BASHPID
readonly ROOT_BASHPID
[[ ! -L /run && -d /run && "$(realpath -e /run)" == /run ]]
RUN_METADATA=$(stat -c '%u:%g:%a' /run)
[[ "${RUN_METADATA%%:*}" == 0 && "${RUN_METADATA#*:}" == 0:* ]]
RUN_MODE=${RUN_METADATA##*:}
(( (8#$RUN_MODE & 0022) == 0 ))
DEPLOYER_SHA=$(/usr/bin/python3 -I - "$DEPLOYER_PATH" <<'PY'
import hashlib
import os
import stat
import sys

path = sys.argv[1]
directory, name = os.path.split(path)
dir_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_CLOEXEC", 0)
dir_fd = os.open(directory, dir_flags)
try:
    before_path = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(name, flags, dir_fd=dir_fd)
    try:
        before_fd = os.fstat(fd)
        if not stat.S_ISREG(before_fd.st_mode):
            raise SystemExit("deployer is not a regular file")
        if (
            before_fd.st_uid,
            before_fd.st_gid,
            stat.S_IMODE(before_fd.st_mode),
            before_fd.st_nlink,
        ) != (0, 0, 0o700, 1):
            raise SystemExit("deployer metadata mismatch")
        if (before_path.st_dev, before_path.st_ino) != (before_fd.st_dev, before_fd.st_ino):
            raise SystemExit("deployer path changed before hashing")
        digest = hashlib.sha256()
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            digest.update(chunk)
        after_fd = os.fstat(fd)
        after_path = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        if (
            before_fd.st_dev,
            before_fd.st_ino,
            before_fd.st_size,
            before_fd.st_mtime_ns,
        ) != (
            after_fd.st_dev,
            after_fd.st_ino,
            after_fd.st_size,
            after_fd.st_mtime_ns,
        ):
            raise SystemExit("deployer changed while hashing")
        if (after_path.st_dev, after_path.st_ino) != (after_fd.st_dev, after_fd.st_ino):
            raise SystemExit("deployer path changed while hashing")
        print(digest.hexdigest())
    finally:
        os.close(fd)
finally:
    os.close(dir_fd)
PY
)
[[ "$DEPLOYER_SHA" =~ ^[0-9a-f]{64}$ ]]
if [[ -e "$LOCK_DIR" ]]; then
    [[ ! -L "$LOCK_DIR" && -d "$LOCK_DIR" ]]
    [[ "$(realpath -e "$LOCK_DIR")" == "$LOCK_DIR" ]]
    [[ "$(stat -c '%F:%u:%g:%a' "$LOCK_DIR")" == 'directory:0:0:700' ]]
else
    install -d -o root -g root -m 700 "$LOCK_DIR"
    sync -f "$LOCK_DIR"
    sync -f /run
fi
if [[ -e "$LOCK_FILE" || -L "$LOCK_FILE" ]]; then
    [[ ! -L "$LOCK_FILE" && -f "$LOCK_FILE" ]]
    [[ "$(realpath -e -- "$LOCK_FILE")" == "$LOCK_FILE" ]]
    [[ "$(stat -c '%u:%g:%a:%h' -- "$LOCK_FILE")" == '0:0:600:1' ]]
fi
exec 9>>"$LOCK_FILE"
chown root:root "$LOCK_FILE"
chmod 600 "$LOCK_FILE"
[[ ! -L "$LOCK_FILE" && -f "$LOCK_FILE" ]]
[[ "$(realpath -e -- "$LOCK_FILE")" == "$LOCK_FILE" ]]
[[ "$(stat -c '%u:%g:%a:%h' -- "$LOCK_FILE")" == '0:0:600:1' ]]
flock -n 9 || { printf 'health monitor install lock busy\n' >&2; exit 1; }

PHASE=LOCKED
BACKUP_DIR=
OLD_STATUS_SHA=
OLD_STATUS_INODE=
VALIDATED_INVOCATION=
SETTLED_INVOCATION=
SETTLED_TIMER_TRIGGER=
PREPARED_TERMINAL_NAME=
PREPARED_TERMINAL_CONTENT=
TERMINAL_MARKER_COMMITTED=0
ROLLBACK_RUNNING=0

sha() {
    sha256sum -- "$1" | cut -d' ' -f1
}

require_dir() {
    local path=$1 mode=$2 metadata
    [[ ! -L "$path" && -d "$path" ]] || { printf 'unsafe directory: %s\n' "$path" >&2; return 1; }
    [[ "$(realpath -e -- "$path")" == "$path" ]] || { printf 'non-canonical directory: %s\n' "$path" >&2; return 1; }
    metadata=$(stat -c '%u:%g:%a' -- "$path") || return 1
    [[ "$metadata" == "0:0:$mode" ]] || { printf 'directory metadata mismatch: %s %s\n' "$path" "$metadata" >&2; return 1; }
}

require_safe_parent() {
    local path=$1 metadata mode_value
    [[ ! -L "$path" && -d "$path" ]] || { printf 'unsafe parent: %s\n' "$path" >&2; return 1; }
    [[ "$(realpath -e -- "$path")" == "$path" ]] || { printf 'non-canonical parent: %s\n' "$path" >&2; return 1; }
    metadata=$(stat -c '%u:%g:%a' -- "$path") || return 1
    [[ "${metadata%%:*}" == 0 && "${metadata#*:}" == 0:* ]] || { printf 'parent not root-owned: %s\n' "$path" >&2; return 1; }
    mode_value=${metadata##*:}
    (( (8#$mode_value & 0022) == 0 )) || { printf 'parent writable by non-root: %s\n' "$path" >&2; return 1; }
}

require_file() {
    local path=$1 mode=$2 expected_sha=$3 metadata
    [[ ! -L "$path" && -f "$path" ]] || { printf 'unsafe file: %s\n' "$path" >&2; return 1; }
    [[ "$(realpath -e -- "$path")" == "$path" ]] || { printf 'non-canonical file: %s\n' "$path" >&2; return 1; }
    metadata=$(stat -c '%F:%u:%g:%a:%h' -- "$path") || return 1
    [[ "$metadata" == "regular file:0:0:$mode:1" ]] || { printf 'file metadata mismatch: %s %s\n' "$path" "$metadata" >&2; return 1; }
    [[ "$(sha "$path")" == "$expected_sha" ]] || { printf 'file hash mismatch: %s\n' "$path" >&2; return 1; }
}

require_status() {
    require_dir "$STATUS_DIR" 700 || return 1
    require_safe_parent /var || return 1
    require_safe_parent /var/lib || return 1
    local metadata
    [[ ! -L "$STATUS_FILE" && -f "$STATUS_FILE" ]] || { printf 'unsafe status file\n' >&2; return 1; }
    metadata=$(stat -c '%F:%u:%g:%a:%h' -- "$STATUS_FILE") || return 1
    [[ "$metadata" == 'regular file:0:0:600:1' ]] || { printf 'status metadata mismatch: %s\n' "$metadata" >&2; return 1; }
}

require_timer_enabled_link() {
    local metadata target
    require_safe_parent "$WANTS_DIR" || return 1
    [[ -L "$WANTS_LINK" ]] || return 1
    metadata=$(stat -c '%F:%u:%g:%a:%h' -- "$WANTS_LINK") || return 1
    [[ "$metadata" == 'symbolic link:0:0:777:1' ]] || return 1
    target=$(readlink -- "$WANTS_LINK") || return 1
    [[ "$target" == "$TIMER_TARGET" ]] || return 1
    [[ "$(realpath -e -- "$WANTS_LINK")" == "$TIMER_TARGET" ]] || return 1
}

require_timer_disabled_link() {
    if [[ ! -e "$WANTS_DIR" && ! -L "$WANTS_DIR" ]]; then
        require_safe_parent /etc/systemd/system || return 1
        return 0
    fi
    require_safe_parent "$WANTS_DIR" || return 1
    [[ ! -e "$WANTS_LINK" && ! -L "$WANTS_LINK" ]] || return 1
}

sync_timer_enable_state() {
    if [[ -e "$WANTS_DIR" || -L "$WANTS_DIR" ]]; then
        require_safe_parent "$WANTS_DIR" || return 1
        sync_path "$WANTS_DIR" || return 1
    else
        require_safe_parent /etc/systemd/system || return 1
    fi
    sync_path /etc/systemd/system || return 1
}

unit_value() {
    systemctl show "$1" --property="$2" --value
}

exec_start_ex_json() {
    local object=$1
    [[ "$object" == "$SERVICE_OBJECT_PATH" ]] || return 1
    /usr/bin/busctl --json=short --system get-property \
        org.freedesktop.systemd1 "$object" \
        org.freedesktop.systemd1.Service ExecStartEx
}

require_exact_exec_start() {
    local object=$1 expected_path=$2 output
    shift 2
    (( $# > 0 )) || return 1
    output=$(exec_start_ex_json "$object") || return 1
    /usr/bin/python3 -I - "$output" "$expected_path" "$@" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
expected_path = sys.argv[2]
expected_argv = sys.argv[3:]
if set(payload) != {"type", "data"}:
    raise SystemExit(1)
if payload["type"] != "a(sasasttttuii)":
    raise SystemExit(1)
data = payload["data"]
if not isinstance(data, list) or len(data) != 1:
    raise SystemExit(1)
entry = data[0]
if not isinstance(entry, list) or len(entry) != 10:
    raise SystemExit(1)
if entry[0] != expected_path or entry[1] != expected_argv or entry[2] != []:
    raise SystemExit(1)
if any(type(value) is not int for value in entry[3:]):
    raise SystemExit(1)
PY
}

require_service_execution_context() {
    local unit=$1 user group environment environment_files pass_environment unset_environment
    local working_directory root_directory root_image exec_search_path
    [[ "$unit" == shuzijun-internal-health.service ]] || return 1
    user=$(unit_value "$unit" User) || return 1
    group=$(unit_value "$unit" Group) || return 1
    environment=$(unit_value "$unit" Environment) || return 1
    environment_files=$(unit_value "$unit" EnvironmentFiles) || return 1
    pass_environment=$(unit_value "$unit" PassEnvironment) || return 1
    unset_environment=$(unit_value "$unit" UnsetEnvironment) || return 1
    working_directory=$(unit_value "$unit" WorkingDirectory) || return 1
    root_directory=$(unit_value "$unit" RootDirectory) || return 1
    root_image=$(unit_value "$unit" RootImage) || return 1
    exec_search_path=$(unit_value "$unit" ExecSearchPath) || return 1
    [[ "$user" == root && "$group" == root ]] || return 1
    [[ -z "$environment" && -z "$environment_files" && -z "$pass_environment" ]] || return 1
    [[ -z "$unset_environment" && -z "$working_directory" && -z "$root_directory" ]] || return 1
    [[ -z "$root_image" && -z "$exec_search_path" ]] || return 1
}

unit_uint64() {
    local object=$1 interface=$2 property=$3 output signature value extra
    output=$(/usr/bin/busctl --system get-property org.freedesktop.systemd1 "$object" "$interface" "$property") || return 1
    IFS=' ' read -r signature value extra <<< "$output"
    [[ "$signature" == t && "$value" =~ ^[0-9]+$ && -z "${extra:-}" ]] || {
        printf 'invalid uint64 systemd property: %s\n' "$property" >&2
        return 1
    }
    printf '%s\n' "$value"
}

service_usec() {
    unit_uint64 "$SERVICE_OBJECT_PATH" org.freedesktop.systemd1.Service "$1"
}

timer_usec() {
    unit_uint64 "$TIMER_OBJECT_PATH" org.freedesktop.systemd1.Timer "$1"
}

require_frozen_files() {
    require_safe_parent /usr || return 1
    require_safe_parent /usr/local || return 1
    require_safe_parent /usr/local/sbin || return 1
    require_safe_parent /etc || return 1
    require_safe_parent /etc/systemd || return 1
    require_safe_parent /etc/systemd/system || return 1
    require_file "$SCRIPT_TARGET" 700 "$OLD_SCRIPT_SHA" || return 1
    require_file "$SERVICE_TARGET" 644 "$OLD_SERVICE_SHA" || return 1
    require_file "$TIMER_TARGET" 644 "$OLD_TIMER_SHA" || return 1
    require_status || return 1
}

require_old_state() {
    require_old_runtime_loaded active inactive-or-failed preflight || return 1
    [[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == enabled ]] || return 1
    require_timer_enabled_link || return 1
}

require_old_runtime_loaded() {
    local expected_timer_state=$1 expected_service_state=$2
    local timer_policy=${3:-strict}
    local timer_state timer_substate timer_job timer_unit timer_reload
    local service_state service_substate service_job service_result service_main_status service_reload service_type
    local service_dropins timer_dropins exec_condition exec_start_pre exec_start_post exec_reload exec_stop exec_stop_post success_status
    [[ "$expected_timer_state" == inactive || "$expected_timer_state" == active ]] || return 1
    [[ "$expected_service_state" == inactive || "$expected_service_state" == inactive-or-failed ]] || return 1
    [[ "$timer_policy" == strict || "$timer_policy" == preflight ]] || return 1
    require_frozen_files || return 1
    require_file "$ROLE_VERIFY" 755 "$ROLE_VERIFY_SHA" || return 1
    /usr/bin/python3 -I "$ROLE_VERIFY" "$ROLE" || return 1
    timer_state=$(unit_value shuzijun-internal-health.timer ActiveState) || return 1
    timer_substate=$(unit_value shuzijun-internal-health.timer SubState) || return 1
    timer_job=$(unit_value shuzijun-internal-health.timer Job) || return 1
    timer_unit=$(unit_value shuzijun-internal-health.timer Unit) || return 1
    timer_reload=$(unit_value shuzijun-internal-health.timer NeedDaemonReload) || return 1
    service_state=$(unit_value shuzijun-internal-health.service ActiveState) || return 1
    service_substate=$(unit_value shuzijun-internal-health.service SubState) || return 1
    service_job=$(unit_value shuzijun-internal-health.service Job) || return 1
    service_reload=$(unit_value shuzijun-internal-health.service NeedDaemonReload) || return 1
    service_type=$(unit_value shuzijun-internal-health.service Type) || return 1
    [[ "$timer_state" == "$expected_timer_state" && -z "$timer_job" ]] || return 1
    if [[ "$expected_timer_state" == active ]]; then
        if [[ "$timer_policy" == preflight ]]; then
            [[ "$timer_substate" == waiting || "$timer_substate" == elapsed ]] || return 1
        else
            [[ "$timer_substate" == waiting ]] || return 1
        fi
    else
        [[ "$timer_substate" == dead ]] || return 1
    fi
    [[ "$timer_unit" == shuzijun-internal-health.service && "$timer_reload" == no ]] || return 1
    [[ -z "$service_job" && "$service_reload" == no && "$service_type" == oneshot ]] || return 1
    if [[ "$expected_service_state" == inactive ]]; then
        [[ "$service_state" == inactive && "$service_substate" == dead ]] || return 1
    else
        case "$service_state:$service_substate" in
            inactive:dead) ;;
            failed:failed)
                service_result=$(unit_value shuzijun-internal-health.service Result) || return 1
                service_main_status=$(unit_value shuzijun-internal-health.service ExecMainStatus) || return 1
                [[ "$service_result" == exit-code && "$service_main_status" == 1 ]] || return 1
                ;;
            *) return 1 ;;
        esac
    fi
    [[ "$(unit_value shuzijun-internal-health.service FragmentPath)" == "$SERVICE_TARGET" ]] || return 1
    [[ "$(unit_value shuzijun-internal-health.timer FragmentPath)" == "$TIMER_TARGET" ]] || return 1
    service_dropins=$(unit_value shuzijun-internal-health.service DropInPaths) || return 1
    timer_dropins=$(unit_value shuzijun-internal-health.timer DropInPaths) || return 1
    [[ -z "$service_dropins" && -z "$timer_dropins" ]] || return 1
    require_exact_exec_start "$SERVICE_OBJECT_PATH" /usr/local/sbin/shuzijun-internal-health /usr/local/sbin/shuzijun-internal-health || return 1
    require_service_execution_context shuzijun-internal-health.service || return 1
    exec_condition=$(unit_value shuzijun-internal-health.service ExecCondition) || return 1
    exec_start_pre=$(unit_value shuzijun-internal-health.service ExecStartPre) || return 1
    exec_start_post=$(unit_value shuzijun-internal-health.service ExecStartPost) || return 1
    exec_reload=$(unit_value shuzijun-internal-health.service ExecReload) || return 1
    exec_stop=$(unit_value shuzijun-internal-health.service ExecStop) || return 1
    exec_stop_post=$(unit_value shuzijun-internal-health.service ExecStopPost) || return 1
    [[ -z "$exec_condition" && -z "$exec_start_pre" && -z "$exec_start_post" ]] || return 1
    [[ -z "$exec_reload" && -z "$exec_stop" && -z "$exec_stop_post" ]] || return 1
    success_status=$(unit_value shuzijun-internal-health.service SuccessExitStatus) || return 1
    [[ -z "$success_status" ]] || return 1
    systemd-analyze verify "$SERVICE_TARGET" "$TIMER_TARGET" || return 1
}

require_old_runtime_isolated() {
    require_old_runtime_loaded inactive inactive || return 1
    [[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == disabled ]] || return 1
    require_timer_disabled_link || return 1
}

require_old_runtime_enabled_inactive() {
    require_old_runtime_loaded inactive inactive || return 1
    [[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == enabled ]] || return 1
    require_timer_enabled_link || return 1
}

require_old_runtime_active() {
    require_old_runtime_loaded active inactive-or-failed || return 1
    [[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == enabled ]] || return 1
