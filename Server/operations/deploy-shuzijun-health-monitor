    require_status || return 1
    current_sha=$(sha "$STATUS_FILE") || return 1
    current_inode=$(stat -c '%i' -- "$STATUS_FILE") || return 1
    [[ "$current_sha" == "$expected_sha" && "$current_inode" == "$expected_inode" ]] || return 1
    sync_path "$STATUS_FILE" || return 1
    sync_path "$STATUS_DIR" || return 1
    require_status || return 1
    current_sha=$(sha "$STATUS_FILE") || return 1
    current_inode=$(stat -c '%i' -- "$STATUS_FILE") || return 1
    [[ "$current_sha" == "$expected_sha" && "$current_inode" == "$expected_inode" ]] || return 1
