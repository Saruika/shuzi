require_old_runtime_loaded() {
    local expected_timer_state=$1 expected_service_state=$2
    local timer_policy=${3:-strict}
    local timer_state timer_substate timer_job timer_unit timer_reload
    local service_state service_substate service_job service_result service_main_status service_reload service_type
    local service_dropins timer_dropins exec_condition exec_start_pre exec_start_post exec_reload exec_stop exec_stop_post success_status
    [[ "$expected_timer_state" == inactive || "$expected_timer_state" == active ]] || return 1
    [[ "$expected_service_state" == inactive || "$expected_service_state" == inactive-or-failed ]] || return 1
    [[ "$timer_policy" == strict || "$timer_policy" == preflight ]] || return 1
    require_frozen_files || return 1
    require_file "$ROLE_VERIFY" 755 "$ROLE_VERIFY_SHA" || return 1
    /usr/bin/python3 -I "$ROLE_VERIFY" "$ROLE" || return 1
    timer_state=$(unit_value shuzijun-internal-health.timer ActiveState) || return 1
    timer_substate=$(unit_value shuzijun-internal-health.timer SubState) || return 1
    timer_job=$(unit_value shuzijun-internal-health.timer Job) || return 1
    timer_unit=$(unit_value shuzijun-internal-health.timer Unit) || return 1
    timer_reload=$(unit_value shuzijun-internal-health.timer NeedDaemonReload) || return 1
    service_state=$(unit_value shuzijun-internal-health.service ActiveState) || return 1
    service_substate=$(unit_value shuzijun-internal-health.service SubState) || return 1
    service_job=$(unit_value shuzijun-internal-health.service Job) || return 1
    service_reload=$(unit_value shuzijun-internal-health.service NeedDaemonReload) || return 1
    service_type=$(unit_value shuzijun-internal-health.service Type) || return 1
    [[ "$timer_state" == "$expected_timer_state" && -z "$timer_job" ]] || return 1
    if [[ "$expected_timer_state" == active ]]; then
        if [[ "$timer_policy" == preflight ]]; then
            [[ "$timer_substate" == waiting || "$timer_substate" == elapsed ]] || return 1
        else
            [[ "$timer_substate" == waiting ]] || return 1
        fi
    else
        [[ "$timer_substate" == dead ]] || return 1
    fi
    [[ "$timer_unit" == shuzijun-internal-health.service && "$timer_reload" == no ]] || return 1
    [[ -z "$service_job" && "$service_reload" == no && "$service_type" == oneshot ]] || return 1
    if [[ "$expected_service_state" == inactive ]]; then
        [[ "$service_state" == inactive && "$service_substate" == dead ]] || return 1
    else
        case "$service_state:$service_substate" in
            inactive:dead) ;;
            failed:failed)
                service_result=$(unit_value shuzijun-internal-health.service Result) || return 1
                service_main_status=$(unit_value shuzijun-internal-health.service ExecMainStatus) || return 1
                [[ "$service_result" == exit-code && "$service_main_status" == 1 ]] || return 1
                ;;
            *) return 1 ;;
        esac
    fi
    [[ "$(unit_value shuzijun-internal-health.service FragmentPath)" == "$SERVICE_TARGET" ]] || return 1
    [[ "$(unit_value shuzijun-internal-health.timer FragmentPath)" == "$TIMER_TARGET" ]] || return 1
    service_dropins=$(unit_value shuzijun-internal-health.service DropInPaths) || return 1
    timer_dropins=$(unit_value shuzijun-internal-health.timer DropInPaths) || return 1
    [[ -z "$service_dropins" && -z "$timer_dropins" ]] || return 1
    require_exact_exec_start "$SERVICE_OBJECT_PATH" /usr/local/sbin/shuzijun-internal-health /usr/local/sbin/shuzijun-internal-health || return 1
    require_service_execution_context shuzijun-internal-health.service || return 1
    exec_condition=$(unit_value shuzijun-internal-health.service ExecCondition) || return 1
    exec_start_pre=$(unit_value shuzijun-internal-health.service ExecStartPre) || return 1
    exec_start_post=$(unit_value shuzijun-internal-health.service ExecStartPost) || return 1
    exec_reload=$(unit_value shuzijun-internal-health.service ExecReload) || return 1
    exec_stop=$(unit_value shuzijun-internal-health.service ExecStop) || return 1
    exec_stop_post=$(unit_value shuzijun-internal-health.service ExecStopPost) || return 1
    [[ -z "$exec_condition" && -z "$exec_start_pre" && -z "$exec_start_post" ]] || return 1
    [[ -z "$exec_reload" && -z "$exec_stop" && -z "$exec_stop_post" ]] || return 1
    success_status=$(unit_value shuzijun-internal-health.service SuccessExitStatus) || return 1
    [[ -z "$success_status" ]] || return 1
    systemd-analyze verify "$SERVICE_TARGET" "$TIMER_TARGET" || return 1
}

