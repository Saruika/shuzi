rollback() {
    local original_rc=${1:-1} rollback_ok=1 isolation_ok=1 commit_sync_ok=1 terminal_sync_ok=1 rollback_status_sha rollback_status_inode rollback_marker expected_done
    if (( ROLLBACK_RUNNING != 0 )); then
        return
    fi
    trap '' INT TERM HUP
    ROLLBACK_RUNNING=1
    trap - ERR
    set +e
    expected_done="invocation=${FINAL_INVOCATION:-} status_sha=${FINAL_STATUS_SHA:-} status_inode=${FINAL_STATUS_INODE:-}"
    if done_marker_matches || {
        (( TERMINAL_MARKER_COMMITTED == 1 )) &&
        [[ -n "${FINAL_INVOCATION:-}" && -n "${FINAL_STATUS_SHA:-}" && -n "${FINAL_STATUS_INODE:-}" ]] &&
        [[ "$PREPARED_TERMINAL_NAME" == ".terminal-DONE-$$" && "$PREPARED_TERMINAL_CONTENT" == "$expected_done" ]]
    }; then
        marker_matches DONE "$expected_done" || commit_sync_ok=0
        sync_path "$BACKUP_DIR/DONE" || commit_sync_ok=0
        sync_path "$BACKUP_DIR" || commit_sync_ok=0
        sync_path "$BACKUP_ROOT" || commit_sync_ok=0
        sync_path "$(dirname -- "$BACKUP_ROOT")" || commit_sync_ok=0
        if (( commit_sync_ok == 1 )); then
            printf 'deployment reached its durable DONE commit before interruption; no rollback was performed; backup=%s\n' "$BACKUP_DIR" >&2
            exit 0
        fi
        printf 'CRITICAL deployment reached a valid DONE commit but journal durability could not be reconfirmed; no rollback was performed; backup=%s\n' "$BACKUP_DIR" >&2
        exit "$original_rc"
    fi
    if [[ "$PHASE" == LOCKED ]]; then
        printf 'deployment preflight failed before any service or final-file mutation\n' >&2
        exit "$original_rc"
    fi
    systemctl disable --now shuzijun-internal-health.timer >/dev/null 2>&1 || isolation_ok=0
    systemctl stop shuzijun-internal-health.service >/dev/null 2>&1 || isolation_ok=0
    normalize_stopped_health_service >/dev/null 2>&1 || isolation_ok=0
    [[ "$(systemctl is-active shuzijun-internal-health.timer 2>/dev/null)" == inactive ]] || isolation_ok=0
    [[ "$(systemctl is-active shuzijun-internal-health.service 2>/dev/null)" == inactive ]] || isolation_ok=0
    require_timer_disabled_link || isolation_ok=0
    sync_timer_enable_state || isolation_ok=0
    require_timer_disabled_link || isolation_ok=0
    (( isolation_ok == 1 )) || rollback_ok=0
    if (( isolation_ok == 1 )) && [[ "$PHASE" == COMMITTED || "$PHASE" == STATUS_MAY_CHANGE || "$PHASE" == ACCEPTED ]]; then
        restore_root_crontab || rollback_ok=0
        restore_optional_asset "$SNAPSHOT_CRON_TARGET" snapshot-cron.old "$OLD_SNAPSHOT_CRON_STATE" "$OLD_SNAPSHOT_CRON_SHA" "$NEW_SNAPSHOT_CRON_SHA" || rollback_ok=0
        require_snapshot_producer_count "$BACKUP_DIR/root-crontab.rollback" 1 || rollback_ok=0
        restore_optional_asset "$PRIVATE_LOG_CONFIG_TARGET" private-logs-conf.old "$OLD_PRIVATE_LOG_CONFIG_STATE" "$OLD_PRIVATE_LOG_CONFIG_SHA" "$NEW_PRIVATE_LOG_CONFIG_SHA" || rollback_ok=0
        restore_private_log_state || rollback_ok=0
        atomic_restore "$BACKUP_DIR/script.old" "$SCRIPT_TARGET" "$OLD_SCRIPT_SHA" 700 || rollback_ok=0
        atomic_restore "$BACKUP_DIR/service.old" "$SERVICE_TARGET" "$OLD_SERVICE_SHA" 644 || rollback_ok=0
        atomic_restore "$BACKUP_DIR/timer.old" "$TIMER_TARGET" "$OLD_TIMER_SHA" 644 || rollback_ok=0
        require_dir "$STATUS_DIR" 700 || rollback_ok=0
        require_safe_parent /var || rollback_ok=0
        require_safe_parent /var/lib || rollback_ok=0
        if (( rollback_ok == 1 )); then
            if require_status && [[ "$(sha "$STATUS_FILE")" == "$OLD_STATUS_SHA" && "$(stat -c '%i' -- "$STATUS_FILE")" == "$OLD_STATUS_INODE" ]]; then
                :
            else
                atomic_restore "$BACKUP_DIR/status.old" "$STATUS_FILE" "$OLD_STATUS_SHA" 600 || rollback_ok=0
            fi
        fi
        if ! require_status || [[ "$(sha "$STATUS_FILE")" != "$OLD_STATUS_SHA" ]]; then
            rollback_ok=0
        fi
    fi
    if (( rollback_ok == 1 )); then
        systemctl daemon-reload || rollback_ok=0
        require_old_runtime_isolated || rollback_ok=0
    fi
    if (( rollback_ok == 1 )); then
        systemctl enable shuzijun-internal-health.timer >/dev/null 2>&1 || rollback_ok=0
        require_old_runtime_enabled_inactive || rollback_ok=0
        sync_timer_enable_state || rollback_ok=0
        require_old_runtime_enabled_inactive || rollback_ok=0
    fi
    if (( rollback_ok == 1 )); then
        rollback_marker="original_rc=$original_rc runtime=restored timer=enabled+active old_script=$OLD_SCRIPT_SHA old_service=$OLD_SERVICE_SHA old_timer=$OLD_TIMER_SHA"
        prepare_terminal_marker ROLLED_BACK "$rollback_marker" || rollback_ok=0
    fi
    if (( rollback_ok == 1 )); then
        systemctl start shuzijun-internal-health.timer >/dev/null 2>&1 || rollback_ok=0
        [[ "$(systemctl is-enabled shuzijun-internal-health.timer)" == enabled ]] || rollback_ok=0
        [[ "$(systemctl is-active shuzijun-internal-health.timer)" == active ]] || rollback_ok=0
        require_timer_enabled_link || rollback_ok=0
        wait_health_idle || rollback_ok=0
        systemctl reset-failed shuzijun-internal-health.service >/dev/null 2>&1 || rollback_ok=0
        systemctl start shuzijun-internal-health.service >/dev/null 2>&1 || true
        wait_health_idle || rollback_ok=0
        settle_timer_schedule || rollback_ok=0
        RESTORED_INVOCATION=$SETTLED_INVOCATION
        RESTORED_TIMER_TRIGGER=$SETTLED_TIMER_TRIGGER
    fi
    if (( rollback_ok == 1 )); then
        require_status || rollback_ok=0
        sync_timer_enable_state || rollback_ok=0
        require_old_runtime_active || rollback_ok=0
    fi
    if (( rollback_ok == 1 )); then
        rollback_status_sha=$(sha "$STATUS_FILE") || rollback_ok=0
        rollback_status_inode=$(stat -c '%i' -- "$STATUS_FILE") || rollback_ok=0
        persist_status_snapshot "$rollback_status_sha" "$rollback_status_inode" || rollback_ok=0
        require_old_runtime_active || rollback_ok=0
    fi
    if (( rollback_ok == 1 )); then
        validate_timer_quiescent "$RESTORED_INVOCATION" "$RESTORED_TIMER_TRIGGER" 60000000 360000000 || rollback_ok=0
    fi
    if (( rollback_ok == 1 )); then
        commit_terminal_marker ROLLED_BACK || rollback_ok=0
    fi
    if (( TERMINAL_MARKER_COMMITTED == 1 )); then
        marker_matches ROLLED_BACK "$rollback_marker" || terminal_sync_ok=0
        sync_path "$BACKUP_DIR/ROLLED_BACK" || terminal_sync_ok=0
        sync_path "$BACKUP_DIR" || terminal_sync_ok=0
        sync_path "$BACKUP_ROOT" || terminal_sync_ok=0
        sync_path "$(dirname -- "$BACKUP_ROOT")" || terminal_sync_ok=0
        marker_matches ROLLED_BACK "$rollback_marker" || terminal_sync_ok=0
        if (( terminal_sync_ok == 1 )); then
            printf 'deployment failed; verified runtime rollback completed; backup=%s\n' "$BACKUP_DIR" >&2
        else
            printf 'CRITICAL rollback commit is published and the verified old timer remains active, but journal durability could not be reconfirmed; backup=%s\n' "$BACKUP_DIR" >&2
        fi
        exit "$original_rc"
    fi
    systemctl disable --now shuzijun-internal-health.timer >/dev/null 2>&1 || true
    systemctl stop shuzijun-internal-health.service >/dev/null 2>&1 || true
    printf 'CRITICAL deployment and/or rollback failed before the rollback commit; timer disable attempted but final isolation state is unverified; backup=%s\n' "$BACKUP_DIR" >&2
    exit "$original_rc"
}

on_error() {
