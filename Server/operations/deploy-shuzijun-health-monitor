capture_root_crontab() {
    local destination=$1 temporary error_file rc state errexit_was_set=0
    temporary=$destination.tmp.$$
    error_file=$destination.stderr.$$
    [[ ! -e "$destination" && ! -L "$destination" && ! -e "$temporary" && ! -L "$temporary" ]] || return 1
    [[ $- == *e* ]] && errexit_was_set=1
    set +e
    /usr/bin/crontab -l >"$temporary" 2>"$error_file"
    rc=$?
    if (( errexit_was_set == 1 )); then
        set -e
    else
        set +e
    fi
    if (( rc == 0 )); then
        [[ ! -s "$error_file" ]] || { rm -f -- "$temporary" "$error_file"; return 1; }
        state=present
    elif (( rc == 1 )) && grep -qFx 'no crontab for root' "$error_file"; then
        [[ ! -s "$temporary" ]] || { rm -f -- "$temporary" "$error_file"; return 1; }
        state=absent
    else
        rm -f -- "$temporary" "$error_file"
        return 1
    fi
    rm -f -- "$error_file" || return 1
    chown root:root "$temporary" || return 1
    chmod 600 "$temporary" || return 1
    sync_path "$temporary" || return 1
    mv -T -- "$temporary" "$destination" || return 1
    sync_path "$(dirname -- "$destination")" || return 1
    CAPTURED_CRONTAB_STATE=$state
    CAPTURED_CRONTAB_SHA=$(sha "$destination") || return 1
    require_file "$destination" 600 "$CAPTURED_CRONTAB_SHA" || return 1
}

transform_root_crontab() {
    local source=$1 destination=$2
    REMOVED_SNAPSHOT_LINES=$(/usr/bin/python3 -I - "$source" "$destination" "$OLD_SNAPSHOT_CRON_LINE" <<'PY'
import os
import pathlib
import sys

source = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
expected = sys.argv[3].encode("utf-8")
data = source.read_bytes()
kept = []
removed = 0
for line in data.splitlines(keepends=True):
    content = line[:-1] if line.endswith(b"\n") else line
    if content == expected:
        removed += 1
    else:
        kept.append(line)
if removed not in (0, 1):
    raise SystemExit("legacy snapshot producer multiplicity mismatch")
flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0)
fd = os.open(destination, flags, 0o600)
try:
    payload = b"".join(kept)
    view = memoryview(payload)
    while view:
        count = os.write(fd, view)
        if count <= 0:
            raise SystemExit("short crontab write")
        view = view[count:]
    os.fsync(fd)
finally:
    os.close(fd)
print(removed)
PY
    ) || return 1
    [[ "$REMOVED_SNAPSHOT_LINES" == 0 || "$REMOVED_SNAPSHOT_LINES" == 1 ]] || return 1
    chown root:root "$destination" || return 1
    chmod 600 "$destination" || return 1
    TRANSFORMED_CRONTAB_SHA=$(sha "$destination") || return 1
    require_file "$destination" 600 "$TRANSFORMED_CRONTAB_SHA" || return 1
}

stargate_digest() {
    /usr/bin/python3 -I - "$1" "$NODE" <<'PY'
import hashlib
import pathlib
import sys

lines = [line for line in pathlib.Path(sys.argv[1]).read_bytes().splitlines(keepends=True) if b"stargate" in line.lower()]
if sys.argv[2] == "primary" and not lines:
    raise SystemExit("primary stargate producer missing")
print(hashlib.sha256(b"".join(lines)).hexdigest())
PY
}

snapshot_producer_count() {
    local root_crontab=$1
    require_safe_parent /etc || return 1
    require_safe_parent /etc/cron.d || return 1
    /usr/bin/python3 -I - "$root_crontab" <<'PY'
import os
import pathlib
import stat
import sys

needle = b"/usr/local/sbin/tencent-daily-snapshot"
paths = [pathlib.Path(sys.argv[1])]
system_crontab = pathlib.Path("/etc/crontab")
if os.path.lexists(system_crontab):
    paths.append(system_crontab)
cron_directory = pathlib.Path("/etc/cron.d")
for entry in sorted(cron_directory.iterdir()):
    if entry.name.startswith("."):
        continue
    paths.append(entry)

count = 0
for path in paths:
    before_path = path.lstat()
    if not stat.S_ISREG(before_path.st_mode):
        raise SystemExit(f"unsafe cron entry: {path}")
    if path != paths[0] and (
        before_path.st_uid != 0
        or before_path.st_gid != 0
        or before_path.st_nlink != 1
        or stat.S_IMODE(before_path.st_mode) & 0o022
    ):
        raise SystemExit(f"unsafe cron metadata: {path}")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
    fd = os.open(path, flags)
    try:
        before_fd = os.fstat(fd)
        if (before_path.st_dev, before_path.st_ino) != (before_fd.st_dev, before_fd.st_ino):
            raise SystemExit(f"cron path changed: {path}")
        chunks = []
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
        after_fd = os.fstat(fd)
        if (before_fd.st_dev, before_fd.st_ino, before_fd.st_size, before_fd.st_mtime_ns, before_fd.st_ctime_ns) != (after_fd.st_dev, after_fd.st_ino, after_fd.st_size, after_fd.st_mtime_ns, after_fd.st_ctime_ns):
            raise SystemExit(f"cron entry changed: {path}")
    finally:
        os.close(fd)
    for line in b"".join(chunks).splitlines():
        stripped = line.lstrip()
        if stripped and not stripped.startswith(b"#") and needle in stripped:
            count += 1
print(count)
PY
}

