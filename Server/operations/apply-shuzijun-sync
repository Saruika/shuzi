def strict_directory(path, uid, gid, mode, device=None):
    metadata = path.lstat()
    if (path.resolve(strict=True) != path or not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != uid or metadata.st_gid != gid
            or stat.S_IMODE(metadata.st_mode) != mode
            or (device is not None and metadata.st_dev != device)):
        raise RuntimeError("unsafe directory")
    return metadata

for parent in (Path("/var"), Path("/var/lib")):
    strict_directory(parent, 0, 0, 0o755)
sync_meta = strict_directory(sync_root, 0, 0, 0o700)
state_meta = strict_directory(state_root, 0, 0, 0o700, sync_meta.st_dev)
if (release_root != sync_root / "uploads-releases"
        or active_path != state_root / "active-uploads-generation"
        or transaction_path != state_root / "uploads-transaction.json"
        or active_release_path != state_root / "active-release-v4.json"
        or live != Path("/var/www/html/shuzijun.com.cn/wp-content/uploads")
        or accepted_path != state_root / "highest-accepted-generation"):
    raise SystemExit(1)

def open_payload(path, pattern=None, limit=4096):
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(descriptor)
        payload = os.read(descriptor, limit + 1)
        if os.read(descriptor, 1):
            raise RuntimeError("oversize state")
    finally:
        os.close(descriptor)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
            or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1 or metadata.st_dev != state_meta.st_dev
            or len(payload) > limit or (pattern is not None and not re.fullmatch(pattern, payload))):
        raise RuntimeError("unsafe state")
    return payload

def read_generation(path, allow_zero=False):
    pattern = rb"(?:0|[1-9][0-9]{0,18})\n" if allow_zero else rb"[1-9][0-9]{0,18}\n"
    return int(open_payload(path, pattern, 31))

def fsync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)

def create_state_temporary(prefix):
    if prefix not in {
        ".active-release-v4.", ".uploads-transaction.", ".active-generation."
    }:
        raise RuntimeError("invalid state temporary prefix")
    for _attempt in range(128):
        temporary = state_root / f"{prefix}{secrets.token_hex(16)}"
        try:
            descriptor = os.open(
                temporary,
                os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
                0o600,
            )
        except FileExistsError:
            continue
        return descriptor, temporary
    raise RuntimeError("state temporary allocation exhausted")

def rename_noreplace(source, destination):
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise RuntimeError("renameat2 unavailable")
    renameat2.argtypes = [
        ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p,
        ctypes.c_uint,
    ]
    renameat2.restype = ctypes.c_int
    if renameat2(
        -100, os.fsencode(source), -100, os.fsencode(destination), 1
    ) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))

def atomic_write(path, payload, prefix, must_be_absent=False):
    if path.parent != state_root:
        raise RuntimeError("unsafe state destination")
    try:
        existing = open_payload(path, limit=32 * 1024)
    except FileNotFoundError:
        existing = None
    if must_be_absent and existing is not None:
        raise RuntimeError("state already exists")
    descriptor, temporary = create_state_temporary(prefix)
    try:
        os.fchmod(descriptor, 0o600)
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise RuntimeError("short state write")
            view = view[written:]
        os.fsync(descriptor)
        metadata = os.fstat(descriptor)
        if (metadata.st_uid != 0 or metadata.st_gid != 0
                or stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_nlink != 1
                or metadata.st_dev != state_meta.st_dev or metadata.st_size != len(payload)):
            raise RuntimeError("unsafe temporary state")
        os.close(descriptor)
        descriptor = -1
        if must_be_absent:
            rename_noreplace(temporary, path)
        else:
            os.replace(temporary, path)
        fsync_directory(state_root)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass

def canonical_transaction(document):
    return (json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True) + "\n").encode("ascii")

def load_transaction():
    raw = open_payload(transaction_path, limit=32 * 1024)
    document = json.loads(raw.decode("ascii"))
    if (set(document) != TX_KEYS or document.get("version") != 1
            or canonical_transaction(document) != raw
            or document.get("phase") not in PHASES):
        raise RuntimeError("invalid transaction")
    for key in ("generation", "previous_generation", "source_dev", "source_ino",
                "candidate_dev", "candidate_ino", "live_dev", "live_ino"):
        value = document.get(key)
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise RuntimeError("invalid transaction number")
    if document["generation"] < 1 or document["previous_generation"] < 1:
        raise RuntimeError("invalid transaction generation")
    if (not re.fullmatch(r"[0-9a-f]{64}", document.get("manifest_sha256", ""))
            or not re.fullmatch(r"\.candidate-generation-[1-9][0-9]{0,18}", document.get("candidate_name", ""))
            or Path(document.get("source", "")).name != "uploads"
            or Path(document.get("backup", "")).parent != Path("/var/backups")
            or not re.fullmatch(r"shuzijun-sync-v1-[0-9]{8}-[0-9]{6}", Path(document["backup"]).name)):
        raise RuntimeError("invalid transaction path")
    return document

ACTIVE_RELEASE_KEYS = {
    "evidence_sha256", "generation", "release_id", "uploads_dev", "uploads_ino", "version"
}

def canonical_active_release(document):
    return (
        json.dumps(
            document,
            ensure_ascii=True,
            separators=(",", ":"),
            sort_keys=True,
        ) + "\n"
    ).encode("ascii")

def load_active_release():
    raw = open_payload(active_release_path, limit=1024)
    document = json.loads(raw.decode("ascii"))
    if (set(document) != ACTIVE_RELEASE_KEYS
            or document.get("version") != 4
            or canonical_active_release(document) != raw
            or isinstance(document.get("generation"), bool)
            or not isinstance(document.get("generation"), int)
            or not 1 <= document["generation"] <= 9_999_999_999_999_999_999
            or not re.fullmatch(r"[0-9a-f]{64}", document.get("release_id", ""))
            or not re.fullmatch(
                r"[0-9a-f]{64}", document.get("evidence_sha256", "")
            )):
        raise RuntimeError("invalid active release record")
    for key in ("uploads_dev", "uploads_ino"):
        value = document.get(key)
        if isinstance(value, bool) or not isinstance(value, int) or value < 1:
            raise RuntimeError("invalid active release identity")
    return document

def read_guard_marker(name):
    if name not in {
        "fpm-activation-guard-v4.armed",
        "fpm-activation-guard-v4.committed",
    }:
        raise RuntimeError("invalid guard marker name")
    marker_path = state_root / name
    raw = open_payload(
        marker_path,
        rb"[1-9][0-9]{0,18} [0-9a-f]{64} [0-9a-f]{64}\n",
        192,
    )
    before = identity(marker_path.lstat())
    # Promote a marker that survived a publisher crash after rename but before
    # directory fsync, then reopen it.  A visible-but-not-yet-durable dirent is
    # never treated as a committed activation merely because it was readable.
    fsync_directory(state_root)
    repeated = open_payload(
        marker_path,
        rb"[1-9][0-9]{0,18} [0-9a-f]{64} [0-9a-f]{64}\n",
        192,
    )
    if identity(marker_path.lstat()) != before or repeated != raw:
        raise RuntimeError("guard marker changed during durability promotion")
    generation, release_id, activation_nonce = raw.decode("ascii").strip().split(" ")
    return int(generation), release_id, activation_nonce

def current_live_identity():
    metadata = strict_directory(live, www.pw_uid, www.pw_gid, 0o755)
    return identity(metadata)

def release_identifier(generation, evidence, live_dev, live_ino):
    if (not isinstance(generation, int) or generation < 1
            or not re.fullmatch(r"[0-9a-f]{64}", evidence)
            or not isinstance(live_dev, int) or live_dev < 1
            or not isinstance(live_ino, int) or live_ino < 1):
        raise RuntimeError("invalid release identity input")
    return hashlib.sha256(
        f"release-v4\0{generation}\0{evidence}\0{live_dev}\0{live_ino}".encode("ascii")
    ).hexdigest()

def transaction_release_document(document, live_identity):
    live_dev, live_ino = live_identity
    if (document["generation"] < 1
            or (document["candidate_dev"], document["candidate_ino"])
                != live_identity):
        raise RuntimeError("transaction release mismatch")
    evidence = document["manifest_sha256"]
    return {
        "evidence_sha256": evidence,
        "generation": document["generation"],
        "release_id": release_identifier(
            document["generation"], evidence, live_dev, live_ino
        ),
        "uploads_dev": live_dev,
        "uploads_ino": live_ino,
        "version": 4,
    }

def active_release_document(document=None):
    generation = read_generation(active_path)
    if read_generation(accepted_path) != generation:
        raise RuntimeError("active release generation mismatch")
    live_dev, live_ino = current_live_identity()
    commit_generation, commit_release_id, _activation_nonce = read_guard_marker(
        "fpm-activation-guard-v4.committed"
    )
    if commit_generation != generation:
        raise RuntimeError("active release commit mismatch")
    if document is None:
        evidence = hashlib.sha256(
            f"bootstrap-root-v4\0{generation}\0{live_dev}\0{live_ino}".encode("ascii")
        ).hexdigest()
        release = {
            "evidence_sha256": evidence,
            "generation": generation,
            "release_id": release_identifier(
                generation, evidence, live_dev, live_ino
            ),
            "uploads_dev": live_dev,
            "uploads_ino": live_ino,
            "version": 4,
        }
    else:
        if (document["generation"] != generation
                or document["phase"] != "committed"
                or (document["candidate_dev"], document["candidate_ino"])
                    != (live_dev, live_ino)):
            raise RuntimeError("committed transaction release mismatch")
        release = transaction_release_document(document, (live_dev, live_ino))
    if release["release_id"] != commit_release_id:
        raise RuntimeError("active release commit identity mismatch")
    return release

def write_active_release(document, allow_replace):
    try:
        existing = load_active_release()
    except FileNotFoundError:
        existing = None
    if existing == document:
        # A predecessor may have died after replacing the dirent but before
        # fsyncing STATE_ROOT. Promote that exact visible record to durable
        # state, then reopen and verify its inode and bytes before allowing
        # committed finalization to remove the transaction.
        before = identity(active_release_path.lstat())
        fsync_directory(state_root)
        if (identity(active_release_path.lstat()) != before
                or load_active_release() != document):
            raise RuntimeError("active release changed during durability promotion")
        return
    if existing is not None and not allow_replace:
        raise RuntimeError("unexpected existing active release")
    atomic_write(
        active_release_path,
        canonical_active_release(document),
        ".active-release-v4.",
        existing is None,
    )

def write_transaction(document, new=False):
