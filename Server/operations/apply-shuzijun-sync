#!/bin/bash
set -euo pipefail

SITE=/var/www/html/shuzijun.com.cn
STAGE=/tmp/shuzijun-stage
DATABASE="$STAGE/shuzijun-sync.sql.gz"
MANIFEST="$STAGE/shuzijun-sync.sha256"
LOG=/var/log/shuzijun-sync-receiver.log
VERIFY=/usr/local/sbin/verify-shuzijun-webroot-security

RSYNC_FILTERS=(
    --exclude='cache/'
    --exclude='debug.log'
    --exclude='*.php?*'
    --exclude='*.php.*'
    --exclude='*.php_*'
    --exclude='*.php-*'
    --exclude='*.php~'
    --exclude='*.bak*'
    --exclude='*.backup*'
    --exclude='*.old*'
    --exclude='*.orig*'
    --exclude='*.save*'
    --exclude='*.swp*'
    --exclude='*.tmp*'
    --exclude='*.copy*'
    --exclude='*.disabled*'
    --exclude='*.corrupt*'
    --exclude='*.fixbak*'
    --exclude='*.before-*'
    --exclude='*~'
    --exclude='.env*'
    --exclude='*.sql*'
    --exclude='*.dump*'
    --exclude='*.pem'
    --exclude='*.key'
    --exclude='*.p12'
    --exclude='*.pfx'
    --exclude='*.jks'
    --exclude='*.zip'
    --exclude='*.tar'
    --exclude='*.tar.gz'
    --exclude='*.tgz'
    --exclude='*.7z'
    --exclude='*.rar'
)

test "$SITE" = /var/www/html/shuzijun.com.cn
test "$STAGE" = /tmp/shuzijun-stage
for file in "$DATABASE" "$MANIFEST"; do test -f "$file"; done
test -x "$VERIFY"

"$VERIFY" "$SITE"

cd "$STAGE"
sha256sum -c "$MANIFEST"

STAMP=$(date +%Y%m%d-%H%M%S)
DEST=/var/backups/pre-sync-$STAMP
install -d -m 700 "$DEST"
cd "$SITE"
wp db export "$DEST/wordpress.sql" --add-drop-table --allow-root >/dev/null
gzip -9 "$DEST/wordpress.sql"
cp -a wp-config.php "$DEST/wp-config.php"

rsync -a --delete "${RSYNC_FILTERS[@]}" \
    "$STAGE/wp-content/" "$SITE/wp-content/"
"$VERIFY" "$SITE"
gunzip -c "$DATABASE" > "$STAGE/shuzijun-sync.sql"
wp db import "$STAGE/shuzijun-sync.sql" --allow-root >/dev/null
wp core update-db --allow-root >/dev/null

# The backup node uses a persistent Redis object cache. A database import does
# not invalidate cached `options`, so without this flush the API can keep
# serving the previous launch poster and update timestamp indefinitely.
wp cache flush --allow-root >/dev/null

chown -R www-data:www-data "$SITE/wp-content"
chown root:www-data "$SITE/wp-config.php"
chmod 640 "$SITE/wp-config.php"
nginx -t
systemctl reload nginx
systemctl restart php8.3-fpm

rm -f "$DATABASE" "$MANIFEST" "$STAGE/shuzijun-sync.sql"
printf '[%s] incremental sync applied; backup=%s\n' "$(date '+%F %T')" "$DEST" >> "$LOG"
printf 'sync-applied backup=%s cache=flushed\n' "$DEST"
