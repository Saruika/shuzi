append_secure_log() {
    local message=$1
    /usr/bin/timeout --signal=TERM --kill-after=5s 30s \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 \
        "$LOG_ROOT" "$LOG" "$message" 9<<'PY'
import os
import hashlib
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
target = Path(sys.argv[2])
message = sys.argv[3]
if (root != Path("/var/lib/shuzijun-logs")
        or target != root / "sync-standby.log"
        or not message or "\n" in message or "\r" in message
        or "\x00" in message or len(message.encode("utf-8")) > 4096):
    raise SystemExit(1)
for parent in (Path("/var"), Path("/var/lib")):
    metadata = parent.lstat()
    if (parent.resolve(strict=True) != parent or not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != 0 or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o755):
        raise SystemExit(1)
metadata = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700):
    raise SystemExit(1)
directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
created = False
try:
    try:
        before = os.stat(target.name, dir_fd=directory, follow_symlinks=False)
        descriptor = os.open(
            target.name,
            os.O_WRONLY | os.O_APPEND | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=directory,
        )
    except FileNotFoundError:
        descriptor = os.open(
            target.name,
            os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_EXCL
            | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory,
        )
        os.fchmod(descriptor, 0o600)
        before = os.fstat(descriptor)
        created = True
    try:
        current = os.fstat(descriptor)
        path_now = os.stat(target.name, dir_fd=directory, follow_symlinks=False)
        if (not stat.S_ISREG(current.st_mode) or current.st_uid != 0
                or current.st_gid != 0 or stat.S_IMODE(current.st_mode) != 0o600
                or current.st_nlink != 1 or current.st_dev != metadata.st_dev
                or (current.st_dev, current.st_ino) != (path_now.st_dev, path_now.st_ino)
                or (before.st_dev, before.st_ino) != (current.st_dev, current.st_ino)):
            raise SystemExit(1)
        payload = message.encode("utf-8") + b"\n"
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise SystemExit(1)
            view = view[written:]
        os.fsync(descriptor)
        after = os.fstat(descriptor)
        path_after = os.stat(target.name, dir_fd=directory, follow_symlinks=False)
        if ((after.st_dev, after.st_ino) != (current.st_dev, current.st_ino)
                or (path_after.st_dev, path_after.st_ino) != (current.st_dev, current.st_ino)
                or after.st_size < current.st_size + len(payload)):
            raise SystemExit(1)
    finally:
        os.close(descriptor)
    if created:
        os.fsync(directory)
finally:
    os.close(directory)
PY
}

verify_authority_role() {
    local expected_role=$1 verifier_fd_path=/proc/self/fd/7 verifier_sha256
    local authority_verify_parent authority_verify_parent_mode verifier_status=0
    test -f "$AUTHORITY_VERIFY" && test -x "$AUTHORITY_VERIFY" \
        && test ! -L "$AUTHORITY_VERIFY" || return 1
    test "$(realpath -e -- "$AUTHORITY_VERIFY")" = "$AUTHORITY_VERIFY" || return 1
    for authority_verify_parent in /usr /usr/local /usr/local/sbin; do
        test "$(realpath -e -- "$authority_verify_parent")" = "$authority_verify_parent" \
            || return 1
        test -d "$authority_verify_parent" && test ! -L "$authority_verify_parent" \
            || return 1
        test "$(stat -c '%u' "$authority_verify_parent")" = 0 || return 1
        authority_verify_parent_mode=$(stat -c '%a' "$authority_verify_parent") || return 1
        (( (8#$authority_verify_parent_mode & 8#022) == 0 )) || return 1
    done
    exec 7<"$AUTHORITY_VERIFY" || return 1
    test "$(stat -Lc '%u:%g:%h:%a' "$verifier_fd_path")" = '0:0:1:755' \
        || { exec 7<&-; return 1; }
    verifier_sha256=$(sha256sum "$verifier_fd_path" | awk '{ print $1 }') \
        || { exec 7<&-; return 1; }
    test "$verifier_sha256" = "$AUTHORITY_VERIFY_SHA256" \
        || { exec 7<&-; return 1; }
    if ! /usr/bin/timeout --signal=TERM --kill-after=5s 30s \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I "$verifier_fd_path" "$expected_role" >/dev/null; then
        verifier_status=1
    fi
    exec 7<&-
    return "$verifier_status"
}

