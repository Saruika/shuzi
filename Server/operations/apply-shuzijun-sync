    if [[ -n "$expected_release_id" || -n "$expected_nonce" ]]; then
        [[ "$expected_release_id" =~ ^[0-9a-f]{64}$ \
            && "$expected_nonce" =~ ^[0-9a-f]{64}$ \
            && "$release_id" == "$expected_release_id" \
            && "$nonce" == "$expected_nonce" ]] \
            || return 1
