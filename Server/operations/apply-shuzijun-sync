retiring = []
for entry in root.iterdir():
    if NAME.fullmatch(entry.name):
        # A damaged historical restore point is evidence for an operator, but
        # must not permanently wedge creation of a new verified restore point.
        # It is deliberately ignored and never selected for retention/deletion.
        try:
            validate_backup_tree(entry, EXPECTED_FILES)
        except SystemExit:
            continue
    elif INCOMPLETE_NAME.fullmatch(entry.name):
        try:
            validate_backup_tree(entry, None)
        except SystemExit:
            continue
        else:
            incomplete.append(entry)
    elif RETIRING_NAME.fullmatch(entry.name):
        # A kill during symlink-safe rmtree may leave any subset of the three
        # already-validated files.  Accept only that exact, root-owned shape so
        # the next run can finish the retirement without touching anything else.
        try:
            validate_backup_tree(entry, None)
            if any(child.name not in EXPECTED_FILES for child in entry.iterdir()):
                raise SystemExit(1)
        except SystemExit:
            continue
        else:
            retiring.append(entry)
if not shutil.rmtree.avoids_symlink_attacks:
    raise SystemExit(1)
for stale in incomplete + retiring:
    shutil.rmtree(stale)
if incomplete or retiring:
    directory = os.open(root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)

budget = max(MIN_BACKUP_BUDGET, logical_bytes * 2 + 64 * 1024 * 1024)
budget = min(budget, MAX_BACKUP_ARCHIVE_BYTES)
filesystem = os.statvfs(root)
if filesystem.f_bavail * filesystem.f_frsize < budget + MIN_FREE_RESERVE:
    raise SystemExit(1)

destination = Path(
    tempfile.mkdtemp(prefix=f".shuzijun-sync-v1-{stamp}.incomplete.", dir=root)
)
created = destination.lstat()
if (not stat.S_ISDIR(created.st_mode) or created.st_uid != 0 or created.st_gid != 0
        or stat.S_IMODE(created.st_mode) != 0o700 or created.st_dev != metadata.st_dev):
    raise SystemExit(1)
directory = os.open(root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
try:
    os.fsync(directory)
finally:
    os.close(directory)
print(destination)
PY
}

