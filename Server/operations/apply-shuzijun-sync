finally:
    os.close(descriptor)

for marker in (armed, committed):
    try:
        descriptor = os.open(marker, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except FileNotFoundError:
        continue
    try:
        current = os.fstat(descriptor)
        payload = os.read(descriptor, 192)
        if os.read(descriptor, 1):
            raise SystemExit(1)
    finally:
        os.close(descriptor)
    if (not stat.S_ISREG(current.st_mode) or current.st_uid != 0
            or current.st_gid != 0 or stat.S_IMODE(current.st_mode) != 0o600
            or current.st_nlink != 1 or current.st_dev != metadata.st_dev
            or not re.fullmatch(
                rb"[1-9][0-9]{0,18} [0-9a-f]{64} [0-9a-f]{64}\n", payload
            )):
        raise SystemExit(1)
# The prior commit and armed marker are deliberately retained here. The shell
# first acquires the guard lease; only then may it clear an old armed marker or
# recover a stale marker-publication temporary without racing a guard writer.
PY
}

reset_fpm_guard_attempt_state() {
