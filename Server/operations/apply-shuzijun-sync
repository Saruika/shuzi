# The receiver runs as an SSH forced command rather than a long-lived systemd
# unit. Bound every service-manager and WordPress client invocation locally so
# a stalled D-Bus client or database subprocess cannot indefinitely postpone
# the EXIT rollback/isolation supervisor.
run_with_deadline() {
    local deadline=$1 kill_grace=$2
    shift 2
    [[ "$deadline" =~ ^[1-9][0-9]{0,5}$ \
        && "$kill_grace" =~ ^[1-9][0-9]{0,3}$ && $# -gt 0 ]] || return 1
    # fd 9 belongs to callers that supply an fd-pinned inline Python helper.
    # Keep the deadline supervisor itself on a disjoint descriptor; otherwise
    # its here-document consumes/replaces the caller's program before Popen.
    /usr/bin/python3 -I /proc/self/fd/19 "$deadline" "$kill_grace" "$@" 19<<'PY'
import ctypes
import os
import signal
import subprocess
import sys
import time

deadline = int(sys.argv[1])
kill_grace = int(sys.argv[2])
command = sys.argv[3:]
if not 1 <= deadline <= 86400 or not 1 <= kill_grace <= 60 or not command:
    raise SystemExit(1)

# Several bounded helpers execute an inline, fd-pinned Python program at
# /proc/self/fd/9. Popen closes inherited descriptors by default; preserve
# exactly the caller-owned fd 9 only for that explicit command form.  The
# supervisor source itself is on fd 19 and is never passed to the child.
pass_fds = (9,) if "/proc/self/fd/9" in command else ()
child = subprocess.Popen(command, start_new_session=True, pass_fds=pass_fds)

class ForwardedSignal(Exception):
    def __init__(self, number):
        self.number = number

def forward(number, _frame):
    raise ForwardedSignal(number)

def signal_group(number):
    try:
        os.killpg(child.pid, number)
    except ProcessLookupError:
        pass

def group_alive():
    try:
        os.killpg(child.pid, 0)
        return True
    except ProcessLookupError:
        return False

def reinforce_cleanup(number, _frame):
    # Once teardown begins, later signals may reinforce the child-group stop
    # but must never unwind the supervisor before SIGKILL/wait completes.
    signal_group(number)

def stop_group(first_signal):
    for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(number, reinforce_cleanup)
    signal_group(first_signal)
    limit = time.monotonic() + kill_grace
    while group_alive() and time.monotonic() < limit:
        child.poll()
        time.sleep(0.05)
    if group_alive():
        signal_group(signal.SIGKILL)
    while True:
        try:
            child.wait()
            break
        except InterruptedError:
            continue

previous = dict(
    (number, signal.signal(number, forward))
    for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
)
try:
    try:
        status = child.wait(timeout=deadline)
    except subprocess.TimeoutExpired:
        stop_group(signal.SIGTERM)
        raise SystemExit(124)
    except ForwardedSignal as interruption:
        stop_group(interruption.number)
        raise SystemExit(128 + interruption.number)
finally:
    for number, handler in previous.items():
        signal.signal(number, handler)

if status < 0:
    status = 128 - status
raise SystemExit(status)
PY
}

systemctl() {
    run_with_deadline 20 5 /usr/bin/systemctl "$@"
}

