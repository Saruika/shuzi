}
PHASES = {
    "staging", "prepared", "accepted", "database-importing",
    "database-imported", "swapped", "activated", "commit-ready", "committed",
    "rollback-media",
}
TX_KEYS = {
    "version", "generation", "previous_generation", "phase", "manifest_sha256",
    "backup", "source", "source_dev", "source_ino", "candidate_name",
    "candidate_dev", "candidate_ino", "live_dev", "live_ino",
}

action = sys.argv[1]
sync_root = Path(sys.argv[2])
release_root = Path(sys.argv[3])
state_root = Path(sys.argv[4])
active_path = Path(sys.argv[5])
transaction_path = Path(sys.argv[6])
live = Path(sys.argv[7])
accepted_path = Path(sys.argv[8])
