clean_stale_state_temporaries() {
    # The caller holds the root-only site-operation lock, so no sender,
    # receiver or deployer owns a state publication. Recover only exact
    # 128-bit-token temporary names created by this receiver. Unknown hidden
    # entries and unsafe inodes remain fail-closed for operator inspection.
    /usr/bin/timeout --signal=TERM --kill-after=2s 10s \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 "$STATE_ROOT" 9<<'PY'
import os
import re
import secrets
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
root_meta = root.lstat()
if (root != Path("/var/lib/shuzijun-sync/state")
        or root.resolve(strict=True) != root
        or not stat.S_ISDIR(root_meta.st_mode)
        or root_meta.st_uid != 0 or root_meta.st_gid != 0
        or stat.S_IMODE(root_meta.st_mode) != 0o700):
    raise SystemExit(1)

temporary_limits = {
    ".highest-accepted.": 32,
    ".uploads-transaction.": 32 * 1024,
    ".active-generation.": 32,
    ".active-release-v4.": 1024,
    ".bootstrap-fpm-commit.": 192,
}
temporary_pattern = re.compile(
    r"(" + "|".join(re.escape(value) for value in temporary_limits) + r")"
    r"([0-9a-f]{32})"
)
rollback_pattern = re.compile(r"\.rollback-database\.[1-9][0-9]{0,18}")
guard_temporary_pattern = re.compile(r"\.fpm-guard-marker\.[0-9a-f]{32}")
directory = os.open(
    root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
)
removed = False
try:
    for entry in root.iterdir():
        if not entry.name.startswith("."):
            continue
        if rollback_pattern.fullmatch(entry.name):
            continue
        if guard_temporary_pattern.fullmatch(entry.name):
            # Guard marker writers do not take the site-operation lock. Their
            # temporaries are recovered only while holding the guard lease.
            continue
        match = temporary_pattern.fullmatch(entry.name)
        if match is None:
            raise RuntimeError("unknown state temporary")
        metadata = os.stat(
            entry.name, dir_fd=directory, follow_symlinks=False
        )
        limit = temporary_limits[match.group(1)]
        if (not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != 0 or metadata.st_gid != 0
                or stat.S_IMODE(metadata.st_mode) != 0o600
                or metadata.st_nlink != 1 or metadata.st_dev != root_meta.st_dev
                or metadata.st_size > limit):
            raise RuntimeError("unsafe state temporary")
        os.unlink(entry.name, dir_fd=directory)
        removed = True
    if removed:
        os.fsync(directory)
finally:
    os.close(directory)
PY
}

enter_site_operation_lock_context() {
    local expected_fd=${SHUZIJUN_SITE_OPERATION_LOCK_FD-}
    local lock_fd_metadata lock_fd_identity lock_path_identity
    local lock_fd_device lock_root_device locked_path_identity
    if [[ "$expected_fd" != 8 ]]; then
        [[ -z "$expected_fd" ]] || return 1
        # Python opens the fixed lock with O_NOFOLLOW and re-execs this exact
        # script while preserving SSH stdin. fd 8 then remains open for the
        # complete protocol/apply transaction.
        exec env -i PATH="$PATH" LC_ALL=C LANG=C \
            /usr/bin/python3 -I /proc/self/fd/9 \
            "$SELF" "$SYNC_ROOT" "$SITE_OPERATION_LOCK" "$@" 9<<'PY'
import os
import stat
import sys
from pathlib import Path

script = Path(sys.argv[1])
root = Path(sys.argv[2])
lock = Path(sys.argv[3])
arguments = sys.argv[4:]
root_meta = root.lstat()
if (script != Path("/usr/local/sbin/apply-shuzijun-sync")
        or root != Path("/var/lib/shuzijun-sync")
        or lock != root / "site-operation.lock"
        or root.resolve(strict=True) != root
        or not stat.S_ISDIR(root_meta.st_mode)
        or root_meta.st_uid != 0 or root_meta.st_gid != 0
        or stat.S_IMODE(root_meta.st_mode) != 0o700):
    raise SystemExit(1)
descriptor = os.open(lock, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
try:
    metadata = os.fstat(descriptor)
    named = lock.lstat()
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
            or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1 or metadata.st_dev != root_meta.st_dev
            or (metadata.st_dev, metadata.st_ino) != (named.st_dev, named.st_ino)):
        raise RuntimeError("unsafe site operation lock")
    if descriptor != 8:
        os.dup2(descriptor, 8, inheritable=True)
    else:
        os.set_inheritable(8, True)
finally:
    if descriptor != 8:
        os.close(descriptor)
environment = {
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "LC_ALL": "C",
    "LANG": "C",
    "SHUZIJUN_SITE_OPERATION_LOCK_FD": "8",
}
os.execve("/bin/bash", ["/bin/bash", str(script), *arguments], environment)
PY
    fi
    lock_fd_metadata=$(stat -Lc '%u:%g:%h:%a' /proc/self/fd/8) || return 1
    [[ "$lock_fd_metadata" == '0:0:1:600' ]] || return 1
    lock_fd_identity=$(stat -Lc '%d:%i' /proc/self/fd/8) || return 1
    lock_path_identity=$(stat -Lc '%d:%i' "$SITE_OPERATION_LOCK") || return 1
    [[ "$lock_fd_identity" == "$lock_path_identity" ]] || return 1
    lock_fd_device=$(stat -Lc '%d' /proc/self/fd/8) || return 1
    lock_root_device=$(stat -Lc '%d' "$SYNC_ROOT") || return 1
    [[ "$lock_fd_device" == "$lock_root_device" ]] || return 1
    flock -n 8 || return 1
    locked_path_identity=$(stat -Lc '%d:%i' "$SITE_OPERATION_LOCK") || return 1
    [[ "$lock_fd_identity" == "$locked_path_identity" ]] || return 1
}

clean_stale_claims() {
    # The exclusive site lock proves no other receiver can own a claim. Remove
    # only exact receiver-created, root-only trees; any unknown entry or unsafe
    # inode fails closed and remains available for operator inspection.
    /usr/bin/timeout --signal=TERM --kill-after=10s 30m \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 "$CLAIM_ROOT" 9<<'PY'
import os
import re
import shutil
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
metadata = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700):
    raise SystemExit(1)
if not shutil.rmtree.avoids_symlink_attacks:
    raise SystemExit(1)
name = re.compile(r"batch\.[A-Za-z0-9]+")
claims = []
for entry in root.iterdir():
    if not name.fullmatch(entry.name):
        raise SystemExit(1)
    claims.append(entry)

for claim in claims:
    claim_metadata = claim.lstat()
    if (not stat.S_ISDIR(claim_metadata.st_mode) or claim_metadata.st_uid != 0
            or claim_metadata.st_gid != 0 or stat.S_IMODE(claim_metadata.st_mode) != 0o700
            or claim_metadata.st_dev != metadata.st_dev):
        raise SystemExit(1)
    for directory, directory_names, file_names, directory_fd in os.fwalk(
        claim, topdown=True, follow_symlinks=False
    ):
        current = os.fstat(directory_fd)
        if (not stat.S_ISDIR(current.st_mode) or current.st_uid != 0
                or current.st_gid != 0 or stat.S_IMODE(current.st_mode) != 0o700
                or current.st_dev != metadata.st_dev):
            raise SystemExit(1)
        for child_name in directory_names:
            child = os.stat(child_name, dir_fd=directory_fd, follow_symlinks=False)
            if (not stat.S_ISDIR(child.st_mode) or child.st_uid != 0
                    or child.st_gid != 0 or stat.S_IMODE(child.st_mode) != 0o700
                    or child.st_dev != metadata.st_dev):
                raise SystemExit(1)
        for child_name in file_names:
            child = os.stat(child_name, dir_fd=directory_fd, follow_symlinks=False)
            if (not stat.S_ISREG(child.st_mode) or child.st_uid != 0
                    or child.st_gid != 0 or stat.S_IMODE(child.st_mode) != 0o600
                    or child.st_nlink != 1 or child.st_dev != metadata.st_dev):
                raise SystemExit(1)

for claim in claims:
    shutil.rmtree(claim)
if claims:
    directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
PY
}

persist_new_claim() {
    local claim=$1
    run_with_deadline 5 2 /usr/bin/python3 -I /proc/self/fd/9 \
        "$CLAIM_ROOT" "$claim" 9<<'PY'
import os
import re
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
claim = Path(sys.argv[2])
root_meta = root.lstat()
if (root != Path("/var/lib/shuzijun-sync/incoming")
        or root.resolve(strict=True) != root
        or not stat.S_ISDIR(root_meta.st_mode)
        or root_meta.st_uid != 0 or root_meta.st_gid != 0
        or stat.S_IMODE(root_meta.st_mode) != 0o700
        or claim.parent != root
        or re.fullmatch(r"batch\.[A-Za-z0-9]{6}", claim.name) is None):
    raise SystemExit(1)

root_descriptor = os.open(
    root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
)
claim_descriptor = -1
try:
    opened_root = os.fstat(root_descriptor)
    named_root = root.lstat()
    if ((opened_root.st_dev, opened_root.st_ino)
            != (named_root.st_dev, named_root.st_ino)):
        raise RuntimeError("claim root changed")
    claim_descriptor = os.open(
        claim.name,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
        dir_fd=root_descriptor,
    )
    claim_meta = os.fstat(claim_descriptor)
    named_claim = os.stat(
        claim.name, dir_fd=root_descriptor, follow_symlinks=False
    )
    if (not stat.S_ISDIR(claim_meta.st_mode)
            or claim_meta.st_uid != 0 or claim_meta.st_gid != 0
            or stat.S_IMODE(claim_meta.st_mode) != 0o700
            or claim_meta.st_dev != root_meta.st_dev
            or (claim_meta.st_dev, claim_meta.st_ino)
                != (named_claim.st_dev, named_claim.st_ino)
            or os.listdir(claim_descriptor)):
        raise RuntimeError("unsafe new claim")
    # Persist the new directory inode before its parent dirent, then return
    # only after reopening-by-name evidence was checked above.
    os.fsync(claim_descriptor)
    os.fsync(root_descriptor)
finally:
    if claim_descriptor >= 0:
        os.close(claim_descriptor)
    os.close(root_descriptor)
PY
}

clean_stale_rollback_sql() {
    # The exclusive site lock proves that no live receiver can own one of these
    # process-scoped plaintext rollback files.  A SIGKILL can bypass EXIT, so a
    # later receiver must remove only the exact, root-only inode shape that this
    # script creates.  Unknown names or metadata are preserved and fail closed.
    run_with_deadline 300 10 /usr/bin/python3 -I /proc/self/fd/9 \
        "$STATE_ROOT" 9<<'PY'
import os
import re
import secrets
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
root_meta = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(root_meta.st_mode)
        or root_meta.st_uid != 0 or root_meta.st_gid != 0
        or stat.S_IMODE(root_meta.st_mode) != 0o700):
    raise SystemExit(1)

