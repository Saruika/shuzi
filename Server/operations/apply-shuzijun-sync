        "$STATE_ROOT" "$FPM_GUARD_LEASE" "$FPM_GUARD_ARMED" \
        "$FPM_GUARD_COMMIT" "$generation" 9<<'PY'
import os
import re
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
lease = Path(sys.argv[2])
armed = Path(sys.argv[3])
committed = Path(sys.argv[4])
generation = sys.argv[5]
metadata = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700
        or {lease, armed, committed} != {
            root / "fpm-activation-guard.lease",
            root / "fpm-activation-guard-v4.armed",
            root / "fpm-activation-guard-v4.committed",
        } or not re.fullmatch(r"[1-9][0-9]{0,18}", generation)):
    raise SystemExit(1)

flags = os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW
created = False
try:
    descriptor = os.open(lease, flags)
except FileNotFoundError:
    descriptor = os.open(lease, flags | os.O_CREAT | os.O_EXCL, 0o600)
    created = True
try:
    if created:
        os.fchmod(descriptor, 0o600)
    current = os.fstat(descriptor)
    if (not stat.S_ISREG(current.st_mode) or current.st_uid != 0
            or current.st_gid != 0 or stat.S_IMODE(current.st_mode) != 0o600
            or current.st_nlink != 1 or current.st_dev != metadata.st_dev
            or current.st_size != 0):
        raise SystemExit(1)
