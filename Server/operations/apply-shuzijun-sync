    run_with_deadline 5 2 env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 \
        "$STATE_ROOT" "$FPM_GUARD_ARMED" "$FPM_GUARD_COMMIT" \
        "$generation" "$disposition" 9<<'PY'
import os
import re
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
armed = Path(sys.argv[2])
committed = Path(sys.argv[3])
generation = sys.argv[4]
disposition = sys.argv[5]
root_meta = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(root_meta.st_mode)
        or root_meta.st_uid != 0 or root_meta.st_gid != 0
        or stat.S_IMODE(root_meta.st_mode) != 0o700
        or armed != root / "fpm-activation-guard-v4.armed"
        or committed != root / "fpm-activation-guard-v4.committed"
        or not re.fullmatch(r"[1-9][0-9]{0,18}", generation)
        or disposition not in {"reset", "preserve"}):
    raise SystemExit(1)

marker_pattern = rb"[1-9][0-9]{0,18} [0-9a-f]{64} [0-9a-f]{64}\n"
def validate_marker(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(descriptor)
        payload = os.read(descriptor, 192)
        if os.read(descriptor, 1):
            raise RuntimeError("oversize guard marker")
    finally:
        os.close(descriptor)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
            or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1 or metadata.st_dev != root_meta.st_dev
            or not re.fullmatch(marker_pattern, payload)):
        raise RuntimeError("unsafe guard marker")

try:
    validate_marker(committed)
except FileNotFoundError:
    pass
try:
    validate_marker(armed)
except FileNotFoundError:
    pass

directory = os.open(
    root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
)
changed = False
try:
    temporary_pattern = re.compile(r"\.fpm-guard-marker\.[0-9a-f]{32}")
    for entry in root.iterdir():
        if not temporary_pattern.fullmatch(entry.name):
            continue
        metadata = os.stat(entry.name, dir_fd=directory, follow_symlinks=False)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
                or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
                or metadata.st_nlink != 1 or metadata.st_dev != root_meta.st_dev
                or metadata.st_size > 192):
            raise RuntimeError("unsafe guard marker temporary")
        os.unlink(entry.name, dir_fd=directory)
        changed = True
    if disposition == "reset":
        try:
            os.unlink(armed.name, dir_fd=directory)
        except FileNotFoundError:
            pass
        else:
            changed = True
    if changed:
        os.fsync(directory)
finally:
    os.close(directory)
PY
}

publish_fpm_guard_marker() {
