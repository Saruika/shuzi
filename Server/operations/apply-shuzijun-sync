                or entry_metadata.st_dev != metadata.st_dev):
            raise ValueError
        children = list(entry.iterdir())
        if {child.name for child in children} != EXPECTED_FILES:
            raise ValueError
        for child in children:
            child_metadata = child.lstat()
            if (not stat.S_ISREG(child_metadata.st_mode) or child_metadata.st_uid != 0
                    or child_metadata.st_gid != 0
                    or stat.S_IMODE(child_metadata.st_mode) != 0o600
                    or child_metadata.st_nlink != 1
                    or child_metadata.st_dev != metadata.st_dev):
                raise ValueError
        entry_canonical = (
            f"{digest_at(entry, 'wordpress.sql.gz')}  wordpress.sql.gz\n"
            f"{digest_at(entry, 'wp-config.php')}  wp-config.php\n"
        ).encode("ascii")
        if (len(entry_canonical) != 163
                or (entry / "backup.sha256").read_bytes() != entry_canonical):
            raise ValueError
    except (OSError, ValueError):
        # Preserve malformed historical entries untouched.  They cannot count
        # toward retention and cannot prevent a new valid backup from landing.
        continue
    backups.append(entry)
if destination not in backups:
    raise SystemExit(1)
if not shutil.rmtree.avoids_symlink_attacks:
    raise SystemExit(1)
old_backups = sorted(
    (path for path in backups if path != destination),
    key=lambda path: path.name,
)
# Always retain the just-published backup even if the wall clock moved
# backwards and its timestamp sorts before an older restore point.
for expired in old_backups[:max(0, len(old_backups) + 1 - RETENTION_COUNT)]:
    tombstone = root / f".{expired.name}.retiring"
    if not RETIRING_NAME.fullmatch(tombstone.name):
        raise SystemExit(1)
    try:
        tombstone.lstat()
    except FileNotFoundError:
        pass
    else:
        raise SystemExit(1)
    os.rename(expired, tombstone)
    directory = os.open(root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    shutil.rmtree(tombstone)
    directory = os.open(root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
print(destination)
PY
}

store_backup_archive() {
    local destination=$1
    # Store a gzip stream without ever materializing a second uncompressed SQL
    # dump.  The output remains bounded and cannot consume the disk reserve.
    /usr/bin/timeout --signal=TERM --kill-after=10s 5m \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 "$destination" 9<<'PY'
import ctypes
import hashlib
import os
import stat
import sys
import tempfile
from pathlib import Path

MAX_BACKUP_ARCHIVE_BYTES = 8 * 1024 * 1024 * 1024
MIN_FREE_RESERVE = 1024 * 1024 * 1024
root = Path(sys.argv[1])
metadata = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700):
    raise SystemExit(1)
destination = root / "wordpress.sql.gz"
temp_descriptor, temp_name = tempfile.mkstemp(prefix=".wordpress-sql-gz.", dir=root)
temp_path = Path(temp_name)
total = 0
digest = hashlib.sha256()
try:
    os.fchmod(temp_descriptor, 0o600)
    while True:
        chunk = os.read(0, 1024 * 1024)
        if not chunk:
            break
        total += len(chunk)
        digest.update(chunk)
        if total > MAX_BACKUP_ARCHIVE_BYTES:
            raise SystemExit(1)
        filesystem = os.statvfs(root)
        if filesystem.f_bavail * filesystem.f_frsize < MIN_FREE_RESERVE + len(chunk):
            raise SystemExit(1)
        view = memoryview(chunk)
        while view:
            written = os.write(temp_descriptor, view)
            if written <= 0:
                raise SystemExit(1)
            view = view[written:]
    if total == 0:
        raise SystemExit(1)
    os.fsync(temp_descriptor)
    completed = os.fstat(temp_descriptor)
    if (not stat.S_ISREG(completed.st_mode) or completed.st_uid != 0
            or completed.st_gid != 0 or stat.S_IMODE(completed.st_mode) != 0o600
            or completed.st_nlink != 1 or completed.st_size != total):
        raise SystemExit(1)
    os.close(temp_descriptor)
    temp_descriptor = -1
    named = temp_path.lstat()
    if (named.st_dev, named.st_ino) != (completed.st_dev, completed.st_ino):
        raise SystemExit(1)
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise SystemExit(1)
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    if renameat2(-100, os.fsencode(temp_path), -100, os.fsencode(destination), 1) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    directory = os.open(root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    print(digest.hexdigest())
finally:
    if temp_descriptor >= 0:
        os.close(temp_descriptor)
    try:
        temp_path.unlink()
    except FileNotFoundError:
        pass
PY
}

