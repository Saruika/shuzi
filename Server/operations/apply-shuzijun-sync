rollback_incomplete_transaction() {
    local details generation previous phase backup disposition commit_status
    details=$(manage_uploads_transaction inspect) || return 1
    read -r generation previous phase backup <<<"$details" || return 1
    [[ "$generation" =~ ^[1-9][0-9]{0,18}$ \
        && "$previous" =~ ^[1-9][0-9]{0,18}$ ]] || return 1
    if [[ "$phase" == staging || "$phase" == prepared ]]; then
        # Candidate preparation is intentionally completed while FPM remains
        # online. It has not touched accepted generation, DB, or live media, so
        # a supervised failure can restore the root-only claim without taking
        # PHP offline.
        disposition=$(manage_uploads_transaction rollback-media "$generation") \
            || return 1
        [[ "$disposition" == clean ]] || return 1
        return 0
    fi
    if [[ "$phase" == committed ]]; then
        # Commit is the sole point after which rollback would misrepresent the
        # accepted generation. Leave finalization to the committed recovery path.
        return 2
    fi
    if [[ "$phase" == commit-ready ]]; then
        if classify_commit_ready_transaction; then
            return 2
        else
            commit_status=$?
        fi
        case "$commit_status" in
            2) ;;
            *)
                # Missing/malformed transaction context, unsafe marker metadata,
                # I/O failure or timeout is not proof that commit is absent.
                # Keep FPM isolated and retain the complete transaction.
                return 3
                ;;
        esac
    fi
    isolate_failed_fpm || return 1
    disposition=$(manage_uploads_transaction rollback-media "$generation") || return 1
    if [[ "$disposition" == database ]]; then
        restore_database_from_backup "$backup" || return 1
        verify_webroot_security || return 1
        validate_database_markers || return 1
        manage_uploads_transaction finish-rollback "$generation" || return 1
    elif [[ "$disposition" != clean ]]; then
        return 1
    fi
    # accepted is monotonic, so a failed generation can never be labelled as a
    # successful rollback. The previous media/DB are restored only to provide a
    # safe base for the next generation; FPM deliberately remains masked.
    isolate_failed_fpm
}

recover_uploads_transaction_if_needed() {
    local details generation previous phase backup commit_status forward=0
    if [[ ! -e "$UPLOADS_TRANSACTION" && ! -L "$UPLOADS_TRANSACTION" ]]; then
        return 0
    fi
    details=$(manage_uploads_transaction inspect) || return 1
    read -r generation previous phase backup <<<"$details" || return 1
    if [[ "$phase" == committed ]]; then
        forward=1
    elif [[ "$phase" == commit-ready ]]; then
        if classify_commit_ready_transaction; then
            forward=1
        else
            commit_status=$?
            case "$commit_status" in
                2)
                rollback_incomplete_transaction
                return $?
                ;;
                *) return 1 ;;
            esac
        fi
    fi
    if [[ "$forward" -eq 1 ]]; then
        validate_fpm_guard_commit_matches_accepted || return 1
        validate_database_markers || return 1
        # The exact activation commit is durable, so make the transaction
        # forward-only and publish its stable release record before attempting
        # another service start.  If a previous receiver then died after a new
        # armed nonce but before replacing the old same-release commit, the
        # next receiver can resume that nonce from stable state instead of
        # wedging a commit-ready transaction on a nonce mismatch.
        POST_COMMIT=1
        if [[ "$phase" == commit-ready ]]; then
            set_uploads_transaction_phase "$generation" committed || return 1
        fi
        finalize_uploads_transaction "$generation" || return 1
        # A committed activation was already runtime-probed before its durable
        # marker was published. If it is still healthy, avoid an unnecessary
        # outage merely to resume housekeeping.
        if verify_fpm_ready && probe_standby_runtime; then
            return 0
        fi
        isolate_failed_fpm || return 1
        arm_fpm_activation_guard "$generation" || return 1
        durably_unmask_fpm || return 1
        systemctl start "$FPM_SERVICE" || return 1
        verify_fpm_ready || return 1
        probe_standby_runtime || return 1
        commit_fpm_activation_guard "$generation" || return 1
        return 0
    fi
    rollback_incomplete_transaction
}

transaction_is_durably_committed() {
    local details generation previous phase backup commit_status
    details=$(manage_uploads_transaction inspect) || return 1
    read -r generation previous phase backup <<<"$details" || return 1
    if [[ "$phase" == committed ]]; then
        validate_fpm_guard_commit_matches_accepted || return 1
        return 0
    fi
    [[ "$phase" == commit-ready ]] || return 1
    if classify_commit_ready_transaction; then
        return 0
    else
        commit_status=$?
    fi
    # Positive absence (2), malformed state, I/O failure and timeout all mean
    # this is not a proven post-commit runtime for supervisor purposes.
    [[ "$commit_status" -eq 0 ]]
}

ensure_receiver_baseline() {
    local accepted active guard_state guard_result guard_exit_status commit_status
    local activation_mode pending pending_generation pending_nonce
    active=$(manage_uploads_transaction active-generation) || return 1
    accepted=$(read_accepted_generation) || return 1
    if verify_fpm_ready; then
        [[ "$active" == "$accepted" ]] || return 1
        validate_fpm_guard_commit_matches_accepted || return 1
        probe_standby_runtime || return 1
        return 0
    fi
    isolate_failed_fpm || return 1
    guard_state=$(systemctl show "$FPM_GUARD_UNIT" --property=ActiveState --value) \
        || return 1
    guard_result=$(systemctl show "$FPM_GUARD_UNIT" --property=Result --value) \
        || return 1
    if [[ "$guard_state" == failed ]]; then
        guard_exit_status=$(systemctl show \
            "$FPM_GUARD_UNIT" --property=ExecMainStatus --value) || return 1
        [[ "$guard_result" == exit-code && "$guard_exit_status" == 77 ]] \
            || return 1
    else
        [[ "$guard_state" == inactive && "$guard_result" == success ]] || return 1
    fi
    if [[ "$active" == "$accepted" ]]; then
        activation_mode=new
        if validate_fpm_guard_commit_matches_accepted; then
            :
        else
            # The normal O(1) boot gate intentionally rejects armed!=commit.
            # Under the receiver's site lock and persistent FPM isolation, an
            # exact stable release plus its prior commit and a matching armed
            # release with a fresh nonce is a resumable activation attempt.
            pending=$(read_pending_stable_activation) || return 1
            read -r pending_generation pending_nonce <<<"$pending" || return 1
            [[ "$pending_generation" == "$accepted" \
                && "$pending_nonce" =~ ^[0-9a-f]{64}$ ]] || return 1
            activation_mode=resume
        fi
        # A process may have died after the durable release commit, or during
        # a later same-release activation. Re-activate only that exact release
        # and reuse an already published armed nonce when present.
        arm_fpm_activation_guard "$accepted" "$activation_mode" || return 1
        durably_unmask_fpm || return 1
        systemctl start "$FPM_SERVICE" || return 1
        verify_fpm_ready || return 1
        probe_standby_runtime || return 1
        commit_fpm_activation_guard "$accepted" || return 1
    else
        # A failed accepted generation has already been rolled back. It remains
        # deliberately offline and may be healed only by a newer signed batch.
        generation_is_less "$active" "$accepted" || return 1
        if classify_fpm_guard_commit_marker "$accepted" "$active"; then
            # A positive accepted-generation commit with older active media is
            # contradictory and must never be treated as a healable rollback.
            return 1
        else
            commit_status=$?
        fi
        case "$commit_status" in
            2) return 0 ;;
            *) return 1 ;;
        esac
    fi
}

generation_is_less() {
    local left=$1 right=$2
    [[ "$left" =~ ^[1-9][0-9]{0,18}$ && "$right" =~ ^[1-9][0-9]{0,18}$ ]] \
        || return 1
    if (( ${#left} < ${#right} )); then
        return 0
    fi
    (( ${#left} == ${#right} )) || return 1
    [[ "$left" < "$right" ]]
}

begin_supervised_service_window() {
    [[ "$MUTATION_GUARD" -eq 0 && "$APPLY_SUCCEEDED" -eq 0 ]] || return 1
    MUTATION_GUARD=1
}

end_supervised_service_window() {
    [[ "$MUTATION_GUARD" -eq 1 && "$APPLY_SUCCEEDED" -eq 0 ]] || return 1
    MUTATION_GUARD=0
    POST_COMMIT=0
}

run_receiver_recovery_and_baseline() {
    # The EXIT/signal trap is installed by the caller before entering this
    # wrapper. Every potentially mutating systemctl path is therefore covered.
    begin_supervised_service_window || return 1
    recover_uploads_transaction_if_needed || return 1
    ensure_receiver_baseline || return 1
    end_supervised_service_window || return 1
}

CLAIM=
ROLLBACK_SQL=
FPM_ACTIVATION_RELEASE_ID=
FPM_ACTIVATION_NONCE=
PREPARE_IN_PROGRESS=0
MUTATION_GUARD=0
APPLY_SUCCEEDED=0
POST_COMMIT=0

finish_receiver() {
    local status=$1 isolation_failed=0 cleanup_failed=0 rollback_status=0
    local preserve_committed_runtime=0
    trap - EXIT INT TERM HUP
    set +e
    if [[ "$MUTATION_GUARD" -eq 0 && "$APPLY_SUCCEEDED" -ne 1 \
        && ( -e "$UPLOADS_TRANSACTION" || -L "$UPLOADS_TRANSACTION" ) ]]; then
        # Prevalidated candidate preparation precedes the FPM isolation window.
        # Its staging/prepared transaction is still supervised and must be
        # restored before the claim tree is removed.
        if ! rollback_incomplete_transaction; then
            cleanup_failed=1
            status=1
            printf '%s\n' \
                'sync receiver: CRITICAL pre-activation transaction cleanup did not complete' >&2
        fi
    fi
    if [[ "$MUTATION_GUARD" -eq 1 && "$APPLY_SUCCEEDED" -ne 1 \
        && "$status" -eq 0 ]]; then
        status=1
    fi
    if [[ "$MUTATION_GUARD" -eq 1 && "$APPLY_SUCCEEDED" -ne 1 ]]; then
        if [[ "${POST_COMMIT:-0}" -eq 1 ]]; then
            preserve_committed_runtime=1
        elif [[ -e "$UPLOADS_TRANSACTION" || -L "$UPLOADS_TRANSACTION" ]] \
            && transaction_is_durably_committed; then
            # Closes the signal window between durable marker publication and
            # the in-process POST_COMMIT assignment.
            preserve_committed_runtime=1
        fi
        if [[ "$preserve_committed_runtime" -eq 1 ]]; then
            printf '%s\n' \
                'sync receiver: committed runtime preserved; housekeeping will resume next run' >&2
        else
            if ! isolate_failed_fpm; then
                isolation_failed=1
                printf '%s\n' \
                    'sync receiver: CRITICAL unsuccessful apply could not re-verify persistent PHP-FPM isolation' >&2
            fi
            if [[ -e "$UPLOADS_TRANSACTION" || -L "$UPLOADS_TRANSACTION" ]]; then
                rollback_incomplete_transaction
                rollback_status=$?
                if [[ "$rollback_status" -eq 2 ]]; then
                    printf '%s\n' \
                        'sync receiver: committed transaction awaits fail-closed recovery finalization' >&2
                elif [[ "$rollback_status" -ne 0 ]]; then
                    isolation_failed=1
                    printf '%s\n' \
                        'sync receiver: CRITICAL supervised media/database rollback did not complete' >&2
                fi
            fi
        fi
    fi
    if [[ -n "$CLAIM" ]]; then
        case "$CLAIM" in
            "$CLAIM_ROOT"/batch.*)
                if [[ -e "$UPLOADS_TRANSACTION" || -L "$UPLOADS_TRANSACTION" ]]; then
                    # A failed pre-activation rollback still owns source paths
                    # below this claim. Preserve both claim and transaction so
                    # the next exclusive run can resume; never orphan source.
                    cleanup_failed=1
                    printf '%s\n' \
                        'sync receiver: preserving claim for incomplete transaction recovery' >&2
                else
                    remove_claim_tree "$CLAIM" || cleanup_failed=1
                fi
                ;;
            *)
                cleanup_failed=1
                printf '%s\n' 'sync receiver: CRITICAL refusing unsafe claim cleanup path' >&2
                ;;
        esac
    fi
    if [[ -n "$ROLLBACK_SQL" ]]; then
        case "$ROLLBACK_SQL" in
            "$STATE_ROOT"/.rollback-database.*)
                if remove_rollback_sql "$ROLLBACK_SQL"; then
                    ROLLBACK_SQL=
                else
                    cleanup_failed=1
                fi
                ;;
            *)
                cleanup_failed=1
                ;;
        esac
    fi
    if [[ "$status" -eq 0 && ( "$isolation_failed" -ne 0 || "$cleanup_failed" -ne 0 ) ]]; then
        status=1
    fi
    exit "$status"
}

if [[ $# -eq 4 && "$1" == --guard-watch ]]; then
    watch_fpm_activation_guard "$2" "$3" "$4"
    exit $?
fi
if [[ $# -eq 2 && "$1" == --guard-finalize ]]; then
    finalize_fpm_activation_guard "$2"
    exit $?
fi

# Hold the root-only operation lock shared by sync deployment, App-content
# deployment and authority configuration. The attestation/protocol queries are
# read-only but still pin the exact receiver release observed by the sender.
validate_sync_state_roots
enter_site_operation_lock_context "$@"
test -x "$VERIFY"
verify_authority_role standby
test "$SELF" = /usr/local/sbin/apply-shuzijun-sync
test "$0" = "$SELF"
test -f "$SELF" && test ! -L "$SELF"
test "$(realpath -e -- "$SELF")" = "$SELF"
test "$(stat -c '%u:%g:%h:%a' "$SELF")" = '0:0:1:755'
exec 10<"$SELF"
test "$(stat -Lc '%u:%g:%h:%a' /proc/self/fd/10)" = '0:0:1:755'
test "$(stat -Lc '%d:%i' /proc/self/fd/10)" = "$(stat -Lc '%d:%i' "$SELF")"
SELF_SHA256=$(sha256sum /proc/self/fd/10 | awk '{ print $1 }')
[[ "$SELF_SHA256" =~ ^[0-9a-f]{64}$ ]]

if [[ $# -eq 1 && "$1" == --attest ]]; then
    printf '%s  %s\n' "$SELF_SHA256" "$SELF"
    exit 0
fi
if [[ $# -eq 1 && "$1" == --protocol ]]; then
    printf '%s\n' "$SYNC_PROTOCOL"
    exit 0
fi
if [[ $# -eq 2 && "$1" == --bootstrap-state ]]; then
    BOOTSTRAP_RELEASE_ID=
    BOOTSTRAP_ACCEPTED=
    BOOTSTRAP_ACTIVE=
    [[ "$EUID" -eq 0 && "$2" =~ ^[1-9][0-9]{0,18}$ ]]
    validate_sync_state_roots
    validate_fpm_guard_unit
    verify_webroot_security >/dev/null
    verify_fpm_ready
    probe_standby_runtime
    BOOTSTRAP_ACCEPTED=$(read_accepted_generation) || exit 1
    test "$BOOTSTRAP_ACCEPTED" = "$2"
    clean_stale_state_temporaries
    manage_uploads_transaction bootstrap "$2"
    BOOTSTRAP_RELEASE_ID=$(manage_uploads_transaction bootstrap-release-id "$2")
    [[ "$BOOTSTRAP_RELEASE_ID" =~ ^[0-9a-f]{64}$ ]]
    bootstrap_fpm_guard_state "$2" "$BOOTSTRAP_RELEASE_ID"
    BOOTSTRAP_ACTIVE=$(manage_uploads_transaction validate-active) || exit 1
    test "$BOOTSTRAP_ACTIVE" = "$2"
    publish_stable_uploads_release "$2"
    validate_fpm_guard_commit_matches_accepted
    exit 0
fi
[[ $# -eq 1 && "$1" == --ingest ]] \
    || { printf 'usage: apply-shuzijun-sync --attest|--protocol|--ingest|--bootstrap-state GENERATION\n' >&2; exit 2; }

# Install supervision before recovery, stale cleanup, incoming-claim creation,
# or any service-manager mutation. SIGKILL cannot run a trap, so exact stale
# claim/rollback cleanup on the next exclusive-lock run is also mandatory.
trap 'finish_receiver $?' EXIT
trap 'exit 130' INT TERM HUP
validate_fpm_guard_unit
validate_allowed_signers
validate_sync_state_roots
clean_stale_state_temporaries
clean_stale_rollback_sql
verify_webroot_security >/dev/null
run_receiver_recovery_and_baseline
clean_stale_claims

# The SSH stream lands directly in a root-only claim. Only bounded control
# records are accepted before signature verification; signed per-file sizes,
# aggregate limits, free-space reserve and hashes gate the remaining stream.
CLAIM=$(mktemp -d "$CLAIM_ROOT/batch.XXXXXX")
persist_new_claim "$CLAIM"
read_control_frame "$CLAIM"
verify_control_signature "$CLAIM"
GENERATION=$(ingest_signed_payload "$CLAIM")
install -d -o root -g root -m 0700 "$CLAIM/wp-content/uploads"
prepare_database_sql "$CLAIM"
validate_fpm_guard_unit

# Complete expensive, read-only history/media verification and candidate
# ownership conversion while the current application remains online. The
# signed candidate is then unreachable to www-data beneath root:0700
# release_root; the short isolation window only needs fixed-inode checks.
STAMP=$(date +%Y%m%d-%H%M%S)
cd "$SITE"
DATABASE_LOGICAL_BYTES=$(read_database_logical_bytes) || exit 1
DEST=$(prepare_backup_destination "$STAMP" "$DATABASE_LOGICAL_BYTES")
BACKUP_DEST="/var/backups/shuzijun-sync-v1-$STAMP"
PREPARE_IN_PROGRESS=1
prepare_uploads_transaction "$GENERATION" "$CLAIM" "$BACKUP_DEST"
# chown/chmod touched every candidate inode. Persist that complete metadata
# set on the sync-state filesystem while the current PHP runtime is still
# online, then recheck the root/live identities before entering isolation.
sync -f "$SYNC_ROOT"
PREPARED_AFTER_SYNC=$(validate_prepared_uploads_transaction "$GENERATION") \
    || exit 1
test "$PREPARED_AFTER_SYNC" = "$GENERATION"

# Static Nginx remains online. PHP is now persistently masked only across the
# bounded DB backup/import, O(1) media publication, start, smoke and commit.
MUTATION_GUARD=1
PREPARE_IN_PROGRESS=0
if ! isolate_failed_fpm; then
    printf '%s\n' \
        'sync receiver: CRITICAL could not establish persistent PHP-FPM isolation before apply' >&2
    exit 1
fi

DATABASE_BACKUP_SHA256=$(wp db export - --add-drop-table --allow-root --quiet \
    | bound_backup_database_sql_stream \
    | gzip -9 | store_backup_archive "$DEST") || exit 1
[[ "$DATABASE_BACKUP_SHA256" =~ ^[0-9a-f]{64}$ ]]
install -o root -g root -m 0600 wp-config.php "$DEST/wp-config.php"
CONFIG_BACKUP_SHA256=$(sha256sum "$DEST/wp-config.php" | awk '{ print $1 }') || exit 1
[[ "$CONFIG_BACKUP_SHA256" =~ ^[0-9a-f]{64}$ ]]
( umask 077; printf '%s  wordpress.sql.gz\n%s  wp-config.php\n' \
    "$DATABASE_BACKUP_SHA256" "$CONFIG_BACKUP_SHA256" > "$DEST/backup.sha256" )
test "$(stat -c '%u:%g:%h:%a' "$DEST/backup.sha256")" = '0:0:1:600'
sync -f "$DEST"
sync -f /var/backups
DEST=$(publish_backup_destination "$DEST" "$STAMP" \
    "$DATABASE_BACKUP_SHA256" "$CONFIG_BACKUP_SHA256") || exit 1
[[ "$DEST" == "$BACKUP_DEST" ]]

accept_generation "$GENERATION"
set_uploads_transaction_phase "$GENERATION" accepted
ACCEPTED_AFTER_WRITE=$(read_accepted_generation) || exit 1
test "$ACCEPTED_AFTER_WRITE" = "$GENERATION"
if ! assert_fpm_guard_uncommitted_for_generation "$GENERATION"; then
    printf '%s\n' 'sync receiver: accepted generation failed the exact pre-apply state gate' >&2
    exit 1
fi

SQL="$CLAIM/shuzijun-sync.sql"
test -f "$SQL" && test ! -L "$SQL"
test "$(stat -c '%u:%g:%h:%a' "$SQL")" = '0:0:1:600'
set_uploads_transaction_phase "$GENERATION" database-importing
wp db import "$SQL" --allow-root >/dev/null
wp core update-db --allow-root >/dev/null
wp cache flush --allow-root >/dev/null
validate_database_markers
set_uploads_transaction_phase "$GENERATION" database-imported

# RENAME_EXCHANGE is the only supported publication primitive. The old live
# inode becomes the verified rollback tree in the same syscall; there is no
# symlink, bind mount, delete/copy, or double-rename fallback.
exchange_uploads_transaction "$GENERATION"
verify_authority_role standby
chown root:www-data "$SITE/wp-config.php"
chmod 640 "$SITE/wp-config.php"
nginx -t -q

arm_fpm_activation_guard "$GENERATION"
durably_unmask_fpm
systemctl start "$FPM_SERVICE"
verify_fpm_ready
if ! probe_standby_runtime; then
    printf '%s\n' \
        'sync receiver: standby runtime smoke failed; supervised rollback will keep PHP-FPM isolated' >&2
    exit 1
fi

# The public runtime has passed all API, homepage, media/HLS and DB markers.
# Publish the active generation and commit under the still-held guard lease;
# both are fsync-backed numeric records and must equal accepted.
test "$(stat -Lc '%d:%i' /proc/self/fd/10)" = "$(stat -Lc '%d:%i' "$SELF")"
test "$(sha256sum /proc/self/fd/10 | awk '{ print $1 }')" = "$SELF_SHA256"
publish_active_uploads_generation "$GENERATION"
set_uploads_transaction_phase "$GENERATION" commit-ready
commit_fpm_activation_guard "$GENERATION"
set_uploads_transaction_phase "$GENERATION" committed
finalize_uploads_transaction "$GENERATION"

# The database/media commit is now durable and FPM is healthy. Mark the
# mutation successful before slow retention/claim cleanup so either can be
# resumed without incorrectly rolling back or isolating the published runtime.
APPLY_SUCCEEDED=1
if ! retire_backup_history "$DEST"; then
    printf '%s\n' \
        'sync receiver: warning: committed backup retention will retry on a later run' >&2
fi
remove_claim_tree "$CLAIM"
CLAIM=
if ! append_secure_log \
    "[$(date '+%F %T')] signed uploads/database sync applied; generation=$GENERATION"; then
    printf '%s\n' 'sync receiver: warning: secure audit append failed after committed apply' >&2
fi
printf 'sync-applied generation=%s receiver-sha256=%s protocol=%s cache=flushed signed=true uploads-only=true\n' \
    "$GENERATION" "$SELF_SHA256" "$SYNC_PROTOCOL"
