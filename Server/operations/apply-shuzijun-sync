import json
import os
import pwd
import re
import secrets
import shutil
import stat
import sys
import tempfile
from pathlib import Path, PurePosixPath

MAX_FILES = 100_000
MAX_DIRECTORIES = 100_000
MAX_FILE_BYTES = 8 * 1024 * 1024 * 1024
MAX_TREE_BYTES = 64 * 1024 * 1024 * 1024
MIN_FREE_RESERVE = 1024 * 1024 * 1024
RENAME_EXCHANGE = 2
FORBIDDEN_NAMES = {".htaccess", ".user.ini"}
FORBIDDEN_SUFFIXES = {
    ".cgi", ".pl", ".py", ".rb", ".sh", ".bash", ".zsh", ".fish",
    ".exe", ".com", ".bat", ".cmd", ".ps1", ".jar", ".war",
}
