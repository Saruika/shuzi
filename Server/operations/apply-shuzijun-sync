    accepted=$(read_accepted_generation) || return 1
    base=$(manage_uploads_transaction validate-stable-base "$accepted") || return 1
    read -r commit_release_id commit_nonce <<<"$base" || return 1
    armed=$(read_fpm_guard_marker "$FPM_GUARD_ARMED" "$accepted") || return 1
    read -r armed_release_id armed_nonce <<<"$armed" || return 1
    [[ "$commit_release_id" =~ ^[0-9a-f]{64}$ \
        && "$commit_nonce" =~ ^[0-9a-f]{64}$ \
        && "$armed_release_id" == "$commit_release_id" \
        && "$armed_nonce" =~ ^[0-9a-f]{64}$ \
        && "$armed_nonce" != "$commit_nonce" ]] || return 1
    printf '%s %s\n' "$accepted" "$armed_nonce"
}

classify_commit_ready_transaction() {
    local accepted details transaction_generation previous phase backup
    local armed_marker armed_release_id armed_nonce expected_release_id
    local commit_status
    accepted=$(read_accepted_generation) || return 1
    details=$(manage_uploads_transaction inspect) || return 1
    read -r transaction_generation previous phase backup <<<"$details" || return 1
    [[ "$transaction_generation" == "$accepted" \
        && "$previous" =~ ^[1-9][0-9]{0,18}$ \
        && "$previous" != "$accepted" \
        && "$phase" == commit-ready && -n "$backup" ]] || return 1
    expected_release_id=$(manage_uploads_transaction activation-release-id "$accepted") \
        || return 1
    [[ "$expected_release_id" =~ ^[0-9a-f]{64}$ ]] || return 1
    armed_marker=$(read_fpm_guard_marker "$FPM_GUARD_ARMED" "$accepted") || return 1
    read -r armed_release_id armed_nonce <<<"$armed_marker" || return 1
    [[ "$armed_release_id" == "$expected_release_id" \
        && "$armed_nonce" =~ ^[0-9a-f]{64}$ ]] || return 1
    if classify_fpm_guard_commit_marker \
        "$accepted" "$previous" "$armed_release_id" "$armed_nonce"; then
        return 0
    else
        commit_status=$?
    fi
    case "$commit_status" in
        2) return 2 ;;
        *) return 1 ;;
    esac
}

assert_fpm_guard_uncommitted_for_generation() {
    local generation=$1 accepted details transaction_generation previous phase backup
    local release_id commit_marker commit_release_id commit_nonce
    [[ "$generation" =~ ^[1-9][0-9]{0,18}$ ]] || return 1
    accepted=$(read_accepted_generation) || return 1
    test "$accepted" = "$generation" || return 1
    details=$(manage_uploads_transaction inspect) || return 1
    read -r transaction_generation previous phase backup <<<"$details" || return 1
    [[ "$transaction_generation" == "$generation" \
        && "$previous" =~ ^[1-9][0-9]{0,18}$ \
        && "$previous" != "$generation" \
        && "$phase" == accepted && -n "$backup" ]] || return 1
    release_id=$(manage_uploads_transaction stable-release-id "$previous") || return 1
    commit_marker=$(read_fpm_guard_marker "$FPM_GUARD_COMMIT" "$previous") || return 1
    read -r commit_release_id commit_nonce <<<"$commit_marker" || return 1
    [[ "$release_id" =~ ^[0-9a-f]{64}$ \
        && "$commit_release_id" == "$release_id" \
        && "$commit_nonce" =~ ^[0-9a-f]{64}$ ]] || return 1
    # All constituent records were read positively and proved to describe the
    # precise pre-apply state; no expected-negative command can hide an I/O or
    # parse failure.
    return 0
}

validate_fpm_guard_runtime_context() {
    test "$0" = "$SELF" || return 1
    test -f "$SELF" && test ! -L "$SELF" || return 1
    test "$(realpath -e -- "$SELF")" = "$SELF" || return 1
    test "$(stat -c '%u:%g:%h:%a' "$SELF")" = '0:0:1:755' || return 1
    validate_sync_state_roots || return 1
}

watch_fpm_activation_guard() {
    local lease=$1 armed=$2 committed=$3 generation release_id nonce lock_status
    local armed_marker armed_release_id
    [[ "$EUID" -eq 0 && "$lease" == "$FPM_GUARD_LEASE" \
        && "$armed" == "$FPM_GUARD_ARMED" && "$committed" == "$FPM_GUARD_COMMIT" ]] \
        || return 1
    validate_fpm_guard_runtime_context || return 1
    exec 6<>"$lease" || return 1
    test "$(stat -Lc '%u:%g:%h:%a' /proc/self/fd/6)" = '0:0:1:600' || return 1
    if flock -n -E 99 6; then
        # No receiver owns the lease, so this is a dependency/boot start.  Do
        # not report READY until a durable successful commit is present.  With
        # RequiredBy+Before, exiting nonzero keeps PHP-FPM from starting.
        if validate_fpm_guard_commit_matches_accepted; then
            systemd-notify --ready || return 1
            return 0
        fi
        if isolate_fpm_from_activation_guard; then
            printf '%s\n' \
                'sync receiver guard: uncommitted dependency start was persistently isolated' >&2
            # Exit 77 is deliberately excluded from Restart=on-failure: exact
            # isolation is already durable, so no retry loop is useful.
            return 77
        else
            printf '%s\n' \
                'sync receiver guard: CRITICAL dependency start could not isolate uncommitted activation' >&2
        fi
        return 1
    else
        lock_status=$?
    fi
    # Only the caller-selected conflict status proves that the receiver owns
    # the lease. I/O errors, an invalid descriptor, or an unsupported flock
    # invocation must never be mistaken for ownership and must never publish
    # an armed marker or READY notification.
    if (( lock_status != 99 )); then
        return 1
    fi
    # The receiver already holds the lease with FPM verified masked.  READY
    # releases `systemctl start`; this independent process then waits through
    # the complete unmask/start/probe window.
    generation=$(read_accepted_generation) || return 1
    release_id=$(manage_uploads_transaction activation-release-id "$generation") || return 1
    [[ "$release_id" =~ ^[0-9a-f]{64}$ ]] || return 1
    if [[ -e "$armed" || -L "$armed" ]]; then
        # A receiver recovering an interrupted activation intentionally keeps
        # the exact armed nonce. Reusing it closes the crash window in which a
        # newly armed attempt coexists with the prior same-release commit.
        armed_marker=$(read_fpm_guard_marker "$armed" "$generation") || return 1
        read -r armed_release_id nonce <<<"$armed_marker" || return 1
        [[ "$armed_release_id" == "$release_id" \
            && "$nonce" =~ ^[0-9a-f]{64}$ ]] || return 1
    else
        nonce=$(new_fpm_activation_nonce) || return 1
        [[ "$nonce" =~ ^[0-9a-f]{64}$ ]] || return 1
        publish_fpm_guard_marker \
            "$armed" "$generation" "$release_id" "$nonce" || return 1
    fi
    systemd-notify --ready || return 1
    flock 6 || return 1
    if validate_fpm_guard_commit_matches_accepted "$nonce"; then
        return 0
    fi
    if isolate_fpm_from_activation_guard; then
        printf '%s\n' \
            'sync receiver guard: uncommitted activation was persistently isolated' >&2
        # RequiredBy does not propagate a later runtime exit to PHP-FPM; the
        # explicit verified isolation above is the safety action. Exit 77
        # prevents a restart storm because that isolation already succeeded.
        return 77
    fi
    printf '%s\n' \
        'sync receiver guard: CRITICAL could not isolate uncommitted activation' >&2
    return 1
}

finalize_fpm_activation_guard() {
    local committed=$1 lease_metadata
    [[ "$EUID" -eq 0 && "$committed" == "$FPM_GUARD_COMMIT" ]] || return 1
    # Only a fully trusted execution context plus an exact durable commit may
    # skip isolation. Missing/tampered state or receiver metadata is therefore
    # treated as uncommitted rather than aborting this last-resort stop hook.
    if validate_fpm_guard_runtime_context \
        && exec 6<>"$FPM_GUARD_LEASE"; then
        lease_metadata=$(stat -Lc '%u:%g:%h:%a' /proc/self/fd/6) || lease_metadata=
        if [[ "$lease_metadata" == '0:0:1:600' ]] \
            && flock -n 6 \
            && validate_fpm_guard_commit_matches_accepted; then
            return 0
        fi
    fi
    if isolate_fpm_from_activation_guard; then
        printf '%s\n' \
            'sync receiver guard: uncommitted stop was persistently isolated' >&2
        return 0
    fi
    printf '%s\n' \
        'sync receiver guard: CRITICAL stop hook could not isolate uncommitted activation' >&2
    return 1
}

arm_fpm_activation_guard() {
    local generation=$1 activation_mode=${2-new}
    local attempt active_state sub_state result exit_status enabled_state
    local expected_release_id armed_marker release_id nonce committed_marker
    local committed_release_id committed_nonce reset_disposition
    [[ "$activation_mode" == new || "$activation_mode" == resume ]] || return 1
    expected_release_id=$(manage_uploads_transaction activation-release-id "$generation") \
        || return 1
    [[ "$expected_release_id" =~ ^[0-9a-f]{64}$ ]] || return 1
    validate_fpm_guard_unit || return 1
    active_state=$(systemctl show "$FPM_GUARD_UNIT" --property=ActiveState --value) \
        || return 1
    result=$(systemctl show "$FPM_GUARD_UNIT" --property=Result --value) || return 1
    exit_status=$(systemctl show "$FPM_GUARD_UNIT" --property=ExecMainStatus --value) \
        || return 1
    [[ "$result" != start-limit-hit ]] || return 1
    case "$active_state" in
        inactive)
            [[ "$result" == success || -z "$result" ]] || return 1
            ;;
        failed)
            [[ "$result" == exit-code && "$exit_status" == 77 ]] || return 1
            ;;
        active)
            # A predecessor receiver can die while its lease-backed watcher is
            # still draining. The caller has already persistently isolated FPM,
            # so stopping that exact watcher is safe and avoids an artificial
            # recovery deadlock. No failed/start-limit state is reset.
            systemctl stop "$FPM_GUARD_UNIT" || return 1
            ;;
        *)
            return 1
            ;;
    esac
    active_state=$(systemctl show "$FPM_GUARD_UNIT" --property=ActiveState --value) \
        || return 1
    sub_state=$(systemctl show "$FPM_GUARD_UNIT" --property=SubState --value) || return 1
    result=$(systemctl show "$FPM_GUARD_UNIT" --property=Result --value) || return 1
    exit_status=$(systemctl show "$FPM_GUARD_UNIT" --property=ExecMainStatus --value) \
        || return 1
    [[ "$sub_state" == dead && ( \
        ( "$active_state" == inactive && "$result" == success ) \
        || ( "$active_state" == failed && "$result" == exit-code && "$exit_status" == 77 ) \
    ) ]] || return 1
    prepare_fpm_guard_state "$generation" || return 1
    exec 6<>"$FPM_GUARD_LEASE" || return 1
    test "$(stat -Lc '%u:%g:%h:%a' /proc/self/fd/6)" = '0:0:1:600' || return 1
    flock -n 6 || return 1
    reset_disposition=reset
    if [[ "$activation_mode" == resume ]]; then
        reset_disposition=preserve
    fi
    reset_fpm_guard_attempt_state "$generation" "$reset_disposition" || return 1
    if [[ "$activation_mode" == resume ]]; then
        armed_marker=$(read_fpm_guard_marker "$FPM_GUARD_ARMED" "$generation") \
            || return 1
        read -r release_id nonce <<<"$armed_marker" || return 1
        committed_marker=$(read_fpm_guard_marker "$FPM_GUARD_COMMIT" "$generation") \
            || return 1
        read -r committed_release_id committed_nonce <<<"$committed_marker" || return 1
        [[ "$release_id" == "$expected_release_id" \
            && "$committed_release_id" == "$expected_release_id" \
            && "$nonce" =~ ^[0-9a-f]{64}$ \
            && "$committed_nonce" =~ ^[0-9a-f]{64}$ \
            && "$nonce" != "$committed_nonce" ]] || return 1
    fi
    systemctl enable "$FPM_GUARD_UNIT" >/dev/null || return 1
    enabled_state=$(read_unit_file_state "$FPM_GUARD_UNIT") || return 1
    test "$enabled_state" = enabled || return 1
    validate_fpm_guard_unit || return 1
    # The RequiredBy symlink must survive a hard reset before the persistent
    # FPM mask is removed by the caller.
    sync -f /etc/systemd/system || return 1
    systemctl start "$FPM_GUARD_UNIT" || return 1
    for attempt in $(seq 1 100); do
        active_state=$(systemctl show "$FPM_GUARD_UNIT" --property=ActiveState --value) \
            || return 1
        sub_state=$(systemctl show "$FPM_GUARD_UNIT" --property=SubState --value) \
            || return 1
        if [[ "$active_state" == active && "$sub_state" == running ]]; then
            armed_marker=$(read_fpm_guard_marker "$FPM_GUARD_ARMED" "$generation") \
                || return 1
            read -r release_id nonce <<<"$armed_marker" || return 1
            [[ "$release_id" == "$expected_release_id" \
                && "$nonce" =~ ^[0-9a-f]{64}$ ]] || return 1
            FPM_ACTIVATION_RELEASE_ID=$release_id
            FPM_ACTIVATION_NONCE=$nonce
            return 0
        fi
        sleep 0.1
    done
    return 1
}

commit_fpm_activation_guard() {
    local generation=$1 attempt active_state sub_state result exit_status accepted
    local release_id nonce
    release_id=$FPM_ACTIVATION_RELEASE_ID
    nonce=$FPM_ACTIVATION_NONCE
    [[ "$release_id" =~ ^[0-9a-f]{64}$ && "$nonce" =~ ^[0-9a-f]{64}$ ]] \
        || return 1
    accepted=$(read_accepted_generation) || return 1
    test "$accepted" = "$generation" || return 1
    validate_fpm_guard_marker \
        "$FPM_GUARD_ARMED" "$generation" "$release_id" "$nonce" || return 1
    publish_fpm_guard_marker \
        "$FPM_GUARD_COMMIT" "$generation" "$release_id" "$nonce" || return 1
    # Publication is fsync-backed and makes this generation forward-only.
    # Mark the supervisor state before any fallible guard shutdown polling or
    # post-commit housekeeping so those failures cannot stop a healthy FPM.
    POST_COMMIT=1
    flock -u 6 || return 1
    exec 6>&- || return 1
    for attempt in $(seq 1 100); do
        active_state=$(systemctl show "$FPM_GUARD_UNIT" --property=ActiveState --value) \
            || return 1
        sub_state=$(systemctl show "$FPM_GUARD_UNIT" --property=SubState --value) \
            || return 1
        if [[ "$active_state" == inactive && "$sub_state" == dead ]]; then
            break
        fi
        sleep 0.1
    done
    result=$(systemctl show "$FPM_GUARD_UNIT" --property=Result --value) || return 1
    exit_status=$(systemctl show "$FPM_GUARD_UNIT" --property=ExecMainStatus --value) \
        || return 1
    [[ "$active_state" == inactive && "$sub_state" == dead \
        && "$result" == success && "$exit_status" == 0 ]] || return 1
    validate_fpm_guard_commit_matches_accepted "$nonce" || return 1
    verify_fpm_ready || return 1
    FPM_ACTIVATION_RELEASE_ID=
    FPM_ACTIVATION_NONCE=
}

