prepare_rollback_sql() {
    local backup=$1 target=$2
    /usr/bin/timeout --signal=TERM --kill-after=10s 5m \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 \
        /var/backups "$backup" "$STATE_ROOT" "$target" 9<<'PY'
import hashlib
import os
import re
import stat
import sys
import zlib
from pathlib import Path

MAX_SQL_BYTES = 4 * 1024 * 1024 * 1024
MIN_FREE_RESERVE = 1024 * 1024 * 1024
root = Path(sys.argv[1])
backup = Path(sys.argv[2])
state = Path(sys.argv[3])
temporary = Path(sys.argv[4])
root_meta = root.lstat()
state_meta = state.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(root_meta.st_mode)
        or root_meta.st_uid != 0 or root_meta.st_gid != 0
        or stat.S_IMODE(root_meta.st_mode) != 0o755
        or backup.parent != root
        or not re.fullmatch(r"shuzijun-sync-v1-[0-9]{8}-[0-9]{6}", backup.name)
        or state.resolve(strict=True) != state or not stat.S_ISDIR(state_meta.st_mode)
        or state_meta.st_uid != 0 or state_meta.st_gid != 0
        or stat.S_IMODE(state_meta.st_mode) != 0o700
        or temporary.parent != state
        or not re.fullmatch(r"\.rollback-database\.[1-9][0-9]{0,18}", temporary.name)):
    raise SystemExit(1)
backup_meta = backup.lstat()
if (not stat.S_ISDIR(backup_meta.st_mode) or backup_meta.st_uid != 0
        or backup_meta.st_gid != 0 or stat.S_IMODE(backup_meta.st_mode) != 0o700
        or {entry.name for entry in backup.iterdir()} != {
            "backup.sha256", "wordpress.sql.gz", "wp-config.php"
        }):
    raise SystemExit(1)

def digest(path):
    value = hashlib.sha256()
    with path.open("rb", buffering=0) as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            value.update(chunk)
    return value.hexdigest()

for name in ("backup.sha256", "wordpress.sql.gz", "wp-config.php"):
    child = (backup / name).lstat()
    if (not stat.S_ISREG(child.st_mode) or child.st_uid != 0 or child.st_gid != 0
            or stat.S_IMODE(child.st_mode) != 0o600 or child.st_nlink != 1
            or child.st_dev != backup_meta.st_dev):
        raise SystemExit(1)
canonical = (
    f"{digest(backup / 'wordpress.sql.gz')}  wordpress.sql.gz\n"
    f"{digest(backup / 'wp-config.php')}  wp-config.php\n"
).encode("ascii")
if len(canonical) != 163 or (backup / "backup.sha256").read_bytes() != canonical:
    raise SystemExit(1)

descriptor = os.open(temporary, os.O_WRONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
decoder = zlib.decompressobj(16 + zlib.MAX_WBITS)
total = 0
try:
    initial = os.fstat(descriptor)
    if (not stat.S_ISREG(initial.st_mode) or initial.st_uid != 0
            or initial.st_gid != 0 or stat.S_IMODE(initial.st_mode) != 0o600
            or initial.st_nlink != 1 or initial.st_dev != state_meta.st_dev
            or initial.st_size != 0):
        raise RuntimeError("unsafe rollback target")
    with (backup / "wordpress.sql.gz").open("rb", buffering=0) as compressed:
        while True:
            chunk = compressed.read(1024 * 1024)
            if not chunk:
                break
            pending = chunk
            while pending:
                output = decoder.decompress(pending, 1024 * 1024)
                pending = decoder.unconsumed_tail
                total += len(output)
                if total > MAX_SQL_BYTES:
                    raise RuntimeError("rollback SQL too large")
                filesystem = os.statvfs(state)
                if filesystem.f_bavail * filesystem.f_frsize < MIN_FREE_RESERVE + len(output):
                    raise RuntimeError("rollback reserve exhausted")
                view = memoryview(output)
                while view:
                    written = os.write(descriptor, view)
                    if written <= 0:
                        raise RuntimeError("short rollback write")
                    view = view[written:]
                if decoder.eof:
                    if decoder.unused_data or pending or compressed.read(1):
                        raise RuntimeError("non-canonical rollback gzip")
                    break
            if decoder.eof:
                break
    if not decoder.eof or total == 0 or decoder.flush():
        raise RuntimeError("incomplete rollback gzip")
    os.fsync(descriptor)
    metadata = os.fstat(descriptor)
    if (metadata.st_uid != 0 or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_nlink != 1
            or metadata.st_dev != state_meta.st_dev or metadata.st_size != total):
        raise RuntimeError("unsafe rollback SQL")
finally:
    os.close(descriptor)
PY
}

