import json
import os
import stat
import sys
from pathlib import Path, PurePosixPath

MAX_FILES = 100_000
MAX_FILE_BYTES = 8 * 1024 * 1024 * 1024
MAX_BATCH_BYTES = 64 * 1024 * 1024 * 1024
MIN_FREE_RESERVE = 1024 * 1024 * 1024
FORBIDDEN_UPLOAD_NAMES = {".htaccess", ".user.ini"}
FORBIDDEN_UPLOAD_SUFFIXES = {
    ".cgi", ".pl", ".py", ".rb", ".sh", ".bash", ".zsh", ".fish",
    ".exe", ".com", ".bat", ".cmd", ".ps1", ".jar", ".war",
}

