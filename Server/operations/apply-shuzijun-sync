        env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 \
        /var/backups "$stamp" "$database_logical_bytes" 9<<'PY'
import ctypes
import hashlib
import os
import re
import shutil
import stat
import sys
import tempfile
from pathlib import Path

MIN_FREE_RESERVE = 1024 * 1024 * 1024
MIN_BACKUP_BUDGET = 128 * 1024 * 1024
MAX_DATABASE_LOGICAL_BYTES = 4 * 1024 * 1024 * 1024
MAX_BACKUP_ARCHIVE_BYTES = 8 * 1024 * 1024 * 1024
EXPECTED_FILES = {"backup.sha256", "wordpress.sql.gz", "wp-config.php"}
INCOMPLETE_TEMP_NAME = re.compile(r"\.wordpress-sql-gz\.[A-Za-z0-9_-]+")
NAME = re.compile(r"shuzijun-sync-v1-[0-9]{8}-[0-9]{6}")
INCOMPLETE_NAME = re.compile(
    r"\.shuzijun-sync-v1-[0-9]{8}-[0-9]{6}\.incomplete\.[A-Za-z0-9_-]+"
)
RETIRING_NAME = re.compile(
    r"\.shuzijun-sync-v1-[0-9]{8}-[0-9]{6}\.retiring"
)

root = Path(sys.argv[1])
stamp = sys.argv[2]
logical_text = sys.argv[3]
metadata = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o755):
    raise SystemExit(1)
if not re.fullmatch(r"[0-9]{8}-[0-9]{6}", stamp):
    raise SystemExit(1)
if not re.fullmatch(r"(?:0|[1-9][0-9]{0,18})", logical_text):
    raise SystemExit(1)
logical_bytes = int(logical_text)
if logical_bytes > MAX_DATABASE_LOGICAL_BYTES:
    raise SystemExit(1)

def validate_backup_tree(path, expected_files):
    entry = path.lstat()
    if (not stat.S_ISDIR(entry.st_mode) or entry.st_uid != 0 or entry.st_gid != 0
            or stat.S_IMODE(entry.st_mode) != 0o700 or entry.st_dev != metadata.st_dev):
        raise SystemExit(1)
    children = list(path.iterdir())
    child_names = {child.name for child in children}
    if expected_files is None:
        if any(
            name not in EXPECTED_FILES and not INCOMPLETE_TEMP_NAME.fullmatch(name)
            for name in child_names
        ):
            raise SystemExit(1)
    elif child_names != expected_files:
        raise SystemExit(1)
    for child in children:
        child_metadata = child.lstat()
        if (not stat.S_ISREG(child_metadata.st_mode) or child_metadata.st_uid != 0
                or child_metadata.st_gid != 0
                or stat.S_IMODE(child_metadata.st_mode) != 0o600
                or child_metadata.st_nlink != 1
                or child_metadata.st_dev != metadata.st_dev):
            raise SystemExit(1)
    if expected_files is not None:
        def digest(name):
            value = hashlib.sha256()
            with (path / name).open("rb", buffering=0) as stream:
                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                    value.update(chunk)
            return value.hexdigest()
        canonical = (
            f"{digest('wordpress.sql.gz')}  wordpress.sql.gz\n"
            f"{digest('wp-config.php')}  wp-config.php\n"
        ).encode("ascii")
        if (len(canonical) != 163
                or (path / "backup.sha256").read_bytes() != canonical):
            raise SystemExit(1)

