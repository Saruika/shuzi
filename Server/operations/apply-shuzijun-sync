read_unit_file_state() {
    local unit=$1 state status
    if state=$(systemctl is-enabled "$unit" 2>/dev/null); then
        status=0
    else
        status=$?
    fi
    # Output alone is not evidence: a timed-out or failed command may already
    # have printed a plausible word. Accept only the exact output/status pairs
    # used by this transaction.
    case "$status:$state" in
        0:enabled|1:disabled|1:masked)
            printf '%s\n' "$state"
            ;;
        *)
            return 1
            ;;
    esac
}

isolate_failed_fpm() {
    local failed=0 load_state= active_state= sub_state= result= job= enabled_state=
    # These operations are intentionally idempotent.  Their individual exit
    # codes are advisory; only the exact persisted/loaded state below decides
    # whether isolation succeeded.
    if ! systemctl mask --now "$FPM_SERVICE" >/dev/null 2>&1; then :; fi
    if ! systemctl stop "$FPM_SERVICE" >/dev/null 2>&1; then :; fi
    # Persist the mask before reporting isolation: on the later activation
    # path, the RequiredBy edge is separately synced before this mask is removed.
    if ! sync -f /etc/systemd/system; then
        failed=1
    fi
    if ! load_state=$(systemctl show "$FPM_SERVICE" --property=LoadState --value); then
        failed=1
    fi
    if ! active_state=$(systemctl show "$FPM_SERVICE" --property=ActiveState --value); then
        failed=1
    fi
    if ! sub_state=$(systemctl show "$FPM_SERVICE" --property=SubState --value); then
        failed=1
    fi
    if ! result=$(systemctl show "$FPM_SERVICE" --property=Result --value); then
        failed=1
    fi
    if ! job=$(systemctl show "$FPM_SERVICE" --property=Job --value); then
        failed=1
    fi
    enabled_state=$(read_unit_file_state "$FPM_SERVICE") || failed=1
    [[ "$load_state" == masked && "$active_state" == inactive \
        && "$sub_state" == dead && "$result" =~ ^[a-z][a-z-]*$ && -z "$job" \
        && "$enabled_state" == masked ]] || failed=1
    [[ "$failed" -eq 0 ]]
}

durably_unmask_fpm() {
    local load_state= enabled_state= job=
    systemctl unmask "$FPM_SERVICE" >/dev/null || return 1
    # The persistent mask is a directory entry under /etc/systemd/system.
    # Make its removal durable before allowing any activation; otherwise a
    # power loss after commit can replay the old /dev/null mask on next boot.
    sync -f /etc/systemd/system || return 1
    load_state=$(systemctl show "$FPM_SERVICE" --property=LoadState --value) \
        || return 1
    enabled_state=$(read_unit_file_state "$FPM_SERVICE") || return 1
    job=$(systemctl show "$FPM_SERVICE" --property=Job --value) || return 1
    [[ "$load_state" == loaded && "$enabled_state" == enabled && -z "$job" ]]
}

isolate_fpm_from_activation_guard() {
    local active_state= sub_state= result= job= enabled_state= attempt
    # The guard runs with a read-only system namespace. It stops FPM through
    # systemd's AF_UNIX control socket, while its already-fsynced RequiredBy
    # edge remains the persistent reboot gate. The receiver mutation path uses
    # isolate_failed_fpm() and a real persistent mask before publication.
    systemctl stop --no-block "$FPM_SERVICE" >/dev/null 2>&1 || :
    for attempt in $(seq 1 100); do
        active_state=$(systemctl show "$FPM_SERVICE" --property=ActiveState --value) \
            || return 1
        sub_state=$(systemctl show "$FPM_SERVICE" --property=SubState --value) \
            || return 1
        result=$(systemctl show "$FPM_SERVICE" --property=Result --value) || return 1
        job=$(systemctl show "$FPM_SERVICE" --property=Job --value) || return 1
        if [[ "$active_state" == inactive && "$sub_state" == dead \
            && "$result" =~ ^[a-z][a-z-]*$ && -z "$job" ]]; then
            break
        fi
        sleep 0.1
    done
    enabled_state=$(read_unit_file_state "$FPM_GUARD_UNIT") || return 1
    [[ "$active_state" == inactive && "$sub_state" == dead \
        && "$result" =~ ^[a-z][a-z-]*$ && -z "$job" && "$enabled_state" == enabled ]] \
        || return 1
    validate_fpm_guard_unit || return 1
}

verify_fpm_ready() {
    local load_state active_state sub_state result job enabled_state triggered_by
    load_state=$(systemctl show "$FPM_SERVICE" --property=LoadState --value) || return 1
    active_state=$(systemctl show "$FPM_SERVICE" --property=ActiveState --value) || return 1
    sub_state=$(systemctl show "$FPM_SERVICE" --property=SubState --value) || return 1
    result=$(systemctl show "$FPM_SERVICE" --property=Result --value) || return 1
    job=$(systemctl show "$FPM_SERVICE" --property=Job --value) || return 1
    enabled_state=$(read_unit_file_state "$FPM_SERVICE") || return 1
    triggered_by=$(systemctl show "$FPM_SERVICE" --property=TriggeredBy --value) || return 1
    [[ "$load_state" == loaded && "$active_state" == active \
        && "$sub_state" == running && "$result" == success && -z "$job" \
        && "$enabled_state" == enabled \
        && -z "$triggered_by" ]] || return 1
}

validate_fpm_guard_unit() {
    local fragment drop_ins load_state need_reload enabled_state guard_sha256
    local service_type notify_access remain_after_exit runtime_max restart_policy restart_delay
    local start_limit_interval start_limit_burst before_units required_by
    test -f "$FPM_GUARD_UNIT_FILE" && test ! -L "$FPM_GUARD_UNIT_FILE" || return 1
    test "$(realpath -e -- "$FPM_GUARD_UNIT_FILE")" = "$FPM_GUARD_UNIT_FILE" || return 1
    test "$(stat -c '%u:%g:%h:%a' "$FPM_GUARD_UNIT_FILE")" = '0:0:1:644' || return 1
    guard_sha256=$(sha256sum "$FPM_GUARD_UNIT_FILE" | awk '{ print $1 }') || return 1
    test "$guard_sha256" = "$FPM_GUARD_UNIT_SHA256" || return 1
    fragment=$(systemctl show "$FPM_GUARD_UNIT" --property=FragmentPath --value) || return 1
    drop_ins=$(systemctl show "$FPM_GUARD_UNIT" --property=DropInPaths --value) || return 1
    load_state=$(systemctl show "$FPM_GUARD_UNIT" --property=LoadState --value) || return 1
    need_reload=$(systemctl show "$FPM_GUARD_UNIT" --property=NeedDaemonReload --value) || return 1
    service_type=$(systemctl show "$FPM_GUARD_UNIT" --property=Type --value) || return 1
    notify_access=$(systemctl show "$FPM_GUARD_UNIT" --property=NotifyAccess --value) || return 1
    remain_after_exit=$(systemctl show "$FPM_GUARD_UNIT" --property=RemainAfterExit --value) \
        || return 1
    runtime_max=$(systemctl show "$FPM_GUARD_UNIT" --property=RuntimeMaxUSec --value) \
        || return 1
    restart_policy=$(systemctl show "$FPM_GUARD_UNIT" --property=Restart --value) || return 1
    restart_delay=$(systemctl show "$FPM_GUARD_UNIT" --property=RestartUSec --value) || return 1
    start_limit_interval=$(systemctl show \
        "$FPM_GUARD_UNIT" --property=StartLimitIntervalUSec --value) || return 1
    start_limit_burst=$(systemctl show \
        "$FPM_GUARD_UNIT" --property=StartLimitBurst --value) || return 1
    before_units=$(systemctl show "$FPM_GUARD_UNIT" --property=Before --value) || return 1
    required_by=$(systemctl show "$FPM_GUARD_UNIT" --property=RequiredBy --value) || return 1
    enabled_state=$(read_unit_file_state "$FPM_GUARD_UNIT") || return 1
    [[ "$fragment" == "$FPM_GUARD_UNIT_FILE" && -z "$drop_ins" \
        && "$load_state" == loaded && "$need_reload" == no \
        && "$service_type" == notify && "$notify_access" == all \
        && "$remain_after_exit" == no && "$runtime_max" == 2min \
        && "$restart_policy" == on-failure && "$restart_delay" == 1s \
        && "$start_limit_interval" == 10min && "$start_limit_burst" == 3 \
        && " $before_units " == *" $FPM_SERVICE "* \
        && ( "$enabled_state" == disabled || "$enabled_state" == enabled ) ]] || return 1
    if [[ "$enabled_state" == enabled ]]; then
        [[ " $required_by " == *" $FPM_SERVICE "* ]] || return 1
    fi
}

prepare_fpm_guard_state() {
