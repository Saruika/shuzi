validate_fpm_guard_commit_matches_accepted() {
    local expected_nonce=${1-} accepted active marker release_id commit_nonce
    if [[ -n "$expected_nonce" && ! "$expected_nonce" =~ ^[0-9a-f]{64}$ ]]; then
        return 1
    fi
    accepted=$(read_accepted_generation) || return 1
    # Guard boot/stop paths must remain O(1): this validates only canonical,
    # fsync-backed state plus the current uploads-root inode. Full per-file
    # hashing stays in the receiver's signed transaction checks and patrols.
    active=$(manage_uploads_transaction validate-activation "$accepted") || return 1
    test "$active" = "$accepted" || return 1
    if [[ -n "$expected_nonce" ]]; then
        marker=$(read_fpm_guard_marker "$FPM_GUARD_COMMIT" "$accepted") || return 1
        read -r release_id commit_nonce <<<"$marker" || return 1
        [[ "$release_id" =~ ^[0-9a-f]{64}$ ]] || return 1
        test "$commit_nonce" = "$expected_nonce" || return 1
    fi
}

