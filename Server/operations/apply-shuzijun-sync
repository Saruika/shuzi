def identity(metadata):
    return metadata.st_dev, metadata.st_ino

def hash_file(path):
    digest = hashlib.sha256()
    with path.open("rb", buffering=0) as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

def validate_tree(path, uid, gid, mode, expected=None, required=False, allow_empty=False):
    root_meta = strict_directory(path, uid, gid, mode)
    files = {}
    file_count = directory_count = total_bytes = 0
    for directory, directory_names, file_names, descriptor in os.fwalk(
        path, topdown=True, follow_symlinks=False
    ):
        current = os.fstat(descriptor)
        if (not stat.S_ISDIR(current.st_mode) or current.st_uid != uid or current.st_gid != gid
                or stat.S_IMODE(current.st_mode) != mode or current.st_dev != root_meta.st_dev):
            raise RuntimeError("unsafe media directory")
        directory_count += 1
        if directory_count > MAX_DIRECTORIES:
            raise RuntimeError("too many media directories")
        relative_directory = Path(directory).relative_to(path)
        for name in directory_names:
            child = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            if (not stat.S_ISDIR(child.st_mode) or child.st_uid != uid or child.st_gid != gid
                    or stat.S_IMODE(child.st_mode) != mode or child.st_dev != root_meta.st_dev):
                raise RuntimeError("unsafe media child directory")
        for name in file_names:
            child = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            lower = name.lower()
            if (not stat.S_ISREG(child.st_mode) or child.st_uid != uid or child.st_gid != gid
                    or stat.S_IMODE(child.st_mode) != (0o600 if uid == 0 else 0o644)
                    or child.st_nlink != 1 or child.st_dev != root_meta.st_dev
                    or child.st_size > MAX_FILE_BYTES
                    or (child.st_size > 0 and child.st_blocks * 512 < child.st_size)
                    or lower in FORBIDDEN_NAMES or ".php" in lower or ".phtml" in lower
                    or ".phar" in lower or any(lower.endswith(suffix) for suffix in FORBIDDEN_SUFFIXES)):
                raise RuntimeError("unsafe media file")
            relative = (relative_directory / name).as_posix()
            file_path = Path(directory) / name
            files[relative] = (hash_file(file_path), child.st_size)
            file_count += 1
            total_bytes += child.st_size
            if file_count > MAX_FILES or total_bytes > MAX_TREE_BYTES:
                raise RuntimeError("media tree exceeds limits")
    if not allow_empty and (file_count == 0 or total_bytes == 0):
        raise RuntimeError("empty media tree")
    if expected is not None and files != expected:
        raise RuntimeError("media manifest mismatch")
    if required and not REQUIRED_MEDIA.issubset(files):
        raise RuntimeError("known media absent")
    return root_meta, files, file_count, total_bytes

def chown_candidate(path):
    for directory, directory_names, file_names, descriptor in os.fwalk(
        path, topdown=False, follow_symlinks=False
    ):
        for name in file_names:
            child = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            if not stat.S_ISREG(child.st_mode) or child.st_nlink != 1:
                raise RuntimeError("unsafe candidate file")
            os.chown(name, www.pw_uid, www.pw_gid, dir_fd=descriptor, follow_symlinks=False)
            os.chmod(name, 0o644, dir_fd=descriptor, follow_symlinks=False)
        for name in directory_names:
            child = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            if not stat.S_ISDIR(child.st_mode):
                raise RuntimeError("unsafe candidate directory")
            os.chown(name, www.pw_uid, www.pw_gid, dir_fd=descriptor, follow_symlinks=False)
            os.chmod(name, 0o755, dir_fd=descriptor, follow_symlinks=False)
        os.fchown(descriptor, www.pw_uid, www.pw_gid)
        os.fchmod(descriptor, 0o755)

def normalize_partial_candidate_to_root(path, expected_identity):
    # A SIGKILL during chown_candidate can leave a precise mix of the only two
    # ownership/mode states that function publishes. Validate every inode and
    # converge it back to the claim's root-only representation before rename;
    # links, devices, foreign owners/modes and filesystem crossings fail closed.
    root_meta = path.lstat()
    if (identity(root_meta) != expected_identity
            or not stat.S_ISDIR(root_meta.st_mode)
            or root_meta.st_dev != release_meta.st_dev):
        raise RuntimeError("unsafe partial candidate root")
    for _directory, directory_names, file_names, descriptor in os.fwalk(
        path, topdown=False, follow_symlinks=False
    ):
        current = os.fstat(descriptor)
        current_owner = (current.st_uid, current.st_gid, stat.S_IMODE(current.st_mode))
        if (not stat.S_ISDIR(current.st_mode)
                or current.st_dev != root_meta.st_dev
                or current_owner not in {
                    (0, 0, 0o700),
                    (www.pw_uid, www.pw_gid, 0o700),
                    (www.pw_uid, www.pw_gid, 0o755),
                }):
            raise RuntimeError("unsafe partial candidate directory")
        for name in directory_names:
            child = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            owner = (child.st_uid, child.st_gid, stat.S_IMODE(child.st_mode))
            if (not stat.S_ISDIR(child.st_mode)
                    or child.st_dev != root_meta.st_dev
                    or owner not in {
                        (0, 0, 0o700),
                        (www.pw_uid, www.pw_gid, 0o700),
                        (www.pw_uid, www.pw_gid, 0o755),
                    }):
                raise RuntimeError("unsafe partial candidate child directory")
            os.chown(name, 0, 0, dir_fd=descriptor, follow_symlinks=False)
            os.chmod(name, 0o700, dir_fd=descriptor, follow_symlinks=False)
        for name in file_names:
            child = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            owner = (child.st_uid, child.st_gid, stat.S_IMODE(child.st_mode))
            lower = name.lower()
            if (not stat.S_ISREG(child.st_mode) or child.st_nlink != 1
                    or child.st_dev != root_meta.st_dev
                    or owner not in {
                        (0, 0, 0o600),
                        (www.pw_uid, www.pw_gid, 0o600),
                        (www.pw_uid, www.pw_gid, 0o644),
                    }
                    or lower in FORBIDDEN_NAMES or ".php" in lower
                    or ".phtml" in lower or ".phar" in lower
                    or any(lower.endswith(suffix) for suffix in FORBIDDEN_SUFFIXES)):
                raise RuntimeError("unsafe partial candidate file")
            os.chown(name, 0, 0, dir_fd=descriptor, follow_symlinks=False)
            os.chmod(name, 0o600, dir_fd=descriptor, follow_symlinks=False)
        os.fchown(descriptor, 0, 0)
        os.fchmod(descriptor, 0o700)
    fsync_directory(path)

def manifest_uploads(path, expected_generation):
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(descriptor)
        raw = b""
        while len(raw) <= 32 * 1024 * 1024:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            raw += chunk
    finally:
        os.close(descriptor)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_nlink != 1
            or len(raw) > 32 * 1024 * 1024):
        raise RuntimeError("unsafe manifest")
    document = json.loads(raw.decode("utf-8"))
    canonical = (json.dumps(document, ensure_ascii=True, separators=(",", ":"), sort_keys=True) + "\n").encode()
    if (canonical != raw or set(document) != {"files", "generation", "version"}
            or document["version"] != 2 or document["generation"] != expected_generation):
        raise RuntimeError("manifest identity mismatch")
    expected = {}
    for item in document["files"]:
        relative = item.get("path")
        if not isinstance(relative, str) or not relative.startswith("wp-content/uploads/"):
            continue
        shortened = relative.removeprefix("wp-content/uploads/")
        pure = PurePosixPath(shortened)
        if not shortened or pure.is_absolute() or any(part in {"", ".", ".."} for part in pure.parts):
            raise RuntimeError("unsafe manifest media path")
        expected[shortened] = (item["sha256"], item["size"])
    if not expected:
        raise RuntimeError("empty manifest media")
    return expected, hashlib.sha256(raw).hexdigest()

def transition(document, phase, allowed):
    if document["phase"] not in allowed:
        raise RuntimeError("invalid transaction transition")
    document["phase"] = phase
    write_transaction(document)

def exchange(parent_a, name_a, parent_b, name_b):
    descriptor_a = os.open(parent_a, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
    descriptor_b = os.open(parent_b, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        renameat2 = getattr(libc, "renameat2", None)
        if renameat2 is None:
            raise RuntimeError("renameat2 unavailable")
        renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
        renameat2.restype = ctypes.c_int
        if renameat2(descriptor_a, os.fsencode(name_a), descriptor_b, os.fsencode(name_b), RENAME_EXCHANGE) != 0:
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error))
        os.fsync(descriptor_a)
        if identity(os.fstat(descriptor_a)) != identity(os.fstat(descriptor_b)):
            os.fsync(descriptor_b)
    finally:
        os.close(descriptor_b)
        os.close(descriptor_a)

def secure_remove_tree(path, expected_identity, allow_empty=False):
    metadata, _, _, _ = validate_tree(
        path, www.pw_uid, www.pw_gid, 0o755, allow_empty=allow_empty
    )
    if identity(metadata) != expected_identity or not shutil.rmtree.avoids_symlink_attacks:
        raise RuntimeError("unsafe retained tree")
    shutil.rmtree(path)
    fsync_directory(path.parent)

