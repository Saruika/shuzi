    run_with_deadline 5 2 env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 \
        "$STATE_ROOT" "$marker" "$generation" "$release_id" "$nonce" 9<<'PY'
import os
import re
import secrets
import stat
import sys
import tempfile
from pathlib import Path

root = Path(sys.argv[1])
marker = Path(sys.argv[2])
generation = sys.argv[3]
release_id = sys.argv[4]
nonce = sys.argv[5]
metadata = root.lstat()
allowed = {
    root / "fpm-activation-guard-v4.armed",
    root / "fpm-activation-guard-v4.committed",
}
if (root.resolve(strict=True) != root or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700
        or marker not in allowed
        or not re.fullmatch(r"[1-9][0-9]{0,18}", generation)
        or not re.fullmatch(r"[0-9a-f]{64}", release_id)
        or not re.fullmatch(r"[0-9a-f]{64}", nonce)):
    raise SystemExit(1)
try:
    existing = os.open(marker, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
except FileNotFoundError:
    pass
else:
    try:
        current = os.fstat(existing)
        value = os.read(existing, 192)
        if os.read(existing, 1):
            raise SystemExit(1)
        named = marker.lstat()
    finally:
        os.close(existing)
    expected = f"{generation} {release_id} {nonce}\n".encode("ascii")
    if (not stat.S_ISREG(current.st_mode) or current.st_uid != 0
            or current.st_gid != 0 or stat.S_IMODE(current.st_mode) != 0o600
            or current.st_nlink != 1 or current.st_dev != metadata.st_dev
            or (current.st_dev, current.st_ino) != (named.st_dev, named.st_ino)
            or not re.fullmatch(
                rb"[1-9][0-9]{0,18} [0-9a-f]{64} [0-9a-f]{64}\n", value
            )):
        raise SystemExit(1)
    # Same-generation publication is idempotent. A different valid generation
    # is replaced atomically below; malformed metadata is never overwritten.
    if value == expected:
        directory = os.open(
            root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
        )
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        repeated = os.open(marker, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            repeated_meta = os.fstat(repeated)
            repeated_value = os.read(repeated, 192)
            if os.read(repeated, 1):
                raise SystemExit(1)
            repeated_named = marker.lstat()
        finally:
            os.close(repeated)
        if ((repeated_meta.st_dev, repeated_meta.st_ino)
                != (current.st_dev, current.st_ino)
                or (repeated_meta.st_dev, repeated_meta.st_ino)
                != (repeated_named.st_dev, repeated_named.st_ino)
                or repeated_value != value):
            raise SystemExit(1)
        raise SystemExit(0)

temp_path = root / f".fpm-guard-marker.{secrets.token_hex(16)}"
descriptor = os.open(
    temp_path,
    os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
    0o600,
)
try:
    os.fchmod(descriptor, 0o600)
    encoded = f"{generation} {release_id} {nonce}\n".encode("ascii")
    view = memoryview(encoded)
    while view:
        written = os.write(descriptor, view)
        if written <= 0:
            raise SystemExit(1)
        view = view[written:]
    os.fsync(descriptor)
    current = os.fstat(descriptor)
    if (not stat.S_ISREG(current.st_mode) or current.st_uid != 0
            or current.st_gid != 0 or stat.S_IMODE(current.st_mode) != 0o600
            or current.st_nlink != 1 or current.st_dev != metadata.st_dev
            or current.st_size != len(encoded)):
        raise SystemExit(1)
    os.close(descriptor)
    descriptor = -1
    os.replace(temp_path, marker)
    directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
finally:
    if descriptor >= 0:
        os.close(descriptor)
    try:
        temp_path.unlink()
    except FileNotFoundError:
        pass
PY
}

read_fpm_guard_marker() {
