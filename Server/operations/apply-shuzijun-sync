prepare_database_sql() {
    local claim=$1
    # Authenticate and ingest the compressed bytes first, then stream them
    # through a single-member gzip decoder with an absolute output bound.  The
    # completed SQL inode is linked into place only after CRC/EOF, size,
    # free-space and metadata checks all pass.
    /usr/bin/timeout --signal=TERM --kill-after=10s 30m \
        env -i PATH="$PATH" LC_ALL=C LANG=C \
        /usr/bin/python3 -I /proc/self/fd/9 "$claim" 9<<'PY'
import ctypes
import os
import stat
import sys
import tempfile
import zlib
from pathlib import Path

MAX_DATABASE_SQL_BYTES = 4 * 1024 * 1024 * 1024
MIN_FREE_RESERVE = 1024 * 1024 * 1024
INPUT_CHUNK = 1024 * 1024
OUTPUT_CHUNK = 1024 * 1024

root = Path(sys.argv[1])
metadata = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o700):
    raise SystemExit(1)

source = root / "shuzijun-sync.sql.gz"
source_metadata = source.lstat()
if (not stat.S_ISREG(source_metadata.st_mode) or source_metadata.st_uid != 0
        or source_metadata.st_gid != 0 or stat.S_IMODE(source_metadata.st_mode) != 0o600
        or source_metadata.st_nlink != 1):
    raise SystemExit(1)
destination = root / "shuzijun-sync.sql"
try:
    destination.lstat()
except FileNotFoundError:
    pass
else:
    raise SystemExit(1)

temp_descriptor, temp_name = tempfile.mkstemp(prefix=".database-sql.", dir=root)
temp_path = Path(temp_name)
decoder = zlib.decompressobj(16 + zlib.MAX_WBITS)
total = 0

def write_output(payload):
    global total
    if not payload:
        return
    total += len(payload)
    if total > MAX_DATABASE_SQL_BYTES:
        raise SystemExit(1)
    filesystem = os.statvfs(root)
    if filesystem.f_bavail * filesystem.f_frsize < MIN_FREE_RESERVE + len(payload):
        raise SystemExit(1)
    view = memoryview(payload)
    while view:
        written = os.write(temp_descriptor, view)
        if written <= 0:
            raise SystemExit(1)
        view = view[written:]

try:
    os.fchmod(temp_descriptor, 0o600)
    with source.open("rb", buffering=0) as compressed:
        while True:
            compressed_chunk = compressed.read(INPUT_CHUNK)
            if not compressed_chunk:
                break
            pending = compressed_chunk
            while pending:
                output = decoder.decompress(pending, OUTPUT_CHUNK)
                write_output(output)
                pending = decoder.unconsumed_tail
                if decoder.eof:
                    if decoder.unused_data or pending or compressed.read(1):
                        raise SystemExit(1)
                    break
            if decoder.eof:
                break
    if not decoder.eof:
        raise SystemExit(1)
    write_output(decoder.flush())
    if total == 0:
        raise SystemExit(1)
    os.fsync(temp_descriptor)
    completed = os.fstat(temp_descriptor)
    if (not stat.S_ISREG(completed.st_mode) or completed.st_uid != 0
            or completed.st_gid != 0 or stat.S_IMODE(completed.st_mode) != 0o600
            or completed.st_nlink != 1 or completed.st_size != total):
        raise SystemExit(1)
    os.close(temp_descriptor)
    temp_descriptor = -1
    named = temp_path.lstat()
    if (named.st_dev, named.st_ino) != (completed.st_dev, completed.st_ino):
        raise SystemExit(1)
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise SystemExit(1)
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    if renameat2(-100, os.fsencode(temp_path), -100, os.fsencode(destination), 1) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    directory = os.open(root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
finally:
    if temp_descriptor >= 0:
        os.close(temp_descriptor)
    try:
        temp_path.unlink()
    except FileNotFoundError:
        pass
PY
}

prepare_backup_destination() {
    local stamp=$1 database_logical_bytes=$2
