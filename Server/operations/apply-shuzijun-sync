    # FPM remained online. release_root is root:0700, so www-data cannot alter
    # the candidate afterwards. Once FPM is persistently masked, fixed inode,
    # owner, mode and same-device checks are the bounded publication gate.
    live_meta = strict_directory(live, www.pw_uid, www.pw_gid, 0o755)
    candidate_meta = strict_directory(candidate, www.pw_uid, www.pw_gid, 0o755)
    if (identity(live_meta) != (document["live_dev"], document["live_ino"])
            or identity(candidate_meta) != (document["candidate_dev"], document["candidate_ino"])
            or live.parent.stat().st_dev != release_meta.st_dev):
        raise RuntimeError("exchange identity mismatch")
    exchange(live.parent, live.name, release_root, candidate.name)
    after_live = live.lstat()
    after_candidate = candidate.lstat()
    if (identity(after_live) != (document["candidate_dev"], document["candidate_ino"])
            or identity(after_candidate) != (document["live_dev"], document["live_ino"])):
        raise RuntimeError("exchange postcondition")
    transition(document, "swapped", {"database-imported"})
elif action == "validate-prepared":
    if document["phase"] != "prepared":
        raise SystemExit(1)
    live_meta = strict_directory(live, www.pw_uid, www.pw_gid, 0o755)
    candidate_meta = strict_directory(candidate, www.pw_uid, www.pw_gid, 0o755)
    source = Path(document["source"])
    try:
        source.lstat()
    except FileNotFoundError:
        pass
    else:
        raise RuntimeError("prepared source unexpectedly exists")
    if (identity(live_meta) != (document["live_dev"], document["live_ino"])
            or identity(candidate_meta)
                != (document["candidate_dev"], document["candidate_ino"])
            or read_generation(active_path) != document["previous_generation"]):
        raise RuntimeError("prepared media identity mismatch")
    print(document["generation"])
elif action == "publish-active":
    if document["phase"] != "swapped" or read_generation(active_path) != document["previous_generation"]:
        raise SystemExit(1)
    if identity(live.lstat()) != (document["candidate_dev"], document["candidate_ino"]):
        raise RuntimeError("new live inode mismatch")
    atomic_write(active_path, f"{document['generation']}\n".encode("ascii"), ".active-generation.")
    transition(document, "activated", {"swapped"})
elif action == "rollback-media":
    phase = document["phase"]
    if phase == "committed":
        print("committed")
        raise SystemExit(0)
    try:
        live_identity = identity(live.lstat())
    except FileNotFoundError:
        raise RuntimeError("live media missing")
    try:
        candidate_identity = identity(candidate.lstat())
    except FileNotFoundError:
        candidate_identity = None
    old_identity = (document["live_dev"], document["live_ino"])
    new_identity = (document["candidate_dev"], document["candidate_ino"])
    if live_identity == new_identity and candidate_identity == old_identity:
        exchange(live.parent, live.name, release_root, candidate.name)
        live_identity = identity(live.lstat())
        candidate_identity = identity(candidate.lstat())
    if live_identity != old_identity:
        raise RuntimeError("cannot restore previous live media")
    active = read_generation(active_path)
    if active == document["generation"]:
        atomic_write(active_path, f"{document['previous_generation']}\n".encode("ascii"), ".active-generation.")
    elif active != document["previous_generation"]:
        raise RuntimeError("active generation mismatch during rollback")
    needs_database = phase in {
        "database-importing", "database-imported", "swapped", "activated",
        "commit-ready", "rollback-media"
    }
    if not needs_database:
        source = Path(document["source"])
        strict_directory(source.parent, 0, 0, 0o700, sync_meta.st_dev)
        try:
            source_identity = identity(source.lstat())
        except FileNotFoundError:
            source_identity = None
        if candidate_identity == new_identity and source_identity is None:
            normalize_partial_candidate_to_root(candidate, new_identity)
            os.rename(candidate, source)
            fsync_directory(release_root)
            fsync_directory(source.parent)
        elif source_identity != new_identity or candidate_identity is not None:
            raise RuntimeError("candidate missing during pre-DB rollback")
        remove_transaction()
    else:
        document["phase"] = "rollback-media"
        write_transaction(document)
    print("database" if needs_database else "clean")
elif action == "finish-rollback":
    if document["phase"] != "rollback-media":
        raise SystemExit(1)
    if (identity(live.lstat()) != (document["live_dev"], document["live_ino"])
            or read_generation(active_path) != document["previous_generation"]):
        raise RuntimeError("rollback state mismatch")
    try:
        candidate_meta = candidate.lstat()
    except FileNotFoundError:
        # SIGKILL may land after symlink-safe deletion removed the candidate
        # root but before the durable transaction unlink.  With the old live
        # inode and previous active generation both positively verified above,
        # absence is the completed cleanup state and is safe to finalize.
        pass
    else:
        if identity(candidate_meta) != (
                document["candidate_dev"], document["candidate_ino"]):
            raise RuntimeError("rollback candidate identity mismatch")
        # A killed rmtree can leave any safe remaining subset, including an
        # empty root.  Revalidate that subset and resume deletion idempotently.
        secure_remove_tree(
            candidate,
            (document["candidate_dev"], document["candidate_ino"]),
            allow_empty=True,
        )
    remove_transaction()
elif action == "finalize":
    if document["phase"] != "committed" or read_generation(active_path) != document["generation"]:
        raise SystemExit(1)
    if identity(live.lstat()) != (document["candidate_dev"], document["candidate_ino"]):
        raise RuntimeError("committed media identity mismatch")
    # Publish compact, fsync-backed O(1) boot evidence before potentially long
    # retirement of the old media tree.  A kill after this point leaves both
    # the valid record and committed transaction for idempotent recovery.
    write_active_release(active_release_document(document), True)
    retained_name = (
        f"previous-generation-{document['previous_generation']}-for-{document['generation']}"
    )
    retained = release_root / retained_name
    try:
        candidate_identity = identity(candidate.lstat())
    except FileNotFoundError:
        candidate_identity = None
    try:
        retained_identity = identity(retained.lstat())
    except FileNotFoundError:
        retained_identity = None
    old_identity = (document["live_dev"], document["live_ino"])
    if not ((candidate_identity == old_identity and retained_identity is None)
            or (candidate_identity is None and retained_identity == old_identity)):
        raise RuntimeError("retained media identity mismatch")
    existing = [entry for entry in release_root.iterdir() if entry not in {candidate, retained}]
    for entry in existing:
        if re.fullmatch(r"\.retiring-previous-generation-[1-9][0-9]{0,18}-for-[1-9][0-9]{0,18}", entry.name):
            secure_remove_tree(entry, identity(entry.lstat()), allow_empty=True)
            continue
        if not re.fullmatch(r"previous-generation-[1-9][0-9]{0,18}-for-[1-9][0-9]{0,18}", entry.name):
            raise RuntimeError("unexpected release entry")
        entry_meta, _, _, _ = validate_tree(entry, www.pw_uid, www.pw_gid, 0o755)
        tombstone = release_root / f".retiring-{entry.name}"
        try:
            tombstone.lstat()
        except FileNotFoundError:
            pass
        else:
            raise RuntimeError("retiring media collision")
        os.rename(entry, tombstone)
        fsync_directory(release_root)
        secure_remove_tree(tombstone, identity(entry_meta), allow_empty=True)
    if retained_identity is None:
        os.rename(candidate, retained)
        fsync_directory(release_root)
    remove_transaction()
elif action == "inspect":
    print(f"{document['generation']} {document['previous_generation']} {document['phase']} {document['backup']}")
else:
    raise SystemExit(2)
PY
}

