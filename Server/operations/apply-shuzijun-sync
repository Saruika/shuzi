classify_fpm_guard_commit_marker() {
    local generation=$1 previous=$2 expected_release_id=${3-} expected_nonce=${4-}
    [[ "$generation" =~ ^[1-9][0-9]{0,18}$ \
        && "$previous" =~ ^[1-9][0-9]{0,18}$ \
        && "$previous" != "$generation" \
        && ( ( -z "$expected_release_id" && -z "$expected_nonce" ) \
            || ( "$expected_release_id" =~ ^[0-9a-f]{64}$ \
                && "$expected_nonce" =~ ^[0-9a-f]{64}$ ) ) ]] \
        || return 1
    # Return 0 only for this activation's exact commit, 2 only for a positively
    # observed absence/previous-generation commit, and 1 for every uncertain
    # state (I/O, timeout, unsafe inode, malformed bytes, future generation, or
    # same-generation nonce mismatch). Callers must never collapse 1 into 2.
    run_with_deadline 5 2 /usr/bin/python3 -I /proc/self/fd/9 \
        "$STATE_ROOT" "$FPM_GUARD_COMMIT" "$generation" "$previous" \
        "$expected_release_id" "$expected_nonce" 9<<'PY'
import os
import re
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
marker = Path(sys.argv[2])
generation = sys.argv[3]
previous = sys.argv[4]
expected_release_id = sys.argv[5]
expected_nonce = sys.argv[6]
root_meta = root.lstat()
if (root.resolve(strict=True) != root or not stat.S_ISDIR(root_meta.st_mode)
        or root_meta.st_uid != 0 or root_meta.st_gid != 0
        or stat.S_IMODE(root_meta.st_mode) != 0o700
        or marker != root / "fpm-activation-guard-v4.committed"
        or not re.fullmatch(r"[1-9][0-9]{0,18}", generation)
        or not re.fullmatch(r"[1-9][0-9]{0,18}", previous)
        or int(previous) >= int(generation)
        or bool(expected_release_id) != bool(expected_nonce)
        or (expected_release_id
            and not re.fullmatch(r"[0-9a-f]{64}", expected_release_id))
        or (expected_nonce and not re.fullmatch(r"[0-9a-f]{64}", expected_nonce))):
    raise SystemExit(1)

directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
try:
    def read_once():
        descriptor = os.open(
            marker.name,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=directory,
        )
        try:
            metadata = os.fstat(descriptor)
            payload = os.read(descriptor, 192)
            if os.read(descriptor, 1):
                raise RuntimeError("oversized commit marker")
        finally:
            os.close(descriptor)
        named = os.stat(marker.name, dir_fd=directory, follow_symlinks=False)
        if (metadata.st_dev, metadata.st_ino) != (named.st_dev, named.st_ino):
            raise RuntimeError("commit marker inode changed")
        return metadata, payload
    try:
        metadata, payload = read_once()
    except FileNotFoundError:
        # Persist and recheck the exact absence before declaring the activation
        # uncommitted.  A missing/previous marker is the only rollback proof;
        # any fsync/stat I/O uncertainty remains status 1 (fail isolated).
        os.fsync(directory)
        try:
            read_once()
        except FileNotFoundError:
            raise SystemExit(2)
        raise RuntimeError("commit marker appeared during absence promotion")
    os.fsync(directory)
    reopened, repeated = read_once()
    if ((reopened.st_dev, reopened.st_ino) != (metadata.st_dev, metadata.st_ino)
            or repeated != payload):
        raise RuntimeError("commit marker changed during durability promotion")
finally:
    os.close(directory)

if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0
        or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_nlink != 1 or metadata.st_dev != root_meta.st_dev
        or not re.fullmatch(
            rb"[1-9][0-9]{0,18} [0-9a-f]{64} [0-9a-f]{64}\n", payload
        )):
    raise SystemExit(1)
marker_generation, marker_release_id, marker_nonce = (
    payload.decode("ascii").strip().split(" ")
)
if marker_generation == generation:
    if expected_release_id and (
            marker_release_id != expected_release_id
            or marker_nonce != expected_nonce):
        raise SystemExit(1)
    raise SystemExit(0)
if marker_generation == previous:
    raise SystemExit(2)
raise SystemExit(1)
PY
}

