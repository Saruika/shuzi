def compile_location_regex(modifier: str, pattern: str, label: str) -> re.Pattern[str]:
    flags = re.IGNORECASE if modifier == "~*" else 0
    try:
        return re.compile(pattern, flags)
    except re.error as error:
        raise InstallError(f"{label} contains an unsupported location regex") from error


def parse_snippet(content: bytes, label: str) -> tuple[Directive, ...]:
    try:
        text = content.decode("utf-8")
    except UnicodeDecodeError as error:
        raise InstallError(f"{label} is not valid UTF-8") from error
    if "\x00" in text:
        raise InstallError(f"{label} contains a NUL byte")
    document = parse(text, label)
    reject_nested_locations(document, label)
    if any(item.name.lower() == "include" for item in all_directives(document)):
        raise InstallError(f"{label} must not contain another include")
    return document


def directive_signature(directive: Directive) -> tuple[object, ...]:
    """Return the semantic AST used to pin reviewed fixed snippets."""

    return (
        directive.name,
        directive.args,
        None
        if directive.children is None
        else tuple(directive_signature(child) for child in directive.children),
    )


