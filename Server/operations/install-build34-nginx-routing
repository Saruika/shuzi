    active_content: bytes,
    snippet_state: FileState,
    expected_direct_old_sha256: str | None,
    expected_snippet_old_sha256: str | None,
    *,
    apply: bool,
    source: str,
) -> AccountApiRewrite:
    try:
        active_text = active_content.decode("utf-8")
    except UnicodeDecodeError as error:
        raise InstallError(f"{source} is not valid UTF-8") from error
    active_document = parse(active_text, source)
    www = unique_tls_server(active_document, WWW_HOST)

    all_account_includes = [
        node
        for node in all_directives(active_document)
        if node.name.lower() == "include" and node.args == (ACCOUNT_API_INCLUDE,)
    ]
    direct_account_includes = [
        node
        for node in direct(www, "include")
        if node.args == (ACCOUNT_API_INCLUDE,)
    ]
    all_active_locations = account_api_locations(active_document)
    direct_active_locations = [
        node for node in (www.children or ()) if account_api_location_like(node)
    ]
    if len(all_active_locations) != len(direct_active_locations):
        raise InstallError("account API location must be a direct child of the www TLS block")

    direct_topology = (
        len(direct_active_locations) == 1
        and not all_account_includes
    )
    snippet_topology = (
        not direct_active_locations
        and len(all_account_includes) == 1
        and len(direct_account_includes) == 1
    )
    if direct_topology == snippet_topology:
        raise InstallError(
            "account API routing must use exactly one direct block or one reviewed snippet include"
        )

    if direct_topology:
        node = direct_active_locations[0]
        reject_nested_locations((node,), "direct account API block")
        if any(
            item.name.lower() == "include" for item in [node, *descendants(node)]
        ):
            raise InstallError("direct account API block must not contain another include")
        parsed = location_path(node)
        if node.args not in ((ACCOUNT_API_PATH,), ("^~", ACCOUNT_API_PATH)):
            raise InstallError("direct account API location is malformed")
        reject_internal_redirect_controls((node,), "direct account API block")
        old_hash = (
            sha256(active_text[node.start : node.end].encode("utf-8"))
            if parsed[0] == "^~"
            else None
        )
        validate_old_block_expectation(
            old_hash,
            expected_direct_old_sha256,
            "direct account API old block",
            apply,
        )
        validate_old_block_expectation(
            None,
            expected_snippet_old_sha256,
            "snippet account API old block",
            apply,
        )
        if old_hash is None:
            return AccountApiRewrite(
                active_content,
                None,
                "direct",
                "direct-already-current",
                None,
                None,
            )
        candidate_text = remove_caret_location_modifier(active_text, node, source)
        candidate = candidate_text.encode("utf-8")
        verified = rewrite_account_api_routes(
            candidate,
            snippet_state,
            "absent",
            "absent",
            apply=True,
            source=source,
        )
        if verified.state != "direct-already-current":
            raise InstallError("direct account API candidate verification failed")
        return AccountApiRewrite(
            candidate,
            None,
            "direct",
            "direct-rewrite-required",
            old_hash,
            None,
        )

    if snippet_state.kind != "file":
        raise InstallError("included account API snippet must be a regular file")
    try:
        snippet_text = snippet_state.data.decode("utf-8")
    except UnicodeDecodeError as error:
        raise InstallError("account API snippet is not valid UTF-8") from error
    snippet_document = parse(snippet_text, ACCOUNT_API_INCLUDE)
    reject_nested_locations(snippet_document, "account API snippet")
    if any(
        item.name.lower() == "include" for item in all_directives(snippet_document)
    ):
        raise InstallError("account API snippet must not contain another include")
    snippet_locations = account_api_locations(snippet_document)
    if (
        len(snippet_document) != 1
        or len(snippet_locations) != 1
        or snippet_document[0] is not snippet_locations[0]
    ):
        raise InstallError("account API snippet must contain exactly one top-level API location")
    snippet_node = snippet_locations[0]
    parsed = location_path(snippet_node)
    if snippet_node.args not in ((ACCOUNT_API_PATH,), ("^~", ACCOUNT_API_PATH)):
        raise InstallError("account API snippet location is malformed")
    validate_account_snippet_controls(snippet_node, "account API snippet")
    old_hash = (
        sha256(snippet_text[snippet_node.start : snippet_node.end].encode("utf-8"))
        if parsed[0] == "^~"
        else None
    )
    validate_old_block_expectation(
        None,
        expected_direct_old_sha256,
        "direct account API old block",
        apply,
    )
    validate_old_block_expectation(
        old_hash,
        expected_snippet_old_sha256,
        "snippet account API old block",
        apply,
    )
    if old_hash is None:
        validate_location_security(
            snippet_document,
            "account API snippet",
            allow_reviewed_account_if=True,
        )
        return AccountApiRewrite(
            active_content,
            snippet_state.data,
            "snippet",
            "snippet-already-current",
            None,
            None,
        )
    candidate_text = remove_caret_location_modifier(
        snippet_text, snippet_node, ACCOUNT_API_INCLUDE
    )
    candidate_bytes = candidate_text.encode("utf-8")
    candidate_state = FileState(
        "file",
        candidate_bytes,
        snippet_state.mode,
        snippet_state.uid,
        snippet_state.gid,
        nlink=snippet_state.nlink,
    )
    verified = rewrite_account_api_routes(
        active_content,
        candidate_state,
        "absent",
        "absent",
        apply=True,
        source=source,
    )
    if verified.state != "snippet-already-current":
        raise InstallError("snippet account API candidate verification failed")
    return AccountApiRewrite(
        active_content,
        candidate_bytes,
        "snippet",
        "snippet-rewrite-required",
        None,
        old_hash,
    )


def validate_candidate_server(
    node: Directive,
    sensitive: Directive,
    legacy: Directive,
    hostname: str,
    *,
    includes_expanded: bool = False,
) -> None:
    reject_nested_locations((node,), hostname)
    roots = direct(node, "root")
    all_roots = [
        item
        for item in [node, *descendants(node)]
        if item.name.lower() == "root"
    ]
    if len(roots) != 1 or len(all_roots) != 1 or roots[0].args != (SITE_ROOT,):
        raise InstallError(
            f"{hostname} must have exactly one direct fixed root {SITE_ROOT} "
            "and no nested override"
        )
    children = list(node.children or ())
    sensitive_index = children.index(sensitive)
    legacy_index = children.index(legacy)
    if sensitive_index >= legacy_index:
        raise InstallError(f"{hostname} sensitive include must precede legacy include")
    locations = [
        index for index, child in enumerate(children) if child.name.lower() == "location"
    ]
    if locations and legacy_index >= min(locations):
        raise InstallError(f"{hostname} security includes must precede every location")
    validate_application_regex_order(node, hostname)
    redirect_controls = {
        "error_page",
        "if",
        "internal_redirect",
        "recursive_error_pages",
        "return",
        "rewrite",
        "try_files",
    }
    for child in node.children or ():
        if child.name.lower() in redirect_controls:
            raise InstallError(
                f"{hostname} has a server-scope redirect mechanism that can bypass deny 404"
            )
    forbidden_any_scope = {
        "error_page",
        "if",
        "internal_redirect",
        "recursive_error_pages",
        "rewrite",
    }
    for item in descendants(node):
        if item.name.lower() in forbidden_any_scope:
            raise InstallError(
                f"{hostname} has an internal redirect mechanism that can bypass deny 404"
            )
    for item in descendants(node):
        parsed = location_path(item)
        if parsed is None:
            continue
        modifier, path = parsed
        if modifier == "" and path.startswith("@"):
            raise InstallError(
                f"{hostname} has a named location that can receive an internal redirect"
            )
        if modifier == "^~":
            raise InstallError(
                f"{hostname} has a ^~ location that bypasses security regex rules"
            )
        if modifier == "=" and exact_location_is_sensitive(path):
            raise InstallError(
                f"{hostname} has an exact location that bypasses sensitive-file rules"
            )
        if is_images_location(modifier, path):
            raise InstallError(
                f"{hostname} contains an inline /images location after transformation"
            )
        if modifier in ("~", "~*"):
            validate_allowed_regex_location(
                hostname,
                item,
                modifier,
                path,
                php_includes_expanded=includes_expanded,
            )


def validate_application_regex_order(node: Directive, hostname: str) -> None:
    indexes: dict[tuple[str, str], list[int]] = {}
    for index, item in enumerate(node.children or ()):
        parsed = location_path(item)
        if parsed is None or parsed[0] not in ("~", "~*"):
            continue
        indexes.setdefault(parsed, []).append(index)

    for key in ALLOWED_REGEX_PROFILES[hostname]:
        if len(indexes.get(key, ())) > 1:
            raise InstallError(
                f"{hostname} repeats a reviewed application regex location"
            )
    missing = [
        key
        for key in REQUIRED_SECURITY_REGEX_PROFILES[hostname]
        if len(indexes.get(key, ())) != 1
    ]
    if missing:
        raise InstallError(
            f"{hostname} is missing a required application security regex location"
        )
    for earlier, later in REGEX_ORDER_CONTRACT[hostname]:
        earlier_indexes = indexes.get(earlier, ())
        later_indexes = indexes.get(later, ())
        if earlier_indexes and later_indexes and earlier_indexes[0] >= later_indexes[0]:
            raise InstallError(
                f"{hostname} application security regex order is unsafe"
            )


def validate_php_limit_req_contract(location: Directive, hostname: str) -> None:
    """Allow the production login throttle without widening PHP execution."""

    all_limit_requests = [
        item
        for item in descendants(location)
        if item.name.lower() == "limit_req"
    ]
    if not all_limit_requests:
        return
    direct_limit_requests = direct(location, "limit_req")
    if location.args != WP_LOGIN_LOCATION_ARGS:
        raise InstallError(
            f"{hostname} limit_req is allowed only in the exact /wp-login.php location"
        )
    if (
        len(all_limit_requests) != 1
        or all_limit_requests != direct_limit_requests
        or all_limit_requests[0].children is not None
        or all_limit_requests[0].args != WP_LOGIN_LIMIT_REQ_ARGS
    ):
        raise InstallError(
            f"{hostname} exact /wp-login.php limit_req parameters drifted"
        )


def validate_fastcgi_handler(location: Directive, hostname: str) -> None:
    children = tuple(location.children or ())
    passes = [item for item in children if item.name.lower() == "fastcgi_pass"]
    if (
        len(passes) != 1
        or passes[0].children is not None
        or passes[0].args != ("unix:/var/run/php/php8.3-fpm.sock",)
    ):
        raise InstallError(f"{hostname} PHP handler must use the reviewed FPM socket")
    markers = [
        Path(item.args[0])
        for item in children
        if item.name.lower() == EXPANDED_INCLUDE_MARKER and len(item.args) == 1
    ]
    if markers != [FASTCGI_PHP_INCLUDE, FASTCGI_BASE_INCLUDE]:
        raise InstallError(
            f"{hostname} PHP handler must use the reviewed fastcgi-php.conf to fastcgi.conf chain"
        )
    validate_php_limit_req_contract(location, hostname)
    allowed = {
        EXPANDED_INCLUDE_MARKER,
        "fastcgi_cache",
        "fastcgi_cache_background_update",
        "fastcgi_cache_bypass",
        "fastcgi_cache_key",
        "fastcgi_cache_lock",
        "fastcgi_cache_lock_timeout",
        "fastcgi_cache_methods",
        "fastcgi_cache_use_stale",
        "fastcgi_cache_valid",
        "fastcgi_hide_header",
        "fastcgi_index",
        "fastcgi_no_cache",
        "fastcgi_param",
        "fastcgi_pass",
        "fastcgi_split_path_info",
        "limit_req",
        "set",
        "try_files",
    }
    if any(item.name.lower() not in allowed for item in children):
        raise InstallError(f"{hostname} PHP handler contains an unreviewed directive")
    params = [item for item in children if item.name.lower() == "fastcgi_param"]
    by_name: dict[str, list[Directive]] = {}
    for item in params:
        if item.children is not None or len(item.args) < 2:
            raise InstallError(f"{hostname} PHP handler has a malformed fastcgi_param")
        name = item.args[0].upper()
        if name not in FASTCGI_ALLOWED_PARAMS:
            raise InstallError(f"{hostname} PHP handler sets an unreviewed FastCGI parameter")
        by_name.setdefault(name, []).append(item)
    duplicates = [name for name, items in by_name.items() if len(items) != 1]
    if duplicates:
        raise InstallError(
            f"{hostname} PHP handler has duplicate FastCGI parameters: {', '.join(duplicates)}"
        )
    required_params = {
        "SCRIPT_FILENAME": ("$document_root$fastcgi_script_name",),
        "DOCUMENT_ROOT": ("$document_root",),
        "SCRIPT_NAME": ("$fastcgi_script_name",),
        "PATH_INFO": ("$path_info",),
    }
    for name, expected in required_params.items():
        matches = by_name.get(name, [])
        if len(matches) != 1 or matches[0].args[1:] != expected:
            raise InstallError(
                f"{hostname} PHP handler {name} is not the reviewed execution target"
            )
    if "PATH_TRANSLATED" in by_name:
        raise InstallError(f"{hostname} PHP handler must not set PATH_TRANSLATED")
    try_files = [item for item in children if item.name.lower() == "try_files"]
    if len(try_files) != 1 or try_files[0].args != (
        "$fastcgi_script_name",
        "=404",
    ):
        raise InstallError(f"{hostname} PHP handler try_files is not reviewed")


def validate_allowed_regex_location(
    hostname: str,
    location: Directive,
    modifier: str,
    pattern: str,
    *,
    label: str | None = None,
    php_includes_expanded: bool = True,
) -> None:
    """Validate the exact regex header and body profile approved in production."""

    context = label or hostname
    profile = ALLOWED_REGEX_PROFILES[hostname].get((modifier, pattern))
    if profile is None:
        raise InstallError(
            f"{context} contains a regex location outside the reviewed allowlist"
        )

    def body_signature(*, omit_expansion_markers: bool = False):
        return tuple(
            (item.name.lower(), item.args, item.children is None)
            for item in (location.children or ())
            if not (
                omit_expansion_markers
                and item.name.lower() == EXPANDED_INCLUDE_MARKER
            )
        )

    if profile == "root-try-files":
        observed = body_signature()
        expected = ROOT_TRY_FILES_BODY_SIGNATURES[(hostname, modifier, pattern)]
        observed_try_files = [
            args for name, args, leaf in observed if name == "try_files" and leaf
        ]
        if observed_try_files and observed_try_files != [("$uri", "=404")]:
            raise InstallError(f"{context} reviewed static regex must fail closed")
        if observed != expected:
            raise InstallError(f"{context} reviewed static regex handler drifted")
        return

    if profile == "www-php":
        # The first rewrite pass intentionally preserves raw include
        # directives.  The mandatory expanded-include pass below validates the
        # exact Debian FastCGI chain and body before any write can occur.
        if not php_includes_expanded:
            return
        validate_fastcgi_handler(location, hostname)
        if body_signature(omit_expansion_markers=True) != WWW_PHP_REGEX_BODY_SIGNATURE:
            raise InstallError(f"{context} reviewed PHP regex body drifted")
        return

    if profile in ("deny-404", "health-204"):
        expected_code = "404" if profile == "deny-404" else "204"
        if body_signature() != (("return", (expected_code,), True),):
            raise InstallError(f"{context} reviewed return-only regex handler drifted")
        return

    if profile == "deny-all":
        if body_signature() != (("deny", ("all",), True),):
            raise InstallError(f"{context} reviewed dotfile regex handler drifted")
        return

    raise InstallError(f"{context} has an unknown regex review profile")


def validate_expanded_include_context(node: Directive, hostname: str) -> None:
    children = tuple(node.children or ())
    server_markers = [
        item for item in children if item.name.lower() == EXPANDED_INCLUDE_MARKER
    ]
    if any(item.args != (str(SECURITY_INCLUDE),) for item in server_markers):
        raise InstallError(f"{hostname} has an unreviewed server-scope include")
    if len(server_markers) > 1:
        raise InstallError(f"{hostname} includes the security-header profile more than once")

    accounted = set(server_markers)
    for location in direct(node, "location"):
        markers = [
            item
            for item in (location.children or ())
            if item.name.lower() == EXPANDED_INCLUDE_MARKER
        ]
        passes = [
            item
            for item in (location.children or ())
            if item.name.lower() == "fastcgi_pass"
        ]
        if markers or passes:
            validate_fastcgi_handler(location, hostname)
        accounted.update(markers)
    all_markers = {
        item
        for item in descendants(node)
        if item.name.lower() == EXPANDED_INCLUDE_MARKER
    }
    if all_markers != accounted:
        raise InstallError(f"{hostname} has an include in an unreviewed Nginx scope")


def validate_candidate_with_includes(
    content: bytes,
    filesystem: Filesystem,
    source: Path,
    sensitive: bytes,
    legacy: bytes,
    account_api: bytes | None,
) -> dict[Path, FileState]:
    try:
        text = content.decode("utf-8")
    except UnicodeDecodeError as error:
        raise InstallError(f"candidate config is not valid UTF-8: {source}") from error
    document = parse(text, str(source))
    overlays = {
        Path(SENSITIVE_INCLUDE): sensitive,
        Path(LEGACY_INCLUDE): legacy,
    }
    if account_api is not None:
        overlays[Path(ACCOUNT_API_INCLUDE)] = account_api
    expansion = IncludeExpansion(filesystem, overlays, source)
    for hostname in (WWW_HOST, IMG_HOST):
        raw = unique_tls_server(document, hostname)
        expanded = expansion.expand_server(raw)
        sensitive_include = require_direct_include(expanded, SENSITIVE_INCLUDE, hostname)
        legacy_include = require_direct_include(expanded, LEGACY_INCLUDE, hostname)
        validate_candidate_server(
            expanded,
            sensitive_include,
            legacy_include,
            hostname,
            includes_expanded=True,
        )
        validate_expanded_include_context(expanded, hostname)
    return expansion.states


def require_security_order(node: Directive, sensitive: Directive, hostname: str) -> None:
    children = list(node.children or ())
    sensitive_index = children.index(sensitive)
    location_indexes = [
        index for index, child in enumerate(children) if child.name.lower() == "location"
    ]
    if location_indexes and sensitive_index >= min(location_indexes):
        raise InstallError(f"{hostname} sensitive include must precede every location")


def directive_full_line_span(text: str, node: Directive, source: str) -> tuple[int, int]:
    start = text.rfind("\n", 0, node.start) + 1
    if text[start : node.start].strip():
        raise InstallError(f"{source}: regex location must begin on its own line")
    newline = text.find("\n", node.end)
    line_end = len(text) if newline == -1 else newline
    trailer = text[node.end : line_end].strip()
    if trailer and not trailer.startswith("#"):
        raise InstallError(f"{source}: regex location has an unsafe line trailer")
    return start, (len(text) if newline == -1 else newline + 1)


def rewrite_application_regex_order(
    content: bytes, source: str
) -> tuple[bytes, bool]:
    try:
        text = content.decode("utf-8")
    except UnicodeDecodeError as error:
        raise InstallError(f"{source} is not valid UTF-8") from error
    changed = False

    for _ in range(16):
        document = parse(text, source)
        move: tuple[Directive, Directive] | None = None
        for hostname in (WWW_HOST, IMG_HOST):
            node = unique_tls_server(document, hostname)
            matches: dict[tuple[str, str], list[tuple[int, Directive]]] = {}
            for index, item in enumerate(node.children or ()):
                parsed = location_path(item)
                if parsed is None or parsed[0] not in ("~", "~*"):
                    continue
                matches.setdefault(parsed, []).append((index, item))
            for key in ALLOWED_REGEX_PROFILES[hostname]:
                if len(matches.get(key, ())) > 1:
                    raise InstallError(
                        f"{hostname} repeats a reviewed application regex location"
                    )
            for earlier, later in REGEX_ORDER_CONTRACT[hostname]:
                earlier_matches = matches.get(earlier, ())
                later_matches = matches.get(later, ())
                if (
                    earlier_matches
                    and later_matches
                    and earlier_matches[0][0] >= later_matches[0][0]
                ):
                    move = (earlier_matches[0][1], later_matches[0][1])
                    break
            if move is not None:
                break
        if move is None:
            return text.encode("utf-8"), changed

        moving, target = move
        moving_start, moving_end = directive_full_line_span(text, moving, source)
        target_start, _ = directive_full_line_span(text, target, source)
        if moving_start <= target_start:
            raise InstallError(f"{source}: internal regex ordering rewrite is invalid")
        rendered = text[moving_start:moving_end]
        text = (
            text[:target_start]
            + rendered
            + text[target_start:moving_start]
            + text[moving_end:]
        )
        changed = True

    raise InstallError(f"{source}: application regex ordering did not converge")


def rewrite_active_config(
    content: bytes,
    expected_old_location_sha256: str | None,
    source: str = "active config",
) -> RewriteResult:
    ordered_content, order_changed = rewrite_application_regex_order(content, source)
    if order_changed:
        verified = rewrite_active_config(
            ordered_content, expected_old_location_sha256, source
        )
        return RewriteResult(
            verified.content,
            "rewrite-required",
            verified.old_location_sha256,
        )

    try:
        text = content.decode("utf-8")
    except UnicodeDecodeError as error:
        raise InstallError(f"{source} is not valid UTF-8") from error
    if "\x00" in text:
        raise InstallError(f"{source} contains a NUL byte")

    document = parse(text, source)
    www = unique_tls_server(document, WWW_HOST)
    img = unique_tls_server(document, IMG_HOST)
    if www is img:
        raise InstallError("www and img must use distinct TLS server blocks")

    www_sensitive = require_direct_include(www, SENSITIVE_INCLUDE, WWW_HOST)
    img_sensitive = require_direct_include(img, SENSITIVE_INCLUDE, IMG_HOST)
    require_security_order(www, www_sensitive, WWW_HOST)
    require_security_order(img, img_sensitive, IMG_HOST)

    www_legacy = matching_include(www, LEGACY_INCLUDE)
    img_legacy = matching_include(img, LEGACY_INCLUDE)
    old_images = images_location(img)
    all_legacy = [
        item
        for node in document
        for item in ([node, *descendants(node)])
        if item.name.lower() == "include" and item.args == (LEGACY_INCLUDE,)
    ]
    all_old_images = [
        item
        for node in document
        for item in ([node, *descendants(node)])
        if item.name.lower() == "location" and item.args == ("^~", "/images/")
    ]

    desired_state = len(www_legacy) == 1 and len(img_legacy) == 1
    old_state = not www_legacy and not img_legacy
    if desired_state:
        www_direct = [
            item for item in direct(www, "include") if item.args == (LEGACY_INCLUDE,)
        ]
        img_direct = [
            item for item in direct(img, "include") if item.args == (LEGACY_INCLUDE,)
        ]
        if (
            len(all_legacy) != 2
            or len(www_direct) != 1
            or len(img_direct) != 1
            or all_old_images
        ):
            raise InstallError("active config has a partial or nested Build 34 routing state")
        for node, sensitive, legacy, hostname in (
            (www, www_sensitive, www_direct[0], WWW_HOST),
            (img, img_sensitive, img_direct[0], IMG_HOST),
        ):
            children = list(node.children or ())
            sensitive_index = children.index(sensitive)
            legacy_index = children.index(legacy)
            if hostname == WWW_HOST and legacy_index != sensitive_index + 1:
                raise InstallError(f"{hostname} legacy include is not immediately after sensitive")
            validate_candidate_server(node, sensitive, legacy, hostname)
        return RewriteResult(content, "already-current", None)

    if not old_state:
        raise InstallError("active config has a partial Build 34 routing state")
    if len(old_images) != 1 or len(all_old_images) != 1:
        raise InstallError("img TLS block must contain exactly one old location ^~ /images/")
    old_location = old_images[0]
    old_location_bytes = text[old_location.start : old_location.end].encode("utf-8")
    observed_old_hash = sha256(old_location_bytes)
    if (
        expected_old_location_sha256 is not None
        and observed_old_hash != expected_old_location_sha256
    ):
        raise InstallError(
            "old /images/ location drifted: "
            f"expected {expected_old_location_sha256}, observed {observed_old_hash}"
        )

    img_children = list(img.children or ())
    old_index = img_children.index(old_location)
    img_sensitive_index = img_children.index(img_sensitive)
    first_location_index = min(
        index
        for index, child in enumerate(img_children)
        if child.name.lower() == "location"
    )
    if old_index != first_location_index or img_sensitive_index >= old_index:
        raise InstallError(
            "old img /images/ block must be the first location after the sensitive include"
        )

    www_indent = line_indentation(text, www_sensitive.start, source)
    line_indentation(text, old_location.start, source)
    insert_at, inserted_include = insertion_after_directive_line(
        text, www_sensitive, www_indent, source
    )
    edits = [
        (
            insert_at,
            insert_at,
            inserted_include,
        ),
        (
            old_location.start,
            old_location.end,
            f"include {LEGACY_INCLUDE};",
        ),
    ]
    rewritten = text
    for start, end, replacement in sorted(edits, reverse=True):
        rewritten = rewritten[:start] + replacement + rewritten[end:]

    # Parse the exact candidate again and require the idempotent branch to
    # accept it.  This also catches offset/whitespace mistakes in the rewrite.
    candidate = rewritten.encode("utf-8")
    verified = rewrite_active_config(candidate, expected_old_location_sha256, source)
    if verified.state != "already-current" or verified.content != candidate:
        raise InstallError("internal candidate verification failed")
    return RewriteResult(candidate, "rewrite-required", observed_old_hash)


class RealFilesystem:
    def require_secure_directory(self, path: Path, owner_uid: int, label: str) -> None:
        try:
            metadata = path.lstat()
        except FileNotFoundError as error:
            raise InstallError(f"{label} is missing: {path}") from error
        if not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
            raise InstallError(f"{label} must be a real directory: {path}")
        if metadata.st_uid != owner_uid or stat.S_IMODE(metadata.st_mode) & 0o022:
            raise InstallError(f"{label} has unsafe ownership or permissions: {path}")

    @staticmethod
    def require_root_only_directory(path: Path, label: str) -> None:
        try:
            metadata = path.lstat()
        except FileNotFoundError as error:
            raise InstallError(f"{label} is missing: {path}") from error
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o700
        ):
            raise InstallError(f"{label} must be a root:root mode 0700 directory: {path}")

    def snapshot(self, path: Path, allow_absent: bool = False) -> FileState:
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            if allow_absent:
                return FileState("absent")
            raise InstallError(f"required path is missing: {path}")
        if stat.S_ISLNK(metadata.st_mode):
            return FileState(
                "symlink",
                mode=stat.S_IMODE(metadata.st_mode),
                uid=metadata.st_uid,
                gid=metadata.st_gid,
                target=os.readlink(path),
                nlink=metadata.st_nlink,
            )
        if not stat.S_ISREG(metadata.st_mode):
            raise InstallError(f"path must be a regular file or reviewed symlink: {path}")
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(path, flags)
        try:
            opened = os.fstat(descriptor)
            chunks: list[bytes] = []
            while True:
                chunk = os.read(descriptor, 1024 * 1024)
                if not chunk:
                    break
                chunks.append(chunk)
            closed = os.fstat(descriptor)
        finally:
            os.close(descriptor)
        if (
            opened.st_dev,
            opened.st_ino,
            opened.st_size,
            opened.st_mtime_ns,
        ) != (
            closed.st_dev,
            closed.st_ino,
            closed.st_size,
            closed.st_mtime_ns,
        ):
            raise InstallError(f"file changed while it was being read: {path}")
        return FileState(
            "file",
            b"".join(chunks),
            stat.S_IMODE(opened.st_mode),
            opened.st_uid,
            opened.st_gid,
            nlink=opened.st_nlink,
        )

    @staticmethod
    def _temporary(path: Path, suffix: str) -> Path:
        return path.parent / f".{path.name}.{suffix}.{os.getpid()}.{secrets.token_hex(8)}"

    @staticmethod
    def _sync_directory(path: Path) -> None:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)

    def atomic_write(self, path: Path, data: bytes, mode: int, uid: int, gid: int) -> None:
        temporary = self._temporary(path, "new")
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        try:
            view = memoryview(data)
            while view:
                written = os.write(descriptor, view)
                if written <= 0:
                    raise InstallError(f"short write while creating {path}")
                view = view[written:]
            os.fsync(descriptor)
            os.fchmod(descriptor, mode)
            os.fchown(descriptor, uid, gid)
            os.fsync(descriptor)
        except BaseException:
            os.close(descriptor)
            temporary.unlink(missing_ok=True)
            raise
        else:
            os.close(descriptor)
        try:
            os.replace(temporary, path)
            self._sync_directory(path.parent)
        finally:
            temporary.unlink(missing_ok=True)

    def atomic_symlink(self, path: Path, target: str, uid: int, gid: int) -> None:
        temporary = self._temporary(path, "link")
        os.symlink(target, temporary)
        try:
            os.lchown(temporary, uid, gid)
            os.replace(temporary, path)
            self._sync_directory(path.parent)
        finally:
            temporary.unlink(missing_ok=True)

    def restore(self, path: Path, state: FileState) -> None:
        if state.kind == "file":
            self.atomic_write(path, state.data, state.mode, state.uid, state.gid)
        elif state.kind == "symlink":
            self.atomic_symlink(path, state.target, state.uid, state.gid)
        elif state.kind == "absent":
            try:
                path.unlink()
            except FileNotFoundError:
                return
            self._sync_directory(path.parent)
        else:
            raise InstallError(f"cannot restore unknown state for {path}")

    def create_backup(self, path: Path, states: dict[str, FileState]) -> None:
        parent = path.parent
        if not parent.exists():
            grandparent = parent.parent
            self.require_secure_directory(grandparent, 0, "backup grandparent")
            os.mkdir(parent, 0o700)
            os.chown(parent, 0, 0)
            self._sync_directory(grandparent)
        self.require_root_only_directory(parent, "backup root")
        try:
            os.mkdir(path, 0o700)
        except FileExistsError as error:
            raise InstallError(f"backup transaction already exists: {path}") from error
        os.chown(path, 0, 0)
        self.require_root_only_directory(path, "backup transaction")
        self._sync_directory(parent)
        manifest: dict[str, dict[str, object]] = {}
        for label, state in states.items():
            manifest[label] = {
                "kind": state.kind,
                "mode": state.mode,
                "uid": state.uid,
                "gid": state.gid,
                "target": state.target,
                "nlink": state.nlink,
                "sha256": sha256(state.data) if state.kind == "file" else None,
            }
            if state.kind == "file":
                self.atomic_write(path / f"{label}.file", state.data, 0o600, 0, 0)
            elif state.kind == "symlink":
                self.atomic_write(
                    path / f"{label}.symlink-target",
                    (state.target + "\n").encode("utf-8"),
                    0o600,
                    0,
                    0,
                )
            else:
                self.atomic_write(path / f"{label}.absent", b"\n", 0o600, 0, 0)
        manifest_data = (json.dumps(manifest, sort_keys=True, indent=2) + "\n").encode()
        self.atomic_write(path / "manifest.json", manifest_data, 0o600, 0, 0)
        self._sync_directory(path)
        self._sync_directory(parent)

    def resolve(self, path: Path) -> Path:
        return path.resolve(strict=True)

    @contextlib.contextmanager
    def lock(self, path: Path):
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as error:
                raise InstallError("another Build 34 Nginx installation is running") from error
            yield
        finally:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_UN)
            finally:
                os.close(descriptor)

    def enabled_documents(self, path: Path) -> dict[Path, bytes]:
        result: dict[Path, bytes] = {}
        try:
            entries = sorted(path.iterdir(), key=lambda item: item.name)
        except OSError as error:
            raise InstallError(f"cannot inventory sites-enabled: {path}") from error
        for entry in entries:
            try:
                metadata = entry.lstat()
            except FileNotFoundError:
                continue
            if stat.S_ISDIR(metadata.st_mode):
                raise InstallError(f"unexpected directory in sites-enabled: {entry}")
            state = self.snapshot(entry, allow_absent=True)
            if state.kind == "absent":
                continue
            if state.kind == "symlink":
                if state.uid != 0 or state.gid != 0 or state.nlink != 1:
                    raise InstallError(
                        f"enabled Nginx symlink must be root:root with one link: {entry}"
                    )
                sites_available = path.parent / "sites-available"
                direct_target = lexical_symlink_target(entry, state)
                if direct_target.parent != sites_available:
                    raise InstallError(
                        f"enabled Nginx symlink target is outside sites-available: {entry}"
                    )
                self.require_secure_directory(
                    sites_available, 0, "sites-available symlink target directory"
                )
                state = self.snapshot(direct_target)
                require_root_config(state, direct_target, "enabled Nginx symlink target")
            else:
                require_root_config(state, entry, "enabled Nginx config")
            result[entry] = state.data
        return result

    def secure_include_matches(
        self, raw_path: str, nginx_root: Path
    ) -> dict[Path, FileState]:
        if "$" in raw_path or "\x00" in raw_path or "\\" in raw_path:
            raise InstallError("dynamic or escaped Nginx include path is not allowed")
        candidate = Path(raw_path)
        if not candidate.is_absolute():
            candidate = nginx_root / candidate
        candidate = Path(os.path.abspath(candidate))

        def within_root(path: Path) -> bool:
            return path == nginx_root or nginx_root in path.parents

        if not within_root(candidate):
            raise InstallError("Nginx include escapes the reviewed root")
        matches: set[Path] = set()
        for match in glob.iglob(str(candidate)):
            matches.add(Path(match))
            if len(matches) > 256:
                raise InstallError("Nginx include glob exceeds the reviewed file limit")
        if not matches:
            raise InstallError(f"Nginx include matched no files: {raw_path}")

        result: dict[Path, FileState] = {}
        checked_directories: set[Path] = set()
        for match in sorted(matches):
            normalized = Path(os.path.abspath(match))
            if not within_root(normalized):
                raise InstallError(f"included Nginx file escapes reviewed root: {match}")
            parent = normalized.parent
            while True:
                if parent not in checked_directories:
                    self.require_secure_directory(parent, 0, "included config directory")
                    checked_directories.add(parent)
                if parent == nginx_root:
                    break
                if parent == parent.parent or not within_root(parent):
                    raise InstallError(
                        f"included Nginx path escapes reviewed root: {match}"
                    )
                parent = parent.parent
            state = self.snapshot(normalized)
            require_root_config(state, normalized, "included Nginx file")
            result[normalized] = state
        return result


class SubprocessRunner:
    def run(self, command: Sequence[str]) -> None:
        completed = subprocess.run(
            list(command),
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C", "LC_ALL": "C"},
        )
        if completed.returncode != 0:
            detail = completed.stderr.strip().splitlines()
            suffix = f": {detail[-1]}" if detail else ""
            raise InstallError(f"command failed ({' '.join(command)}){suffix}")


def require_root_owned_file(state: FileState, path: Path, label: str) -> None:
    if state.kind != "file":
        raise InstallError(f"{label} must be a regular non-symlink file: {path}")
    if state.uid != 0 or state.mode & 0o022 or state.nlink != 1:
        raise InstallError(f"{label} must be root-owned and not group/other writable: {path}")


def require_root_config(state: FileState, path: Path, label: str) -> None:
    require_root_owned_file(state, path, label)
    if state.gid != 0 or state.mode != 0o644:
        raise InstallError(f"{label} must be root:root mode 0644: {path}")


def lexical_symlink_target(path: Path, state: FileState) -> Path:
    if state.kind != "symlink":
        raise InstallError(f"expected a symlink state for {path}")
    target = Path(state.target)
    if not target.is_absolute():
        target = path.parent / target
    return Path(os.path.abspath(target))


def expected_state_hash(state: FileState, expected: str, label: str) -> None:
    if expected == "absent":
        if state.kind != "absent":
            raise InstallError(f"{label} drifted: expected absent")
        return
    expected = validate_sha256(expected, f"{label} expected SHA-256")
    if state.kind != "file":
        raise InstallError(f"{label} drifted: expected a regular file")
    observed = sha256(state.data)
    if observed != expected:
        raise InstallError(f"{label} drifted: expected {expected}, observed {observed}")


class Installer:
    def __init__(
        self,
        filesystem: Filesystem,
        runner: CommandRunner,
        *,
        owner_uid: int = 0,
        nginx_test: Sequence[str] = NGINX_TEST,
        nginx_reload: Sequence[str] = NGINX_RELOAD,
        nginx_active: Sequence[str] = NGINX_ACTIVE,
    ) -> None:
        self.fs = filesystem
        self.runner = runner
        self.owner_uid = owner_uid
        self.nginx_test = tuple(nginx_test)
        self.nginx_reload = tuple(nginx_reload)
        self.nginx_active = tuple(nginx_active)

    def install(
        self,
        *,
        active: Path,
        available: Path,
        sensitive_source: Path,
        legacy_source: Path,
        sensitive_target: Path,
        legacy_target: Path,
        account_api_target: Path,
        expected_active_sha256: str,
        expected_available_sha256: str,
        expected_sensitive_target: str,
        expected_legacy_target: str,
        expected_account_api_snippet: str,
        sensitive_source_sha256: str,
        legacy_source_sha256: str,
        expected_old_location_sha256: str | None,
        expected_old_direct_account_api_sha256: str | None,
        expected_old_snippet_account_api_sha256: str | None,
        backup_dir: Path,
        apply: bool,
    ) -> RewriteResult:
        for path, label in (
            (active, "active config"),
            (available, "sites-available config"),
            (sensitive_source, "sensitive snippet input"),
            (legacy_source, "legacy snippet input"),
            (sensitive_target, "sensitive snippet target"),
            (legacy_target, "legacy snippet target"),
            (account_api_target, "account API snippet target"),
            (backup_dir, "backup transaction"),
        ):
            if not path.is_absolute():
                raise InstallError(f"{label} path must be absolute")
        if len({active, available, sensitive_target, legacy_target, account_api_target}) != 5:
            raise InstallError("configuration and snippet target paths must be distinct")
        for directory, label in (
            (active.parent, "sites-enabled directory"),
            (available.parent, "sites-available directory"),
            (sensitive_target.parent, "snippet directory"),
        ):
            self.fs.require_secure_directory(directory, self.owner_uid, label)
        if legacy_target.parent != sensitive_target.parent:
            self.fs.require_secure_directory(
                legacy_target.parent, self.owner_uid, "legacy snippet directory"
            )
        if account_api_target.parent != sensitive_target.parent:
            self.fs.require_secure_directory(
                account_api_target.parent, self.owner_uid, "account API snippet directory"
            )

        active_state = self.fs.snapshot(active)
        available_state = self.fs.snapshot(available)
        sensitive_input = self.fs.snapshot(sensitive_source)
        legacy_input = self.fs.snapshot(legacy_source)
        sensitive_before = self.fs.snapshot(sensitive_target, allow_absent=True)
        legacy_before = self.fs.snapshot(legacy_target, allow_absent=True)
        account_api_before = self.fs.snapshot(account_api_target, allow_absent=True)

        require_root_config(available_state, available, "sites-available config")
        require_root_owned_file(sensitive_input, sensitive_source, "sensitive snippet input")
        require_root_owned_file(legacy_input, legacy_source, "legacy snippet input")
        for state, path, label in (
            (sensitive_before, sensitive_target, "sensitive snippet target"),
            (legacy_before, legacy_target, "legacy snippet target"),
            (account_api_before, account_api_target, "account API snippet target"),
        ):
            if state.kind != "absent":
                require_root_config(state, path, label)
        if active_state.kind == "file":
            require_root_config(active_state, active, "active config")
            active_data = active_state.data
        elif active_state.kind == "symlink":
            if active_state.uid != 0 or active_state.gid != 0 or active_state.nlink != 1:
                raise InstallError("active symlink must be root:root with one link")
            if lexical_symlink_target(active, active_state) != available:
                raise InstallError("active symlink does not directly target sites-available")
            if self.fs.resolve(active) != self.fs.resolve(available):
                raise InstallError("active symlink does not resolve to canonical sites-available")
            active_data = available_state.data
        else:
            raise InstallError("active config must be a regular file or canonical symlink")

        expected_active_sha256 = validate_sha256(
            expected_active_sha256, "active config expected SHA-256"
        )
        expected_available_sha256 = validate_sha256(
            expected_available_sha256, "sites-available expected SHA-256"
        )
        if sha256(active_data) != expected_active_sha256:
            raise InstallError(
                "active config drifted: "
                f"expected {expected_active_sha256}, observed {sha256(active_data)}"
            )
        expected_state_hash(
            available_state, expected_available_sha256, "sites-available config"
        )
        expected_state_hash(
            sensitive_before, expected_sensitive_target, "sensitive snippet target"
        )
        expected_state_hash(legacy_before, expected_legacy_target, "legacy snippet target")
        expected_state_hash(
            account_api_before,
            expected_account_api_snippet,
            "account API snippet target",
        )
        sensitive_source_sha256 = validate_sha256(
            sensitive_source_sha256, "sensitive snippet input SHA-256"
        )
        legacy_source_sha256 = validate_sha256(
            legacy_source_sha256, "legacy snippet input SHA-256"
        )
        if sha256(sensitive_input.data) != sensitive_source_sha256:
            raise InstallError("sensitive snippet input SHA-256 mismatch")
        if sha256(legacy_input.data) != legacy_source_sha256:
            raise InstallError("legacy snippet input SHA-256 mismatch")
        validate_fixed_snippet_candidates(sensitive_input.data, legacy_input.data)
        if expected_old_location_sha256 is not None:
            expected_old_location_sha256 = validate_sha256(
                expected_old_location_sha256, "old /images/ location SHA-256"
            )
        elif apply:
            raise InstallError(
                "--expected-old-images-location-sha256 is mandatory with --apply"
            )
        account_rewrite = rewrite_account_api_routes(
            active_data,
            account_api_before,
            expected_old_direct_account_api_sha256,
            expected_old_snippet_account_api_sha256,
            apply=apply,
            source=str(active),
        )
        base_rewrite = rewrite_active_config(
            account_rewrite.active_content, expected_old_location_sha256, str(active)
        )
        rewrite = RewriteResult(
            base_rewrite.content,
            base_rewrite.state,
            base_rewrite.old_location_sha256,
            account_rewrite.snippet_content,
            account_rewrite.state,
            account_rewrite.old_direct_sha256,
            account_rewrite.old_snippet_sha256,
        )
        candidate_account_state = (
            FileState(
                "file",
                account_rewrite.snippet_content,
                account_api_before.mode,
                account_api_before.uid,
                account_api_before.gid,
                nlink=account_api_before.nlink,
            )
            if account_rewrite.snippet_content is not None
            else account_api_before
        )
        rewrite_account_api_routes(
            rewrite.content,
            candidate_account_state,
            "absent",
            "absent",
            apply=True,
            source=str(active),
        )
        candidate_account_bytes = (
            candidate_account_state.data
            if candidate_account_state.kind == "file"
            else None
        )
        include_states = validate_candidate_with_includes(
            rewrite.content,
            self.fs,
            active,
            sensitive_input.data,
            legacy_input.data,
            candidate_account_bytes,
        )
        validate_enabled_uniqueness(
            self.fs.enabled_documents(active.parent), active, rewrite.content
        )

        originals = {
            "active": active_state,
            "available": available_state,
            "sensitive-snippet": sensitive_before,
            "legacy-snippet": legacy_before,
            "account-api-snippet": account_api_before,
        }
        if not apply:
            return rewrite

        with self.fs.lock(active.parent):
            return self._apply_transaction(
                active=active,
                available=available,
                sensitive_source=sensitive_source,
                legacy_source=legacy_source,
                sensitive_target=sensitive_target,
                legacy_target=legacy_target,
                account_api_target=account_api_target,
                sensitive_input=sensitive_input,
                legacy_input=legacy_input,
                rewrite=rewrite,
                originals=originals,
                include_states=include_states,
                candidate_account_bytes=candidate_account_bytes,
                backup_dir=backup_dir,
            )

    def _apply_transaction(
        self,
        *,
        active: Path,
        available: Path,
        sensitive_source: Path,
        legacy_source: Path,
        sensitive_target: Path,
        legacy_target: Path,
        account_api_target: Path,
        sensitive_input: FileState,
        legacy_input: FileState,
        rewrite: RewriteResult,
        originals: dict[str, FileState],
        include_states: dict[Path, FileState],
        candidate_account_bytes: bytes | None,
        backup_dir: Path,
    ) -> RewriteResult:
        active_state = originals["active"]
        available_state = originals["available"]
        sensitive_before = originals["sensitive-snippet"]
        legacy_before = originals["legacy-snippet"]
        account_api_before = originals["account-api-snippet"]

        # The lock coordinates all copies of this installer.  Re-read every
        # byte under the lock before creating the backup or modifying a path.
        if self.fs.snapshot(active) != active_state:
            raise InstallError("active config changed after validation")
        if self.fs.snapshot(available) != available_state:
            raise InstallError("sites-available changed after validation")
        if self.fs.snapshot(sensitive_target, allow_absent=True) != sensitive_before:
            raise InstallError("sensitive snippet target changed after validation")
        if self.fs.snapshot(legacy_target, allow_absent=True) != legacy_before:
            raise InstallError("legacy snippet target changed after validation")
        if self.fs.snapshot(account_api_target, allow_absent=True) != account_api_before:
            raise InstallError("account API snippet target changed after validation")
        if self.fs.snapshot(sensitive_source) != sensitive_input:
            raise InstallError("sensitive snippet input changed after validation")
        if self.fs.snapshot(legacy_source) != legacy_input:
            raise InstallError("legacy snippet input changed after validation")
        locked_include_states = validate_candidate_with_includes(
            rewrite.content,
            self.fs,
            active,
            sensitive_input.data,
            legacy_input.data,
            candidate_account_bytes,
        )
        if locked_include_states != include_states:
            raise InstallError("included Nginx files changed after validation")
        validate_enabled_uniqueness(
            self.fs.enabled_documents(active.parent), active, rewrite.content
        )

        # Establish a healthy, reloadable baseline before the first backup or
        # write.  A pre-existing invalid configuration is not a deployment
        # rollback failure and must be reported without mutating disk.
        self.runner.run(self.nginx_test)
        self.runner.run(self.nginx_active)
        self.fs.create_backup(backup_dir, originals)
        try:
            self.fs.atomic_write(
                sensitive_target, sensitive_input.data, 0o644, self.owner_uid, 0
            )
            self.fs.atomic_write(
                legacy_target, legacy_input.data, 0o644, self.owner_uid, 0
            )
            expected_account_api = account_api_before
            if rewrite.account_api_state == "snippet-rewrite-required":
                if rewrite.account_api_content is None:
                    raise InstallError("account API snippet candidate is missing")
                self.fs.atomic_write(
                    account_api_target,
                    rewrite.account_api_content,
                    0o644,
                    self.owner_uid,
                    0,
                )
                expected_account_api = FileState(
                    "file",
                    rewrite.account_api_content,
                    0o644,
                    self.owner_uid,
                    0,
                )
            self.fs.atomic_write(
                available,
                rewrite.content,
                0o644,
                self.owner_uid,
                0,
            )
            relative_target = os.path.relpath(available, active.parent)
            self.fs.atomic_symlink(active, relative_target, self.owner_uid, 0)
            self._confirm(
                active,
                available,
                sensitive_target,
                legacy_target,
                account_api_target,
                rewrite.content,
                sensitive_input.data,
                legacy_input.data,
                expected_account_api,
            )
            rewrite_account_api_routes(
                rewrite.content,
                self.fs.snapshot(account_api_target, allow_absent=True),
                "absent",
                "absent",
                apply=True,
                source=str(active),
            )
            validate_fixed_snippet_candidates(
                self.fs.snapshot(sensitive_target).data,
                self.fs.snapshot(legacy_target).data,
            )
            post_include_states = validate_candidate_with_includes(
                rewrite.content,
                self.fs,
                active,
                self.fs.snapshot(sensitive_target).data,
                self.fs.snapshot(legacy_target).data,
                (
                    expected_account_api.data
                    if expected_account_api.kind == "file"
                    else None
                ),
            )
            if post_include_states != include_states:
                raise InstallError("included Nginx files changed during deployment")
            validate_enabled_uniqueness(
                self.fs.enabled_documents(active.parent), active, rewrite.content
            )
            self.runner.run(self.nginx_test)
            self.runner.run(self.nginx_reload)
            self.runner.run(self.nginx_active)
            self._confirm(
                active,
                available,
                sensitive_target,
                legacy_target,
                account_api_target,
                rewrite.content,
                sensitive_input.data,
                legacy_input.data,
                expected_account_api,
            )
        except BaseException as deployment_error:
            try:
                # Restore the active entry first so subsequent file restores
                # cannot leave a new symlink observing stale available bytes.
                for label, path in (
                    ("active", active),
                    ("available", available),
                    ("sensitive-snippet", sensitive_target),
                    ("legacy-snippet", legacy_target),
                    ("account-api-snippet", account_api_target),
                ):
                    self.fs.restore(path, originals[label])
                self.runner.run(self.nginx_test)
                self.runner.run(self.nginx_reload)
                self.runner.run(self.nginx_active)
                for label, path in (
                    ("active", active),
                    ("available", available),
                    ("sensitive-snippet", sensitive_target),
                    ("legacy-snippet", legacy_target),
                    ("account-api-snippet", account_api_target),
                ):
                    if self.fs.snapshot(path, allow_absent=True) != originals[label]:
                        raise InstallError(f"rollback did not exactly restore {label}")
            except BaseException as rollback_error:
                raise InstallError(
                    f"deployment failed ({deployment_error}); rollback failed "
                    f"({rollback_error}); recover from {backup_dir}"
                ) from rollback_error
            raise InstallError(
                f"deployment failed and exact rollback completed: {deployment_error}"
            ) from deployment_error
        return rewrite

    def _confirm(
        self,
        active: Path,
        available: Path,
        sensitive_target: Path,
        legacy_target: Path,
        account_api_target: Path,
        expected_config: bytes,
        expected_sensitive: bytes,
        expected_legacy: bytes,
        expected_account_api: FileState,
    ) -> None:
        active_state = self.fs.snapshot(active)
        if active_state.kind != "symlink":
            raise InstallError("active entry is not the canonical symlink after reload")
        if (
            active_state.uid != self.owner_uid
            or active_state.gid != 0
            or active_state.nlink != 1
        ):
            raise InstallError("active symlink postcondition ownership is unsafe")
        if self.fs.resolve(active) != self.fs.resolve(available):
            raise InstallError("active symlink does not resolve to sites-available after reload")
        if lexical_symlink_target(active, active_state) != available:
            raise InstallError("active symlink does not directly target sites-available after reload")
        checks = (
            (self.fs.snapshot(available), expected_config, "sites-available"),
            (
                self.fs.snapshot(sensitive_target),
                expected_sensitive,
                "sensitive snippet",
            ),
            (self.fs.snapshot(legacy_target), expected_legacy, "legacy snippet"),
        )
        for state, expected, label in checks:
            if state.kind != "file" or state.data != expected:
                raise InstallError(f"{label} postcondition mismatch")
            if (
                state.uid != self.owner_uid
                or state.gid != 0
                or state.mode != 0o644
                or state.nlink != 1
            ):
                raise InstallError(f"{label} postcondition permissions are unsafe")
        actual_account_api = self.fs.snapshot(account_api_target, allow_absent=True)
        if actual_account_api != expected_account_api:
            raise InstallError("account API snippet postcondition mismatch")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Install Build 34 Nginx routing from the active config transactionally"
    )
    mode = result.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="validate only (default)")
    mode.add_argument("--apply", action="store_true", help="back up and apply changes")
    result.add_argument("--sensitive-source", type=Path, required=True)
    result.add_argument("--legacy-source", type=Path, required=True)
    result.add_argument("--expected-active-sha256", required=True)
    result.add_argument("--expected-available-sha256", required=True)
    result.add_argument(
        "--expected-sensitive-target",
        required=True,
        metavar="SHA256|absent",
    )
    result.add_argument(
        "--expected-legacy-target", required=True, metavar="SHA256|absent"
    )
    result.add_argument(
        "--expected-account-api-snippet",
        required=True,
        metavar="SHA256|absent",
        help="expected state of the fixed account API snippet target",
    )
    result.add_argument("--sensitive-source-sha256", required=True)
    result.add_argument("--legacy-source-sha256", required=True)
    result.add_argument(
        "--expected-old-images-location-sha256",
        help="required for --apply; omit once in dry-run to inventory the exact old block",
    )
    result.add_argument(
        "--expected-old-direct-account-api-location-sha256",
        help=(
            "SHA256 or absent; required for --apply and must match the direct www "
            "account API topology"
        ),
    )
    result.add_argument(
        "--expected-old-snippet-account-api-location-sha256",
        help=(
            "SHA256 or absent; required for --apply and must match the included "
            "account API snippet topology"
        ),
    )
    result.add_argument("--backup-dir", type=Path)
    return result


def require_backup_transaction_path(path: Path) -> None:
    if (
        not path.is_absolute()
        or path.parent != DEFAULT_BACKUP_ROOT
        or not BACKUP_NAME_PATTERN.fullmatch(path.name)
    ):
        raise InstallError(
            f"--backup-dir must be a direct child of {DEFAULT_BACKUP_ROOT}"
        )


def main(argv: Sequence[str] | None = None) -> int:
    arguments = parser().parse_args(argv)
    if os.geteuid() != 0:
        print("install-build34-nginx-routing: must run as root", file=sys.stderr)
        return 1
    backup_dir = arguments.backup_dir
    if backup_dir is None:
        backup_dir = DEFAULT_BACKUP_ROOT / (
            time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + f"-{os.getpid()}"
        )
    try:
        require_backup_transaction_path(backup_dir)
    except (InstallError, OSError) as error:
        print(f"install-build34-nginx-routing: {error}", file=sys.stderr)
        return 1
    installer = Installer(RealFilesystem(), SubprocessRunner())
    try:
        outcome = installer.install(
            active=DEFAULT_ACTIVE,
            available=DEFAULT_AVAILABLE,
            sensitive_source=arguments.sensitive_source,
            legacy_source=arguments.legacy_source,
            sensitive_target=DEFAULT_SENSITIVE_TARGET,
            legacy_target=DEFAULT_LEGACY_TARGET,
            account_api_target=DEFAULT_ACCOUNT_API_TARGET,
            expected_active_sha256=arguments.expected_active_sha256,
            expected_available_sha256=arguments.expected_available_sha256,
            expected_sensitive_target=arguments.expected_sensitive_target,
            expected_legacy_target=arguments.expected_legacy_target,
            expected_account_api_snippet=arguments.expected_account_api_snippet,
            sensitive_source_sha256=arguments.sensitive_source_sha256,
            legacy_source_sha256=arguments.legacy_source_sha256,
            expected_old_location_sha256=arguments.expected_old_images_location_sha256,
            expected_old_direct_account_api_sha256=(
                arguments.expected_old_direct_account_api_location_sha256
            ),
            expected_old_snippet_account_api_sha256=(
                arguments.expected_old_snippet_account_api_location_sha256
            ),
            backup_dir=backup_dir,
            apply=arguments.apply,
        )
    except (InstallError, OSError) as error:
        print(f"install-build34-nginx-routing: {error}", file=sys.stderr)
        return 1
    mode = "apply" if arguments.apply else "dry-run"
    print(
        "install-build34-nginx-routing: "
        f"{mode} passed state={outcome.state} "
        f"account_api_state={outcome.account_api_state} "
        f"candidate_sha256={sha256(outcome.content)}"
    )
    if outcome.old_location_sha256 is not None:
        print(
            "install-build34-nginx-routing: "
            f"old_images_location_sha256={outcome.old_location_sha256}"
        )
    if outcome.old_direct_account_api_sha256 is not None:
        print(
            "install-build34-nginx-routing: "
            "old_direct_account_api_location_sha256="
            f"{outcome.old_direct_account_api_sha256}"
        )
    if outcome.old_snippet_account_api_sha256 is not None:
        print(
            "install-build34-nginx-routing: "
            "old_snippet_account_api_location_sha256="
            f"{outcome.old_snippet_account_api_sha256}"
        )
    if arguments.apply:
        print(f"install-build34-nginx-routing: backup={backup_dir}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
