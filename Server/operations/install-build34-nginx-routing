    document = parse_snippet(content, label)
    if tuple(directive_signature(node) for node in document) != EXPECTED_LEGACY_SIGNATURE:
        raise InstallError(f"{label} semantic content drifted")
    if len(document) != 3 or any(
        node.name.lower() != "location" or node.children is None for node in document
    ):
        raise InstallError(f"{label} must contain exactly three top-level locations")

    exact = [node for node in document if node.args == ("=", "/images")]
    fallback = [node for node in document if node.args == ("~*", r"^/images/")]
    regexes = [
        node
        for node in document
        if len(node.args) == 2 and node.args[0] in ("~", "~*")
