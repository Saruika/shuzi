@dataclass
class IncludeExpansion:
    filesystem: Filesystem
    overlays: dict[Path, bytes]
    root_source: Path
    nginx_root: Path = DEFAULT_NGINX_ROOT
    included_files: int = 0
    included_bytes: int = 0

    MAX_DEPTH = 32
    MAX_FILES = 256
    MAX_BYTES = 8 * 1024 * 1024

    def __post_init__(self) -> None:
        self.states: dict[Path, FileState] = {}

    def expand_server(self, server: Directive) -> Directive:
        children = self._expand_sequence(
            server.children or (), self.root_source, (self.root_source,), 0
        )
        return Directive(
            server.name,
            server.args,
            children,
            server.start,
            server.end,
            server.line,
        )

    def _normalized_include(self, raw_path: str) -> Path:
        if "$" in raw_path or "\x00" in raw_path or "\\" in raw_path:
            raise InstallError("dynamic or escaped Nginx include path is not allowed")
        candidate = Path(raw_path)
        if not candidate.is_absolute():
            candidate = self.nginx_root / candidate
        candidate = Path(os.path.abspath(candidate))
        if candidate != self.nginx_root and self.nginx_root not in candidate.parents:
            raise InstallError("Nginx include escapes the reviewed root")
        return candidate

    def _expand_include(
        self,
        directive: Directive,
        source: Path,
        stack: tuple[Path, ...],
        depth: int,
    ) -> tuple[Directive, ...]:
        if len(directive.args) != 1:
            raise InstallError("include must have exactly one local path")
        raw_path = directive.args[0]
        normalized = self._normalized_include(raw_path)
        overlay = self.overlays.get(normalized)
        if overlay is not None:
            if glob.has_magic(raw_path) or source != self.root_source or depth != 0:
                raise InstallError("fixed snippet must be directly included by active config")
            return (
                Directive(
                    "include",
                    (str(normalized),),
                    None,
                    directive.start,
                    directive.end,
                    directive.line,
                ),
            )

        if depth >= self.MAX_DEPTH:
            raise InstallError("Nginx include nesting exceeds the reviewed limit")
        expanded: list[Directive] = []
        matches = self.filesystem.secure_include_matches(raw_path, self.nginx_root)
        for path, state in matches.items():
            if path in stack:
                chain = " -> ".join(str(item) for item in (*stack, path))
                raise InstallError(f"recursive Nginx include cycle: {chain}")
            self.included_files += 1
            self.included_bytes += len(state.data)
            if self.included_files > self.MAX_FILES:
                raise InstallError("Nginx include file count exceeds the reviewed limit")
            if self.included_bytes > self.MAX_BYTES:
                raise InstallError("Nginx include bytes exceed the reviewed limit")
            previous = self.states.get(path)
            if previous is not None and previous != state:
                raise InstallError(f"included Nginx file changed during validation: {path}")
            self.states[path] = state
            try:
                text = state.data.decode("utf-8")
            except UnicodeDecodeError as error:
                raise InstallError(f"included Nginx file is not valid UTF-8: {path}") from error
            if "\x00" in text:
                raise InstallError(f"included Nginx file contains a NUL byte: {path}")
            document = parse(text, str(path))
            if any(
                item.name.lower() == EXPANDED_INCLUDE_MARKER
                for item in all_directives(document)
            ):
                raise InstallError(
                    f"included Nginx file uses reserved validator directive: {path}"
                )
            self._validate_reviewed_include_file(path, document)
            expanded.append(
                Directive(
                    EXPANDED_INCLUDE_MARKER,
                    (str(path),),
                    None,
                    directive.start,
                    directive.end,
                    directive.line,
                )
            )
            expanded.extend(
                self._expand_sequence(document, path, (*stack, path), depth + 1)
            )
        return tuple(expanded)

    def _validate_reviewed_include_file(
        self, path: Path, document: Sequence[Directive]
    ) -> None:
        """Fail closed on every non-versioned include used by selected TLS blocks."""

        if path == SECURITY_INCLUDE:
            if len(document) != 7 or any(
                item.name.lower() != "add_header"
                or item.children is not None
                or len(item.args) not in (2, 3)
                for item in document
            ):
                raise InstallError(
                    f"security header include is not the reviewed seven-header profile: {path}"
                )
            return
        if path == FASTCGI_PHP_INCLUDE:
            if any(item.children is not None for item in document):
                raise InstallError(f"FastCGI PHP include contains a block: {path}")
            allowed = {
                "fastcgi_split_path_info",
                "try_files",
                "set",
                "fastcgi_param",
                "fastcgi_index",
                "include",
            }
            if any(item.name.lower() not in allowed for item in document):
                raise InstallError(f"FastCGI PHP include contains an unreviewed directive: {path}")
            includes = [item for item in document if item.name.lower() == "include"]
            if len(includes) != 1 or includes[0].args != ("fastcgi.conf",):
                raise InstallError(f"FastCGI PHP include must include fastcgi.conf once: {path}")
            required = {
                "fastcgi_split_path_info": 1,
                "try_files": 1,
                "set": 1,
                "fastcgi_param": 1,
                "fastcgi_index": 1,
            }
            counts = {
                name: sum(item.name.lower() == name for item in document)
                for name in required
            }
            if counts != required:
                raise InstallError(f"FastCGI PHP include topology drifted: {path}")
            if direct_args(document, "try_files") != [
                ("$fastcgi_script_name", "=404")
            ]:
                raise InstallError(f"FastCGI PHP include try_files drifted: {path}")
            if direct_args(document, "fastcgi_split_path_info") != [
                (r"^(.+?\.php)(/.*)$",)
            ]:
                raise InstallError(f"FastCGI PHP include split-path rule drifted: {path}")
            if direct_args(document, "set") != [("$path_info", "$fastcgi_path_info")]:
                raise InstallError(f"FastCGI PHP include PATH_INFO state drifted: {path}")
            if direct_args(document, "fastcgi_param") != [("PATH_INFO", "$path_info")]:
                raise InstallError(f"FastCGI PHP include PATH_INFO parameter drifted: {path}")
            if direct_args(document, "fastcgi_index") != [("index.php",)]:
                raise InstallError(f"FastCGI PHP include index drifted: {path}")
            return
        if path == FASTCGI_BASE_INCLUDE:
            if not document or any(
                item.name.lower() != "fastcgi_param"
                or item.children is not None
                or len(item.args) < 2
                or item.args[0].upper() not in FASTCGI_ALLOWED_PARAMS
                for item in document
            ):
                raise InstallError(f"FastCGI base include semantic content drifted: {path}")
            return
        raise InstallError(f"selected TLS block includes an unreviewed file: {path}")

    def _expand_sequence(
        self,
        directives: Sequence[Directive],
        source: Path,
        stack: tuple[Path, ...],
        depth: int,
    ) -> tuple[Directive, ...]:
        expanded: list[Directive] = []
        for directive in directives:
            if directive.name.lower() == EXPANDED_INCLUDE_MARKER:
                raise InstallError("active Nginx config uses a reserved validator directive")
            if directive.name.lower() == "include":
                expanded.extend(self._expand_include(directive, source, stack, depth))
                continue
            children = None
            if directive.children is not None:
                children = self._expand_sequence(
                    directive.children, source, stack, depth
                )
            expanded.append(
                Directive(
                    directive.name,
                    directive.args,
                    children,
                    directive.start,
                    directive.end,
                    directive.line,
                )
            )
        return tuple(expanded)


class Filesystem(Protocol):
    def require_secure_directory(self, path: Path, owner_uid: int, label: str) -> None: ...

    def snapshot(self, path: Path, allow_absent: bool = False) -> FileState: ...

    def atomic_write(self, path: Path, data: bytes, mode: int, uid: int, gid: int) -> None: ...

    def atomic_symlink(self, path: Path, target: str, uid: int, gid: int) -> None: ...

    def restore(self, path: Path, state: FileState) -> None: ...

    def create_backup(self, path: Path, states: dict[str, FileState]) -> None: ...

    def resolve(self, path: Path) -> Path: ...

    def lock(self, path: Path) -> ContextManager[None]: ...

    def enabled_documents(self, path: Path) -> dict[Path, bytes]: ...

    def secure_include_matches(
        self, raw_path: str, nginx_root: Path
    ) -> dict[Path, FileState]: ...


class CommandRunner(Protocol):
    def run(self, command: Sequence[str]) -> None: ...


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def validate_sha256(value: str, label: str) -> str:
    lowered = value.lower()
    if not SHA256_PATTERN.fullmatch(lowered):
        raise InstallError(f"{label} must be exactly 64 hexadecimal characters")
    return lowered


def nginx_escape_value(escaped: str) -> str:
    translated = {"t": "\t", "r": "\r", "n": "\n"}
    if escaped in translated:
        return translated[escaped]
    if escaped in ('"', "'", "\\"):
        return escaped
    return "\\" + escaped


def tokenize(text: str, source: str) -> list[Token]:
    """Tokenize structural Nginx syntax while ignoring comments and quotes."""

    tokens: list[Token] = []
    index = 0
    line = 1
    length = len(text)
    while index < length:
        char = text[index]
        if char in " \t\r":
            index += 1
            continue
        if char == "\n":
            line += 1
            index += 1
            continue
        if char == "#":
            newline = text.find("\n", index)
            if newline == -1:
                break
            index = newline
            continue
        if char in ";{}":
            tokens.append(Token(char, index, index + 1, line, True))
            index += 1
            continue
        if char in "'\"":
            quote = char
            token_start = index
            token_line = line
            index += 1
            value: list[str] = []
            while index < length:
                char = text[index]
                if char == "\\":
                    if index + 1 >= length:
                        raise InstallError(f"{source}:{token_line}: unterminated quote escape")
                    escaped = text[index + 1]
                    if escaped == "\n":
                        line += 1
                    # Nginx preserves the backslash for non-special escapes.
                    # Dropping it turns e.g. "\\.php$" into ".php$" and can
                    # make semantic regex checks inspect a different pattern.
                    value.append(nginx_escape_value(escaped))
                    index += 2
                    continue
                if char == quote:
                    index += 1
                    break
                if char == "\n":
                    line += 1
                value.append(char)
                index += 1
            else:
                raise InstallError(f"{source}:{token_line}: unterminated quote")
            tokens.append(Token("".join(value), token_start, index, token_line))
            continue

        token_start = index
        token_line = line
        value: list[str] = []
        while index < length:
            char = text[index]
            if char in " \t\r\n;#":
                break
            if char == "\\":
                if index + 1 >= length:
                    raise InstallError(
                        f"{source}:{token_line}: unterminated unquoted escape"
                    )
                escaped = text[index + 1]
                if escaped == "\n":
                    line += 1
                value.append(nginx_escape_value(escaped))
                index += 2
                continue
            if char == "{" and value and value[-1] == "$":
                closing = text.find("}", index + 1)
                if closing == -1:
                    raise InstallError(
                        f"{source}:{token_line}: unterminated variable expansion"
                    )
                value.append(text[index : closing + 1])
                index = closing + 1
                continue
            if char in "{}":
                break
            value.append(char)
            index += 1
        if not value:
            raise InstallError(f"{source}:{line}: cannot tokenize input")
        tokens.append(Token("".join(value), token_start, index, token_line))
    return tokens


def parse(text: str, source: str) -> tuple[Directive, ...]:
    tokens = tokenize(text, source)
    position = 0
    max_block_depth = 64

    def parse_scope(
        expect_close: bool, depth: int = 0
    ) -> tuple[tuple[Directive, ...], Token | None]:
        nonlocal position
        if depth > max_block_depth:
            raise InstallError(f"{source}: block nesting exceeds the reviewed limit")
        directives: list[Directive] = []
        while position < len(tokens):
            if tokens[position].value == "}":
                if not expect_close:
                    raise InstallError(
                        f"{source}:{tokens[position].line}: unexpected closing brace"
                    )
                closing = tokens[position]
                position += 1
                return tuple(directives), closing
            start = tokens[position]
            if start.symbol:
                raise InstallError(
                    f"{source}:{start.line}: expected directive, got {start.value!r}"
                )
            position += 1
            args: list[str] = []
            while position < len(tokens) and tokens[position].value not in (";", "{", "}"):
                args.append(tokens[position].value)
                position += 1
            if position >= len(tokens):
                raise InstallError(
                    f"{source}:{start.line}: unterminated directive {start.value}"
                )
            terminator = tokens[position]
            if terminator.value == "}":
                raise InstallError(
                    f"{source}:{start.line}: directive {start.value} lacks ';' or '{{'"
                )
            position += 1
            if terminator.value == ";":
                directives.append(
                    Directive(
                        start.value,
                        tuple(args),
                        None,
                        start.start,
                        terminator.end,
                        start.line,
                    )
                )
            else:
                children, closing = parse_scope(True, depth + 1)
                if closing is None:
                    raise InstallError(f"{source}:{start.line}: unclosed block")
                directives.append(
                    Directive(
                        start.value,
                        tuple(args),
                        children,
                        start.start,
                        closing.end,
                        start.line,
                    )
                )
        if expect_close:
            raise InstallError(f"{source}: unclosed block")
        return tuple(directives), None

    document, _ = parse_scope(False)
    if position != len(tokens):
        raise InstallError(f"{source}: trailing parser state")
    return document


def direct(node: Directive, name: str) -> list[Directive]:
    return [
        child
        for child in (node.children or ())
        if child.name.lower() == name.lower()
    ]


def direct_args(document: Sequence[Directive], name: str) -> list[tuple[str, ...]]:
    return [item.args for item in document if item.name.lower() == name.lower()]


def descendants(node: Directive) -> list[Directive]:
    result: list[Directive] = []
    for child in node.children or ():
        result.append(child)
        result.extend(descendants(child))
    return result


def is_tls_listener(node: Directive) -> bool:
    for listener in direct(node, "listen"):
        lowered = [argument.lower() for argument in listener.args]
        endpoint_443 = any(
            argument == "443"
            or argument.endswith(":443")
            for argument in lowered
        )
        if endpoint_443 and "ssl" in lowered:
            return True
    return False


def unique_tls_server(document: Sequence[Directive], hostname: str) -> Directive:
    candidates: list[Directive] = []
    for node in document:
        if node.name.lower() != "server" or node.children is None:
            continue
        names = {
            argument.lower()
            for directive in direct(node, "server_name")
            for argument in directive.args
        }
        if hostname.lower() in names and is_tls_listener(node):
            candidates.append(node)
    if len(candidates) != 1:
        raise InstallError(f"active config must contain exactly one TLS block for {hostname}")
    return candidates[0]


def tls_servers(document: Sequence[Directive], hostname: str) -> list[Directive]:
    result: list[Directive] = []
    for node in document:
        if node.name.lower() != "server" or node.children is None:
            continue
        names = {
            argument.lower()
            for directive in direct(node, "server_name")
            for argument in directive.args
        }
        if hostname.lower() in names and is_tls_listener(node):
            result.append(node)
    return result


def validate_enabled_uniqueness(
    documents: dict[Path, bytes], active: Path, candidate: bytes
) -> None:
    if active not in documents:
        raise InstallError("active config is not present in sites-enabled inventory")
    parsed: dict[Path, tuple[Directive, ...]] = {}
    for path, content in documents.items():
        selected = candidate if path == active else content
        try:
            text = selected.decode("utf-8")
        except UnicodeDecodeError as error:
            raise InstallError(f"enabled Nginx config is not valid UTF-8: {path}") from error
        parsed[path] = parse(text, str(path))
        if any(node.name.lower() == "include" for node in parsed[path]):
            raise InstallError(
                f"enabled Nginx config must not contain a top-level include: {path}"
            )
    for hostname in (WWW_HOST, IMG_HOST):
        matches = [
            (path, node)
            for path, document in parsed.items()
            for node in tls_servers(document, hostname)
        ]
        if len(matches) != 1 or matches[0][0] != active:
            raise InstallError(
                f"{hostname} must appear in exactly one enabled TLS block from {active}"
            )


def matching_include(node: Directive, include_path: str) -> list[Directive]:
    all_nodes = [node, *descendants(node)]
    return [
        item
        for item in all_nodes
        if item.name.lower() == "include" and item.args == (include_path,)
    ]


def require_direct_include(node: Directive, include_path: str, hostname: str) -> Directive:
    matches = matching_include(node, include_path)
    direct_matches = [
        item for item in direct(node, "include") if item.args == (include_path,)
    ]
    if len(matches) != 1 or len(direct_matches) != 1:
        raise InstallError(
            f"{hostname} must contain exactly one direct {include_path} include"
        )
    return direct_matches[0]


def line_indentation(text: str, offset: int, source: str) -> str:
    line_start = text.rfind("\n", 0, offset) + 1
    prefix = text[line_start:offset]
    if prefix.strip():
        raise InstallError(f"{source}: security directive must begin on its own line")
    return prefix


def insertion_after_directive_line(
    text: str, directive: Directive, indentation: str, source: str
) -> tuple[int, str]:
    newline = text.find("\n", directive.end)
    line_end = len(text) if newline == -1 else newline
    trailer = text[directive.end:line_end].lstrip()
    if trailer and not trailer.startswith("#"):
        raise InstallError(f"{source}: sensitive include must be alone on its line")
    rendered = f"{indentation}include {LEGACY_INCLUDE};"
    if newline == -1:
        return line_end, "\n" + rendered
    return newline + 1, rendered + "\n"


def images_location(node: Directive) -> list[Directive]:
    return [
        child
        for child in (node.children or ())
        if child.name.lower() == "location" and child.args == ("^~", "/images/")
    ]


def location_path(node: Directive) -> tuple[str, str] | None:
    if node.name.lower() != "location" or not node.args:
        return None
    if node.args[0] in ("=", "~", "~*", "^~"):
        return (node.args[0], node.args[1] if len(node.args) > 1 else "")
    return "", node.args[0]


def is_images_location(modifier: str, path: str) -> bool:
    lowered = path.lower().replace(r"\/", "/")
    if modifier in ("~", "~*"):
        return "/images" in lowered
    return lowered == "/images" or lowered.startswith("/images/")


SENSITIVE_EXACT_LOCATION_PATTERNS = tuple(
    re.compile(pattern, re.IGNORECASE)
    for pattern in (
        # Keep these expressions equivalent to
        # shuzijun-sensitive-files-deny.conf.  Exact Nginx locations outrank
        # regex locations, so every exact sensitive URI must be rejected.
        r"(?:^|/)(?:wp-config\.php(?:$|[^/]+)|[^/]+\.php[^/]+$|"
        r"[^/]+\.(?:bak|backup|old|orig|save|swp|tmp|copy|disabled|corrupt|"
        r"corrupted|fixbak)(?:$|[._~-])|[^/]+\.before-[^/]+$|[^/]+~$)",
        r"^/wp-content/.*\.php(?:$|/)",
        r"^/images/.*\.php(?:$|/)",
        r"(?:^|/)(?:\.env(?:\.[^/]*)?|\.(?:git|svn|hg)(?:/|$)|"
