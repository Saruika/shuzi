def validate_account_snippet_controls(node: Directive, label: str) -> None:
    """Allow only the reviewed local-proxy assignment ``if`` in account snippet."""

    reject_internal_redirect_controls((node,), label, allow_if=True)
    forbidden = {"return", "try_files"}
    if any(
        item.name.lower() in forbidden for item in all_directives((node,))
    ):
        raise InstallError(f"{label} contains an unreviewed control-flow directive")
    all_ifs = [
        item for item in all_directives((node,)) if item.name.lower() == "if"
    ]
    direct_ifs = [
        item for item in (node.children or ()) if item.name.lower() == "if"
    ]
    if len(all_ifs) != 1 or all_ifs != direct_ifs:
        raise InstallError(f"{label} contains an unreviewed if block")
    reviewed_if = all_ifs[0]
    children = tuple(reviewed_if.children or ())
    if (
        reviewed_if.args != REVIEWED_ACCOUNT_ASSIGNMENT_IF_ARGS
        or len(children) != 1
        or children[0].name.lower() != "set"
        or children[0].args != REVIEWED_ACCOUNT_ASSIGNMENT_SET_ARGS
        or children[0].children is not None
    ):
        raise InstallError(f"{label} contains an unreviewed if block")
    all_client_ip_sets = [
        item
        for item in all_directives((node,))
        if item.name.lower() == "set"
        and item.args
        and item.args[0] == "$yishu_client_ip"
    ]
    direct_initializers = [
        item
        for item in (node.children or ())
        if item.name.lower() == "set"
        and item.args == REVIEWED_ACCOUNT_INITIAL_SET_ARGS
        and item.children is None
    ]
    if (
        len(direct_initializers) != 1
        or len(all_client_ip_sets) != 2
        or not any(item is children[0] for item in all_client_ip_sets)
        or not any(item is direct_initializers[0] for item in all_client_ip_sets)
    ):
        raise InstallError(f"{label} client IP assignment topology drifted")


def validate_location_security(
    document: Sequence[Directive],
    label: str,
    *,
    allow_reviewed_account_if: bool = False,
) -> None:
    reject_nested_locations(document, label)
    if any(item.name.lower() == "include" for item in all_directives(document)):
        raise InstallError(f"{label} must not contain another include")
    if allow_reviewed_account_if:
        if len(document) != 1:
            raise InstallError(f"{label} reviewed if requires one account location")
        validate_account_snippet_controls(document[0], label)
    else:
        reject_internal_redirect_controls(document, label)
    for item in all_directives(document):
        parsed = location_path(item)
        if parsed is None:
            continue
        modifier, path = parsed
        if modifier == "^~":
            raise InstallError(f"{label} has a ^~ location that bypasses security regex rules")
        if modifier == "=" and exact_location_is_sensitive(path):
            raise InstallError(
                f"{label} has an exact location that bypasses sensitive-file rules"
            )
        if is_images_location(modifier, path):
            raise InstallError(f"{label} contains an inline /images location")
        if modifier in ("~", "~*"):
            validate_allowed_regex_location(
                WWW_HOST, item, modifier, path, label=label
            )


