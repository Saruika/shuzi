def account_api_location_like(node: Directive) -> bool:
    parsed = location_path(node)
    if parsed is None:
        return False
    modifier, path = parsed
    normalized = path.lower().replace(r"\/", "/")
    namespace = ACCOUNT_API_PATH.lower()
    if modifier in ("~", "~*"):
        return namespace.rstrip("/") in normalized
    return (
        normalized.rstrip("/") == namespace.rstrip("/")
        or normalized.startswith(namespace)
    )


def account_api_locations(document: Sequence[Directive]) -> list[Directive]:
    return [node for node in all_directives(document) if account_api_location_like(node)]


def remove_caret_location_modifier(text: str, node: Directive, source: str) -> str:
    tokens = tokenize(text, source)
    try:
        index = next(index for index, token in enumerate(tokens) if token.start == node.start)
    except StopIteration as error:
        raise InstallError(f"{source}: account API location token is missing") from error
    header = tokens[index : index + 4]
    if (
        len(header) != 4
        or header[0].value.lower() != "location"
        or header[1].value != "^~"
        or header[2].value != ACCOUNT_API_PATH
        or header[3].value != "{"
    ):
        raise InstallError(f"{source}: account API location header is malformed")
    return text[: header[1].start] + text[header[2].start :]


def validate_old_block_expectation(
    observed: str | None,
    expected: str | None,
    label: str,
    apply: bool,
) -> None:
    if observed is None:
        if expected not in (None, "absent"):
            raise InstallError(f"{label} drifted: expected no old block")
        if apply and expected != "absent":
            raise InstallError(f"{label}=absent is mandatory with --apply")
        return
    if expected is None:
        if apply:
            raise InstallError(f"{label} SHA-256 is mandatory with --apply")
        return
    if expected == "absent":
        raise InstallError(f"{label} drifted: an old block is present")
    expected_hash = validate_sha256(expected, f"{label} SHA-256")
    if observed != expected_hash:
        raise InstallError(f"{label} drifted: expected {expected_hash}, observed {observed}")


def reject_internal_redirect_controls(
    document: Sequence[Directive], label: str, *, allow_if: bool = False
) -> None:
    redirect_controls = {
        "error_page",
        "internal_redirect",
        "recursive_error_pages",
