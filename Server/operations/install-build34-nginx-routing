def direct_return(node: Directive, arguments: tuple[str, ...]) -> bool:
    returns = direct(node, "return")
    return len(returns) == 1 and returns[0].args == arguments


def validate_sensitive_snippet(content: bytes) -> None:
    label = "sensitive snippet candidate"
    document = parse_snippet(content, label)
    if tuple(directive_signature(node) for node in document) != EXPECTED_SENSITIVE_SIGNATURE:
        raise InstallError(f"{label} semantic content drifted")
    if not document or any(
        node.name.lower() != "location" or node.children is None for node in document
    ):
        raise InstallError(f"{label} must contain only top-level deny locations")

    compiled: list[re.Pattern[str]] = []
    for node in document:
        if len(node.args) != 2 or node.args[0] != "~*":
            raise InstallError(f"{label} locations must be case-insensitive regexes")
        if not direct_return(node, ("404",)):
            raise InstallError(f"{label} locations must return exactly 404")
        for child in node.children or ():
            if child.children is not None or child.name.lower() not in (
                "access_log",
                "log_not_found",
                "return",
            ):
                raise InstallError(f"{label} contains a content or redirect handler")
        compiled.append(compile_location_regex(node.args[0], node.args[1], label))

    required_denials = (
        "/wp-config.php",
        "/copy.php.bak",
        "/wp-content/mu-plugins/app.php",
        "/images/payload.php",
        "/.env.production",
        "/.git/config",
        "/composer.json",
        "/exports/database.sql",
        "/private/credentials.json",
        "/WP-CONFIG.PHP",
        "/IMAGES/PAYLOAD.PHP",
        "/PRIVATE/CREDENTIALS.JSON",
    )
    for uri in required_denials:
        if not any(pattern.search(uri) for pattern in compiled):
            raise InstallError(f"{label} does not deny required URI family: {uri}")


def validate_legacy_snippet(content: bytes) -> None:
