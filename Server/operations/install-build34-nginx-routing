        raise InstallError(f"{label} route topology is not the reviewed flat-image API")
    if not direct_return(exact[0], ("308", "/images/")):
        raise InstallError(f"{label} exact route must redirect to /images/")
    if not direct_return(fallback[0], ("404",)):
        raise InstallError(f"{label} fallback route must return 404")

