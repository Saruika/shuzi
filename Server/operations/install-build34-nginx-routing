def exact_location_is_sensitive(path: str) -> bool:
    return any(pattern.search(path) for pattern in SENSITIVE_EXACT_LOCATION_PATTERNS)


def all_directives(document: Sequence[Directive]) -> list[Directive]:
    result: list[Directive] = []
    for node in document:
        result.append(node)
        result.extend(descendants(node))
    return result


def reject_nested_locations(document: Sequence[Directive], label: str) -> None:
    def walk(nodes: Sequence[Directive], inside_location: bool) -> None:
        for node in nodes:
            is_location = node.name.lower() == "location"
            if is_location and inside_location:
                raise InstallError(f"{label} contains a nested location")
            if node.children is not None:
                walk(node.children, inside_location or is_location)

    walk(document, False)


